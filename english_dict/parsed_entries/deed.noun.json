          "quotations": [
            {
              "old_english": "Be ðam ðe seó dǽd sý according as the deed may be",
              "english": "according as the deed may be",
              "citations": "L. Eth. v. 31; Th. i. 312, 10: vi. 38; Th. i. 324, 23: L. C. E. 3; Th. i. 360, 13"
            },
            {
              "old_english": "Seó árfæste dǽd",
              "english": "the goodly deed",
              "citations": "Bd. 3, 6; S. 528, 22: Cd. 28; Th. 37, 24; Gen. 594: 226; Th. 301, 4; Sat. 576: Bt. Met. Fox 9, 36; Met. 9, 18: Chr. 1036; Erl. 165, 11; Ælf. Tod. 6"
            },
            {
              "old_english": "Gesǽton land unspédigran ðonne se frumstól wæs, ðe hie, æfter dǽde, ofadrifen wurdon",
              "english": "they inhabited a land more barren than the first settlement was, which they, after their deed, were driven from",
              "citations": "Cd. 46; Th. 59, 15; Gen. 964"
            },
            {
              "old_english": "For ðære dǽde",
              "english": "for that deed",
              "citations": "125; Th. 159, 23; Gen. 2639: 126; Th. 161, 24; Gen. 2670"
            },
            {
              "old_english": "Hió speón hine on ða dimman dǽd",
              "english": "she urged him to that dark deed",
              "citations": "32; Th. 43, 3; Gen. 685"
            },
            {
              "old_english": "Sceolde he dǽd ongyldan",
              "english": "he must expiate the deed",
              "citations": "15; Th. 19, 23; Gen. 295: 17; Th. 20, 15; Gen. 309: 25; Th. 32, 23; Gen. 507: Beo. Th. 5772; B. 2890: Elen. Kmbl. 772; El. 386"
            },
            {
              "old_english": "Mid ðisre dǽde",
              "english": "with this deed",
              "citations": "Homl. Th. i. 218, 7: Exon. 103 b; Th. 393, 8; Rä. 12, 7"
            },
            {
              "old_english": "Ne sindon him dǽda dyrne",
              "english": "deeds are not dark to him",
              "citations": "23 a; Th. 65, 5; Cri. 1050: 39 b; Th. 130, 12; Gú. 437"
            },
            {
              "old_english": "Ðæt his góde dǽda swýðran wearþan ðonne misdǽda",
              "english": "that his good deeds be more prevailing than his misdeeds",
              "citations": "Chr. 959; Erl. 121, 5"
            },
            {
              "old_english": "Opene weorþaþ monna dǽde",
              "english": "men's deeds shall be open",
              "citations": "Exon. 23 a; Th. 64, 34; Cri. 1047"
            },
            {
              "old_english": "Ðú scealt þrówian ðínra dǽda gedwild",
              "english": "thou shalt expiate the error of thy deeds",
              "citations": "Cd. 43; Th. 57, 2; Gen. 922: 188; Th. 233, 27; Dan. 282: Bd. pref; S. 471, 13: Exon. 53 a; Th. 185, 16; Az. 8"
            },
            {
              "old_english": "Ðeáh ðe he dǽda gehwæs dyrstig wǽre",
              "english": "although he were daring in every deed",
              "citations": "Beo. Th. 5668; B. 2838: Elen. Kmbl. 2563; El. 1283"
            },
            {
              "old_english": "In his dǽdum",
              "english": "in his deeds",
              "citations": "Exon. 82 a; Th. 308, 17; Seef. 41: 76 a; Th. 284, 34; Jul. 707: Cd. 29; Th. 38, 6; Gen. 602: Chr. 755; Erl. 49, 21"
            },
            {
              "old_english": "Wile Dryhten sylf dǽda gehýran",
