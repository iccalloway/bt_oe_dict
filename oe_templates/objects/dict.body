<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cysel-stān" d:title="cysel-stān">
		<body>
			<h1>cysel-stān<span class="pron"> | Ky.sel.stɑːn |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">gravel</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ceosel-stān" class="xref-target">ceosel-stān</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-briceþ" d:title="be-briceþ">
		
		<body>
			<h1>be-briceþ<span class="pron"> | be.bri.Keθ |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">breaks off, deprives by breaking</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-brecan" class="xref-target">be-brecan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-tilþ" d:title="ge-tilþ">
		<body>
			<h1>ge-tilþ<span class="pron"> | je.tilθ |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gain</span>
						<span class="meaning-la"> (Lat. mercimonia)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="siþþan" d:title="siþþan">
		<body>
			<h1>siþþan<span class="pron"> | siθ.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē wolde ðā ealdan ǣ ǣr gefyllan, and siððan ðā nīwan gecȳðnysse onginnan</span>
							<span class="q-cite"> (Hml. Th. ii. 244, 28: Chr. 690; P. 40, 11)</span>
						</li>
						<li>
							<span class="q-oe">Þæt sind ǣrest heofonas. . . and syððan þeōs eorðe</span>
							<span class="q-cite"> (Hml. Th. i. 276, 11)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">correlative, when . . . then</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Metellus prius belluas vel in fugam vel in mortem egit, et sic magnam vim hostium superavit</span>
							<span class="q-oe">Siþþan Metellus þā elpendas ofercōm, siþþan hē hæfde eāc raðe þæt ōþer folc gefliēmed</span>
							<span class="q-cite"> (Ors. 4, 6; S. 178, 2-3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āgimmed" d:title="āgimmed">
		
		<body>
			<h1>āgimmed<span class="pron"> | ɑː.Gim.med |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gemmed, set with gems</span>
						<span class="meaning-la"> (Lat. gemmatus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">a gemmed and worked crown, a diadem</span>
							<span class="q-la">diadema</span>
							<span class="q-oe">Agimmed and gesmiðed bend a gemmed and worked crown, a diadem</span>
							<span class="q-cite"> (Ælfc. Gl. 64; Som. 69, 12; Wrt. Voc. 40, 46)</span>
						</li>
						<li>
							<span class="q-en">a gemmed girdle or ring</span>
							<span class="q-la">strophium</span>
							<span class="q-oe">Agimmed gerdel, vel gyrdel, vel angseta, vel hringc a gemmed girdle or ring</span>
							<span class="q-cite"> (64; Som. 69, 20; Wrt. Voc. 40, 51)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gimmian" class="xref-target">gimmian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-nyhtsum" d:title="ge-nyhtsum">
		<body>
			<h1>ge-nyhtsum<span class="pron"> | je.nyxt.sum |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">abundant, plenteous, being in great quantity</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">descendit pluuia copiosa</span>
							<span class="q-oe">Cōm reng micel and genihtsum</span>
							<span class="q-cite"> (Bd. 4, 13; Sch. 419, 10)</span>
						</li>
						<li>
							<span class="q-la">caritas vestra abundat</span>
							<span class="q-oe">Eōwer lufu is suīðe genyhtsumu</span>
							<span class="q-cite"> (Past. 213, 12)</span>
						</li>
						<li>
							<span class="q-oe">Wæs gold swā genihtsum and seolfor swā stānas ofer eorðan</span>
							<span class="q-cite"> (Angl. xi. 8, 27)</span>
						</li>
						<li>
							<span class="q-la">abundantia pacis</span>
							<span class="q-oe">Syb genihtsum</span>
							<span class="q-cite"> (Ps. Th. 71, 7)</span>
						</li>
						<li>
							<span class="q-la">opulenti luxus</span>
							<span class="q-oe">Genihsumre wenñe</span>
							<span class="q-cite"> (An. Ox. 11, 44)</span>
						</li>
						<li>
							<span class="q-la">exuberante reditu</span>
							<span class="q-oe">Of genihtsumum edhwyrfte</span>
							<span class="q-cite"> (8, 67)</span>
						</li>
						<li>
							<span class="q-la">sumtuosa, copiosa (alimonia)</span>
							<span class="q-oe">Of genihtsumere</span>
							<span class="q-cite"> (1840)</span>
						</li>
						<li>
							<span class="q-la">fertilem (praedam)</span>
							<span class="q-oe">Genihtsume</span>
							<span class="q-cite"> (110)</span>
						</li>
						<li>
							<span class="q-la">uberrimam (facundiam)</span>
							<span class="q-oe">Þā genihtsumestan</span>
							<span class="q-cite"> (9, 12)</span>
						</li>
						<li>
							<span class="q-la">uberrima experimenta</span>
							<span class="q-oe">Þā genihtsummestan āfundenessa</span>
							<span class="q-cite"> (81)</span>
						</li>
					</ul>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="sub-heading">beón (wesan) genyhtsum to be abundance</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">fiat abundantia in turribus tuis</span>
									<span class="q-oe">On þīnum torrum wese genihtsum</span>
									<span class="q-cite"> (Ps. Th. 121, 7)</span>
								</li>
								<li>
									<span class="q-oe">Bið on þīnes hūses hwommum genihtsum</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-nyhtsumlīce" class="xref-target">ge-nyhtsumlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-gēmed" d:title="be-gēmed">
		<body>
			<h1>be-gēmed<span class="pron"> | be.Geː.med |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">taken care of, governed; pp. of be-gȳman</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mǣd-land" d:title="mǣd-land">
		<body>
			<h1>mǣd-land<span class="pron"> | mæːd.lɑnd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Meadow-land, grass-land which is mown</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">both of land for mowing and of arable land</span>
							<span class="q-oe">Ǣgðer ge mǣdlondes ge eyrþlondes</span>
							<span class="q-cite"> (Cod. Dipl. Kmbl. ii. 95, 16)</span>
						</li>
						<li>
							<span class="q-oe">Mēdlandes</span>
							<span class="q-cite"> (vi. 219, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:mǣdwe-land" class="xref-target">mǣdwe-land</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nerian" d:title="nerian">
		<body>
			<h1>nerian<span class="pron"> | ne.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To save</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if a man's death be not doomed, oft destiny saves him</span>
							<span class="q-oe">Wyrd oft nereþ unfǣægne eorl</span>
							<span class="q-cite"> (Beo. Th. 1149; B. 572)</span>
						</li>
						<li>
							<span class="q-la">eripuit</span>
							<span class="q-oe">Of neādum heora hē nerode (eripuit) hig</span>
							<span class="q-cite"> (Ps. Spl. 106, 6)</span>
						</li>
						<li>
							<span class="q-oe">Hiē hālig God</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="seowian" d:title="seowian">
		
		<body>
			<h1>seowian<span class="pron"> | se͜o.wi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To sew</span>
						<span class="meaning-la"> (Lat. id)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sarcio</span>
							<span class="q-oe">Siōuu</span>
							<span class="q-cite"> (Wrt. Voc. ii. 119, 52)</span>
						</li>
						<li>
							<span class="q-la">sarcio</span>
							<span class="q-oe">Ic siwige</span>
							<span class="q-cite"> (Ælfc. Gr. 30, 2 ; Zup. 190, 6)</span>
						</li>
						<li>
							<span class="q-oe">Ic sywige (siwige, MS. R.)</span>
							<span class="q-cite"> (28, 3; Zup. 167, 6)</span>
						</li>
						<li>
							<span class="q-la">illa suit</span>
							<span class="q-oe">Heō siwaþ (seowaþ, MS. U.)</span>
							<span class="q-cite"> (15; Zup. 97, 6)</span>
						</li>
						<li>
							<span class="q-la">assuit</span>
							<span class="q-oe">Siwaþ (siuieþ, Lind.: siowes, Rush.)</span>
							<span class="q-cite"> (Mk. Skt. 2, 21)</span>
						</li>
						<li>
							<span class="q-oe">Sum sūtere siwode (seowode, MS. C.) ðæs hālgan weres sceōs</span>
							<span class="q-cite"> (Homl. Skt. i. 15, 23)</span>
						</li>
						<li>
							<span class="q-oe">Hig siwodon ficleāf and worhton him wǣdbrēc</span>
							<span class="q-cite"> (Gen. 3, 7)</span>
						</li>
						<li>
							<span class="q-oe">Seowa mid seolce fæste</span>
							<span class="q-cite"> (Lchdm. ii. 56, 7)</span>
						</li>
						<li>
							<span class="q-oe">Wǣda sioloce siowian</span>
							<span class="q-cite"> (Met. 8, 24)</span>
						</li>
						<li>
							<span class="q-oe">Byrne, searonet seowed smiþes orþancum</span>
							<span class="q-cite"> (Beo. Th. 816; B. 406)</span>
						</li>
						<li>
							<span class="q-la">segmentata</span>
							<span class="q-oe">Golde siowode</span>
							<span class="q-cite"> (Wrt. Voc. ii. 95, 49)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-seowian" class="xref-target">ā-seowian</a>, <a href="x-dictionary:r:be-seowian" class="xref-target">be-seowian</a>, <a href="x-dictionary:r:be-siwian" class="xref-target">be-siwian</a>, <a href="x-dictionary:r:ge-seōwan" class="xref-target">ge-seōwan</a>, <a href="x-dictionary:r:ge-siwed" class="xref-target">ge-siwed</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efen-ēce" d:title="efen-ēce">
		<body>
			<h1>efen-ēce<span class="pron"> | e.fen.eː.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">coeternus</span>
						<span class="q-oe">Efenēce coeternus</span>
						<span class="q-cite"> (Wrt. Voc. ii. 136, 40)</span>
					</li>
					<li>
						<span class="q-oe">Godes Sunu is efenēce (efn-, v. l.) his Fæder and þām Hālgan Gāste</span>
						<span class="q-cite"> (Gr. D. 60, 15: Hml. Th. i. 198, 15: 278, 21)</span>
					</li>
					<li>
						<span class="q-oe">Euenēce</span>
						<span class="q-cite"> (32, 6)</span>
					</li>
					<li>
						<span class="q-oe">Efnēce</span>
						<span class="q-cite"> (Bl. H. 111, 8: 29, 3)</span>
					</li>
					<li>
						<span class="q-oe">Ān Godcundnys and gelīc wuldor and efenēce mægen—ðrymnys</span>
						<span class="q-cite"> (Hml. Th. i. 276, 26)</span>
					</li>
					<li>
						<span class="q-oe">Ðurh ðīnum euenēcum wīsdōme</span>
						<span class="q-cite"> (ii. 598, 31)</span>
					</li>
					<li>
						<span class="q-oe">On mec his efenēcne sunu</span>
						<span class="q-cite"> (Shrn. 106, 13)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hālig-wæter" d:title="hālig-wæter">
		<body>
			<h1>hālig-wæter<span class="pron"> | xɑː.liG.wæ.ter |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Gā man mid hāligdōme ūt and mid hāligwætere</span>
						<span class="q-cite"> (Wlfst. 173, 13)</span>
					</li>
					<li>
						<span class="q-oe">Sprænge se mæssepreōst hāligwæter ofer hig ealle</span>
						<span class="q-cite"> (Ll. Th. i. 226, 23)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-limpan" d:title="be-limpan">
		<body>
			<h1>be-limpan<span class="pron"> | be.lim.pɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to belong to</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Belimpþ attinet.</span>
							<span class="q-cite"> (An. Ox. 27, 22)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of possession</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se dæg (the extra day of leap-year) belimpþ ǣgðer ge tō ðǣre sunnan ge tō ðām mōnan</span>
									<span class="q-cite"> (Lch. iii. 264, 13)</span>
								</li>
								<li>
									<span class="q-oe">Þā termina gebyriaþ ł belimpað tō Pentecosten</span>
									<span class="q-cite"> (Angl. viii. . 329, 2)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">of subordination or subjection</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þæt Witland belimpeð tō Ēstum</span>
									<span class="q-cite"> (Ors. 1, 1; S. 20, 6)</span>
								</li>
								<li>
									<span class="q-oe">Þā belimpað tō þām deōfle þe grǣdignysse gefremmað</span>
									<span class="q-cite"> (Scrd. 20, 10)</span>
								</li>
								<li>
									<span class="q-oe">Eal ðæt folc þe tō his rīce belomp</span>
									<span class="q-cite"> (Shrn. 120, 33)</span>
								</li>
								<li>
									<span class="q-oe">Manege scīran mid weorce tō Lundenne belumpon</span>
									<span class="q-cite"> (Chr. 1097; P. 234, 5)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">to be of a class</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þā þuneras ne belimpað tō ðām ðunere þe on þyssere lyfte brastlað</span>
									<span class="q-cite"> (Lch. iii. 280, 12)</span>
								</li>
								<li>
									<span class="q-oe">Belimpende pertinentes (ad inferiorem gradum)</span>
									<span class="q-cite"> (An. Ox. 872)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="sub-heading">to be proper for, adapted to</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þās lǣce-dōmas belimpað tō eallum innoþa mettrymnessum</span>
									<span class="q-cite"> (Lch. ii. 158, 1)</span>
								</li>
								<li>
									<span class="q-oe">Leōð þā þe tō ǣfestnesse belumpon carmina religioni apta</span>
									<span class="q-cite"> (Bd. 4, 24; Sch. 481, 5)</span>
								</li>
								<li>
									<span class="q-oe">Ǣlc man, hwæt his hāde tō belumpe, folgade</span>
									<span class="q-cite"> (Chr. 1086; P. 219, 31)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(5)</span>
								<span class="sub-heading">to concern, be the concern of a person</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hwæt belympð tō þē hwylcere mǣgðe ic sȳ</span>
									<span class="q-cite"> (Hml. S. 19, 56)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(6)</span>
								<span class="sub-heading">to pertain to, relate to, have to do with</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þā þing þe Gode belimpað</span>
									<span class="q-cite"> (Ex. 4, 16)</span>
								</li>
								<li>
									<span class="q-oe">Ðā ðing ðe tō scipene belimpað</span>
									<span class="q-cite"> (Angl. ix. 260, 5)</span>
								</li>
								<li>
									<span class="q-oe">Plegan tō ðām bæðstede belimpende</span>
									<span class="q-cite"> (An. Th. 12, 18)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to happen, befall</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Belamp evenit, conligit</span>
							<span class="q-cite"> (An. Ox. 3203)</span>
						</li>
						<li>
							<span class="q-oe">Belamp ꝥ se arꝥ UNCERTAIN fērde tō Rōme</span>
							<span class="q-cite"> (Chr. 1070; P. 206, 7)</span>
						</li>
						<li>
							<span class="q-oe">Ðætte ne wyrsa ðē bilimpe (blimpe, L. contingat)</span>
							<span class="q-cite"> (Jn. R. 5, 14)</span>
						</li>
						<li>
							<span class="q-en">that the terrible sentence be not applied to them</span>
							<span class="q-oe">Þæt him ne belimpe se egeslica cwyde</span>
							<span class="q-cite"> (Hml. Th. ii. 536, 6)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to be-come, attain the character of</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þis godspel ūs tō bysene belimpeþ ēces līfes</span>
							<span class="q-cite"> (Bl. H. 15, 32)</span>
						</li>
						<li>
							<span class="q-oe">Þā ælmessan þe gē syllaþ eōw tō nǣnigre āre ne belimpaþ (-eþ, MS.)</span>
							<span class="q-cite"> (41, 23)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt bið unnyt word, ðætte gescēdwīse menn ne magon ongietan ðæt hit belimpe tō ryhtwīslicre ðearfe otiosum verbum est, quod ratione justae necessitatis caret</span>
							<span class="q-cite"> (Past. 281, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="īsern-gelōma" d:title="īsern-gelōma">
		<body>
			<h1>īsern-gelōma<span class="pron"> | iː.sern.Ge.loː.mɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An iron tool</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā īserngelōman wē hātaþ spadan and spitelas.</span>
							<span class="q-cite"> (Gr. D. 201, 19)</span>
						</li>
						<li>
							<span class="q-oe">þæt him mon īserngelōman (issern-, v. l.) brōhte</span>
							<span class="q-cite"> (Bd. 4, 28; S. 520, 20)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt wǣron mi stāncræftigan . . . hȳ gesēnedon ǣlce morgen heora īsern-gelōman</span>
							<span class="q-cite"> (Shrn. 146, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:iren-geubma" class="xref-target">iren-geubma</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="seofonteōpa" d:title="seofonteōpa">
		
		<body>
			<h1>seofonteōpa<span class="pron"> | se͜o.fon.te͜oː.pɑ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">seventeenth</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se wæs seofonteogeþa fram Agusto</span>
							<span class="q-cite"> (Bd. 1. 5; S. 476, 6)</span>
						</li>
						<li>
							<span class="q-oe">Ðȳ seofonteōþan dæge</span>
							<span class="q-cite"> (3, 24; S. 557, 12)</span>
						</li>
						<li>
							<span class="q-oe">On ðone seofenteōþan dæge ðæs mōnþes</span>
							<span class="q-cite"> (Gen. 7, 11)</span>
						</li>
						<li>
							<span class="q-oe">Seofontegðan</span>
							<span class="q-cite"> (Shrn. 91, 32)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heāh-heoloþe" d:title="heāh-heoloþe">
		<body>
			<h1>heāh-heoloþe<span class="pron"> | xæ͜ɑːx.xe͜o.lo.θe |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Elecampane</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Heāhhioloþe</span>
							<span class="q-cite"> (Lch. ii. 104, 1 : 138, 16)</span>
						</li>
						<li>
							<span class="q-oe">Genim heāhheoloþan</span>
							<span class="q-cite"> (18, 22)</span>
						</li>
						<li>
							<span class="q-oe">Heāhhioloþan</span>
							<span class="q-cite"> (102, 23: 274, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eh-heoloþe" class="xref-target">eh-heoloþe</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ār-wyrþnes" d:title="ār-wyrþnes">
		<body>
			<h1>ār-wyrþnes<span class="pron"> | ɑːr.wyrθ.nes |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Dignity</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ār-weorþnes" class="xref-target">ār-weorþnes</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bēd-rīp" d:title="bēd-rīp">
		<body>
			<h1>bēd-rīp<span class="pron"> | beːd.riːp |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The cutting or reaping of corn on request</span>
						<span class="meaning-la"> (Lat. ad preces messio)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bēn-rīp" class="xref-target">bēn-rīp</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-settan" d:title="in-settan">
		<body>
			<h1>in-settan<span class="pron"> | in.set.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To appoint, institute</span>
						<span class="meaning-la"> (Lat. instituit)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">instituit</span>
							<span class="q-oe">Insette</span>
							<span class="q-cite"> (Bd. 4, 23; S. 593, 38)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-insettan" class="xref-target">ge-insettan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="DEĀD" d:title="DEĀD">
		<body>
			<h1>DEĀD<span class="pron"> | dæ͜ɑːd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">DEAD</span>
						<span class="meaning-la"> (Lat. mortuus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Lazarus mortuus est</span>
							<span class="q-oe">Lazarus ys deād</span>
							<span class="q-cite"> (Jn. Bos. 11, 14: Mt. Bos. 9, 24: Jud. 3, 25: Elen. Kmbl. 1761; El. 882: Bco. Th. 939; B. 467: Exon. 126 b; Th. 487, 19; Rä. 73, 4)</span>
						</li>
						<li>
							<span class="q-la">nec erat quidquam mortuum de his</span>
							<span class="q-oe">Næs ðǣr nān þing deād of ðām</span>
							<span class="q-cite"> (Ex. 9, 7; 21, 34)</span>
						</li>
						<li>
							<span class="q-en">the Lord's joys are more exciting to me than this dead life</span>
							<span class="q-oe">Me hātran sind Dryhtnes dreāmas ðonne ðis deāde līf</span>
							<span class="q-cite"> (Exon. 82 a; Th. 309, 31; Seef. 65)</span>
						</li>
						<li>
							<span class="q-en">the inheritance of a dead man shall be divided</span>
							<span class="q-oe">Sceal yrfe gedǣled deādes monnes</span>
							<span class="q-cite"> (90 a; Th. 338, 19; Gn. Ex. 81)</span>
						</li>
						<li>
							<span class="q-en">the grave shall groan for the dead man</span>
							<span class="q-oe">Græf deādum men heōfeþ</span>
							<span class="q-cite"> (91 b; Th. 342, 29; Gn. Ex. 149)</span>
						</li>
						<li>
							<span class="q-en">father and mother gave me up as dead</span>
							<span class="q-oe">Mec deādne ofgeāfun fæder and mōder</span>
							<span class="q-cite"> (103 a; Th. 391, 7; Rä. 10, 1: Beo.Th. 2623; B. 1309)</span>
						</li>
						<li>
							<span class="q-en">Brihtric thought that he would get Wulfnoth alive or dead</span>
							<span class="q-oe">Brihtrīc þohte ðæt he Wulfnōþ cuconne oððe deādne begytan sceolde</span>
							<span class="q-cite"> (Chr. 1009; Erl. 142, 3)</span>
						</li>
						<li>
							<span class="q-la">mortui sunt omnes</span>
							<span class="q-oe">Ealle synd deāde</span>
							<span class="q-cite"> (Ex. 4, 19: Mt. Bos. 28, 4: Ps. Th. 113, 24)</span>
						</li>
						<li>
							<span class="q-en">the dead shall rise from the dust through power of God</span>
							<span class="q-oe">Deāde of duste arīsaþ þurh Drihtnes miht</span>
							<span class="q-cite"> (Cd. 227; Th. 302, 24; Sat. 605: Exon. 25 a; Th. 72, 30; Cri. 1180)</span>
						</li>
						<li>
							<span class="q-la">manducavērunt sacrificia mortuōrum</span>
							<span class="q-oe">Hī ǣton deādra lāc</span>
							<span class="q-cite"> (Ps. Th. 105, 22: Mt. Bos. 23, 27)</span>
						</li>
						<li>
							<span class="q-en">the land mourned over the corpses of the dead</span>
							<span class="q-oe">Land dryrmyde deādra hrǣwum</span>
							<span class="q-cite"> (Cd. 144; Th. 180, 6; Exod. 41: Elen. Kmbl. 1299; El. 651: 1887; El. 945)</span>
						</li>
						<li>
							<span class="q-en">for the dead</span>
							<span class="q-oe">Be deādum</span>
							<span class="q-cite"> (Exon. 82 b; Th. 311, 27; Seef. 98)</span>
						</li>
						<li>
							<span class="q-en">with the dead skins</span>
							<span class="q-oe">Mid ðām deādum fellum</span>
							<span class="q-cite"> (Boutr. Scrd. 20, 29)</span>
						</li>
						<li>
							<span class="q-la">ne occidĕris eos</span>
							<span class="q-oe">Ne dō hȳ to deādan</span>
							<span class="q-cite"> (Ps. Th. 58, 10: 61, 3: Ex. 21, 35, 36)</span>
						</li>
						<li>
							<span class="q-en">dread ye not dead bands</span>
							<span class="q-oe">Ne willaþ eōw andrǣdan deāde fēðan</span>
							<span class="q-cite"> (Cd. 156; Th. 194, 26; Exod. 266: Exon. 24 b; Th. 71, 21; Cri. 1159: Andr. Kmbl. 2156; An. 1079)</span>
						</li>
						<li>
							<span class="q-en">let the dead bury their dead</span>
							<span class="q-oe">Lǣt deāde bebyrigean hyra deādnn</span>
							<span class="q-cite"> (Mt. Bos. 8, 22)</span>
						</li>
						<li>
							<span class="q-la">numquid mortuis facies mirabĭlia?</span>
							<span class="q-oe">Ne hūru wundur wyrceaþ deāde</span>
							<span class="q-cite"> (Ps. Th. 87, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:woruld-deād" class="xref-target">woruld-deād</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="borg-gylda" d:title="borg-gylda">
		
		<body>
			<h1>borg-gylda<span class="pron"> | borɣ.Gyl.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A debtor</span>
						<span class="meaning-la"> (Lat. mortis debitoribus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mortis debitoribus</span>
							<span class="q-oe">Deāðes borggeldum</span>
							<span class="q-cite"> (Ps. Srt. ii. 203, 29)</span>
						</li>
						<li>
							<span class="q-oe">Borhgeldum</span>
							<span class="q-cite"> (Hy. S. 33, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="biscepdōm" d:title="biscepdōm">
		<body>
			<h1>biscepdōm<span class="pron"> | bi.ʃep.doːm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-la"> (Lat. pontificium, flamina)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ægelbryht onfēng Wesseaxna biscdōmes</span>
							<span class="q-cite"> (Chr. 650; P. 28, 5)</span>
						</li>
						<li>
							<span class="q-oe">Hlōþhere fēng tō biscepdōme ofer Wesseaxan</span>
							<span class="q-cite"> (670; P. 34, 12)</span>
						</li>
						<li>
							<span class="q-oe">On his bisceopdōme (-hāde, v. l.) binnan Affrican scīre</span>
							<span class="q-cite"> (Hml. A. 5, 108)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-bȳren" d:title="ge-bȳren">
		<body>
			<h1>ge-bȳren<span class="pron"> | je.byː.ren |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:neāh-gebȳren" class="xref-target">neāh-gebȳren</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-lystan" d:title="ge-lystan">
		<body>
			<h1>ge-lystan<span class="pron"> | je.ly.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">with acc. of person</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">gen. of thing desired</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hȳ gelyst ǣlces ȳdeles</span>
									<span class="q-cite"> (R. Ben. 136, 22)</span>
								</li>
								<li>
									<span class="q-la">secretum locum petii amicum moeroris</span>
									<span class="q-oe">Þa mē gelyste þǣre deōglan stōwe þe ic ǣr on wæs in mynstre; seō is þǣre gnornunge freōnd</span>
									<span class="q-cite"> (Gr. D. 3, 10)</span>
								</li>
								<li>
									<span class="q-la">lactucam conspiciens concupivit</span>
									<span class="q-oe">Geseah heō ǣnne leahtric and hȳ gelyste þæs</span>
									<span class="q-cite"> (30, 33)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">with infin. of action a person desires to do</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hwīlum hiē wel gelyst ūt gangan and him þā byrþenne fram āweorpan</span>
									<span class="q-cite"> (Lch. ii. 230, 23)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">with dat. of person (and infin.)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē hæfde hī þā hwīle þe him geliste</span>
							<span class="q-cite"> (Chr. 1046 ; P. 164, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-lustan" class="xref-target">ge-lustan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-pōht" d:title="ge-pōht">
