<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-deādlīcness" d:title="un-deādlīcness">
		<body>
			<h1>un-deādlīcness<span class="pron"> | un.dæ͜ɑːd.liː.kness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Immortality</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ūre ǣhta sind ēce on heofenum, ðǣr ðǣr undeādlīcnys rīcsaþ</span>
							<span class="q-cite"> (Homl. Th. ii. 484, 28)</span>
						</li>
						<li>
							<span class="q-oe">Hyht hiora undeādlīcnise (immortalitate) full is</span>
							<span class="q-cite"> (Rtl. 86, 22: Homl. Th. i. 544. 3)</span>
						</li>
						<li>
							<span class="q-oe">Hæfde God ðæs mannes sāwle gegōdod mid undeādlīcnysse ... wē ne forluron nā ða undeādlīcnyssæ</span>
							<span class="q-cite"> (20, 1-4: Bd. 1, 27; S. 493, 4: 3, 21; S. 551, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-deāþlīcness" class="xref-target">un-deāþlīcness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="seāmere" d:title="seāmere">
