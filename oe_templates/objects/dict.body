			<h1>hwer-hwette<span class="pron"> | xwer.xwet.te |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hwærhwætte cucumeris</span>
						<span class="q-cite"> (Wrt. Voc. i. 67, II)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣ-bylg" d:title="ǣ-bylg">
		<body>
			<h1>ǣ-bylg<span class="pron"> | æː.bylɣ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to excite God's anger</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">to excite God's anger</span>
							<span class="q-oe">Geæfnan ǣbylg Godes</span>
							<span class="q-cite"> (Gū. 1211)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="borgas" d:title="borgas">
