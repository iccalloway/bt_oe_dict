<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="agēn-gehweorfan" d:title="agēn-gehweorfan">
		<body>
			<h1>agēn-gehweorfan<span class="pron"> | ɑ.Geːn.Ge.xwe͜or.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -gehwearf, pl: -gehwurfon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -gehworfen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To change again, to return</span>
						<span class="meaning-la"> (Lat. redire)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cum redirent</span>
							<span class="q-oe">Ðā hīg agēn-gehwurfon</span>
							<span class="q-cite"> (Lk. Bos. 2, 43)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heāfod-wind" d:title="heāfod-wind">
		<body>
			<h1>heāfod-wind<span class="pron"> | xæ͜ɑː.fod.wind |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A wind from one of the four chief points of the compass</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Feōwer heāfodwindas synd se fyrmesta is eāsterne wind ... se ōðer heāfodwind is sūðerne ... se þridda heāfodwind hātte zephirus ... se feōrþe heāfodwind hātte septemtrio</span>
							<span class="q-cite"> (Lchdm. iii. 274, 12-23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fæderen-cyn" d:title="fæderen-cyn">
		
		<body>
			<h1>fæderen-cyn<span class="pron"> | fæ.de.ren.kynn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A paternal kin or race</span>
						<span class="meaning-la"> (Lat. paternum genus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">their direct paternal kin goes to Cerdic</span>
							<span class="q-oe">Hiera ryht fæderencyn [fædrencynn, Th. 87, 14, col. 1] gǣþ to Cerdice</span>
							<span class="q-cite"> (Chr. 755 Th. 86, 14, col. 1)</span>
						</li>
						<li>
							<span class="q-en">we cannot tell the paternal kin</span>
							<span class="q-oe">We areccan ne māgon ðæt fædrencynn</span>
							<span class="q-cite"> (Exon. 11 b ; Th. 16, 4 ; Cri. 248)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-tamlīc" d:title="un-tamlīc">
		<body>
			<h1>un-tamlīc<span class="pron"> | un.tɑm.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Untameable</span>
						<span class="meaning-la"> (Lat. indomabilis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">indomabilis</span>
							<span class="q-oe">Untamlīc (printed untamcul)</span>
							<span class="q-cite"> (Germ. 397, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hād" d:title="hād">
		<body>
			<h1>hād<span class="pron"> | xɑːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">V b.</span>
						<span class="meaning-en">in a personal sense, those belonging to an order or rank</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cum consilio omnium ecclesiasticorum graduum</span>
							<span class="q-oe">Cwæð ǣlc hād ciricean þǣre mǣgðe ānmōdlīce</span>
							<span class="q-cite"> (Ll. Th. i. 36, 10)</span>
						</li>
						<li>
							<span class="q-oe">Ðā godcundan hādas giorne wǣron ymb lāre</span>
							<span class="q-cite"> (Past. 3, 9)</span>
						</li>
						<li>
							<span class="q-oe">Wǣran heāfodstedas and heālice hādas (i. e. cyning, arcebiscop, æðeling, leōdbiscop, ealdorman, 11, 10, 11, 14) micelre mǣðe wyrðe</span>
							<span class="q-cite"> (Ll. Th. i. 330, 6)</span>
						</li>
						<li>
							<span class="q-oe">Þā hālgan hādas þe Godes folc lǣran scylan</span>
							<span class="q-cite"> (244, 9)</span>
						</li>
						<li>
							<span class="q-oe">Eallum crīstenum mannum gebyrað ꝥ hig , . . hādas. . . ǣfre griðian and frinan, and ꝥ hī hāda gehwylcne weorðian be mǣðe</span>
							<span class="q-cite"> (360, 25-28 : 336, 1: 334, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ciric-hād" class="xref-target">ciric-hād</a>, <a href="x-dictionary:r:heāh-hād" class="xref-target">heāh-hād</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="billere" d:title="billere">
		
		<body>
			<h1>billere<span class="pron"> | bil.le.re |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a plant name</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">(in a list of plant names)</span>
							<span class="q-oe">Billere bibulta</span>
							<span class="q-cite"> (Wrt. Voc. i. 286, 29: ii. 11, 58)</span>
						</li>
						<li>
							<span class="q-oe">Billeru</span>
							<span class="q-cite"> (102, 4)</span>
						</li>
						<li>
							<span class="q-oe">Bilhergas bibultum</span>
							<span class="q-cite"> (126, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mamme" d:title="mamme">
		<body>
			<h1>mamme<span class="pron"> | mɑm.me |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A teat, breast</span>
						<span class="meaning-la"> (Lat. mamma)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">in papillas</span>
							<span class="q-oe">An mamman</span>
							<span class="q-cite"> (Germ. 401, 77)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-sittende" d:title="under-sittende">
		<body>
			<h1>under-sittende<span class="pron"> | un.der.sit.ten.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sitting under</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-bylded" d:title="ge-bylded">
		
		<body>
			<h1>ge-bylded<span class="pron"> | je.byl.ded |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Emboldened, encouraged, animated</span>
						<span class="meaning-la"> (Lat. corrōbērātus, animātus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">aposteli flagellis simul et exhortationibus animātus ērat Laurentius</span>
							<span class="q-oe">Wæs Laurentius mid ðæs apostoles swingum and trymnessum swīðe gebylded</span>
							<span class="q-cite"> (Bd. 2, 6; S. 508, 22)</span>
						</li>
						<li>
							<span class="q-en">he stood against many of the old fiends, emboldened with courage</span>
							<span class="q-oe">He wið mongum stōd ealdfeōnda elne gebylded</span>
							<span class="q-cite"> (Exon. 39 b; Th. 130, 31; Gū. 446)</span>
						</li>
						<li>
							<span class="q-en">Barak, much encouraged by God, fought against them</span>
							<span class="q-oe">Se Barac, gebyld swīðe þurh God, feaht him togeānes</span>
							<span class="q-cite"> (Jud. 4, 14)</span>
						</li>
						<li>
							<span class="q-en">they were encouraged</span>
							<span class="q-oe">Hȳ wǣron gebylde</span>
							<span class="q-cite"> (Ors. 4, 1; Bos. 77, 25)</span>
						</li>
						<li>
							<span class="q-en">we bless ourselves emboldened by God</span>
							<span class="q-oe">We us bletsiap gebylde ðurh God</span>
							<span class="q-cite"> (H. R. 105, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cōn" d:title="cōn">
		
		<body>
			<h1>cōn<span class="pron"> | koːn |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">bold</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:coon" class="xref-target">coon</a>, <a href="x-dictionary:r:cēne" class="xref-target">cēne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wiþer-rǣdness" d:title="wiþer-rǣdness">
		<body>
			<h1>wiþer-rǣdness<span class="pron"> | wi.θer.ræːd.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="meaning-en">Contrariety, opposition</span>
						<span class="meaning-la"> (Lat. contrarietas, contrauersio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wiðerrǣdnys contrarietas, contrauersio</span>
							<span class="q-cite"> (Ælfc. Gr. 47; Zup. 275, 7)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">hostility, ill-will</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wið hunda rēðnysse and wiðerrǣdnysse; se ðe hafaþ hundes heortan mid him, ne beōð ongeān hine hundas cēne</span>
							<span class="q-cite"> (Lchdm. i. 372, 3)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">unfavourableness, disadvantage</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">caumene refugio hybernalis algoris et intemperei adversitas leuigetur</span>
							<span class="q-oe">Ðæs fȳrhȳses hlȳwing[e] winterlīces cyles and ungetemprunge wiþerrǣdnes sī gelȳht</span>
							<span class="q-cite"> (Anglia xiii. 397, 462)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">oppositeness of nature</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">went in contrarium uertit</span>
							<span class="q-oe">On wiþerǣdnysse</span>
							<span class="q-cite"> (Scint. 55)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wiþer-rǣde" class="xref-target">wiþer-rǣde</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rēnig" d:title="rēnig">
		<body>
			<h1>rēnig<span class="pron"> | reː.niG |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:regnig" class="xref-target">regnig</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-ecge" d:title="-ecge">
		<body>
			<h1>-ecge<span class="pron"> | edʒ.dʒe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:feōwer-ecge" class="xref-target">feōwer-ecge</a>, <a href="x-dictionary:r:six-ecge" class="xref-target">six-ecge</a>, <a href="x-dictionary:r:twi-ecge" class="xref-target">twi-ecge</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cniht-geogoþ" d:title="cniht-geogoþ">
		<body>
			<h1>cniht-geogoþ<span class="pron"> | knixt.Ge͜o.ɣoθ |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Boyhood, youth</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þā feōwer tīman . . . sumor . . . , and eāc þā gelīcnyssa . . . cnihtiugoð and sumor beōð gelīce . . . sumor byð wearm . . . cnihtiugoð byð wearm</span>
							<span class="q-cite"> (Angl. viii. 299, 23-30)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fore-gangan" d:title="fore-gangan">
		<body>
			<h1>fore-gangan<span class="pron"> | fo.re.gɑn.gɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to precede (in time)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þā foregangendan hlǣfdian (praecedentes matres) gewunodon ꝥ hī hit sǣdon þām gingrum nunnum, and nū þā gingran nunnan hit reccaþ</span>
									<span class="q-cite"> (Gr. D. 280, 26)</span>
								</li>
								<li>
									<span class="q-oe">Gōdra foregangendra (praecedentium) wera</span>
									<span class="q-cite"> (8, 20: 277, 10)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to take precedence of, rank higher than</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ðes Iōhannes wæs māra ðonne ǣnig ōþer mon būton Crīste . . . ealle þā apostolas and martyras hē foregongeð</span>
									<span class="q-cite"> (Shrn. 95, 11)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="midnæddran" d:title="midnæddran">
		
		<body>
			<h1>midnæddran<span class="pron"> | mid.næd.drɑn |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ofer nǣddran and midnǣddran (mid nǣddran (?) basiliscum: the glosser seems to have taken -cum as a preposition suffixed, and to have thought basiliscum = cum basilis) þū gǣst</span>
						<span class="q-cite"> (Ps. Spl. 90, 13)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="TREŌWA" d:title="TREŌWA">
