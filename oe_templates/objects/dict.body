<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="blōt" d:title="blōt">
		<body>
			<h1>blōt<span class="pron"> | bloːt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">blood</span>
						<span class="meaning-la"> (Lat. sanguis)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:blōt-spīung" class="xref-target">blōt-spīung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-miltan" d:title="ā-miltan">
		<body>
			<h1>ā-miltan<span class="pron"> | ɑː.mil.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To melt (trans.)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Lǣt ūs āmyltan þā sylfrenan godas</span>
							<span class="q-cite"> (Hml. S. 5, 233)</span>
						</li>
						<li>
							<span class="q-oe">Drincan āmylte buteran</span>
							<span class="q-cite"> (Lch. ii. 106, 3: 268, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-āmelt" class="xref-target">un-āmelt</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrgan" d:title="byrgan">
		<body>
			<h1>byrgan<span class="pron"> | byr.ɣɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to bury</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-byrged" class="xref-target">un-byrged</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="BERSTAN" d:title="BERSTAN">
		<body>
			<h1>BERSTAN<span class="pron"> | ber.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -berste, 2sg: -birst, 3sg: -birsteþ, 3sg: -biersteþ, 3sg: -birst, 3sg: -byrst, 3sg: -bierst, pl: -berstaþ</b>
				</p>
				<p>
					<b class="ending">past: 1sg: -bærst, 3sg: -bærst, 2sg: -burste, pl: -burston</b>
				</p>
				<p>
					<b class="ending">participle: present participle sg: -berstende, past participle sg: -borsten</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to BURST, break, fail, fall</span>
						<span class="meaning-la"> (Lat. cum fragore dissilire, corruere, rumpi, frangi)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the heavens burst</span>
							<span class="q-oe">Heofonas berstaþ</span>
							<span class="q-cite"> (Exon. 21 b; Th. 58, 10; Cri. 933)</span>
						</li>
						<li>
							<span class="q-en">the bone-inclosures burst</span>
							<span class="q-oe">Burston bān-locan</span>
							<span class="q-cite"> (Beo. Th. 1640; B. 818)</span>
						</li>
						<li>
							<span class="q-en">the waves broke</span>
							<span class="q-oe">Wǣgas burston</span>
							<span class="q-cite"> (Cd. 167; Th. 208, 15; Exod. 483)</span>
						</li>
						<li>
							<span class="q-la">muri illico corruerunt</span>
							<span class="q-oe">Ðā burston ða weallas</span>
							<span class="q-cite"> (Jos. 6, 20 : Ors. 1, 7; Bos. 29, 38)</span>
						</li>
						<li>
							<span class="q-en">if an oath failed them</span>
							<span class="q-oe">Gif him āþ burste</span>
							<span class="q-cite"> (L. Ed. 3; Th. i. 160, 20)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to make the noise of a bursting or breaking, to crash, dash, crack</span>
						<span class="meaning-la"> (Lat. fragorem edere, sonare, crepare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the dashing sea threatened bloody horrors</span>
							<span class="q-oe">Brim berstende blōd-egesan hweōp</span>
							<span class="q-cite"> (Cd. 166; Th. 208, 2; Exod. 477)</span>
						</li>
						<li>
							<span class="q-en">his fingers cracked</span>
							<span class="q-oe">Fingras burston</span>
							<span class="q-cite"> (Beo. Th. 1525; B. 760)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āberstan" class="xref-target">āberstan</a>, <a href="x-dictionary:r:æt-berstan" class="xref-target">æt-berstan</a>, <a href="x-dictionary:r:for-berstan" class="xref-target">for-berstan</a>, <a href="x-dictionary:r:ōþ-berstan" class="xref-target">ōþ-berstan</a>, <a href="x-dictionary:r:to-berstan" class="xref-target">to-berstan</a>, <a href="x-dictionary:r:ūt-berstan" class="xref-target">ūt-berstan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-rēþra" d:title="ge-rēþra">
		<body>
			<h1>ge-rēþra<span class="pron"> | je.reː.θrɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sailor, rower</span>
						<span class="meaning-la"> (Lat. nauta)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gerēþra [MS. gerēþru] nauta</span>
							<span class="q-cite"> (Ælfc. Gl. 103; Wrt. Voc. 56, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:rēþra" class="xref-target">rēþra</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīw-lǣred" d:title="nīw-lǣred">
