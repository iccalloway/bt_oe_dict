<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-beāt" d:title="ge-beāt">
		<body>
			<h1>ge-beāt<span class="pron"> | je.bæ͜ɑːt |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A beating, blow</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the Lord made a scourge of ropes and hurried them all out with beating</span>
							<span class="q-oe">Drihten worhte āne swipe of rāpum, and hī ealle mid gebeāte ūtascynde</span>
							<span class="q-cite"> (Homl. Th. i. 406, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fȳst-gebeāt" class="xref-target">fȳst-gebeāt</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-lēd" d:title="be-lēd">
		
		<body>
			<h1>be-lēd<span class="pron"> | be.leːd |</span>
			</h1>
