<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hām-sīþ" d:title="hām-sīþ">
		<body>
			<h1>hām-sīþ<span class="pron"> | xɑːm.siːθ |</span>
			</h1>
			<div>
