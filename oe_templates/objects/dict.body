<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hrisel" d:title="hrisel">
		
		<body>
			<h1>hrisel<span class="pron"> | xri.sel |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A shuttle</span>
						<span class="meaning-la"> (Lat. radius)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hrisl radiolum</span>
							<span class="q-cite"> (Ælfc. Gl. 110; Som. 79, 54; Wrt. Voc. 59, 25)</span>
						</li>
						<li>
							<span class="q-oe">radium</span>
							<span class="q-cite"> (Wrt. Voc. 281, 75)</span>
						</li>
						<li>
							<span class="q-oe">Hresl [hrefl. Wrt.] radius</span>
							<span class="q-cite"> (66, 12)</span>
						</li>
						<li>
							<span class="q-oe">Hrisil</span>
							<span class="q-cite"> (Exon. 109 a; Th. 417, 20; Rä. 36, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hrisian" class="xref-target">hrisian</a>, <a href="x-dictionary:r:scytel" class="xref-target">scytel</a>
			</p>
		</body>
	</d:entry>
