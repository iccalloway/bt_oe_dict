<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fole" d:title="ge-fole">
		<body>
			<h1>ge-fole<span class="pron"> | je.fo.le |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Having a foal, milch</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thirty milch camels [camelos fætas] with their colts</span>
							<span class="q-oe">Ðrītig gefolra olfend-myrena mid heora coltum</span>
							<span class="q-cite"> (Gen. 32, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
