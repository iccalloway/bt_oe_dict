<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="welig-stedende" d:title="welig-stedende">
		<body>
			<h1>welig-stedende<span class="pron"> | we.liG.ste.den.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Making rich</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Uoeligstydende (printed uoeglig-) locupletans</span>
							<span class="q-cite"> (Rtl. 98, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:stede" class="xref-target">stede</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feþor-byrste" d:title="feþor-byrste">
		<body>
			<h1>feþor-byrste<span class="pron"> | fe.θor.byr.ste |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:fiþer-byrste" class="xref-target">fiþer-byrste</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-wealdan" d:title="ofer-wealdan">
		<body>
			<h1>ofer-wealdan<span class="pron"> | o.fer.wæ͜ɑl.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to rule over, control</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ne lǣte hē nǣfre his hȳrmen hyne oferwealdan</span>
							<span class="q-cite"> (Angl. ix. 260, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wealdan" class="xref-target">wealdan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-cennicge" d:title="ā-cennicge">
		<body>
			<h1>ā-cennicge<span class="pron"> | ɑː.Ken.nidʒ.dʒe |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A (female) parent</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">genetricis et virginis</span>
							<span class="q-oe">Ācennic and hehstald</span>
							<span class="q-cite"> (Rtl. 69, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bǣdend" d:title="bǣdend">
		<body>
			<h1>bǣdend<span class="pron"> | bæː.dend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A vehement or earnest persuader, a solicitor, stirrer</span>
						<span class="meaning-la"> (Lat. impulsor)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-þwǣrian" d:title="ge-þwǣrian">
		<body>
			<h1>ge-þwǣrian<span class="pron"> | je.θwæː.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<ul class="quotes">
						<li>
							<span class="q-oe">Geþwǣrie respiret (conspiret?)</span>
							<span class="q-cite"> (Germ. 398, 140)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">trans. To reconcile</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">reconcilia te ei</span>
							<span class="q-oe">Geþwǣre þē wið hine</span>
							<span class="q-cite"> (Ll. Th. ii. 194, 2)</span>
						</li>
						<li>
							<span class="q-oe">Ǣr þām ðe hē hine sylfne geþwǣrige (reconciliaverit) wið his nēhstan</span>
							<span class="q-cite"> (192, 30)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">intrans. To be in agreement</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Geþwǣrie vel samod orþie conspiret, i. consentiet</span>
							<span class="q-cite"> (Wrt. Voc. ii. 134, 13)</span>
						</li>
						<li>
							<span class="q-oe">Samod geþwǣrende concordantes</span>
							<span class="q-cite"> (24, 8)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of persons</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">to agree together</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">cum invicem concordare non possent</span>
											<span class="q-oe">Þā ne mihte hī betwyh him geþwǣrian and geweorþan</span>
											<span class="q-cite"> (Bd. 4, 4; Sch. 369, 5)</span>
										</li>
										<li>
											<span class="q-oe">Gegadan vel geþwǣriende complices, conspirantes</span>
											<span class="q-cite"> (Wrt. Voc. i. 50, 12)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">to agree with another in act or thought</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">obsecrans eos unitatem pacis et catholicae obseruationis cum ea ecclesia Christi tenere</span>
											<span class="q-oe">Hē bæd hiē ꝥ hī on ānnesse sibbe and in gehylde rihtra eāstrena geþwǣrede (-þwǣredon, -hwǣredon, v. ll.) mid þā Crīstes cyricean</span>
											<span class="q-cite"> (Bd. 2, 4; Sch. 128, 2)</span>
										</li>
										<li>
											<span class="q-oe">Geþwǣriende (-hwǣriende, 5376) assentatrix (lingua)</span>
											<span class="q-cite"> (An. Ox. 2, 461)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(c)</span>
										<span class="sub-heading">where a person agrees with, consents to, a thing</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">si cogitationi non consenseris</span>
											<span class="q-oe">Gif þū geþance nā geþwǣrast</span>
											<span class="q-cite"> (Scint. 141, 12)</span>
										</li>
										<li>
											<span class="q-oe">Þām eāðmōdum þe mid heora līfes ðeāwum Crīstes bebodum geþwǣriað</span>
											<span class="q-cite"> (Hml. Th. i. 514, 6)</span>
										</li>
										<li>
											<span class="q-oe">Gif þū þārtō geþwǣrudest</span>
											<span class="q-cite"> (Ll. Lbmn. 414, 4)</span>
										</li>
										<li>
											<span class="q-oe">Þā men þe þās stale gefremoden and þe þǣrto geþwǣrdon</span>
											<span class="q-cite"> (438, 9)</span>
										</li>
										<li>
											<span class="q-la">qui seducitur quid consentiat [e]uidenter ignorat</span>
											<span class="q-oe">Se byþ beswicen hwæt hē gēþwǣrige gesewenlīce hē nāt</span>
											<span class="q-cite"> (Scint. 229, 5)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">of things</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">to agree together</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">concordante simul visione et sacrificio</span>
											<span class="q-oe">On þǣre samodgeþwēriendan gesihðe and onsægdnesse</span>
											<span class="q-cite"> (Gr. D. 346, 5)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">to agree with another</span>
									</p>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(α)</span>
												<span class="sub-heading">with dat.</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-la">Iohannis vox in aestimatione ista concordat</span>
													<span class="q-oe">Iōhannes stefn geþwǣreþ (-þweoraþ, v. l.) þām ylcan andgyte</span>
													<span class="q-cite"> (Gr. D. 332, 21)</span>
												</li>
												<li>
													<span class="q-la">conuenit reuelationi et relationi fratris ... sermo Ecgbercti</span>
													<span class="q-oe">Geþwǣraþ (-þwēriaþ, v. l.) þǣre onwrigenesse and þǣre gesegene þæs brōðor ... þæt word Ecgbryhtes</span>
													<span class="q-cite"> (Bd. 4, 3; Sch. 363, 6)</span>
												</li>
											</ul>
										</li>
										<li>
											<p>
												<span class="sense-label">(β)</span>
												<span class="sub-heading">with prep.</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-la">concordabat vitae munditia cum studio praedicationis</span>
													<span class="q-oe">His līfes clǣnnys geþwǣrode (-ede, -hwǣþrede, v. ll.) mid þām bīgenge his bodunge</span>
													<span class="q-cite"> (Gr. D. 33, 22)</span>
												</li>
												<li>
													<span class="q-la">ut mens nostra concordet voci nostre</span>
													<span class="q-oe">Þæt ūre mōd geþwǣrige mid þæs mūðes clypunge</span>
													<span class="q-cite"> (R. Ben. 45, 11)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-geþwǣrian" class="xref-target">un-geþwǣrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flēs" d:title="flēs">
		<body>
			<h1>flēs<span class="pron"> | fleːs |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A FLEECE</span>
						<span class="meaning-la"> (Lat. vellus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">of a sheep's going with its fleece</span>
							<span class="q-oe">Be sceāpes gonge mid his flēse</span>
							<span class="q-cite"> (L. In. 69; Th. i. 146, 9, note 20, MS. G.)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:flȳs" class="xref-target">flȳs</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-hwearf" d:title="be-hwearf">
		<body>
			<h1>be-hwearf<span class="pron"> | be.xwæ͜ɑrf |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A change, an exchange</span>
						<span class="meaning-la"> (Lat. commutatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">in commutationibus eorum</span>
							<span class="q-oe">On be-hwearfum heora</span>
							<span class="q-cite"> (Ps. Spl. 43. 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ānȳdan" d:title="ānȳdan">
		<body>
			<h1>ānȳdan<span class="pron"> | ɑː.nyː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -nȳdde</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -nȳded, past participle pl: -nȳdede, past participle pl: -nȳdde</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to repel, thrust or beat back, keep from, restrain, constrain, force</span>
						<span class="meaning-la"> (Lat. repellere, extorquere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they had formerly been unjustly forced from his kinsmen</span>
							<span class="q-oe">Hī fram his māgum ǣr mid unrihte anȳdde wǣron</span>
							<span class="q-cite"> (Chr. 823; Th. 111, 34)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">with ūt to expel, to drive</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sundor-feoh" d:title="sundor-feoh">
		<body>
			<h1>sundor-feoh<span class="pron"> | sun.dor.fe͜ox |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Private property, private estate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Mīn sundorfeoh on ðam neoþeran Hysseburnan</span>
							<span class="q-cite"> (Chart. Th. 488, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feran" d:title="feran">
		<body>
			<h1>feran<span class="pron"> | fe.rɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ferde, pl: -ferdon</b>
				</p>
				<p>
					<b class="ending">participle: present participle sg: -ferende, past participle sg: -fered</b>
				</p>
				<p>
					<b class="ending">infinitive: sg: -to ferenne</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To go, make a journey, set out, travel, march, sail</span>
						<span class="meaning-la"> (Lat. īre, iter facere, proficisci, transīre, migrāre, nāvigāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he called him to go to the king</span>
							<span class="q-oe">He hine to cyninge feran hēt</span>
							<span class="q-cite"> (Bd. 3, 23; S. 554, 39: Cd. 109; Th. 144, 32; Gen. 2398: Exon. 28 b; Th. 86, 31; Cri. 1416: Beo. Th. 53; B. 27: Andr. Kmbl. 347; An. 174: Elen. Kmbl. 429; El. 215; Ps. Th. 118, 3: Bt. Met. Fox 4, 35; Met. 4, 18: Judth. 9; Thw. 21, 10; Jud. 12: Byrht. Th. 132, 64; By. 41)</span>
						</li>
						<li>
							<span class="q-en">when they must go so great a journey</span>
							<span class="q-oe">Ðā hī swā mycelne sīþfæt feran sceoldan</span>
							<span class="q-cite"> (Bd. 3, 15; S. 541, 30: 1, 23; S. 485, 38)</span>
						</li>
						<li>
							<span class="q-en">he wished to set out in the morning</span>
							<span class="q-oe">He on morne feran wolde</span>
							<span class="q-cite"> (Bd. 2, 6; S. 508, 7)</span>
						</li>
						<li>
							<span class="q-en">I think to go thy ways with my feet</span>
							<span class="q-oe">Ic wegas ðīne þence to ferenne fōtum mīnum</span>
							<span class="q-cite"> (Ps. Th. 118, 59)</span>
						</li>
						<li>
							<span class="q-en">travelling people</span>
							<span class="q-oe">Folc ferende</span>
							<span class="q-cite"> (Cd. 80; Th. 99, 28; Gen. 1653: Exon. 103 a; Th. 390, 12; Rä. 8, 9: Ps. Th. 125, 5)</span>
						</li>
						<li>
							<span class="q-en">I travel over the earth</span>
							<span class="q-oe">Ic fere geond foldan</span>
							<span class="q-cite"> (Exon. 101 a; Th. 381, 2; Rä. 2, 5: Ps. Th. 140, 12)</span>
						</li>
						<li>
							<span class="q-en">thou goest with my grace</span>
							<span class="q-oe">Ðū mid mildse mīnre ferest</span>
							<span class="q-cite"> (Andr. Kmbl, 3345; An. 1676)</span>
						</li>
						<li>
							<span class="q-en">a man goes far</span>
							<span class="q-oe">Mon fereþ feor</span>
							<span class="q-cite"> (Exon. 91 a; Th. 343, 20; Gn. Ex. 146; Salm. Kmbl. 614; Sal. 306: Menol. Fox 327; Men. 165)</span>
						</li>
						<li>
							<span class="q-en">a ship [lit. oak] often saileth over the sea [lit. sea-fowl's bath]</span>
							<span class="q-oe">Āc fereþ gelōme ofer ganotes bæþ</span>
							<span class="q-cite"> (Runic pm. 25; Kmbl. 344, 18; Hick, Thes. i. 135, 49)</span>
						</li>
						<li>
							<span class="q-en">those who go hence</span>
							<span class="q-oe">Ða ðe heonon feraþ</span>
							<span class="q-cite"> (Cd. 228; Th. 305, 29; Sat. 654: Exon. 102 a; Th. 385, 14; Rä. 4, 44)</span>
						</li>
						<li>
							<span class="q-en">I went to earth from the realm above</span>
							<span class="q-oe">Ic ferde to foldan ufan from ēþle</span>
							<span class="q-cite"> (Cd. 224; Th. 295, 30; Sat. 495; Ps. Th. 142, 11)</span>
						</li>
						<li>
							<span class="q-la">Noe cum Deo ambulāvit</span>
							<span class="q-oe">Mid Gode Noe ferde</span>
							<span class="q-cite"> (Gen. 6, 9: Andr. Kmbl. 1323; An. 662: Exon. 42 b; Th. 143, 18; Gū. 663)</span>
						</li>
						<li>
							<span class="q-la">prōcessit rūmor ejus in omnem regiōnem Galilææ</span>
							<span class="q-oe">Ferde his hlīsa to Galilea rīce</span>
							<span class="q-cite"> (Mk. Bos. 1, 28: Homl. Th. ii. 358, 5)</span>
						</li>
						<li>
							<span class="q-en">a sower went to sow his seed</span>
							<span class="q-oe">Sum sǣdere ferde to sāwenne his sǣd</span>
							<span class="q-cite"> (ii. 88, 13: 90, 10)</span>
						</li>
						<li>
							<span class="q-la">recessit ab eis et ferēbātur in cælum</span>
							<span class="q-oe">He ferde fram him and wæs fered on heofen</span>
							<span class="q-cite"> (Lk. Bos. 24, 51)</span>
						</li>
						<li>
							<span class="q-en">he went home again</span>
							<span class="q-oe">He eft hām ferde</span>
							<span class="q-cite"> (Bd. 2, 9; S. 512, 5: 3, 11; S. 536, 9)</span>
						</li>
						<li>
							<span class="q-la">Hilda de morte transīvit ad vītam</span>
							<span class="q-oe">Hilde of deāþe ferde to līfe</span>
							<span class="q-cite"> (Bd. 4, 23; S. 595, 32)</span>
						</li>
						<li>
							<span class="q-en">he went over the sea</span>
							<span class="q-oe">He ferde ofer sǣ</span>
							<span class="q-cite"> (Boutr. Scrd. 17, 7: 19, 2: Chr. 1140; Erl. 265, 39)</span>
						</li>
						<li>
							<span class="q-la">abiit Dominus</span>
							<span class="q-oe">God ferde forþ</span>
							<span class="q-cite"> (Gen. 18, 33)</span>
						</li>
						<li>
							<span class="q-en">Constantius died [lit. went forth] in Britain</span>
							<span class="q-oe">Ferde Constantius forþ on Breotone</span>
							<span class="q-cite"> (Bd. 1, 8; S. 479, 29)</span>
						</li>
						<li>
							<span class="q-en">they went to Rome</span>
							<span class="q-oe">Hī ferdon to Rōme</span>
							<span class="q-cite"> (Chr. 737; Erl. 47, 22: Gen. 11, 31: Boutr. Scrd. 22, 18: Beo. Th. 3268; B. 1632)</span>
						</li>
						<li>
							<span class="q-la">in opus eos verbi proficisci suādet</span>
							<span class="q-oe">He hī lǣrde ðæt hī ferdon on ðæt geweorc ðæs Godes wordes</span>
							<span class="q-cite"> (Bd. 1, 23; S. 485, 39)</span>
						</li>
						<li>
							<span class="q-la">exiērunt obviam sponso</span>
							<span class="q-oe">Hī ferdon ongēn ðone brȳdguman</span>
							<span class="q-cite"> (Mt. Bos. 25, 1)</span>
						</li>
						<li>
							<span class="q-en">they went over the sea</span>
							<span class="q-oe">Hī ofer sǣ ferdon</span>
							<span class="q-cite"> (Chr. 1087; Erl. 226, 7, 12)</span>
						</li>
						<li>
							<span class="q-en">it is time that thou goest</span>
							<span class="q-oe">Tīd is ðæt ðū fete</span>
							<span class="q-cite"> (Exon. 51 b; Th. 179, 30; Gū. 1269: Andr. Kmbl. 448; An. 224)</span>
						</li>
						<li>
							<span class="q-en">ere ye go further</span>
							<span class="q-oe">Ǣr gē furður feran</span>
							<span class="q-cite"> (Beo. Th. 513; B. 254)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-feran" class="xref-target">be-feran</a>, <a href="x-dictionary:r:for-feran" class="xref-target">for-feran</a>, <a href="x-dictionary:r:forþ-feran" class="xref-target">forþ-feran</a>, <a href="x-dictionary:r:ge-feran" class="xref-target">ge-feran</a>, <a href="x-dictionary:r:geond-feran" class="xref-target">geond-feran</a>, <a href="x-dictionary:r:of-feran" class="xref-target">of-feran</a>, <a href="x-dictionary:r:ofer-feran" class="xref-target">ofer-feran</a>, <a href="x-dictionary:r:þurh-feran" class="xref-target">þurh-feran</a>, <a href="x-dictionary:r:to-feran" class="xref-target">to-feran</a>, <a href="x-dictionary:r:faran" class="xref-target">faran</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hrægel" d:title="hrægel">
		
		<body>
			<h1>hrægel<span class="pron"> | xræ.Gel |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A garment, dress, robe, rail [in night-rail] clothing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gerǣwen hrægel segmentata vestis: þicce gewefen hrægel pavidensis: þenne gewefen hrægel levidensis: purpuren hrægel clavus vel purpura: feala hiwes hrægel polymita: wōgum bewerod hrægel ralla vel rasilis: geedniwod eald hrægel interpola vestis: geclūtad hrægel panucla: gediht hrægel acupicta: þrȳlen hrægel trilicis</span>
							<span class="q-cite"> (Ælfc. Gl. 63; Som. 68, 99-109; Wrt. Voc. 40, 10-19)</span>
						</li>
						<li>
							<span class="q-en">robe and rings</span>
							<span class="q-oe">Hrægl and hringas</span>
							<span class="q-cite"> (Beo. Th. 2394; B. 1195)</span>
						</li>
						<li>
							<span class="q-en">a beggar sat there naked asked for a garment and an alms</span>
							<span class="q-oe">Sæt ðǣr sum þearfa nacod bæd hrægles and ælmessan</span>
							<span class="q-cite"> (Blickl. Homl. 213, 33)</span>
						</li>
						<li>
							<span class="q-en">lacking raiment I cover me with leaves</span>
							<span class="q-oe">Hrægles þearfa ic mē leāfum þecce</span>
							<span class="q-cite"> (Cd. 40; Th. 53, 25; Gen. 866)</span>
						</li>
						<li>
							<span class="q-en">use this robe</span>
							<span class="q-oe">Ðisses hrægles neōt</span>
							<span class="q-cite"> (Beo. Th. 2439; B. 1217)</span>
						</li>
						<li>
							<span class="q-la">mulieribus licet sub nigro velamine eucharistiam accipere</span>
							<span class="q-oe">Wīf mōton under brūnun hrægle tō hūsle gān</span>
							<span class="q-cite"> (L. Ecg. C. 37; Th. ii. 162, 7)</span>
						</li>
						<li>
							<span class="q-la">fiat ei sicut vestimentum</span>
							<span class="q-oe">Wese hē hrægle gelīc</span>
							<span class="q-cite"> (Ps. Th. 108, 19)</span>
						</li>
						<li>
							<span class="q-en">with food and clothing</span>
							<span class="q-oe">Mid mete and mid hrægle</span>
							<span class="q-cite"> (Blickl. Homl. 41, 29)</span>
						</li>
						<li>
							<span class="q-en">who was dressed in that one garment</span>
							<span class="q-oe">Se ðe mid ðon ānum hrægle wæs gegyrwed</span>
							<span class="q-cite"> (169, 1)</span>
						</li>
						<li>
							<span class="q-en">moderate in dress</span>
							<span class="q-oe">On medmyclum hrægle gehealdene</span>
							<span class="q-cite"> (185, 17)</span>
						</li>
						<li>
							<span class="q-en">he is burnt with his arms and clothing</span>
							<span class="q-oe">Man hine forbærneþ mid his wǣpnum and hrægle</span>
							<span class="q-cite"> (Ors. 1, 1; Swt. 21, 8)</span>
						</li>
						<li>
							<span class="q-en">the cloak that he had given to the beggar</span>
							<span class="q-oe">Ðæt hrægl ðe hē ǣr ðæm þearfan sealde</span>
							<span class="q-cite"> (Blickl. Homl. 215, 18: 223, 8)</span>
						</li>
						<li>
							<span class="q-en">began to rend his robe</span>
							<span class="q-oe">Ongan his hrægl teran</span>
							<span class="q-cite"> (Judth. 12; Thw. 25, 28; Jud. 283)</span>
						</li>
						<li>
							<span class="q-en">the white robes of the angels</span>
							<span class="q-oe">Ða hwītan hrægl ðara engla</span>
							<span class="q-cite"> (Blickl. Homl. 121, 24)</span>
						</li>
						<li>
							<span class="q-en">let him give his old clothes to the poor</span>
							<span class="q-oe">Sylle earmum mannum his ealde hrægl</span>
							<span class="q-cite"> (53, 13)</span>
						</li>
						<li>
							<span class="q-en">they had many ornaments of costly garments</span>
							<span class="q-oe">Hie hæfdon manige glengas deōrwyrþra hrægla</span>
							<span class="q-cite"> (99, 19)</span>
						</li>
						<li>
							<span class="q-oe">Beaduscrūda betst hrægla sēlest</span>
							<span class="q-cite"> (Beo. Th. 912; B. 454)</span>
						</li>
						<li>
							<span class="q-la">infantem pannis involutum</span>
							<span class="q-oe">Ān cild hreglum [hræglum, MS. C.] bewunden</span>
							<span class="q-cite"> (Lk. Skt. 2, 12)</span>
						</li>
						<li>
							<span class="q-en">with purple raiment</span>
							<span class="q-oe">Mid godwebbenum hræglum</span>
							<span class="q-cite"> (Blickl. Homl. 95, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sand-pytt" d:title="sand-pytt">
		<body>
			<h1>sand-pytt<span class="pron"> | sɑnd.pytt |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sand-pit</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē hēt lǣdan þā hālgan tō ānum sandpytte, and setton hī þǣron, and bewurpan mid eorþan and mid weorcstānum</span>
							<span class="q-cite"> (Hml. S. 35, 325)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwāra" d:title="hwāra">
		<body>
			<h1>hwāra<span class="pron"> | xwɑː.rɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:hwǣr" class="xref-target">hwǣr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="orcen" d:title="orcen">
		<body>
			<h1>orcen<span class="pron"> | or.Ken |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a sea-monster</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðanon untydras ealle onwōcon, eotenas and ylfe and orcneas [orcenas (?). Grein reads orc-nēas, with which compare orc-þyrs under orc] swylce gigantas</span>
							<span class="q-cite"> (Beo. Th. 225; B. 112)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cǣg-bora" d:title="cǣg-bora">
		<body>
			<h1>cǣg-bora<span class="pron"> | KæːG.bo.rɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A key-bearer</span>
						<span class="meaning-la"> (Lat. claviger)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-tīn(?)" d:title="for-tīn(?)">
		<body>
			<h1>for-tīn(?)<span class="pron"> | for.tiːn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A portent</span>
						<span class="meaning-la"> (Lat. signa et portenta)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">signa et portenta</span>
							<span class="q-oe">Bēcun and fortīna (bēceno and fertīno, L.) signa et portenta</span>
							<span class="q-cite"> (Mk. R. 13, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="long" d:title="long">
