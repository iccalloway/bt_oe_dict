			<h1>brōce<span class="pron"> | broː.Ke |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:brȳce" class="xref-target">brȳce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cnæpling" d:title="cnæpling">
		<body>
			<h1>cnæpling<span class="pron"> | knæ.pling |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A stripling, youth, boy</span>
						<span class="meaning-la"> (Lat. adolescens, puer)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I am a boy</span>
							<span class="q-oe">Eom ic cnæpling</span>
							<span class="q-cite"> (Homl. Th. ii. 576, 14: Mone B. 2514)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="restan" d:title="restan">
		<body>
			<h1>restan<span class="pron"> | re.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I a 3.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ǣlīg . . . þēr mīnes hlāfordes līchoma rest</span>
							<span class="q-cite"> (C. D. iii. 274, 14)</span>
						</li>
						<li>
							<span class="q-oe">Þā hālgan stōwæ þæ mīne yldran on restaþ</span>
							<span class="q-cite"> (273, 17)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II 2.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">List ðū and rest þē and Godes þeōwa līð æt þīnum gatum</span>
							<span class="q-cite"> (Hml. S. 31, 1152)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣr-wacol" d:title="ǣr-wacol">
		<body>
			<h1>ǣr-wacol<span class="pron"> | æːr.wɑ.kol |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Se apostol ǣrwacol tō ðǣre cyrcan com</span>
						<span class="q-cite"> (Hml. Th. i. 74, 20)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wæp-mann" d:title="wæp-mann">
