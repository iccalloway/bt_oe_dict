<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-stōp" d:title="forþ-stōp">
		<body>
			<h1>forþ-stōp<span class="pron"> | forθ.stoːp |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -forþ-stōp, pl: -stōpon</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">went forth, proceeded, passed by</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:forþ-stapan" class="xref-target">forþ-stapan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="murnung" d:title="murnung">
		<body>
			<h1>murnung<span class="pron"> | mur.nung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Of þæs magan ādle cumað monige and missenlica ādla . . . micla murnunga and unrōtnessa būtan þearfe</span>
						<span class="q-cite"> (Lch. ii. 174, 26)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ende-mes" d:title="ende-mes">
		
		
		<body>
			<h1>ende-mes<span class="pron"> | en.de.mes |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Equally, likewise, in like manner, together</span>
						<span class="meaning-la"> (Lat. pārĭter)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">because I cannot equally reckon all the manifest evils</span>
							<span class="q-oe">Forðon ic ne mæg eal ða monigfealdan yfel endemes areccan</span>
							<span class="q-cite"> (Ors. 2, 5; Bos. 49, 11: 3, 10; Bos. 69, 36)</span>
						</li>
						<li>
							<span class="q-en">nor can she equally shine upon all</span>
							<span class="q-oe">Ne mæg hiō ealle endemest gescīnan</span>
							<span class="q-cite"> (Bt. 41, 1; Fox 244, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cneōwede" d:title="cneōwede">
		
		<body>
			<h1>cneōwede<span class="pron"> | kne͜oː.we.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Having great knees</span>
						<span class="meaning-la"> (Lat. genosus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Cneōwede genosus</span>
							<span class="q-cite"> (Wrt. Voc. i. 45, 39)</span>
						</li>
						<li>
							<span class="q-oe">Cneōwade</span>
							<span class="q-cite"> (ii. 42, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þurh-sceōtendlic" d:title="þurh-sceōtendlic">
