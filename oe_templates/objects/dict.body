<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="freā-meaht" d:title="freā-meaht">
		<body>
			<h1>freā-meaht<span class="pron"> | fræ͜ɑː.mæ͜ɑxt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Lordly power</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Deus meus et fortitudo meus</span>
							<span class="q-oe">God mīn and freāmiht mīn</span>
							<span class="q-cite"> (Ps. Rdr. 42, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fina" d:title="fina">
		
		<body>
			<h1>fina<span class="pron"> | fi.nɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">marsopicus</span>
						<span class="q-oe">Fīna marsopicus</span>
						<span class="q-cite"> (Txts. 78, 648)</span>
					</li>
					<li>
						<span class="q-la">picus</span>
						<span class="q-oe">Fīna vel higrae picus</span>
						<span class="q-cite"> (Txts. 88, 808)</span>
					</li>
					<li>
						<span class="q-oe">Tō fīnan mǣdwum</span>
						<span class="q-cite"> (C. D. iii. 386, I)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byro" d:title="byro">
		<body>
			<h1>byro<span class="pron"> | by.ro |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A birch-tree</span>
						<span class="meaning-la"> (Lat. betula)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Byre betula [MS. betulus]</span>
							<span class="q-cite"> (Ælfc. Gl. 47; Som. 65, 20; Wrt. Voc. 33, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:birce" class="xref-target">birce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mete-leās" d:title="mete-leās">
		<body>
			<h1>mete-leās<span class="pron"> | me.te.læ͜ɑːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ne mihte Iūdas meteleās þǣr ābīdan</span>
						<span class="q-cite"> (Hml. S. 25, 447)</span>
					</li>
					<li>
						<span class="q-oe">Hiē ( the Danes) sǣton on þām īglande . . . oþ þone first þe hiū wurdon swīþe meteleāse</span>
						<span class="q-cite"> (Chr. 918; P. 98, 32)</span>
					</li>
					<li>
						<span class="q-oe">Þā leōn leofodon be hungre seofon niht meteleāse</span>
						<span class="q-cite"> (Hml. S. 16, 82)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrgedness" d:title="byrgedness">
