<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æt-īwedness" d:title="æt-īwedness">
		<body>
			<h1>æt-īwedness<span class="pron"> | æt.iː.wed.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A shewing, manifestation</span>
						<span class="meaning-la"> (Lat. ostensio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">erat in desertis usque in diem ostensionis suæ ad Israel</span>
							<span class="q-oe">Wæs on wēstenum ōþ ðone dæg hys ætīwednessum on Israhel</span>
							<span class="q-cite"> (Lk. Bos. 1, 80)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:æt-ȳwnys" class="xref-target">æt-ȳwnys</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fleswian" d:title="fleswian">
		<body>
			<h1>fleswian<span class="pron"> | fle.swi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To mutter, whisper</span>
						<span class="meaning-la"> (Lat. susurrāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">when he then told a feigned message with his crafty mouth, and falsely whispered</span>
							<span class="q-la">cum sĭmŭlātam lēgātiōnem ōre astūto volvĕret</span>
							<span class="q-oe">Mid ðȳ he ðā geswippre mūþe līccetende ǣrend rehte [MS. wrehte] and leāse fleswede</span>
							<span class="q-cite"> (Bd. 2, 9; S. 511, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-scǣning" d:title="-scǣning">
