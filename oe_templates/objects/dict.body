				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">devil-sickness</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:deōfolseōcnes" class="xref-target">deōfolseōcnes</a>
			</p>
