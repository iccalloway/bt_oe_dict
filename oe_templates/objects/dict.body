<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-fæðmness" d:title="on-fæðmness">
		<body>
			<h1>on-fæðmness<span class="pron"> | on.fæθm.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Embrace</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the Virgin Mary</span>
							<span class="q-oe">Seō onblāwnes ðære heofonlīcan onfæðmnesse sȳ gewindwod on ðē</span>
							<span class="q-cite"> (Blickl. Homl. 7, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
