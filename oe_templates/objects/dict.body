<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gin[n]" d:title="gin[n]">
		<body>
			<h1>gin[n]<span class="pron"> | Gin, n |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A wide expanse</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wīddra and sīddra þonne befæðman mæge eorðan ymbhwyrft and ūprodor, gārsecges gin and þeōs geōmre lyft</span>
							<span class="q-cite"> (Exod. 430)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ginne" class="xref-target">ginne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tȳman" d:title="tȳman">
		<body>
			<h1>tȳman<span class="pron"> | tyː.mɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:tȳman" class="xref-target">tȳman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="furh" d:title="furh">
		
		<body>
			<h1>furh<span class="pron"> | furx |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">nominative pl: -fyrh</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fir, pine</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Of ðā[m] ellen-stubbe on ðane ōðerne ellenstubbe; ðanone on ðā ealdan fyrh</span>
							<span class="q-cite"> (C. D. vi. 102, 26)</span>
						</li>
						<li>
							<span class="q-oe">On ðā ealdan firh</span>
							<span class="q-cite"> (iii. 97, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:next word" class="xref-target">next word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="friþ-sōcn" d:title="friþ-sōcn">
		<body>
			<h1>friþ-sōcn<span class="pron"> | friθ.soːkn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A peace-refuge, an asylum</span>
						<span class="meaning-la"> (Lat. asylum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that he may seek a refuge of peace</span>
							<span class="q-oe">Ðæt he friþsōcne gesēce</span>
							<span class="q-cite"> (L. Eth. ix. 1; Th. i. 340, 8: L. C. E. 2; Th. i. 358, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-unwendness" d:title="ge-unwendness">
		<body>
			<h1>ge-unwendness<span class="pron"> | je.un.wend.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unchangeableness</span>
						<span class="meaning-la"> (Lat. immutatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðeōs ungewendnes hæc immutatio</span>
							<span class="q-cite"> (Ps. Th. 76, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fromian" d:title="fromian">
		<body>
			<h1>fromian<span class="pron"> | fro.mi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To profit, avail</span>
						<span class="meaning-la"> (Lat. prōdesse, valēre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">quia sacrificium salutare ad redemptionem valeret et animæ et corporis sempiternam</span>
							<span class="q-oe">Ðætte seō hālwende onsægednes to ēcre alȳsnesse swīþrade and fromade ge līchoman ge sāwle</span>
							<span class="q-cite"> (Bd. 4, 22; S. 592, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fremian" class="xref-target">fremian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="up-flēring" d:title="up-flēring">
		<body>
			<h1>up-flēring<span class="pron"> | up.fleː.ring |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">an upper floor</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Seō upflēring tōbærst under his fötum</span>
							<span class="q-cite"> (Homl. Th. ii. 164, 3)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">an upper chamber</span>
						<span class="meaning-la"> (Lat. coenaculum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hī āstigon upp on āne upflēringe (coenaculum, Acts 1, 13)</span>
							<span class="q-cite"> (Homl. Th. i. 296, 9: 314, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lomb" d:title="lomb">
