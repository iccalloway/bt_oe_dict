<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feoh-leās" d:title="feoh-leās">
		<body>
			<h1>feoh-leās<span class="pron"> | fe͜ox.læ͜ɑːs |</span>
			</h1>
