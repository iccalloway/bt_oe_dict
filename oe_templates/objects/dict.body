<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frēfrend" d:title="frēfrend">
		
		<body>
			<h1>frēfrend<span class="pron"> | freː.frend |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Paraclitus, þæt is Frēfrigend</span>
						<span class="q-cite"> (Hml. Th. i. 550, 31)</span>
					</li>
					<li>
						<span class="q-oe">Hēr is se frēfrigend ūres geswinces and weorces</span>
						<span class="q-cite"> (560, 34: 562, 18)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:fore-frēfrend" class="xref-target">fore-frēfrend</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-mynegod" d:title="un-mynegod">
		<body>
			<h1>un-mynegod<span class="pron"> | un.my.ne.ɣod |</span>
			</h1>
