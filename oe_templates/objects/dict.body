<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="birging" d:title="birging">
		<body>
			<h1>birging<span class="pron"> | bir.Ging |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Tasting, taste</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Byrgincg (gustus) swēte ūt ānȳdde of neorxena wonge</span>
							<span class="q-cite"> (Scint. 57, 2)</span>
						</li>
						<li>
							<span class="q-oe">Hnesce on æthrine and weredre on byrigincge (biriginge, byrincge, v. ll.)</span>
							<span class="q-cite"> (Lch. i. 108, 2)</span>
						</li>
						<li>
							<span class="q-oe">On byrgynge</span>
							<span class="q-cite"> (250, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:on-birging" class="xref-target">on-birging</a>, <a href="x-dictionary:r:bȳrging" class="xref-target">bȳrging</a>
			</p>
		</body>
	</d:entry>
