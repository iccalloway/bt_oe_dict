<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="god-sunu" d:title="god-sunu">
		<body>
			<h1>god-sunu<span class="pron"> | god.su.nu |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -a</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A GODSON</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">then he accepted him and took him from the font at the bishop's hand as his godson</span>
							<span class="q-oe">Ðā onfēng he him and æt fulluhtbæþe nam æt ðæs B' handa him to godsuna</span>
							<span class="q-cite"> (Bd. 3, 7; S. 529, 18)</span>
						</li>
						<li>
							<span class="q-en">one of them was his godson, the other was alderman Ethelred's</span>
							<span class="q-oe">Hiora wæs ōðer his godsunu ōðer Æþerēdes ealdormonnes</span>
							<span class="q-cite"> (Chr. 894 ; Erl. 91, 29: L. In. 76; Th. i. 150, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hleahtor-lic" d:title="hleahtor-lic">
