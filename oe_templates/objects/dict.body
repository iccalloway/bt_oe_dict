<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="HŪ" d:title="HŪ">
		<body>
			<h1>HŪ<span class="pron"> | xuː |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">How</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="sub-heading">in direct questions</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">quomodo potest quisquam intrare in domum fortis?</span>
									<span class="q-oe">Hū mæg man ingān on stranges hūs</span>
									<span class="q-cite"> (Mt. Kmbl. 12, 29: 34)</span>
								</li>
								<li>
									<span class="q-la">nonne vos magis plures estis illis?</span>
									<span class="q-oe">Hū ne synt gē sēlran ðonne hig</span>
									<span class="q-cite"> (6, 26: 25)</span>
								</li>
								<li>
									<span class="q-en">how are we to live?</span>
									<span class="q-oe">Hū sculon wit nū libban</span>
									<span class="q-cite"> (Cd. 38; Th. 50, 7; Gen. 805)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="sub-heading">in exclamations [see also I]</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">how now! was not our agreement for a penny?</span>
									<span class="q-oe">Hū la! ne gewearþ unc tō ānum peninge</span>
									<span class="q-cite"> (Th. An. 74, 20)</span>
								</li>
								<li>
									<span class="q-la">quam bonus</span>
									<span class="q-oe">Hū gōd is ēce God</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flǣsc-hamian" d:title="flǣsc-hamian">
		<body>
			<h1>flǣsc-hamian<span class="pron"> | flæːʃ.xɑ.mi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to become incarnate</span>
						<span class="meaning-la"> (Lat. carnem humānam induĕre)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hama" class="xref-target">hama</a>, <a href="x-dictionary:r:ge-flǣschamod" class="xref-target">ge-flǣschamod</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="LEAHTER" d:title="LEAHTER">
