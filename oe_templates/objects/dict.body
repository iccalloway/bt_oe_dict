	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="camal" d:title="camal">
		<body>
			<h1>camal<span class="pron"> | kɑ.mɑl |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
