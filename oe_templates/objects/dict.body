<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weorc-hūs" d:title="weorc-hūs">
		<body>
			<h1>weorc-hūs<span class="pron"> | we͜ork.xuːs |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A workshop</span>
						<span class="meaning-la"> (Lat. officina)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Weorchūs officina</span>
							<span class="q-cite"> (Wrt. Voc. i. 58, 23)</span>
						</li>
						<li>
							<span class="q-oe">ergasterium vel operatorium</span>
							<span class="q-cite"> (59, 6)</span>
						</li>
						<li>
							<span class="q-oe">Werchūs ergasterium</span>
							<span class="q-cite"> (34, 54)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Gomorringas" d:title="Gomorringas">
