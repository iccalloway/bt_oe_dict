<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="caminatum" d:title="caminatum">
		<body>
			<h1>caminatum<span class="pron"> | kɑ.mi.nɑ.tum |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">caminatum</span>
						<span class="q-cite"> (Wrt. Voc. i. 58, 7)</span>
					</li>
					<li>
						<span class="q-oe">Fȳrhūses (printed -hȳses) hlȳwing caumene refugium</span>
						<span class="q-cite"> (Angl. xiii. 397, 461)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geān-cwide" d:title="geān-cwide">
