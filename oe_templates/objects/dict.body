				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A knee-joint</span>
						<span class="meaning-la"> (Lat. genuculum)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-wrinclod[e]" d:title="ge-wrinclod[e]">
