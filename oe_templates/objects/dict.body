<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cyssan" d:title="ge-cyssan">
		<body>
			<h1>ge-cyssan<span class="pron"> | je.Kys.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -cyste</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -cyssed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To kiss</span>
						<span class="meaning-la"> (Lat. osculāri)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the king kissed the best of thanes</span>
							<span class="q-oe">Gecyste cyning þegn betstan</span>
							<span class="q-cite"> (Beo. Th. 3744; B. 1870)</span>
						</li>
						<li>
							<span class="q-la">osculabatur pedes ejus</span>
							<span class="q-oe">Gecyste foet his</span>
							<span class="q-cite"> (Lk. Skt. Lind. 7, 38)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="træppe" d:title="træppe">
