						<span class="q-cite"> (88, 807)</span>
					</li>
					<li>
						<span class="q-oe">Fealfor</span>
						<span class="q-cite"> (Wrt. Voc. ii. 68, 28)</span>
					</li>
					<li>
						<span class="q-oe">Fealefor onocratulus</span>
						<span class="q-cite"> (63, 44)</span>
					</li>
