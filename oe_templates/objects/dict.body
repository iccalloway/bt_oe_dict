	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-nyht-līce" d:title="ge-nyht-līce">
		
		
		<body>
			<h1>ge-nyht-līce<span class="pron"> | je.nyxt.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Genycthlīce abunde</span>
						<span class="q-cite"> (Wrt. Voc. ii. 98, 17)</span>
					</li>
					<li>
						<span class="q-oe">Genihtlīce (printed -riht-)</span>
						<span class="q-cite"> (4, 14)</span>
					</li>
				</ul>
			</div>
