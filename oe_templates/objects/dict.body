<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="GE-WEORHT" d:title="GE-WEORHT">
		<body>
			<h1>GE-WEORHT<span class="pron"> | je.we͜orxt |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A work, building</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eodorcan" d:title="eodorcan">
