<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wyrht" d:title="wyrht">
		<body>
			<h1>wyrht<span class="pron"> | wyrxt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Doing, work</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non secundum peccata nostra fecit nobis</span>
							<span class="q-oe">Nā ðū be gewyrhtum ūrum, wommum wyrhtum, woldest ūs dōn</span>
							<span class="q-cite"> (Ps. Th. 102, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:for-wyrht" class="xref-target">for-wyrht</a>, <a href="x-dictionary:r:ge-wyrht" class="xref-target">ge-wyrht</a>, <a href="x-dictionary:r:leōþ-wyrht" class="xref-target">leōþ-wyrht</a>, <a href="x-dictionary:r:stān-wyrht" class="xref-target">stān-wyrht</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feāra" d:title="feāra">
		<body>
			<h1>feāra<span class="pron"> | fæ͜ɑː.rɑ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">of a few</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">feāra</span>
							<span class="q-cite"> (Beo. Th. 2828; B. 1412)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:feā" class="xref-target">feā</a>, <a href="x-dictionary:r:feāwa" class="xref-target">feāwa</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rīnan" d:title="rīnan">
