<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tō-weccan" d:title="tō-weccan">
		<body>
			<h1>tō-weccan<span class="pron"> | toː.wek.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -wehte</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To wake (trans.) up, stir up, arouse</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">how they stirred up strife amongst themselves</span>
							<span class="q-oe">Hū ða folc mid him fǣhþe tōwehton</span>
							<span class="q-cite"> (Beo. Th. 5889, ; B. 2948)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gefremed" d:title="un-gefremed">
