<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mynster-land" d:title="mynster-land">
		<body>
			<h1>mynster-land<span class="pron"> | myn.ster.lɑnd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Land belonging to a monastery</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ædelwold sealde mē tō gehwerfe ðone hām Heartingas on sixtigum hīdum wið ðām mynsterlande ðe līð intō Ēlīg</span>
							<span class="q-cite"> (C. D. iii. 60, 32)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þyrfende" d:title="þyrfende">
