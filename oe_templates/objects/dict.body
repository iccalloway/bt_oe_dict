				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The wrist</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cubitum</span>
							<span class="q-oe">Fæðm betwux elboga and handwyrste</span>
							<span class="q-cite"> (Ælfc. Gl. 72; Som. 70, 125; Wrt. Voc. 43, 51)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
