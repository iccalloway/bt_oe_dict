<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="blǣc" d:title="blǣc">
		<body>
			<h1>blǣc<span class="pron"> | blæːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">bright</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Lēg onetteð blǣc, byrnende</span>
							<span class="q-cite"> (Dōm. 56)</span>
						</li>
						<li>
							<span class="q-oe">Þæs deōres hīw, blǣc brigda gehwæs</span>
							<span class="q-cite"> (Pa. 26)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">pale</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Blaec thrustfeil bitiligo</span>
							<span class="q-cite"> (Txts. 45, 296)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:blāc" class="xref-target">blāc</a>
			</p>
		</body>
	</d:entry>
