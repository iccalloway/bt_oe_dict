<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ceosel-stān" d:title="ceosel-stān">
		
		<body>
			<h1>ceosel-stān<span class="pron"> | Ke͜o.sel.stɑːn |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sand-stone, gravel</span>
						<span class="meaning-la"> (Lat. glarea, calculus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ceoselstān glarea</span>
							<span class="q-cite"> (Wrt. Voc. 63, 70)</span>
						</li>
						<li>
							<span class="q-oe">Cyselstān calculus</span>
							<span class="q-cite"> (Ælfc. Gl. 11; Som. 57, 46; Wrt. Voc. 19, 48)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-līf" d:title="ā-līf">
		<body>
			<h1>ā-līf<span class="pron"> | ɑː.liːf |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">everlasting life</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þǣr bið eallum hālgum ālīf sceapen</span>
							<span class="q-cite"> (Först. Verc. 99, 2)</span>
						</li>
						<li>
							<span class="q-oe">Tō ālīfe gesceapen</span>
							<span class="q-cite"> (92, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
