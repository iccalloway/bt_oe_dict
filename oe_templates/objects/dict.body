<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ān-līc" d:title="ān-līc">
		
		<body>
			<h1>ān-līc<span class="pron"> | ɑːn.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">ONLY, singular, incomparable, excellent, elegant, beautiful</span>
						<span class="meaning-la"> (Lat. unicus, eximius, egregius, elegans, pulcher)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">unicus est mihi filius</span>
							<span class="q-oe">He is mīn ānlīca sunu</span>
							<span class="q-cite"> (Lk. Bos. 9, 38)</span>
						</li>
						<li>
							<span class="q-la">confitetur ecclesia tuum verum et unicum filium</span>
							<span class="q-oe">Andett seō gelaðung ðīnne sōðan and ānlīcan sunu</span>
							<span class="q-cite"> (Ps. Lamb. fol. 195 a, 12: Te Dm. Thomson 37, 12)</span>
						</li>
						<li>
							<span class="q-la">factus sum sicut passer unicus</span>
							<span class="q-oe">Ic spearu-wan swā some gelīce gewearþ, ānlīcum fugele</span>
							<span class="q-cite"> (Ps. Th. 101, 5: Exon. 56a; Th. 198, 12; Ph. 9: Beo. Th. 507; B. 251)</span>
						</li>
						<li>
							<span class="q-en">restore thou myn aon lijf aloone [darling] fro liouns</span>
							<span class="q-la">restitue a leonibus unicam meam</span>
							<span class="q-oe">Gesete fram deōflum oððe fram leōnum ānlīcan oððe ānnysse mīne</span>
							<span class="q-cite"> (Ps. Lamb. 34, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-clingan" d:title="ge-clingan">
