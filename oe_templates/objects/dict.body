<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-māgnys" d:title="ge-māgnys">
		<body>
			<h1>ge-māgnys<span class="pron"> | je.mɑː.ɣnys |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Perseverance, importunity, petulance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">truly importunity is pleasing to the true judge</span>
							<span class="q-oe">Sōðlīce gemāguys is ðam sōðan Dēman gecwēme</span>
							<span class="q-cite"> (Homl. Th. ii. 126, 2)</span>
						</li>
						<li>
							<span class="q-en">slothfulness gives birth to petulance</span>
							<span class="q-oe">Asolcennys acenþ gemāgnysse</span>
							<span class="q-cite"> (220, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þe" d:title="þe">
		<body>
			<h1>þe<span class="pron"> | θe |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">= se, in Northern Gospels</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ipse</span>
							<span class="q-oe">Ðe ł h-e ipse</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 15, 24)</span>
						</li>
						<li>
							<span class="q-la">ipse</span>
							<span class="q-oe">Ðe ilca ipse</span>
							<span class="q-cite"> (3, 4)</span>
						</li>
						<li>
							<span class="q-la">qui</span>
							<span class="q-oe">Ðe ðe qui</span>
							<span class="q-cite"> (3, 2)</span>
						</li>
						<li>
							<span class="q-oe">Ðe Hǣlend</span>
							<span class="q-cite"> (Jn. Skt. Rush. 4, 2, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:se" class="xref-target">se</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cǣlan" d:title="ge-cǣlan">
