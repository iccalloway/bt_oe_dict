<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-feran" d:title="forþ-feran">
		
		<body>
			<h1>forþ-feran<span class="pron"> | forθ.fe.rɑn |</span>
			</h1>
