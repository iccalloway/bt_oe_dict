<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rocettan" d:title="rocettan">
		
		<body>
			<h1>rocettan<span class="pron"> | ro.Ket.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To eructate, utter</span>
						<span class="meaning-la"> (Lat. eructare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">eructabo abscondita</span>
							<span class="q-oe">Roketto ł bilketto forþ ða ðe āhȳded wērun</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 13, 35)</span>
						</li>
						<li>
							<span class="q-la">eructuat</span>
							<span class="q-oe">Roccetteþ</span>
							<span class="q-cite"> (Ps. Surt. 18, 3 : eructuavit, 44, 2)</span>
						</li>
						<li>
							<span class="q-la">eructabunt</span>
							<span class="q-oe">Rocetaþ</span>
							<span class="q-cite"> (118, 171)</span>
						</li>
						<li>
							<span class="q-la">eructuat, i. a corde emittit</span>
							<span class="q-oe">Bylcetteþ, roccetteþ</span>
							<span class="q-cite"> (Wrt. Voc. ii. 144, 13)</span>
						</li>
						<li>
							<span class="q-la">ructabat</span>
							<span class="q-oe">Bleōw ł roccette</span>
							<span class="q-cite"> (96, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-mearcund" d:title="ge-mearcund">
