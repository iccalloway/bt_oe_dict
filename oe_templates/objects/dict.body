			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-en">which he inscribed in five books</span>
						<span class="q-oe">Ðe he on fīf bōcum afæstnode</span>
						<span class="q-cite"> (Hexam. 1; Norm. 2, 18: Deut. 32, 23)</span>
					</li>
					<li>
						<span class="q-la">injixus sum</span>
						<span class="q-oe">Afæstnod ic eom</span>
						<span class="q-cite"> (Ps. Spl. 68, 2)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
