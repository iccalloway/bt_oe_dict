<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stīþ-ecg" d:title="stīþ-ecg">
		<body>
			<h1>stīþ-ecg<span class="pron"> | stiːθ.edʒː |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Of stiff or strong edge</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Stīiðecg stȳle</span>
							<span class="q-cite"> (Exon. Th. 499, 11 ; Rä. 88, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cind" d:title="cind">
		<body>
			<h1>cind<span class="pron"> | Kind |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a kind, nature</span>
					</p>
				</li>
