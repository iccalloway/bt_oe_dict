<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-feōn" d:title="be-feōn">
		<body>
			<h1>be-feōn<span class="pron"> | be.fe͜oːn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -feōd</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To deprive of property (feoh), to confiscate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">infiscaretur, i. fraudaretur</span>
							<span class="q-oe">Ꝥ hē wǣre benǣmed, befeōd (-fiōd, Hpt. Gl. 480, 53)</span>
							<span class="q-cite"> (An. Ox. 3157)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="willa" d:title="willa">
		
		<body>
			<h1>willa<span class="pron"> | wil.lɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A well, spring, fountain (lit. and fig. )</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">fons</span>
							<span class="q-oe">Wæs ðēr wælla (fons) . . . ðe Hælend sæt ofer ðæm wælh</span>
							<span class="q-cite"> (Jn. Skt. Rush. 4, 6, 14)</span>
						</li>
						<li>
							<span class="q-oe">In ðæm wælla</span>
							<span class="q-cite"> (9, 7)</span>
						</li>
						<li>
							<span class="q-la">ad te fontent omnis sapientiae</span>
							<span class="q-oe">Tō ðē ðam willan ealles wīsdðmes</span>
							<span class="q-cite"> (Bd. 5, 24 ; S. 649, 3)</span>
						</li>
						<li>
							<span class="q-la">fonte baptismatis</span>
							<span class="q-oe">Mid ðam willan fulluhte bæþes</span>
							<span class="q-cite"> (5, 7; S. 620, 33)</span>
						</li>
						<li>
							<span class="q-la">puteum</span>
							<span class="q-oe">Ðiosne pytt ł uælla</span>
							<span class="q-cite"> (Jn. Skt. Lind. Rush. 4, 12)</span>
						</li>
						<li>
							<span class="q-oe">Heo ȝeoten i þan welle (wille, 2nd MS. ) ; þa wes þa welle mid attre bigon.</span>
							<span class="q-cite"> (Laym. 19771)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wille" class="xref-target">wille</a>, <a href="x-dictionary:r:will" class="xref-target">will</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-geregnod" d:title="un-geregnod">
		<body>
			<h1>un-geregnod<span class="pron"> | un.Ge.re.ɣnod |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unornamented</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Massehakele þæt is ungerēnad</span>
							<span class="q-cite"> (Chart. Th. 515, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-lǣtan" d:title="for-lǣtan">
		<body>
			<h1>for-lǣtan<span class="pron"> | for.læː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -lǣte, 2sg: -lǣtest, 2sg: -lǣtst, 3sg: -lǣteþ, 3sg: -lēteþ, pl: -lǣtaþ</b>
				</p>
				<p>
					<b class="ending">past: sg: -lēt, sg: -leōrt, sg: -leōt, pl: -lēton</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -lǣten</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to let go, permit, suffer</span>
						<span class="meaning-la"> (Lat. permittěre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">some earthly law permits</span>
							<span class="q-oe">Sum eorþlīc ǣ forlǣtaþ</span>
							<span class="q-cite"> (Bd. 1, 27; S. 491, 2)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to relinquish, forsake, omit, neglect</span>
						<span class="meaning-la"> (Lat. relinquěre, omittěre, praetěrīre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the man shall leave father and mother, and join himself to his wife</span>
							<span class="q-oe">Forlǣt se man fæder and mōder, and geþeōt hine to his wīfe</span>
							<span class="q-cite"> (Gen. 2, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Bryt-ford" d:title="Bryt-ford">
		<body>
			<h1>Bryt-ford<span class="pron"> | bryt.ford |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">BRITFORD, near Sarum, Wiltshire</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Tostig was then at Britfqrd with the king</span>
							<span class="q-oe">Tostig wæs ðā æt Brytforda [MS. Brytfordan] mid ðam cinge [MS. kinge]</span>
							<span class="q-cite"> (Chr. 1065; Erl. 194, 38)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-grip" d:title="ge-grip">
