			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">That is not hindered</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">inoffensis pedibus</span>
							<span class="q-oe">Unætspornenum fōtum</span>
							<span class="q-cite"> (Dial. 1, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heald-nes" d:title="heald-nes">
		<body>
			<h1>heald-nes<span class="pron"> | xæ͜ɑld.nes |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Holding, keeping, observance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">maxime in Pascha observando</span>
							<span class="q-oe">Ealles mǣst ymb eāstrena healdnyssa</span>
							<span class="q-cite"> (Bd. 2, 4; S. 505, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fȳr-fōda" d:title="fȳr-fōda">
