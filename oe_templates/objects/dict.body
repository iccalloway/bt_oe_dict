<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-sceādlic" d:title="ge-sceādlic">
		<body>
			<h1>ge-sceādlic<span class="pron"> | je.ʃæ͜ɑːd.liK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">reasonable, suitable</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">si res rationabilis ita exigerit</span>
							<span class="q-oe">Gyf þing gesceādlic swā gyrnþ</span>
							<span class="q-cite"> (Angl. xiii. 374, 130)</span>
						</li>
						<li>
							<span class="q-la">commotae mentes responsorum ratione tanguntur</span>
							<span class="q-oe">Ðæt āhrērede mōd mid ðǣre gesceādlican andsuare bið getǣsed</span>
							<span class="q-cite"> (Past. 297, 17)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">rational, based on reason or argument</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">fulcrum hoc atque pretiosum, sive GREEK, sive corollarium vocari mavis</span>
							<span class="q-oe">Is þis wundorlic and winsum and ge-sceādlic (gesceādwīslic, v.l.) spell</span>
							<span class="q-cite"> (Bt. 34, 5; F. 140, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-gesceādlic" class="xref-target">un-gesceādlic</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="emb-stemn" d:title="emb-stemn">
