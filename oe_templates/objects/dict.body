<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cwic-seolfor" d:title="cwic-seolfor">
		<body>
			<h1>cwic-seolfor<span class="pron"> | kwiK.se͜ol.for |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">electrum</span>
						<span class="q-oe">Cwicseolfor vel mæstling electrum</span>
						<span class="q-cite"> (Wrt. Voc. ii. 142, 77)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="morþ-wyrhta" d:title="morþ-wyrhta">
		<body>
			<h1>morþ-wyrhta<span class="pron"> | morθ.wyrx.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ðider (to hell) sculan mānsworan and morð-wyrhtan</span>
						<span class="q-cite"> (Wlfst. 26, 16)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cyncg" d:title="cyncg">
		<body>
			<h1>cyncg<span class="pron"> | Kyndʒː |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a king</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cyning" class="xref-target">cyning</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrnan" d:title="byrnan">
		<body>
			<h1>byrnan<span class="pron"> | byr.nɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 3sg: -byrneþ</b>
				</p>
				<p>
					<b class="ending">participle: present participle sg: -byrnende</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">To burn, to be on fire</span>
						<span class="meaning-la"> (Lat. ardere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">vestræ lucernæ ardentes</span>
							<span class="q-oe">Sīn eōwer leōhtfatu byrnende sint</span>
							<span class="q-cite"> (Lk. Bos. 12, 35: Deut. 9, 15)</span>
						</li>
						<li>
							<span class="q-la">cum exarserit ira ejus</span>
							<span class="q-oe">Ðonne bymeþ gramen his</span>
							<span class="q-cite"> (Ps. Spl. 2, 13: Bd. 5, 3; S. 616, 36)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">To burn</span>
						<span class="meaning-la"> (Lat. urere, comburere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sicut ignis comburit sylvas</span>
							<span class="q-oe">Swā fȳr wudu byrneþ</span>
							<span class="q-cite"> (Ps. Th. 82, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:beornan" class="xref-target">beornan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bæc-slitol" d:title="bæc-slitol">
		<body>
			<h1>bæc-slitol<span class="pron"> | bæK.sli.tol |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A backbiter</span>
						<span class="meaning-la"> (Lat. detractor)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hræd-wilness" d:title="hræd-wilness">
		<body>
			<h1>hræd-wilness<span class="pron"> | xræd.wil.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Precipitancy, haste</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mentem impellit furor, quo non trahit desiderium</span>
							<span class="q-oe">Siō hātheortness and siō hrædwilnes dæt mōd gebringþ on ðæm weorce ðe hine ǣr nān willa tō ne spōn</span>
							<span class="q-cite"> (Past. 33, 1; Swt. 215, 9)</span>
						</li>
						<li>
							<span class="q-la">tamen præcipitatio impellit</span>
							<span class="q-oe">Ðeāh for hrædwilnesse tō fōþ</span>
							<span class="q-cite"> (23, 2; Swt. 177, 15: 49, 1; Swt. 375, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hræd-hȳdigness" class="xref-target">hræd-hȳdigness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="deōre" d:title="deōre">
		<body>
			<h1>deōre<span class="pron"> | de͜oː.re |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Dearly</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">in reference to payment</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">care vendidit</span>
									<span class="q-oe">Deōre bebohte</span>
									<span class="q-cite"> (Wrt. Voc. ii. 129, 16)</span>
								</li>
								<li>
									<span class="q-oe">His ceāp þe hē deōre gebohte</span>
									<span class="q-cite"> (Ll. Th. i. 304, 22)</span>
								</li>
								<li>
									<span class="q-oe">Hī sculon deōre āgildan eal</span>
									<span class="q-cite"> (Wlfst. 190, 22)</span>
								</li>
								<li>
									<span class="q-oe">Hygeteōnan seolfre deōre bētan</span>
									<span class="q-cite"> (Gen. 2732)</span>
								</li>
								<li>
									<span class="q-oe">Ǣlce misdǣda deōr-ar āgyldan</span>
									<span class="q-cite"> (Ll. Th. i. 328, 15)</span>
								</li>
								<li>
									<span class="q-oe">Se cyng sealde his land tō male swā hē deōrost mihte</span>
									<span class="q-cite"> (Chr. 1086; P. 218, 12)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">with kindness, as holding a person dear</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">judica populum tuum in tua justitia</span>
									<span class="q-oe">Dēm þū þīn folc deōre mid sōðe</span>
									<span class="q-cite"> (Ps. Th. 71, 2 : 117, 24)</span>
								</li>
								<li>
									<span class="q-oe">Drihten, mīn gebed deōre gehȳre, and onfōh georne mine hālsunge</span>
									<span class="q-cite"> (142, 1: 118, 154)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-strūdian" d:title="ge-strūdian">
		<body>
			<h1>ge-strūdian<span class="pron"> | je.struː.di.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To commit rapine, prey on</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þā biōd þǣr on mǣstre nearonesse forþylmed þā þe hēr hiora līchaman mid mǣstum unrihtum byldað and ꝥ on ōðrum mannum mid wō gestrūdiaþ</span>
							<span class="q-cite"> (Nap. 32)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:next word" class="xref-target">next word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-mīðan" d:title="be-mīðan">
		
		<body>
			<h1>be-mīðan<span class="pron"> | be.miː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -māþ, pl: -miðon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -miðen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To hide, conceal</span>
						<span class="meaning-la"> (Lat. abscondere, occultare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non potuit latere</span>
							<span class="q-oe">He ne mihte hit bemīðan</span>
							<span class="q-cite"> (Mk. Bos. 7, 24)</span>
						</li>
						<li>
							<span class="q-en">they cannot conceal their heart's thoughts before the Supreme</span>
							<span class="q-oe">Hī ne māgon heortan geþohtas fōre Waldende bemīðan</span>
							<span class="q-cite"> (Exon. 23 a; Th. 65, 4; Cri. 1049)</span>
						</li>
						<li>
							<span class="q-en">he had concealed his shape</span>
							<span class="q-oe">He his mǣgwlite bemiðen hæfde</span>
							<span class="q-cite"> (Andr. Kmbl. 1712; An. 858)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gewinful" d:title="gewinful">
		<body>
			<h1>gewinful<span class="pron"> | Ge.win.ful |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">utinam minus fuissent laboriosa</span>
							<span class="q-oe">Ic wolde ꝥ hyra lǣs wǣre gewinfulra</span>
							<span class="q-cite"> (Nar. 2, 29)</span>
						</li>
						<li>
							<span class="q-oe">Hī ne mihton swā gewinnfullicum (gewinesfullicum, v. l.) fyrdum (tam laboriosis expeditionibus) swencte beōn</span>
							<span class="q-cite"> (Bd. 1, 12; Sch. 33, 17)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">full of trouble</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þis līf is lǣnlic and hit is gewinful</span>
							<span class="q-cite"> (Ll. Th. ii. 400, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-win" class="xref-target">ge-win</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Andredes ceaster" d:title="Andredes ceaster">
		<body>
			<h1>Andredes ceaster<span class="pron"> | ɑn.dre.des, Kæ͜ɑ.ster |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:Andred" class="xref-target">Andred</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="myrige" d:title="myrige">
		
		<body>
			<h1>myrige<span class="pron"> | my.ri.Ge |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Fegerne tūn timbrian, and þǣr murge and sōfte on eardian.</span>
						<span class="q-cite"> (Solil. H. I. 13)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-rȳman" d:title="ge-rȳman">
		<body>
			<h1>ge-rȳman<span class="pron"> | je.ryː.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="meaning-en">or thing, removes itself, to leave clear, of persons, to evacuate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Seō sǣfit flōwende him gerymde þreora mlla [fæt] dries færeldes</span>
							<span class="q-cite"> (Hml. Th. i. 564, 1 8)</span>
						</li>
						<li>
							<span class="q-oe">Hī flugon and þæt igland eallunge gerȳmdon ðǣm æðelan cempan</span>
							<span class="q-cite"> (ii. 142, 33)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">so as to allow access, to clear the way to</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gife unscynde mægencyning ontȳnde, tīdum gerymde</span>
									<span class="q-cite"> (El. 1249)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="sub-heading">so as to allow free action, to give free course to</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">he gives free play to his divine powers</span>
									<span class="q-oe">He his godcundnesse mid sōþum wīsum gerȳmeþ</span>
									<span class="q-cite"> (Bl. H. 179, 24)</span>
								</li>
								<li>
									<span class="q-oe">Metod mōd gerymde</span>
									<span class="q-cite"> (Exod. 479)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4 a)</span>
								<span class="sub-heading">the object a moving thing, to clear a course for</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">fluvium per loco alia derivare conati sunt</span>
									<span class="q-oe">Þā ongunnon hi on ōðre stōwe gerȳman</span>
									<span class="q-cite"> (Gr. D. 192, 22)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4 b)</span>
								<span class="sub-heading">the object an action, to make the way clear for, give opportunity for</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ne gladige hē on þæt, swilce him gerȳmed sȳ and antimber geseald, þæt hē God bereāfige</span>
									<span class="q-cite"> (Lch. iii. 442, 36)</span>
								</li>
								<li>
									<span class="q-oe">Þā him gerȳmed wearð þæt hiē wælstōwe wealdan mōston</span>
									<span class="q-cite"> (B. 2983)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to clear away an obstruction</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Swā hwæt swā þæne migðan gelet, hyt gerȳmð and forð gelǣdeþ</span>
							<span class="q-cite"> (Lch. i. 90, 27)</span>
						</li>
						<li>
							<span class="q-oe">Wegas syndon drȳge, holm gerȳmed</span>
							<span class="q-cite"> (Exod. 284)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">intrans. To make or leave the way clear to (tō) a place, condition, object, make way for a person</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he leaves the way clear for other worms to get food</span>
							<span class="q-oe">Hē ōðtrum gerȳmeð wyrmum tō wiste</span>
							<span class="q-cite"> (Seel. 123)</span>
						</li>
						<li>
							<span class="q-la">minor surgat et det majori locum sedendi</span>
							<span class="q-oe">Ārīse se gingra and þām yldran tō setle geryme</span>
							<span class="q-cite"> (R. Ben. 116, 5)</span>
						</li>
						<li>
							<span class="q-oe">God ūs gerȳme tō ðǣre ēcan myrhðe</span>
							<span class="q-cite"> (Wlfst. 80, 7)</span>
						</li>
						<li>
							<span class="q-en">that for them the Lord by death's pang clear the way to the end of their troubles</span>
							<span class="q-oe">Þæt him Dryhten þurh deāðes cwealm tō hyra earfeða ende gerȳme</span>
							<span class="q-cite"> (Gū. 196)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fælsian" d:title="fælsian">
		<body>
			<h1>fælsian<span class="pron"> | fæl.si.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To cleanse, purify</span>
						<span class="meaning-la"> (Lat. lustrāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that I may purify Heorot</span>
							<span class="q-oe">Ðæt ic mōte Heorot fælsian</span>
							<span class="q-cite"> (Beo. Th. 869; B. 432)</span>
						</li>
						<li>
							<span class="q-en">he had purified Hrothgar's hall</span>
							<span class="q-oe">He Hrōþgāres sele fælsode</span>
							<span class="q-cite"> (Beo. Th. 4694; B. 2352)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-fælsian" class="xref-target">ge-fælsian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="felge" d:title="felge">
