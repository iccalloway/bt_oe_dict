<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-neāt-scōlu" d:title="ge-neāt-scōlu">
		<body>
			<h1>ge-neāt-scōlu<span class="pron"> | je.næ͜ɑːt.ʃoː.lu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A band of companions</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ða ðegnas seō geneāt-scōlu</span>
							<span class="q-cite"> (Exon. 75 b; Th. 283, 22; Jul. 684)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-rihte" d:title="forþ-rihte">
		<body>
			<h1>forþ-rihte<span class="pron"> | forθ.rix.te |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of direction, straight on, without swerving</span>
								<span class="meaning-en">of direction, straight on, without swerving</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">indeclinabiliter ad destinatum locum</span>
									<span class="q-oe">Forðrihte tō foregetihtgedre stōwe</span>
									<span class="q-cite"> (Hpt. Gl. 406, 3)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">of manner, without modification or qualification, plainly, simply, directly</span>
								<span class="meaning-en">of manner, without modification or qualification, plainly, simply, directly</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">of a title</span>
										<span class="meaning-en">of a title</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Sarai is gereht 'Mīn ealdor,' ac God hī hēt syððan Sarra, þæt is, 'Ealdor,' þæt heō nǣre synderlīce hire hīrēdes ealdor gecīged, ac forðrihte 'Ealdor,'</span>
											<span class="q-cite"> (Hml. Th. i. 92, 19)</span>
										</li>
										<li>
											<span class="q-oe">Ne cwǣdon hī nā Ūre Hlāford, ne Ðīn Hlāford, ac forðrihte Hlāford,</span>
											<span class="q-cite"> (210, 2)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">of the service in church</span>
										<span class="meaning-en">of the service in church</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Gif hit mycel gefērrǣden is, sȳn hȳ mid antefene gesungene, gif seō gefērrǣden lytel is, sȳn hȳ forðrihte (in directum) būtan sōne gesungene ... ðā sealmas sȳn gesungene forðrihte (directanei) būtan antefene,</span>
											<span class="q-cite"> (R. Ben. 41, 7-16)</span>
										</li>
										<li>
											<span class="q-la">directo a puero prolato</span>
											<span class="q-oe">Forþrihte fram cilde gecwedenum</span>
											<span class="q-cite"> (Angl. xiii. 429, 914)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:forþ-riht" class="xref-target">forþ-riht</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-gewītan" d:title="forþ-gewītan">
		<body>
			<h1>forþ-gewītan<span class="pron"> | forθ.Ge.wiː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -gewāt, pl: -gewiton</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -gewiten</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To go forth, proceed, go by, pass, depart, die</span>
						<span class="meaning-la"> (Lat. procēdere, transīre, præterīre, decēdere, mori)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">tanquam sponsus procedens de thālamo suo</span>
							<span class="q-oe">Swā swā brȳdguma forþgewītende of brȳdbūre his</span>
							<span class="q-cite"> (Ps. Spl. 18, 5)</span>
						</li>
						<li>
							<span class="q-la">dōnec transeat inīquitas</span>
							<span class="q-oe">Ōþ-ðæt forþgewīteþ unriht</span>
							<span class="q-cite"> (56, 2)</span>
						</li>
						<li>
							<span class="q-la">tanquam dies hesterna quæ præteriit</span>
							<span class="q-oe">Swylce gysternlīc dæg ðe forþgewāt</span>
							<span class="q-cite"> (Ps. Lamb. 89, 4: Bd. 4, 9; S. 577, 35)</span>
						</li>
						<li>
							<span class="q-la">procēde et regna</span>
							<span class="q-oe">Forþgewīt and rīce</span>
							<span class="q-cite"> (Ps. Spl. 44, 5)</span>
						</li>
						<li>
							<span class="q-en">præstēritum tempus is the past tense</span>
							<span class="q-la">prætēritum tempus is the past tense</span>
							<span class="q-oe">Prætēritum tempus is forþgewiten tīd</span>
							<span class="q-cite"> (Ælfc. Gr. 20; Som. 23, 7, 10, 12, 13)</span>
						</li>
						<li>
							<span class="q-en">the past tense</span>
							<span class="q-oe">Se forþgewitena tīma the past tense</span>
							<span class="q-cite"> (Som. 23, 14)</span>
						</li>
						<li>
							<span class="q-oe">Ðone forþgewitenan tīman</span>
							<span class="q-cite"> (Som. 23, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scyriendlīc" d:title="scyriendlīc">
		<body>
			<h1>scyriendlīc<span class="pron"> | ʃy.ri͜ynd.liːK |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:sciriendlīc" class="xref-target">sciriendlīc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stīþ-hycgende" d:title="stīþ-hycgende">
		<body>
			<h1>stīþ-hycgende<span class="pron"> | stiːθ.xydʒ.dʒen.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">in a good sense, of firm, inflexible purpose, resolute</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Stōpon tō ðære stōwe stīðhycgende</span>
							<span class="q-cite"> (Elen. Kmbl. 1429 ; El. 716)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">in a bad sense, obstinate, stubborn</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hire Iudas oncwæð stīðhycgende: 'Ic ða stōwe ne can,'</span>
							<span class="q-cite"> (1362 ; El. 683)</span>
						</li>
						<li>
							<span class="q-oe">Stīðhycgendum (the multitude of unbelievers)</span>
							<span class="q-cite"> (Andr. Kmbl. 1481 ; An. 742)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">having hard, unpleasant thoughts</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">'Is mē feorhgedāl leōfre micle ðonne ðeōs līfcearo.' Him ðā stefn oncwæð stīðhycgendum</span>
							<span class="q-cite"> (2858 ; An. 1431)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="steōp-fæder" d:title="steōp-fæder">
		<body>
			<h1>steōp-fæder<span class="pron"> | ste͜oːp.fæ.der |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A step-father</span>
						<span class="meaning-la"> (Lat. vitricus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Steōpfaeder bitricius</span>
							<span class="q-cite"> (Txts. 45, 300)</span>
						</li>
						<li>
							<span class="q-oe">Steōpfaeder, steūpfaedaer, staupfotar, steūffeder vitricius</span>
							<span class="q-cite"> (107, 2124)</span>
						</li>
						<li>
							<span class="q-oe">Steōp-fæder vitricus vel patraster</span>
							<span class="q-cite"> (Wrt. i. 52, 11: 72, 31: 284, 75: ii. 11, 10)</span>
						</li>
						<li>
							<span class="q-oe">Hē ofslōh ge his āgenne fæder ge his steōpfæder (vitricum suum)</span>
							<span class="q-cite"> (Ors. 1, 8; Swt. 42, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þyldigian" d:title="þyldigian">
		<body>
			<h1>þyldigian<span class="pron"> | θyl.di.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To endure</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">bene patientes erunt</span>
							<span class="q-oe">Wel þyldigende hī beōð</span>
							<span class="q-cite"> (Ps. Spl. 91, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-ðyldigian" class="xref-target">ā-ðyldigian</a>, <a href="x-dictionary:r:for-ðyldigian" class="xref-target">for-ðyldigian</a>, <a href="x-dictionary:r:ge-ðyldigian" class="xref-target">ge-ðyldigian</a>, <a href="x-dictionary:r:ge-þylgian" class="xref-target">ge-þylgian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mǣte" d:title="mǣte">
		<body>
			<h1>mǣte<span class="pron"> | mæː.te |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hē mōt ǣgðer witan ge lǣsse ge mǣre, ge betere ge mǣtre ðæs ðe tō tūne belimpð</span>
						<span class="q-cite"> (Angl. ix. 259, 23)</span>
					</li>
					<li>
						<span class="q-la">firmauerunt sibi uerbum malum</span>
						<span class="q-oe">Hȳ getrymedon him word mǣte</span>
						<span class="q-cite"> (Ps. Rdr. 63, 6)</span>
					</li>
					<li>
						<span class="q-oe">Micle ge mēttan</span>
						<span class="q-cite"> (C. D. B. iii. 491, 12)</span>
					</li>
					<li>
						<span class="q-oe">Ðā druncengeornan synt micele mǣttran ðonne nȳtenu</span>
						<span class="q-cite"> (Hml. A. 145, 27)</span>
					</li>
					<li>
						<span class="q-oe">Swā biōð þā midmestan (mǣstan, v.l.) men onmiddan þām spācan, and þā betran neār þǣre nafe, and þā mǣtran neār ðǣm felgum . . . þā felga longiað on þǣm spācan. . . swā dōð þā mǣtestan (mǣstan, v.l.) men on þǣm midmestum, and þā midmestan on þǣm betstan . . . þā mǣtestan (mǣstan, v.l.) ealle hiora lufe wenden tō ðisse weorulde</span>
						<span class="q-cite"> (Bt. 39, 7; S. 130, 1-9)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:byrþen-mǣte" class="xref-target">byrþen-mǣte</a>, <a href="x-dictionary:r:pund-mǣte" class="xref-target">pund-mǣte</a>, <a href="x-dictionary:r:ūþ-mǣte" class="xref-target">ūþ-mǣte</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāste" d:title="eāste">
		<body>
			<h1>eāste<span class="pron"> | æ͜ɑː.ste |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The east</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eāst" class="xref-target">eāst</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hlid" d:title="ge-hlid">
		<body>
			<h1>ge-hlid<span class="pron"> | je.xlid |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es, nominative pl: -hlidu, accusative pl: -hlidu, nominative pl: -hleodu, accusative pl: -hleodu</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A lid, covering, roof, an inclosure, a vault</span>
						<span class="meaning-la"> (Lat. tectum, clausūra, septum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I know all the roofs of the high heavens</span>
							<span class="q-oe">Ic cann ealle heāh-heofona gehlidu</span>
							<span class="q-cite"> (Cd. 27; Th. 37, 3; Gen. 584)</span>
						</li>
						<li>
							<span class="q-en">when the son of God shall appear through heaven's vaults</span>
							<span class="q-oe">Ðonne bearn Godes þurh heofona gehleodu ōþȳweþ</span>
							<span class="q-cite"> (21 a; Th. 56, 23; Cri, 905)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cælcian" d:title="ge-cælcian">
		<body>
			<h1>ge-cælcian<span class="pron"> | je.Kæl.Ki.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-cilcan" class="xref-target">ge-cilcan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="breāc" d:title="breāc">
		<body>
			<h1>breāc<span class="pron"> | bræ͜ɑːK |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">enjoyed; p. of brūcan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:brūcan" class="xref-target">brūcan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-ālīfendlīce" d:title="un-ālīfendlīce">
		
		<body>
			<h1>un-ālīfendlīce<span class="pron"> | un.ɑː.liː.fend.liː.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unallowably, unlawfully</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">inlicite</span>
							<span class="q-oe">Uuālȳfendlīce</span>
							<span class="q-cite"> (Scint. 141, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gedwol-mist" d:title="gedwol-mist">
		<body>
			<h1>gedwol-mist<span class="pron"> | Ge.dwol.mist |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Mist of error</span>
						<span class="meaning-la"> (Lat. erroris nabula)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">with the mist of error</span>
							<span class="q-oe">Mid ðam gedwolmiste</span>
							<span class="q-cite"> (Bt. 35, 1; Fox 156, 1 : Bt. Met. Fox 22, 65; Met. 22, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-hīrung" d:title="-hīrung">
		<body>
			<h1>-hīrung<span class="pron"> | xiː.rung |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hīrung" class="xref-target">ge-hīrung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scortness" d:title="scortness">
		<body>
			<h1>scortness<span class="pron"> | ʃort.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">shortness (of time)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cum exarsent in brevi ira ejus</span>
							<span class="q-oe">Ðonne byrneþ on scortnisse gramen hys</span>
							<span class="q-cite"> (Ps. Spl. 2, 13)</span>
						</li>
						<li>
							<span class="q-oe">Ða scortnesse ðysse worulde and ða ēcnesse ðæs tōweardan līfes.</span>
							<span class="q-cite"> (Homl. As. 168, 117)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a short account, an epitome (cf. a brief, and v. scortlīce, II)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Manega synd gyt coniunctiones, ðe wē ne māgon nū secgan on ðissere sceortnysse,</span>
							<span class="q-cite"> (Ælfc. Gr. 44 ; Zup. 266, 8)</span>
						</li>
						<li>
							<span class="q-oe">Wē habbaþ gesǣd on ðisre sceortnysse, hū God geswutelode ða sōðfæstan godspelleras,</span>
							<span class="q-cite"> (Homl. Skt. i. 15, 219)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:scortlīce" class="xref-target">scortlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þwāstrian" d:title="þwāstrian">
		<body>
			<h1>þwāstrian<span class="pron"> | θwɑː.stri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to murmur, speak low</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I dare not yet even speak low</span>
							<span class="q-oe">Þis ic spece nū gyt mid swā miccle ege ðæt mē þinceþ ðæt mē siō tunge stomrige nis hit gyt forðun ðæt ic þwāstrian durre</span>
							<span class="q-cite"> (Shrn. 42, 35)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hwāstrian" class="xref-target">hwāstrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-bȳsnung" d:title="-bȳsnung">
