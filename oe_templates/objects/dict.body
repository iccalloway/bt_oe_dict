<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wiþo-bān" d:title="wiþo-bān">
		<body>
			<h1>wiþo-bān<span class="pron"> | wi.θo.bɑːn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es, genitive sg: --bāne</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A collar-bone</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif widobāne gebroced weorðeþ</span>
							<span class="q-cite"> (L. Ethb. 52; Th. i. 16, 5)</span>
						</li>
						<li>
							<span class="q-oe">Ofer ealle ða sīdan āstīhþ ōþ ðæt wiþobān and ōþ ðone swīþran sculdor ðæt sār</span>
							<span class="q-cite"> (Lchdm. ii. 198, 18)</span>
						</li>
						<li>
							<span class="q-oe">Stingende sār ōþ ða wiþobān ōð ða eaxle</span>
							<span class="q-cite"> (204, 26)</span>
						</li>
						<li>
							<span class="q-oe">Hwīlum ofer ealle ða sīdan biþ ðæt sār, hwīlum becymð on ða weoþobān, and eft ymb lytel ða gesculdru ðæt sār grēt</span>
							<span class="q-cite"> (258, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þoterian" d:title="þoterian">
		<body>
			<h1>þoterian<span class="pron"> | θo.te.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To howl, wail, cry out</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">clamat</span>
							<span class="q-oe">Þotraþ</span>
							<span class="q-cite"> (Wrt. Voc. ii. 21, 12)</span>
						</li>
						<li>
							<span class="q-la">gemens infernus ululat</span>
							<span class="q-oe">Geōmriende hell þoteraþ</span>
							<span class="q-cite"> (Hymn. Surt. 84, 34)</span>
						</li>
						<li>
							<span class="q-la">plorabitis et flebitis</span>
							<span class="q-oe">Gē wēpaþ and þoteriaþ</span>
							<span class="q-cite"> (Scint. 167, 3)</span>
						</li>
						<li>
							<span class="q-oe">Hī ðotorodon swilce ōðre wulfas</span>
							<span class="q-cite"> (Homl. Th. ii. 488, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:þeōtan" class="xref-target">þeōtan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-flōwan" d:title="forþ-flōwan">
