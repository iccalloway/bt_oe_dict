<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-līce" d:title="ge-līce">
		
		<body>
			<h1>ge-līce<span class="pron"> | je.liː.tʃe |</span>
			</h1>
