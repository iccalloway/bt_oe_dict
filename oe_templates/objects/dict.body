			<h1>ge-yrsian<span class="pron"> | je.yr.si.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-irsian" class="xref-target">ge-irsian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="FOR-FŌR" d:title="FOR-FŌR">
