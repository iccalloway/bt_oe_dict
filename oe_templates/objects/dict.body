<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hund-eahtatig" d:title="hund-eahtatig">
		<body>
			<h1>hund-eahtatig<span class="pron"> | xund.æ͜ɑx.tɑ.tiG |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">him eōde on hundeahtatig burga</span>
						<span class="q-cite"> (Ors. 4, 10; S. 198, 15)</span>
					</li>
					<li>
						<span class="q-oe">Hē hund-eahtatig scipa gegaderade</span>
						<span class="q-cite"> (4, 6; S. 170, 34)</span>
					</li>
				</ul>
			</div>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">as adj.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">octuagies</span>
							<span class="q-oe">Hund-eahtatigon sīðon</span>
							<span class="q-cite"> (Ælfc. Gr. Z. 286, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-standendlīc" d:title="under-standendlīc">
		<body>
			<h1>under-standendlīc<span class="pron"> | un.der.stɑn.dend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Intelligible, to be understood</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gyltan" d:title="gyltan">
		<body>
			<h1>gyltan<span class="pron"> | Gyl.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -gylte</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -gylt</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To commit guilt or sin, to be guilty</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the sins of the guilty</span>
							<span class="q-oe">Ðara gyltendra scylda</span>
							<span class="q-cite"> (Past. 21; Swt. 167, 6; Hat. MS.)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gylting" class="xref-target">gylting</a>, <a href="x-dictionary:r:gyltend" class="xref-target">gyltend</a>, <a href="x-dictionary:r:āgyltan" class="xref-target">āgyltan</a>, <a href="x-dictionary:r:for-gyltan" class="xref-target">for-gyltan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tō-lūcan" d:title="tō-lūcan">
		<body>
			<h1>tō-lūcan<span class="pron"> | toː.luː.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -leāc, pl: -lucon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -locen</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">To tear to pieces, wrench asunder, dislocate</span>
					</p>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="sub-heading">literal</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ðæs ne wēndon witan Scyldinga, ðæt hit (the hall) manna ǣnig tōbrecan meahte, listum tōlūcan</span>
									<span class="q-cite"> (Beo. Th. 1566; B. 781)</span>
								</li>
								<li>
									<span class="q-la">eo quod interanea essent ruendo convulsa</span>
									<span class="q-oe">Forðon ðe mīne innoþas on ðam fylle tōlocene wǣron</span>
									<span class="q-cite"> (Bd. 5, 6; S. 619, 31)</span>
								</li>
								<li>
									<span class="q-oe">Sint mē leoð tōlocen, līc sāre gebrocen</span>
									<span class="q-cite"> (Andr. Kmbl. 2807; An. 1406)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">figurative, to root out, destroy</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">constitui te super gentes et super regna, ut evellas et destruas et disperdas et dissipes</span>
							<span class="q-oe">Ic hæbbe ðē gesetne ofer rīce and ofer ðiōda ðæt ðū hī tōlūce and tōweorpe and forspilde and tōstence</span>
							<span class="q-cite"> (Past. 58; Swt. 441, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:tō-hlecan" class="xref-target">tō-hlecan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-wērgian" d:title="ge-wērgian">
		
		<body>
			<h1>ge-wērgian<span class="pron"> | je.weːr.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To weary, fatigue</span>
						<span class="meaning-la"> (Lat. fatīgāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he sat wearied</span>
							<span class="q-oe">He gewērgad sæt</span>
							<span class="q-cite"> (Beo. Th. 5697; B. 2852: Exon. 51 a; Th. 178, 12; Gū. 1243)</span>
						</li>
						<li>
							<span class="q-en">the Mauritanians were wearied by it</span>
							<span class="q-oe">Mauritanie wǣron mid ðam gewērgode</span>
							<span class="q-cite"> (Ors. 5, 7; Bos. 107, 7)</span>
						</li>
						<li>
							<span class="q-en">who were wearied with ague</span>
							<span class="q-oe">Ðe on lengtenādle gewērigade wǣron</span>
							<span class="q-cite"> (Bd. 4, 6; S. 574, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hnesc-līc" d:title="hnesc-līc">
		<body>
			<h1>hnesc-līc<span class="pron"> | xneʃ.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Effeminate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he [Sardanapalus] was a very effeminate man</span>
							<span class="q-oe">Hē wæs swīðe hnesclīc man</span>
							<span class="q-cite"> (Ors. 1, 12; Bos. 35, 15)</span>
						</li>
						<li>
							<span class="q-la">hi sunt delicati ita fornicantes</span>
							<span class="q-oe">Hi beōþ hneslīce swā forlegene</span>
							<span class="q-cite"> (L. Ecg. P. iv. 68, 6; Th. ii. 228, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-prǣstan" d:title="for-prǣstan">
		<body>
			<h1>for-prǣstan<span class="pron"> | for.præː.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To entirely bruise, break</span>
						<span class="meaning-la"> (Lat. conterere)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:þrǣstan" class="xref-target">þrǣstan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Gotonisc" d:title="Gotonisc">
		<body>
			<h1>Gotonisc<span class="pron"> | go.to.niʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Of the Goths</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Gothorum clangorem</span>
							<span class="q-oe">Gotonisce cerme</span>
							<span class="q-cite"> (An. Ox. 4606)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōre-beōn" d:title="fōre-beōn">
		<body>
			<h1>fōre-beōn<span class="pron"> | foː.re.be͜oːn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to be before or over, to preside</span>
						<span class="meaning-la"> (Lat. præesse)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fōre-eom" class="xref-target">fōre-eom</a>, <a href="x-dictionary:r:fōre-wesan" class="xref-target">fōre-wesan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hundred-sōcn" d:title="hundred-sōcn">
		<body>
			<h1>hundred-sōcn<span class="pron"> | xun.dred.soːkn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Attendance at the hundred-gemot; fine for non-attendance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Omnes forisfacturas terrarum suarum, id est, burgbrice, hundredsōcna, āthas, ordēlas, . . . hāmsōcna et frithbrice et foresteall</span>
							<span class="q-cite"> (Cht. Th. 187, 23)</span>
						</li>
						<li>
							<span class="q-oe">Of Hylle . . . hāmsōcne and forsteall, griðbrice . . . āþ and ordēl, and iii gemōt on geāre</span>
							<span class="q-cite"> (433, 26-32)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āblican" d:title="āblican">
		<body>
			<h1>āblican<span class="pron"> | ɑː.bli.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -blāc, pl: -blicon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -blicen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To shine, shine forth, to appear, glitter, to be white, to astonish, amaze</span>
						<span class="meaning-la"> (Lat. dealbari, micare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ego autem in justitia apparebo [micabo]</span>
							<span class="q-oe">Sōþ-līce on rihtwīsnysse ic ablīce</span>
							<span class="q-cite"> (Ps. Spl. T. 16, 17)</span>
						</li>
						<li>
							<span class="q-la">super nivem dealbabor</span>
							<span class="q-oe">Ofer snāw ic beō ablicen</span>
							<span class="q-cite"> (Ps. Spl. 50, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scōh-wyrhta" d:title="scōh-wyrhta">
		<body>
			<h1>scōh-wyrhta<span class="pron"> | ʃoːx.wyrx.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A shoemaker. From the description of his work given by the sceōwyrhta (sutor) in Ælfric's Colloquy, Thorpe, p. 27, he seems to have been a general worker-in leather. Besides boots and shoes he makes harness, leather bags and bottles</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sūtere" class="xref-target">sūtere</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lyft-fleōgend" d:title="lyft-fleōgend">
		<body>
			<h1>lyft-fleōgend<span class="pron"> | lyft.fle͜oː.Gend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">That which flies in the air, a bird</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Lyftfleōgendra</span>
							<span class="q-cite"> (Salm. Kmbl. 579; Sal. 289)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="HEĀH-SETL" d:title="HEĀH-SETL">
		<body>
			<h1>HEĀH-SETL<span class="pron"> | xæ͜ɑːx.setl |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:HEALDAN" class="xref-target">HEALDAN</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-bīdan" d:title="on-bīdan">
		<body>
			<h1>on-bīdan<span class="pron"> | on.biː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē þǣr onbād sume hwīle oð ꝥ flōd ūp eōde</span>
							<span class="q-cite"> (Chr. 1052; P. 180, 13)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þǣr his Pompeius on ānre dūne onbād</span>
							<span class="q-cite"> (Ors. 5, 12; S. 240, 23)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">with clause</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē gesæt be þām swere anbīdende hwæt him gelimpan scolde</span>
							<span class="q-cite"> (Bl. H. 239, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ragu-finc" d:title="ragu-finc">
		<body>
			<h1>ragu-finc<span class="pron"> | rɑ.ɣu.fink |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The name of some bird</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ragofinc scutatis, scutatus</span>
							<span class="q-cite"> (Wrt. Voc. i. 62, 44 : 281, 15 : barrulus, ii. 10, 79)</span>
						</li>
						<li>
							<span class="q-oe">Reagufinc bariulus</span>
							<span class="q-cite"> (101, 62)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eard" d:title="eard">
		<body>
			<h1>eard<span class="pron"> | æ͜ɑrd |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:mid-eard" class="xref-target">mid-eard</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣrend-wreccan" d:title="ǣrend-wreccan">
		<body>
			<h1>ǣrend-wreccan<span class="pron"> | æː.rend.wrek.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -wrehte</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To deliver a message</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">intravit quasi nuntium domini sui referens; et cum simulatam legationem ore astuto volveret</span>
							<span class="q-oe">Ðā eōde hē in swā swā hē his hlāfordes ǣrende secgan sceolde; and mid ðȳ hē ðā geswippre mūþe līccetende ǣrend (ǣrende, v. l.) wrehte (ǣrendwrehte?)</span>
							<span class="q-cite"> (Bd. 2, 9; Sch. 146, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-serīfan" d:title="ge-serīfan">
		<body>
			<h1>ge-serīfan<span class="pron"> | je.se.riː.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -scrāf, sg: -screāf</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -scrifen</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to judge, deem, assign, impose, appoint</span>
						<span class="meaning-la"> (Lat. judicare, assignare, imponere, designare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">who to him had assigned misery</span>
							<span class="q-oe">Se ðe him gescrāf weān</span>
							<span class="q-cite"> (Cd. 148; Th. 186, 16; Exod. 139)</span>
						</li>
						<li>
							<span class="q-en">so fate assigned to him</span>
							<span class="q-oe">Swā him wyrd gescrāf</span>
							<span class="q-cite"> (Beo. Th. 5142; B. 2574: Elen. Grm. 1047: Bt. Met. Fox 1, 58; Met. 1, 29)</span>
						</li>
						<li>
							<span class="q-la">paulo minus consummaverunt me in terra</span>
							<span class="q-oe">Hiō me lytle læs lāðe woldan ðisses eorþweges ende gescrīfan</span>
							<span class="q-cite"> (Ps. Th. 118, 87)</span>
						</li>
						<li>
							<span class="q-en">when you have given the appointed sum</span>
							<span class="q-oe">Siððan gē agifen habbaþ sceattas gescrifene</span>
							<span class="q-cite"> (Andr. Kmbl. 593; An. 297)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to shrive, impose penance, censure</span>
						<span class="meaning-la"> (Lat. pœnitentiam imponere, reprehendere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the physician of men's souls must consider how he shall shrive their deeds and yet not condemn them</span>
							<span class="q-oe">Manna sāwla lǣce sceal geþencan, hū he mannum heora dǣda gescrīfe and hī þeāh-hwæðere ne fordēme</span>
							<span class="q-cite"> (L. de. Cf. 1; Th. ii. 260, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āhȳðan" d:title="āhȳðan">
		
		<body>
			<h1>āhȳðan<span class="pron"> | ɑː.xyː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To destroy, lay waste, despoil</span>
						<span class="meaning-la"> (Lat. vastare, abolere, subvertere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they would conquer the empire of the Romans, lay it waste with their armies</span>
							<span class="q-oe">Hī woldon Rōmwara rīce geþringan, hergum ahȳðan</span>
							<span class="q-cite"> (Elen. Kmbl. 81; El. 41)</span>
						</li>
						<li>
							<span class="q-en">hunger despoileth it</span>
							<span class="q-oe">Hungor he ahȳðeþ [MS. A. ahiēðeþ]</span>
							<span class="q-cite"> (Salm. Kmbl. 147; Sal. 73)</span>
						</li>
						<li>
							<span class="q-oe">Ahīðan</span>
							<span class="q-cite"> (Exon. 87a; Th. 328, 9; Vy. 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hȳðan" class="xref-target">hȳðan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="beācen-stān" d:title="beācen-stān">
		<body>
			<h1>beācen-stān<span class="pron"> | bæ͜ɑː.Ken.stɑːn |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A stone whereon the beacon fire was made, a stone or tower whereon to set the beacon fire</span>
						<span class="meaning-la"> (Lat. specula, pharus)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heoru-scearp" d:title="heoru-scearp">
		<body>
			<h1>heoru-scearp<span class="pron"> | xe͜o.ru.ʃæ͜ɑrp |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Terribly sharp</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dys-līce" d:title="dys-līce">
		<body>
			<h1>dys-līce<span class="pron"> | dys.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Foolishly</span>
						<span class="meaning-la"> (Lat. stulte)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he tempteth God very foolishly</span>
							<span class="q-oe">Se Godes cunnaþ ful dyslīce</span>
							<span class="q-cite"> (Salm. Kmbl. 455; Sal. 228)</span>
						</li>
						<li>
							<span class="q-la">stulte opĕrātus es</span>
							<span class="q-oe">Dyslīce ðū dydest</span>
							<span class="q-cite"> (Gen. 31, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="GE-TRAHTNIAN" d:title="GE-TRAHTNIAN">
		<body>
			<h1>GE-TRAHTNIAN<span class="pron"> | je.trɑxt.ni.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:GE-TRĪWE" class="xref-target">GE-TRĪWE</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="winter-dūn" d:title="winter-dūn">
		<body>
			<h1>winter-dūn<span class="pron"> | win.ter.duːn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A down or hill on which there is pasturage for sheep during the winter(?)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On manegum landum tilð bið redre ðonne on ōðrum, ge yrðe tīma hrædra, ge mǣda rædran, ge winterdūn (the sheep can be sent on to the hills earlier(?), cf. Sunt pascua ouium in meōsdūne pertinentia ad Tangmere, Cod. Dip. Kmbl. iii. 373, 23) eāc swā</span>
							<span class="q-cite"> (Anglia ix. 259, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-scyrian" d:title="be-scyrian">
		<body>
			<h1>be-scyrian<span class="pron"> | be.ʃy.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to deprive, separate, defraud</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-scerian" class="xref-target">be-scerian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāþ-mōdnes" d:title="eāþ-mōdnes">
		<body>
			<h1>eāþ-mōdnes<span class="pron"> | æ͜ɑːθ.moːd.nes |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">humility, meekness</span>
						<span class="meaning-la"> (Lat. humilitas)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">humilitas</span>
							<span class="q-oe">Eādmōdnys humilitas</span>
							<span class="q-cite"> (Wrt. Voc. i. 76, 28)</span>
						</li>
						<li>
							<span class="q-oe">Þæt wæs ānrǣdlicu eāþmōdnes ꝥ heō sylf hiē þeōwen nemde</span>
							<span class="q-cite"> (Bl. H. 13, 13)</span>
						</li>
						<li>
							<span class="q-la">humilitas</span>
							<span class="q-oe">Ēðmōdnisse humilitas</span>
							<span class="q-cite"> (Rtl. 100, 11)</span>
						</li>
						<li>
							<span class="q-oe">Be ðām twelf stæpum ealre eāðmōdnesse</span>
							<span class="q-cite"> (R. Ben. 23, 16)</span>
						</li>
						<li>
							<span class="q-oe">Eallon þām tō hǣlde þe his hālgan līchoman mid ealre eādmōdnysse sēceað</span>
							<span class="q-cite"> (Chr. 1023; P. 156, 26)</span>
						</li>
						<li>
							<span class="q-oe">Hē geseah his þīnene eādmōdnesse (ēðmōdnisse, R.)</span>
							<span class="q-cite"> (Lk. 1, 48)</span>
						</li>
						<li>
							<span class="q-la">humilitatem</span>
							<span class="q-oe">Ēdmōdnise humilitatem</span>
							<span class="q-cite"> (p. 8, 10)</span>
						</li>
						<li>
							<span class="q-oe">Hiē him ongeān cōmon and his mid eāþmōdnessum anfēngon</span>
							<span class="q-cite"> (Ors. 3, 9; S. 126, 14)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">gentleness, graciousness, kindness</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Secggan wē Gode þanc ealra his miltsa and his eāðmōdnessa and his geofena</span>
							<span class="q-cite"> (Bl. H. 103, 26)</span>
						</li>
						<li>
							<span class="q-oe">Ealra his eāðmōdnessa and fremsumnessa</span>
							<span class="q-cite"> (115, 23)</span>
						</li>
						<li>
							<span class="q-oe">Be þǣm eādmōdnessum and mildheortnessum</span>
							<span class="q-cite"> (103, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-þrysmian" d:title="for-þrysmian">
		<body>
			<h1>for-þrysmian<span class="pron"> | for.θry.smi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To suffocate, choke, strangle</span>
						<span class="meaning-la"> (Lat. suffōcāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sollicitudo sæculi istīus, et fallācia dīvitiārum suffocat verbum</span>
							<span class="q-oe">Eornfullness ðisse worulde, and leāsung ðissa woruldwēlena forþiysmiaþ ðæt wurd</span>
							<span class="q-cite"> (Mt. Bos. 13, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-cund" d:title="-cund">
		<body>
			<h1>-cund<span class="pron"> | kund |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:eorl-cund" class="xref-target">eorl-cund</a>, <a href="x-dictionary:r:esne-cund" class="xref-target">esne-cund</a>, <a href="x-dictionary:r:meter-cund" class="xref-target">meter-cund</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="syle" d:title="syle">
		<body>
			<h1>syle<span class="pron"> | sy.le |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:sylu" class="xref-target">sylu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ealdor-bisceop" d:title="ealdor-bisceop">
		<body>
			<h1>ealdor-bisceop<span class="pron"> | æ͜ɑl.dor.bi.ʃe͜op |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a chief priest, high priest of the Jews</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">dixit princeps sacerdotum (Acts, 7, 1)</span>
							<span class="q-oe">Cwæð se ealdorbiscop</span>
							<span class="q-cite"> (Hml. Th. i. 46, 6: ii. 422, 20)</span>
						</li>
						<li>
							<span class="q-oe">Ðā gȳtsigendan ealdorbiscopas</span>
							<span class="q-cite"> (i. 406, 5)</span>
						</li>
						<li>
							<span class="q-oe">Þām weardmannum þe wǣron āsænde fram þām ealdorbisceopum tō Crīstes byrgenne</span>
							<span class="q-cite"> (Hml. A. 78, 153)</span>
						</li>
						<li>
							<span class="q-la">congregans omnes principes sacerdotum (Mt. 2, 4)</span>
							<span class="q-oe">Hē gesamnode ealle þā ealdorbiscopas</span>
							<span class="q-cite"> (Hml. Th. i. 78, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nā-þing" d:title="nā-þing">
		<body>
			<h1>nā-þing<span class="pron"> | nɑː.θing |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">nothing</span>
						<span class="meaning-la"> (Lat. nihil)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nāþing nihil</span>
							<span class="q-cite"> (Germ. 395, 31)</span>
						</li>
						<li>
							<span class="q-oe">Ne gefrēdde hē nāþinc þæs brynes</span>
							<span class="q-cite"> (Hml. A. 196, 48)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="land-sōcn" d:title="land-sōcn">
		<body>
			<h1>land-sōcn<span class="pron"> | lɑnd.soːkn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Search for land or country</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">to separate in search of land [of the dispersion at the tower of Babel]</span>
							<span class="q-oe">Tōfaran on landsōcne</span>
							<span class="q-cite"> (Cd. 80; Th. 100, 17; Gen. 1665: 81; Th. 102, 12; Gen. 1699)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="regn-snegel" d:title="regn-snegel">
		<body>
			<h1>regn-snegel<span class="pron"> | reɣn.sne.Gel |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a snail</span>
						<span class="meaning-la"> (Lat. limax)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">limax</span>
							<span class="q-oe">Rēnsnægl</span>
							<span class="q-cite"> (An. Ox. 23, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lytel" d:title="lytel">
		
		<body>
			<h1>lytel<span class="pron"> | ly.tel |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">A.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">as the opposite of great</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">of material objects, portions of space, &amp;c., small in size, not large</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ne bið nǣnig tō þæs lytel lið on lime āweaxen</span>
											<span class="q-cite"> (Seel. 96)</span>
										</li>
										<li>
											<span class="q-oe">Swilce ān lytel (lytlu, v. l.) pricu</span>
											<span class="q-cite"> (Bt. 18, 1 ; F. 62, 4)</span>
										</li>
										<li>
											<span class="q-oe">Lyttel scipp naviculam</span>
											<span class="q-cite"> (Mt. L. 13, 2)</span>
										</li>
										<li>
											<span class="q-oe">Sē ðe lytelo bȳ (domicilium) hæfde in byrgennum</span>
											<span class="q-cite"> (Mk. L. 5, 3)</span>
										</li>
										<li>
											<span class="q-oe">lytle bollan fulle</span>
											<span class="q-cite"> (Lch. ii. 214, 11)</span>
										</li>
										<li>
											<span class="q-oe">Hē wæs lytel (lyttel pussillus, L.) on wæstmum</span>
											<span class="q-cite"> (Lk. 19, 3)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(1 a)</span>
												<span class="meaning-en">used to designate species or varieties which are distinguished by their smallness from others belonging to the same genus or bearing the same name</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Brūne wyrt, hāre wyrt lytelu</span>
													<span class="q-cite"> (Lch, ii. 132, 8)</span>
												</li>
											</ul>
										</li>
										<li>
											<p>
												<span class="sense-label">(1 b)</span>
												<span class="meaning-en">with superlative force in little finger, toe</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Gif se lytla bið of āslegen</span>
													<span class="q-cite"> (Ll. Th. i. 96, 7)</span>
												</li>
												<li>
													<span class="q-oe">Siō lytle tā</span>
													<span class="q-cite"> (23)</span>
												</li>
												<li>
													<span class="q-oe">On ðǣm lytlan . . . ānum fingre (cf. on ðām lǣstan fingre, Bt. 33, 4; F. 132, 1)</span>
													<span class="q-cite"> (Met. 20, 179)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">used of young children</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Lytel cnæht ðes parvolus iste</span>
											<span class="q-cite"> (Mt. L. 18, 4)</span>
										</li>
										<li>
											<span class="q-oe">Syle þicgean on wine geongum men fif cuceleras fulle, and gingrum and untrumum and wīfum þrȳ cuculeras, litlum cildum ānne</span>
											<span class="q-cite"> (Lch. i. 122, 24)</span>
										</li>
										<li>
											<span class="q-oe">Lytlo cild parvulos</span>
											<span class="q-cite"> (Mk. 10, 13)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(3)</span>
										<span class="meaning-en">of collective unities, having few members, inhabitants, &amp;c. ; small in number</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hēr is an lytele (parva) burg swīðe neāh . . . Hiō is ān lytel (modica)</span>
											<span class="q-cite"> (Past. 399, 23)</span>
										</li>
										<li>
											<span class="q-oe">Is hiora here . . . tō lytel swelcra lāriōwa</span>
											<span class="q-cite"> (Met. 10, 55)</span>
										</li>
										<li>
											<span class="q-oe">Lytlo ēdo pusillo gregi</span>
											<span class="q-cite"> (Lk. p. 7, 15)</span>
										</li>
										<li>
											<span class="q-oe">Lytle werede</span>
											<span class="q-cite"> (Gen. 2093)</span>
										</li>
										<li>
											<span class="q-oe">Ic wāt hēr āne neāh lytle ceastre</span>
											<span class="q-cite"> (2578)</span>
										</li>
										<li>
											<span class="q-oe">Lytle worado pauci</span>
											<span class="q-cite"> (Lk. L. 13, 23)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(4)</span>
										<span class="meaning-en">of immaterial things, considered in respect of their quantity, length in series, &amp;c.</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Gē eōw ondrǣdaþ ꝥ gē onfōn tō lytlum leānum</span>
											<span class="q-cite"> (Bl. H. 41, 21)</span>
										</li>
										<li>
											<span class="q-oe">Lytlum sticcum leōðworda dǣl reccan</span>
											<span class="q-cite"> (An. 1490)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(5)</span>
										<span class="meaning-en">of distance or period of time. Cf. B. II. 3</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ðā geswigode se wīsdōm āne lytle hwīle</span>
											<span class="q-cite"> (Bt. 7, 1 ; F. 16, 5)</span>
										</li>
										<li>
											<span class="q-oe">Lytle hwīle</span>
											<span class="q-cite"> (B. 2030)</span>
										</li>
										<li>
											<span class="q-oe">Þone lytlan fyrst</span>
											<span class="q-cite"> (Cri. 1323)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(6)</span>
										<span class="meaning-en">of qualities, conditions, &amp;c. , small in extent or degree</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Mē þūhte þæt sār swīðe lytel oððe ealles nāwiht</span>
											<span class="q-cite"> (Solil. H. 41, 4)</span>
										</li>
										<li>
											<span class="q-oe">Mē ne þincþ nāuht lytel gōd þisses andweardan līfes gesǣlþa, ne eāc nāuht lytel yfel his ungesǣlþa in hac ipsa fortuna populari nonnihil boni malive inesse perpendo</span>
											<span class="q-cite"> (Bt. 39, 2 ; F. 212, 14)</span>
										</li>
										<li>
											<span class="q-oe">Nales fore lytlum . . . ac fore þām mǣstan mægenearfeðum</span>
											<span class="q-cite"> (Cri. 963)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(7)</span>
										<span class="meaning-en">not of importance</span>
									</p>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(a)</span>
												<span class="meaning-en">of things, trifling, trivial</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Þonne ongit hē hū lytel se hlīsa bið and hū lǣne and hū tēdre and hū bedǣled ǣlces gōdes fama quam sit exilis et totius vacua ponderis</span>
													<span class="q-cite"> (Bt. 18, 1; F. 60, 29)</span>
												</li>
												<li>
													<span class="q-oe">Hē biþ for swīþe lytlium þingum gedrēfed</span>
													<span class="q-cite"> (1. 11; F. 32, 18)</span>
												</li>
												<li>
													<span class="q-oe">Ēnne of bebodum ðissum lytlum (minimus)</span>
													<span class="q-cite"> (Mt. L. 5, 19)</span>
												</li>
												<li>
													<span class="q-oe">For ðām ðe þū wǣre getrȳwe ofer lytle þing, ic gesette þē ofer mycle</span>
													<span class="q-cite"> (Mt. 25, 21)</span>
												</li>
											</ul>
										</li>
										<li>
											<p>
												<span class="sense-label">(b)</span>
												<span class="meaning-en">of persons, inferior in rank or condition, not distinguished</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Lytel hē bið genemned in rīc heafna . . . ðes micil bið geceigd</span>
													<span class="q-cite"> (Mt. L. 5, 19)</span>
												</li>
												<li>
													<span class="q-oe">Lytel þāhte ic leōda bearnum, læg on heardum stāne</span>
													<span class="q-cite"> (Cri. 1425)</span>
												</li>
												<li>
													<span class="q-oe">Swā hwylc swā sylð ānne drinc ānum þyssa lytylra manna</span>
													<span class="q-cite"> (Mt. 10, 42)</span>
												</li>
												<li>
													<span class="q-oe">Ānum of ðisum brōðrum mīnum lytlum</span>
													<span class="q-cite"> (Mt. L. 25, 40)</span>
												</li>
											</ul>
											<ol class="sub-senses labeled">
												<li>
													<p>
														<span class="sense-label">(b a)</span>
														<span class="meaning-en">of a town</span>
													</p>
													<ul class="quotes">
														<li>
															<span class="q-oe">Ðū, Bethlem, unðærfe ðing lyttel arð (nequa—quam minima es)</span>
															<span class="q-cite"> (Mt. L. 2, 6)</span>
														</li>
													</ul>
												</li>
											</ol>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(8)</span>
										<span class="meaning-en">mean, vile</span>
									</p>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(a)</span>
												<span class="meaning-en">of things</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Tō þām þæt ðū hwylce þēnunga mīnon lytlan līchaman tō gehȳðnysse gegearwige</span>
													<span class="q-cite"> (Hml. S. 23 b, 252)</span>
												</li>
											</ul>
										</li>
										<li>
											<p>
												<span class="sense-label">(b)</span>
												<span class="meaning-en">of persons</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Ic eom se lytla for þē and se lȳðra man, se hēr syngigeswīðe genehhe. . . þearle scyldig</span>
													<span class="q-cite"> (Hy. 3, 41)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">as opposite of much</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">not much, only a slight amount or degree of, barely any</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Sceāwige mon georne hwilc se ūtgang siē, þe micel. þe lytel, þe þǣr nān ne siē</span>
											<span class="q-cite"> (Lch. ii. 218, 11)</span>
										</li>
										<li>
											<span class="q-oe">Hwæt is heora nū tō lāfe būtan se lytla hlīsa and se nama mid feāum stafum āwriten signat superstes fama tenuis pauculis inane women litteris</span>
											<span class="q-cite"> (Bt. 19; F. 70, 10)</span>
										</li>
										<li>
											<span class="q-oe">Gȳt lǣssan mynstres þǣr lytel þeōwdōm sȳ</span>
											<span class="q-cite"> (Ll. Th. i. 360, 22)</span>
										</li>
										<li>
											<span class="q-oe">Byþ lytel frēcne fram fȳre</span>
											<span class="q-cite"> (Lch. i. 330, 2)</span>
										</li>
										<li>
											<span class="q-oe">Tō lytel hit biþ, beō hit ā lǣsse</span>
											<span class="q-cite"> (Ll. Th. i. 432, 24 : B. 1748)</span>
										</li>
										<li>
											<span class="q-oe">Lytles geleāfas</span>
											<span class="q-cite"> (Mt. L. 6, 30 : 14, 31)</span>
										</li>
										<li>
											<span class="q-oe">Wē habbaþ litellne gearowitan būton tweōn</span>
											<span class="q-cite"> (Bt. 41, 5 ; F. 254, 10)</span>
										</li>
										<li>
											<span class="q-oe">Ic him līfwraðe lytle meahte ætgifan</span>
											<span class="q-cite"> (B. 2877)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(1 a)</span>
												<span class="meaning-en">forming with its sb. a kind of privative combination, with the sense absence or scarcity of what the sb. denotes</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Gemune hwæt sī mīn lytle spēd memorare quae mea substantia</span>
													<span class="q-cite"> (Ps. Th. 83, 40)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">a small quantity of, some, though not much</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Nū gȳt ys lytel (lyttil, L. , lyttel, R. ) leōht on eōw athuc modicum lumen in uobis est</span>
											<span class="q-cite"> (Jn. 12, 35)</span>
										</li>
										<li>
											<span class="q-oe">lytle bollan fulle mid lytle hunige gemengde</span>
											<span class="q-cite"> (Lch. ii. 214, 11)</span>
										</li>
										<li>
											<span class="q-oe">Þǣr dydon Rōmāne lytla triēwþa þæt him þā wǣron unweorþe þe hiera hlāford beswican in hoc solo Romanis circa eum fortiter agentibus quod percussores ejus indignos judicarent</span>
											<span class="q-cite"> (Ors. 5, 2 ; S. 218, 17)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(3)</span>
										<span class="meaning-en">with pl., few</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Wræccum lytlum (feāwum, W. S. ) plagis paucis</span>
											<span class="q-cite"> (Lk. R. L. 12, 48)</span>
										</li>
										<li>
											<span class="q-oe">Hȳ sculan nyttian lytlum and</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fore-þingung" d:title="fore-þingung">
		<body>
			<h1>fore-þingung<span class="pron"> | fo.re.θin.gung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A pleading for anyone, intercession</span>
						<span class="meaning-la"> (Lat. intercessio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the Saviour commanded each to wash the other from foul sins by intercession</span>
							<span class="q-oe">Se Hǣlend hēt gehwilcne ōðerne aþweān fram fūlum synnum mid foreþingunge</span>
							<span class="q-cite"> (Homl. Th. ii. 242, 33)</span>
						</li>
						<li>
							<span class="q-en">per intercessionnes omnium sanctorum tuorum exaudi me</span>
							<span class="q-la">per intercessiōnes omnium sanctōrum tuōrum exaudi me</span>
							<span class="q-oe">Þurh foreþingunga ealra hāligra ðīnra gehȳr me</span>
							<span class="q-cite"> (Wanl. Catal. 294, 20, col. 2)</span>
						</li>
						<li>
							<span class="q-en">with good intercessions</span>
							<span class="q-oe">Mid gōdum foreþingungum</span>
							<span class="q-cite"> (Bd. 4, 3; S. 568, 21, note, MS. Ca.; Rtl. 49, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="getel-cræft" d:title="getel-cræft">
		<body>
			<h1>getel-cræft<span class="pron"> | Ge.tel.kræft |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Arithmetic</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-streccan" d:title="ā-streccan">
		<body>
			<h1>ā-streccan<span class="pron"> | ɑː.strek.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to stretch out, hold out</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hī āstræhton heora swuran tō slæge</span>
									<span class="q-cite"> (Hml. S. 28, 71)</span>
								</li>
								<li>
									<span class="q-la">columna lucis ad caelum usque porrecta, Bd. 3, 11</span>
									<span class="q-oe">Leōht ofer þ geteld āstreht stōd up tō heofonum</span>
									<span class="q-cite"> (Hml. S. 26, 183)</span>
								</li>
								<li>
									<span class="q-la">erectam cervicem</span>
									<span class="q-oe">Āstrehtne hneccan</span>
									<span class="q-cite"> (Scint. 83, 18)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="meaning-en">of time, to extend</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Seō fīfte yld stōd āstreht oð þæt Crīst sylf com</span>
									<span class="q-cite"> (Ælfc. T. Grn. 8, 31 : 19, 41)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to prostrate</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">of a person's posture, lit. or fig.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē hine āstreahte ofer leomu þæs deādan mannes</span>
									<span class="q-cite"> (Bl. H. 117, 27)</span>
								</li>
								<li>
									<span class="q-oe">Hē hine on gebed āstreahte</span>
									<span class="q-cite"> (219, 17)</span>
								</li>
								<li>
									<span class="q-la">debent jacere substrati</span>
									<span class="q-oe">Hiē sculon licgean āstreahte</span>
									<span class="q-cite"> (Past. 109, 23)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to lay low</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Crīst oferswīðde hine and āstrehte</span>
									<span class="q-cite"> (Hml. Th. i. 176, 29)</span>
								</li>
								<li>
									<span class="q-oe">Hē āstrehte middangeardes wuldor</span>
									<span class="q-cite"> (578, 33)</span>
								</li>
								<li>
									<span class="q-oe">Ær ðan þe se fǣrlica siege ūs āstrecce</span>
									<span class="q-cite"> (ii. 124, 21)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ē-sceapa" d:title="ē-sceapa">
		<body>
			<h1>ē-sceapa<span class="pron"> | eː.ʃæ͜ɑ.pɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:scip" class="xref-target">scip</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="an-æðelian" d:title="an-æðelian">
		<body>
			<h1>an-æðelian<span class="pron"> | ɑn.æ.θe.li.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To dishonour, degrade</span>
						<span class="meaning-la"> (Lat. ignobilem reddere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">and thence becomes degraded till he is unnoble</span>
							<span class="q-oe">And ðonan wyrþ anæðelad ōþ-ðæt he wyrþ unæðele</span>
							<span class="q-cite"> (Bt. 30, 2; Fox 110, 22: Bt. Met. Fox 17, 53; Met. 17, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-æðelian" class="xref-target">un-æðelian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-trumian" d:title="ge-trumian">
		<body>
			<h1>ge-trumian<span class="pron"> | je.tru.mi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">intrans.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">convalescas</span>
									<span class="q-oe">Þū getrumast</span>
									<span class="q-cite"> (Wrt. Voc. ii. 15, 75)</span>
								</li>
								<li>
									<span class="q-la">ueterno infirmitatis discusso</span>
									<span class="q-oe">Hē þǣre ealdan untrumnesse getrumad wæs</span>
									<span class="q-cite"> (Bd. 5, 5; Sch. 572, 10)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">reflex.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">convalui</span>
									<span class="q-oe">Þā getrumade ic mē and gestrangad wæs</span>
									<span class="q-cite"> (5, 6; Sch. 581, 11)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hæftnan" d:title="ge-hæftnan">
		
		<body>
			<h1>ge-hæftnan<span class="pron"> | je.xæft.nɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To take, lay hold of, take captive</span>
						<span class="meaning-la"> (Lat. comprehendĕre, captīvāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thou didst take me captive</span>
							<span class="q-oe">Ðū me gehæftnedest [gehæftnадest, Exon. 98 a; Th. 368; 29]</span>
							<span class="q-cite"> (Soul Kmbl. 63; Seel. 32)</span>
						</li>
						<li>
							<span class="q-la">persequātur inimīcus animam meam et comprehendat</span>
							<span class="q-oe">Sȳ ēhtende oððe ēhte feōnd mīne sāwle and gehæftnige hī oððe gegrīpe hī</span>
							<span class="q-cite"> (Ps. Lamb. 7, 6)</span>
						</li>
						<li>
							<span class="q-en">who before were held captive</span>
							<span class="q-oe">Ða ðe ǣr gehæftnede wǣron</span>
							<span class="q-cite"> (Blickl. Homl. 87, 7 : 89, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="elebeām-stybb" d:title="elebeām-stybb">
