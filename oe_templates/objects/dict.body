			<h1>hagalian<span class="pron"> | xɑ.ɣɑ.li.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">per septem dies grando lapidum terram verberavit</span>
						<span class="q-oe">Hit hagolade seofon niht ofer ealle Rōmāne</span>
						<span class="q-cite"> (Ors. 5, 10; Swt. 234, 6)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cifes-gemāna" d:title="cifes-gemāna">
		<body>
			<h1>cifes-gemāna<span class="pron"> | Ki.fes.Ge.mɑː.nɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fornication</span>
						<span class="meaning-la"> (Lat. concubinatus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">docemus, ut cessent concubinatus</span>
							<span class="q-oe">We lǣraþ, ðæt man geswīce cifesgemānan [MS. cifesgemanna]</span>
							<span class="q-cite"> (L. Edg. C. 21; Wilk. 84, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wæterbūc" d:title="wæterbūc">
		<body>
			<h1>wæterbūc<span class="pron"> | wæ.ter.buːk |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">Gedeon dedit in manibus eorum lagenas vacuas</span>
						<span class="q-oe">Gedeon hēt heora ǣlcne geniman ānne ǣmtigne sester oððe ǣnne wæterbūc</span>
						<span class="q-cite"> (Jud. 7, 16)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ferhþ-bana" d:title="ferhþ-bana">
