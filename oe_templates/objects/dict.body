<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Geangsumod" d:title="Geangsumod">
		<body>
			<h1>Geangsumod<span class="pron"> | Gæ͜ɑng.su.mod |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-oe">Geangsumod mid ðæra ormǣtan ontendnysse and hrȳmande ... 'Forgif mē ðam men ðe mīn mōd mē tō spenþ</span>
							<span class="q-cite"> (Homl. Skt. i. 3, 387: 3, 397)</span>
						</li>
						<li>
							<span class="q-oe">Ic on ðē ādwesce ealle ontendnysse</span>
							<span class="q-cite"> (4, 171)</span>
						</li>
					</ul>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="meaning-en">burning sensation, inflammation</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">He unscrȳdde hine ealne, and wylode hine sylfne on ðām þiccum bremlum and þornum and netelum ... and swā þurh ðære hȳde wunda ādwæscte his mōdes wunda; for ðan ðe hē āwende ðone unlust tō sārnysse, and þurh ða ȳttran ontendnysse ācwencte ða inran</span>
									<span class="q-cite"> (Homl. Th. ii. 156, 27-33)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-grymetian" d:title="ge-grymetian">
