<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fearrian" d:title="ge-fearrian">
		<body>
			<h1>ge-fearrian<span class="pron"> | je.fæ͜ɑr.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To remove to a distance, go away</span>
						<span class="meaning-la"> (Lat. avellere, discedere, abscedere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ipse avulsus est ab eis</span>
							<span class="q-oe">He gefearrad wæs from him</span>
							<span class="q-cite"> (Lk. Skt. Lind. 22, 41)</span>
						</li>
						<li>
							<span class="q-la">abscedat</span>
							<span class="q-oe">Gifearria</span>
							<span class="q-cite"> (Rtl. 98, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:feorran" class="xref-target">feorran</a>, <a href="x-dictionary:r:afyrran" class="xref-target">afyrran</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feald" d:title="feald">
