<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ceaster-hof" d:title="ceaster-hof">
		<body>
			<h1>ceaster-hof<span class="pron"> | Kæ͜ɑ.ster.xof |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A city-dwelling</span>
						<span class="meaning-la"> (Lat. urbis ædes)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">a storm arose along the city-dwellings</span>
							<span class="q-oe">Storm upp arās æfter ceasterhofum</span>
							<span class="q-cite"> (Andr. Kmbl. 2475; An. 1239)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hoh-fæst" d:title="hoh-fæst">
