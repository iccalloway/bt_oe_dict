						<span class="q-oe">Hæring sordino</span>
						<span class="q-cite"> (Wrt. Voc. i. 281, 64)</span>
					</li>
					<li>
						<span class="q-oe">Heringas sardinas</span>
						<span class="q-cite"> (Txts. 94, 910)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-scǣnedness" d:title="-scǣnedness">
