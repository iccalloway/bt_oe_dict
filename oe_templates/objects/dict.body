			<h1>un-gecnāwen<span class="pron"> | un.Ge.knɑː.wen |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unknown</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē fela þinga forðteāh ðe ðam folce ungecnāwe[n] wæs and ungewunelīc</span>
							<span class="q-cite"> (Ap. Th. 17, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eældian" d:title="eældian">
