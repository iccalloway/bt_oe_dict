<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heaðu-rōf" d:title="heaðu-rōf">
		<body>
			<h1>heaðu-rōf<span class="pron"> | xæ͜ɑ.θu.roːf |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Famed for excellence in battle</span>
