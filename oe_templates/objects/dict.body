					<p>
						<span class="meaning-en">Flax</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Eatol-ware" d:title="Eatol-ware">
