<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tigel-leāh" d:title="tigel-leāh">
		<body>
			<h1>tigel-leāh<span class="pron"> | ti.Gel.læ͜ɑːx |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A brick-field</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On tigelleāge</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. v. 267, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gebeāten" d:title="un-gebeāten">
		<body>
			<h1>un-gebeāten<span class="pron"> | un.Ge.bæ͜ɑː.ten |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unhewn (stone), not trimmed</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">lapide inpolito, non excise (i. non tunso lapide, Ld. Gl. G. iii. 29)</span>
							<span class="q-oe">Ungeb[e]itne stāne</span>
							<span class="q-cite"> (Txls. 113, 69)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nēd-" d:title="nēd-">
