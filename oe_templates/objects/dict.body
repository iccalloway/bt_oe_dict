<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efne" d:title="efne">
		<body>
			<h1>efne<span class="pron"> | e.fne |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I 3.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā land dǣlan him betweōnan swā hig efnost magon</span>
							<span class="q-cite"> (C.D. vi. 147, 19)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II 2.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">For hwon ... būton efne for þon ...</span>
							<span class="q-cite"> (Shrn. 133, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
