<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="friþ-gedāl" d:title="friþ-gedāl">
		<body>
			<h1>friþ-gedāl<span class="pron"> | friθ.Ge.dɑːl |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A life or spirit-separation, death</span>
						<span class="meaning-la"> (Lat. pāce divortium, ŏbĭtus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he should effect separation front life</span>
							<span class="q-oe">He friþgedāl fremman sceolde</span>
							<span class="q-cite"> (Cd. 56; Th. 69, 27; Gen. 1142)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ferþ vita" class="xref-target">ferþ vita</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-scyred" d:title="be-scyred">
