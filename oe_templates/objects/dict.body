			<ol>
				<li>
					<p>
						<span class="meaning-en">Desolation</span>
						<span class="meaning-la"> (Lat. desolatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">desolatio ejus</span>
							<span class="q-oe">Woestenisse hire</span>
							<span class="q-cite"> (Lk. Skt. Lind. 21, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-wēstness" class="xref-target">ā-wēstness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Ingwine" d:title="Ingwine">
