			<h1>ge-cirran<span class="pron"> | je.Kir.rɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:nīw-gecirred" class="xref-target">nīw-gecirred</a>, <a href="x-dictionary:r:un-gecirred" class="xref-target">un-gecirred</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="drēd" d:title="drēd">
		<body>
			<h1>drēd<span class="pron"> | dreːd |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">dreaded, feared; p. of drǣdan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:drǣdan" class="xref-target">drǣdan</a>
			</p>
