			<p class="xref">See also: <a href="x-dictionary:r:āwecgan" class="xref-target">āwecgan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wræcca" d:title="wræcca">
