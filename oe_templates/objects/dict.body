<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōr-weorþfullīc" d:title="fōr-weorþfullīc">
		<body>
			<h1>fōr-weorþfullīc<span class="pron"> | foːr.we͜orθ.ful.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Very worthy, very excellent</span>
						<span class="meaning-la"> (Lat. præclārus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">very excellent wealth</span>
							<span class="q-oe">Fōrweorþfullīc wēla</span>
							<span class="q-cite"> (Bt. 29, 1; Fox 102, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-wirpan" d:title="ā-wirpan">
		<body>
			<h1>ā-wirpan<span class="pron"> | ɑː.wir.pɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Wearð geðūht swilce heō āwyrpan mihte, ac heō gewāt of worulde</span>
						<span class="q-cite"> (Hml. S. 20, 65)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wen-spring" d:title="wen-spring">
		
		<body>
			<h1>wen-spring<span class="pron"> | wen.spring |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A mole</span>
						<span class="meaning-la"> (Lat. nevorum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wensprynga nevorum</span>
							<span class="q-cite"> (Wrt. Voc. ii. 59, 50)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þrum" d:title="þrum">
