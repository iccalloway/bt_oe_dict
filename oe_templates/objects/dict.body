<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mūga" d:title="mūga">
		<body>
			<h1>mūga<span class="pron"> | muː.ɣɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Mūgan aceruos (farris)</span>
						<span class="q-cite"> (An. Ox. 26, 45)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="clawu" d:title="clawu">
		<body>
			<h1>clawu<span class="pron"> | klɑ.wu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a claw</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">of a bird or beast</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Earnes clawa</span>
									<span class="q-cite"> (Hml. Th. ii. 434, 9)</span>
								</li>
								<li>
									<span class="q-la">pedibus nigris</span>
									<span class="q-oe">Him (birds) wǣron þā cleā blace</span>
									<span class="q-cite"> (Nar. 16, 16)</span>
								</li>
								<li>
									<span class="q-la">ungularum</span>
									<span class="q-oe">Clawa</span>
									<span class="q-cite"> (An. Ox. 8, 385)</span>
								</li>
								<li>
									<span class="q-oe">Seō culfre is unrēðe on hire clawum</span>
									<span class="q-cite"> (Hml. Th. ii. 44, 26)</span>
								</li>
								<li>
									<span class="q-oe">Þā fuglas þā fixas mid hiora clēum (cleam, Nar. 16, 20) tǣron</span>
									<span class="q-cite"> (Angl. iv. 153, 378)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">claw-like nail of a human being</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Mē cōman tō Sīlhearwan . . heora clawa wǣron scearpe</span>
									<span class="q-cite"> (Hml. S. 4, 289)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a hoof</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þā þe synd gehōfode on horses gelīcnysse untōclofenum clawum</span>
							<span class="q-cite"> (Hml. S. 25, 45)</span>
						</li>
						<li>
							<span class="q-oe">Eofores clawa oþþe ōþres swīnes gebærn tō ahsan</span>
							<span class="q-cite"> (Lch. ii. 88, 21)</span>
						</li>
						<li>
							<span class="q-la">ungulas</span>
							<span class="q-oe">Caelf forðlǣdende cleā</span>
							<span class="q-cite"> (Ps. Srt. 68, 33)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a hook</span>
						<span class="meaning-la"> (Lat. harpago)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">harpago</span>
							<span class="q-oe">Clauuo</span>
							<span class="q-cite"> (Wrt. Voc. ii. 100, 78)</span>
						</li>
						<li>
							<span class="q-oe">Clawu</span>
							<span class="q-cite"> (7, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hī man clifrode mid īsenum clawum</span>
							<span class="q-cite"> (Hml. S. 12, 187)</span>
						</li>
						<li>
							<span class="q-oe">Ic ofercōm þæs cwelleres tintregu, scearp īsen and þā slītendan clawa</span>
							<span class="q-cite"> (8, 189)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heorot-crop" d:title="heorot-crop">
		<body>
			<h1>heorot-crop<span class="pron"> | xe͜o.rot.krop |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Genim heorotcrop neobeweardne</span>
						<span class="q-cite"> (Lch. ii. 50. II.)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hilde-sæd" d:title="hilde-sæd">
		<body>
			<h1>hilde-sæd<span class="pron"> | xil.de.sæd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Wearied with battle</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swǣp" d:title="swǣp">
		<body>
			<h1>swǣp<span class="pron"> | swæːp |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">enticement, deceit</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">suadente diabolo</span>
							<span class="q-oe">Syþþan þonne ǣnig yfel geþōht þurh deōfles swǣp (suadente diabolo) on ūre heortan cume</span>
							<span class="q-cite"> (Chrd. 38, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-tweō" d:title="ge-tweō">
		<body>
			<h1>ge-tweō<span class="pron"> | je.twe͜oː |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">ꝥ ic wite būton getweōn ꝥ, ꝥ mē þincð ꝥ ic wite</span>
						<span class="q-cite"> (Solil. H. 21, 4)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āsceamian" d:title="āsceamian">
		<body>
			<h1>āsceamian<span class="pron"> | ɑː.ʃæ͜ɑ.mi.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:āscamian" class="xref-target">āscamian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mēþe" d:title="mēþe">
		<body>
			<h1>mēþe<span class="pron"> | meː.θe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:hyge-mēþe" class="xref-target">hyge-mēþe</a>, <a href="x-dictionary:r:sǣ-mēþe" class="xref-target">sǣ-mēþe</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ēðe-līce" d:title="ēðe-līce">
		
		<body>
			<h1>ēðe-līce<span class="pron"> | eː.θe.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Easily</span>
						<span class="meaning-la"> (Lat. faciliter)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thou bearest all things easily without labour</span>
							<span class="q-oe">Ðū eall þing birest ēðelīce būton geswince</span>
							<span class="q-cite"> (Bt. Met. Fox 20, 552; Met. 20, 276)</span>
						</li>
						<li>
							<span class="q-en">that thou mayest most easily come</span>
							<span class="q-oe">Ðæt ðū mǣge cumon ēðelīcost</span>
							<span class="q-cite"> (Bt. 41, 5; Fox 254, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eāðelīce" class="xref-target">eāðelīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="māðum-fæt" d:title="māðum-fæt">
		<body>
			<h1>māðum-fæt<span class="pron"> | mɑː.θum.fæt |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A costly vessel</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Māððumfæt mǣre</span>
							<span class="q-cite"> (Beo. Th. 4801; B. 2405)</span>
						</li>
						<li>
							<span class="q-oe">Ðā genam hē ða māðmfatu, gyldene and sylfrene, binnon Godes temple</span>
							<span class="q-cite"> (Homl. Th. ii. 432, 25)</span>
						</li>
						<li>
							<span class="q-oe">Ða mādmfatu ðæs temples ungerīme, gyldene and sylfrene, mid ōðrum goldhordum</span>
							<span class="q-cite"> (66, 7)</span>
						</li>
						<li>
							<span class="q-oe">Ðā Ælfrēd king forlēt his mādmes and mādmfaten</span>
							<span class="q-cite"> (Shrn, 16, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cæfian" d:title="cæfian">
		
		<body>
			<h1>cæfian<span class="pron"> | Kæ.fi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To embroider</span>
						<span class="meaning-la"> (Lat. acu pingere)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wuldorful-līce" d:title="wuldorful-līce">
		
		<body>
			<h1>wuldorful-līce<span class="pron"> | wul.dor.ful.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gloriously</span>
						<span class="meaning-la"> (Lat. gloriose)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On eallum ðām ðe wuldorfullīce (gloriose) fram him gewurdon</span>
							<span class="q-cite"> (Lk. Skt. 13, 17)</span>
						</li>
						<li>
							<span class="q-oe">Hī wurdon wuldorfullīce gemartyrode</span>
							<span class="q-cite"> (Homl. Th. i. 80, 29)</span>
						</li>
						<li>
							<span class="q-oe">Heō tō dæg wuldorfullīce of ðam līchaman gewāt</span>
							<span class="q-cite"> (440, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlȳd" d:title="hlȳd">
		<body>
			<h1>hlȳd<span class="pron"> | xlyːd |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Rumour, noise made in discussing an event</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the matter made such a great noise that Mordecai became known to the king</span>
							<span class="q-oe">Mardocheus wearð þurh þā micclan hlȳde cūð þām cyninge</span>
							<span class="q-cite"> (Hml. A. 95, 120)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hlyn" class="xref-target">hlyn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="of-stingan" d:title="of-stingan">
		<body>
			<h1>of-stingan<span class="pron"> | of.stin.gɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hiene mon geceās þȳ ilcan dæge þe mon Iulianus ofstong (cf. Cōm sum cempa . . . and hyne (Julian) [mid francan] þurhþȳddē, Hml. S. 3, 237)</span>
						<span class="q-cite"> (Ors. 6, 32 ; S. 286, 26)</span>
					</li>
					<li>
						<span class="q-oe">Hēt hē hȳ mid sweorde ofstingan</span>
						<span class="q-cite"> (Shrn. 143, 12)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sopa" d:title="sopa">
		<body>
			<h1>sopa<span class="pron"> | so.pɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sup, draught</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On wearmum wætre drince betonican tȳn sopan</span>
							<span class="q-cite"> (Lchdm. ii. 134, 22)</span>
						</li>
						<li>
							<span class="q-oe">Sūpe cū buteran .viii. morgnas .iii. sopan</span>
							<span class="q-cite"> (294, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sūpan" class="xref-target">sūpan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="druncen" d:title="druncen">
		<body>
			<h1>druncen<span class="pron"> | drun.Ken |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ne genihtsumað þē ꝥ þū sylf an ꝥ druncen beyrnst</span>
						<span class="q-cite"> (Chrd. 74, 30)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hnol" d:title="hnol">
		<body>
			<h1>hnol<span class="pron"> | xnol |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">In verticem ejus</span>
						<span class="q-oe">In verticem ejus</span>
						<span class="q-cite"> (Ps. Spl. 7, 17: 67, 23)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="handlinga" d:title="handlinga">
		<body>
			<h1>handlinga<span class="pron"> | xɑnd.lin.gɑ |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">With the hands</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it is not read of him that he killed any man with his own hands</span>
							<span class="q-oe">Nis be him gerǣd ðæt hē handling ǣnigne man ācwealde</span>
							<span class="q-cite"> (Homl. Th. i. 386, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
