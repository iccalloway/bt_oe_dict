<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rān" d:title="rān">
		<body>
			<h1>rān<span class="pron"> | rɑːn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
