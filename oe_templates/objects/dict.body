<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-warian" d:title="on-warian">
		<body>
			<h1>on-warian<span class="pron"> | on.wɑ.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to take heed, beware</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Is ūs tō behealdanne, þæt wē onwarigan þæt þǣra yfela and þǣra unrīhta ne sȳ tō feala</span>
							<span class="q-cite"> (Verc. Först. 105, 4)</span>
						</li>
						<li>
							<span class="q-oe">Is mycel þearf ǣghwylcum men tō onwariganne þæt hē þis symle hæbbe on gemyndum</span>
							<span class="q-cite"> (109, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="see" d:title="see">
