<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-þoftrǣden" d:title="ge-þoftrǣden">
		<body>
			<h1>ge-þoftrǣden<span class="pron"> | je.θof.træː.den |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Companionship, fellowship, converse</span>
						<span class="meaning-la"> (Lat. consortium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">God held converse with him</span>
							<span class="q-oe">God to him genam geþoftrǣdene</span>
							<span class="q-cite"> (Homl. Th. i. 90, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Tīw" d:title="Tīw">
		
		<body>
			<h1>Tīw<span class="pron"> | tiːw |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">the god Tiw, a Teutonic deity to whom amongst the Latin gods Mars most nearly corresponded</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Tiig Mars, Martis</span>
							<span class="q-cite"> (Txts. 77, 1293)</span>
						</li>
						<li>
							<span class="q-oe">Tīg</span>
							<span class="q-cite"> (Wrt. Voc. ii. 55, 56)</span>
						</li>
						<li>
							<span class="q-oe">Tuu (Tīw?)</span>
							<span class="q-cite"> (58, 40)</span>
						</li>
						<li>
							<span class="q-oe">Ðone Syxtum nēdde Decius se cāsere Tīges (Martis) deōfolgylde</span>
							<span class="q-cite"> (Shrn. 114, 9)</span>
						</li>
						<li>
							<span class="q-oe">On Tīwes-dæg tertia feria</span>
							<span class="q-cite"> (R. Ben. 38, 6; R. Ben. Interl. 49, 14: Wulfst. 180, 25)</span>
						</li>
						<li>
							<span class="q-oe">On Tīwes-niht</span>
							<span class="q-cite"> (Lchdm. iii. 146, 23)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">one form of the name of the Runic T</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:Tīr" class="xref-target">Tīr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="husc-līce" d:title="husc-līce">
		
		<body>
			<h1>husc-līce<span class="pron"> | xuʃ.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Sleānde mid handbredum huxlīce and gelōme</span>
						<span class="q-cite"> (Hml. Th. ii. 248, 13)</span>
					</li>
					<li>
						<span class="q-oe">Huxlīce gebundenne</span>
						<span class="q-cite"> (Hml. A. 107, 157)</span>
					</li>
					<li>
						<span class="q-oe">þa hors hī oftrǣdan huxlīce under fōtum</span>
						<span class="q-cite"> (Hml. S. 18, 347)</span>
					</li>
					<li>
						<span class="q-oe">Ne ǣnig man ne gewunie þæt hē huxlīce onhisce</span>
						<span class="q-cite"> (Wlfst. 70, 11)</span>
					</li>
					<li>
						<span class="q-oe">Tǣlende þone Hǣlend huxlīce mid wordum</span>
						<span class="q-cite"> (Hml. A. 60, 208 : Hml. S. 15, 83)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:huxlīce" class="xref-target">huxlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-el" d:title="-el">
		
		<body>
			<h1>-el<span class="pron"> | el |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a termination denoting persons</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">an outrider</span>
							<span class="q-oe">Fōrrīdel</span>
						</li>
						<li>
							<span class="q-en">a herald</span>
							<span class="q-oe">bȳdel</span>
						</li>
					</ul>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="meaning-en">It denotes also inanimate objects</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">a girdle</span>
									<span class="q-oe">Gyrdel</span>
								</li>
								<li>
									<span class="q-en">a steeple</span>
									<span class="q-oe">stȳpel</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="healseta" d:title="healseta">
		<body>
			<h1>healseta<span class="pron"> | xæ͜ɑl.se.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The opening in a tunic for the head to pass through, the neck of a tunic</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bēting" d:title="bēting">
		<body>
			<h1>bēting<span class="pron"> | beː.ting |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a cable</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bǣting" class="xref-target">bǣting</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rihtung" d:title="rihtung">
		<body>
			<h1>rihtung<span class="pron"> | rix.tung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">direction, guidance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Bisceope gebyreþ ǣlc rihting ... Hē sceall gehādode men gewissian, ðæt heora ǣlc wite hwæt him gebyrige tō dōnne</span>
							<span class="q-cite"> (L. I. P. 7; Th. ii. 312, 9)</span>
						</li>
						<li>
							<span class="q-la">virga directionis</span>
							<span class="q-oe">Gyrd rihtingce</span>
							<span class="q-cite"> (Ps. Spl. 44, 8)</span>
						</li>
						<li>
							<span class="q-oe">Him God hālige ǣ sette tō heora līfes rihtinge</span>
							<span class="q-cite"> (Homl. Th. i. 558, 21)</span>
						</li>
						<li>
							<span class="q-oe">Ðonne mann wīsdōm sprecþ manegum tō þearfe and tō rihtinge</span>
							<span class="q-cite"> (Ælfc. T. Grn. 21, 28)</span>
						</li>
						<li>
							<span class="q-la">directiones</span>
							<span class="q-oe">Rihtinga</span>
							<span class="q-cite"> (Ps. Lamb. 98, 4)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">correction, setting right</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">correctio</span>
							<span class="q-oe">Rihtingc</span>
							<span class="q-cite"> (96, 2)</span>
						</li>
						<li>
							<span class="q-oe">Bisceopes dægweorc . . . his gebedu ǣrest, and ðonne his bōcweorc, rǣding oððon rihting (correcting manuscripts?)</span>
							<span class="q-cite"> (L. I. P. 8; Th. ii. 314, 19)</span>
						</li>
						<li>
							<span class="q-en">on the condition that the charter be ready for them, if they need it for any correction</span>
							<span class="q-oe">On ða gerād ðæt seō bōc heam sȳ geara, gyf hȳ hyre beþurfan tō ǣnire rihtinge</span>
							<span class="q-cite"> (Chart. Th. 588, 17)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">correction, reproof</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ne correptionis studia privatus dolor exasperet</span>
							<span class="q-oe">For ðære geornfulnesse ðære ryhtinge ne sīe hē tō stīð tō ðære wrace</span>
							<span class="q-cite"> (Past. 13, 2; Swt. 79, 11)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">a direction, rule</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ne scylen hȳ beōn būtan regole, ðæt is līfes rihtinge</span>
							<span class="q-cite"> (R. Ben. 61, 14)</span>
						</li>
						<li>
							<span class="q-oe">Ðisne regul, ðæt is līfes rihtunge, wē āwriton tō dȳ ðæt wē hine on mynstre healden</span>
							<span class="q-cite"> (132, 14)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">a translation of the technical term regularis</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">De regularibus feriarum dicamus . . . Januarius and October habbaþ twā rihtinga, and Februarius and Martius and November gladiaþ on fīfum, and Aprilis and Julius habbaþ āne rihtinge, and Maius hæfþ þrȳ, and Agustus mid feōwrum glitnaþ, Junius āna hæfþ syx rihtinga, and September and December mid heora seofon gefērum gladiaþ</span>
							<span class="q-cite"> (Anglia viii. 302, 1-4)</span>
						</li>
						<li>
							<span class="q-oe">De regularibus lunae. Gyf ðū wille witan ðæra rihtinga gesceād ðe geþungene preōstas cweþaþ lunares</span>
							<span class="q-cite"> (305, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ūta-cund" d:title="ūta-cund">
		<body>
			<h1>ūta-cund<span class="pron"> | uː.tɑ.kund |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Foreign, alien, strange</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">alienigena</span>
							<span class="q-oe">Ūtacund cynn alienigena</span>
							<span class="q-cite"> (Lk. Skt. p. 9, 8)</span>
						</li>
						<li>
							<span class="q-oe">Ðes ūtacunda</span>
							<span class="q-cite"> (Lind. 17, 18)</span>
						</li>
						<li>
							<span class="q-la">in alieno</span>
							<span class="q-oe">On ūtacund in alieno</span>
							<span class="q-cite"> (16, 12)</span>
						</li>
						<li>
							<span class="q-la">alienum ... alienorum</span>
							<span class="q-oe">Ūtacund alienum ... ðara ūtacundra alienorum</span>
							<span class="q-cite"> (Jn. Skt. Lind. 10, 5)</span>
						</li>
						<li>
							<span class="q-la">ab alienis</span>
							<span class="q-oe">From ūtacundum ab alienis</span>
							<span class="q-cite"> (Mt, Kmbl. Lind. 17, 25: Rtl. 168, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:innan-cund" class="xref-target">innan-cund</a>, <a href="x-dictionary:r:inne-cund" class="xref-target">inne-cund</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mæg" d:title="mæg">
		<body>
			<h1>mæg<span class="pron"> | mæG |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">power, might, virtue</span>
						<span class="meaning-la"> (Lat. uirtus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">uirtus vere orationis est celsitudo caritatis</span>
							<span class="q-oe">Mæg (mægen ?) sōðes gebedes ys hȳhð sōðre lufe</span>
							<span class="q-cite"> (Scint. 4, 19)</span>
						</li>
						<li>
							<span class="q-oe">Micel ys mæg (uirtus) gif þū nā dera fram þām þe þū gederod ert</span>
							<span class="q-cite"> (12, 17)</span>
						</li>
						<li>
							<span class="q-oe">Hē Godes rīce . . . eallum mæge (mægene ?) fyrþrode</span>
							<span class="q-cite"> (Lch. iii. 438, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:maga" class="xref-target">maga</a>, <a href="x-dictionary:r:mægen-þrymnes" class="xref-target">mægen-þrymnes</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="earh" d:title="earh">
		<body>
			<h1>earh<span class="pron"> | æ͜ɑrx |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Swift, fleeing through fear, timorous, weak</span>
						<span class="meaning-la"> (Lat. fugax)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:earg" class="xref-target">earg</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rics" d:title="rics">
		<body>
			<h1>rics<span class="pron"> | riks |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:rysc" class="xref-target">rysc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="buterian" d:title="buterian">
		<body>
			<h1>buterian<span class="pron"> | bu.te.ri.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-buterod" class="xref-target">ge-buterod</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-unlybba" d:title="ge-unlybba">
		<body>
			<h1>ge-unlybba<span class="pron"> | je.un.lyb.bɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Poison [particularly when used in witchcraft]</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thou shalt not suffer a witch to live</span>
							<span class="q-oe">Ne lǣt ðū lybban ða ðe geunlybban wyrcon</span>
							<span class="q-cite"> (Ex. 22, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:unlybba" class="xref-target">unlybba</a>, <a href="x-dictionary:r:lyblāc" class="xref-target">lyblāc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geān-talu" d:title="geān-talu">
		<body>
			<h1>geān-talu<span class="pron"> | Gæ͜ɑːn.tɑ.lu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gain-saying, contradiction, dispute, objection</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gāþ þā oþræ v. hīda forð mid . . . mid eallum þingum swā hit þonnæ stænt būtan æ-lcon geāntalæ</span>
							<span class="q-cite"> (Cht. Th. 587, 24)</span>
						</li>
						<li>
							<span class="q-oe">Būten alken gēntale</span>
							<span class="q-cite"> (594, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="teosol" d:title="teosol">
		
		<body>
			<h1>teosol<span class="pron"> | te͜o.sol |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A small squared piece of stone, a die</span>
						<span class="meaning-la"> (Lat. tessera)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Tasul(-ol) tessera</span>
							<span class="q-cite"> (Txts. 101, 2000)</span>
						</li>
						<li>
							<span class="q-oe">Tæsium tesellum (tessellis in text, v. tæfl)</span>
							<span class="q-cite"> (Wrt. Voc. ii. 93, 44)</span>
						</li>
						<li>
							<span class="q-oe">Tæfles monnes, ðonne teoselum weorpeþ</span>
							<span class="q-cite"> (Exon. Th. 345, 9; Gn. Ex. 185)</span>
						</li>
						<li>
							<span class="q-oe">Tesulas tesseras</span>
							<span class="q-cite"> (Txts. 114, 84)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-tǣsan" d:title="ge-tǣsan">
		<body>
			<h1>ge-tǣsan<span class="pron"> | je.tæː.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">fig. - to touch, affect the mind</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">commotae mentes, dum et parci sibi sentiunt, et tamen responsorum rations in intimis tanguntur.</span>
							<span class="q-oe">Ðæt āhrērede mōd, ðonne hit ongiet ðæt him mon birgð mid ðǣre gesceādlican andsuare, hit bið getǣsed on ðæt ingeðonc</span>
							<span class="q-cite"> (Past. 297, 18.)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
