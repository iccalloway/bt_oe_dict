<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="oll" d:title="oll">
		<body>
			<h1>oll<span class="pron"> | oll |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">nequiquam, frustra</span>
						<span class="q-oe">On ol, īdel</span>
						<span class="q-cite"> (An. Ox. 2000)</span>
					</li>
					<li>
						<span class="q-en">(note to the preceding)</span>
						<span class="q-oe">On oll and on edwīt</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="clawan" d:title="clawan">
