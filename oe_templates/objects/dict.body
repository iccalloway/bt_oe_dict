<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="beorþ" d:title="beorþ">
		
		<body>
			<h1>beorþ<span class="pron"> | be͜orθ |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e, genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A BIRTH, the act of coming into life, the thing born</span>
