<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ābehōfian" d:title="ābehōfian">
		<body>
			<h1>ābehōfian<span class="pron"> | ɑː.be.xoː.fi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To behove, concern</span>
						<span class="meaning-la"> (Lat. decere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">with more animosity than it behoved him</span>
							<span class="q-oe">Mid māran unrǣde ðone him abehōfode</span>
							<span class="q-cite"> (Chr. 1093; Th. 360, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-hōfian" class="xref-target">be-hōfian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eges fullīc" d:title="eges fullīc">
		<body>
			<h1>eges fullīc<span class="pron"> | e.Ges, ful.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Full of fear, fearful, awful</span>
						<span class="meaning-la"> (Lat. terrĭbĭlis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Quam terrĭbĭlis est in consĭliis sŭper fĭlios homĭnum</span>
							<span class="q-oe">Hū eges-fullīc he is in geþeahtingum ofer monna bearn</span>
							<span class="q-cite"> (Bd. 4, 25; S. 601, 36)</span>
						</li>
						<li>
							<span class="q-oe">Egesfullīcran, nom. pl. more full of terror</span>
							<span class="q-cite"> (Salm. Kmbl. 93; Sal. 46)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bār" d:title="bār">
		
		<body>
			<h1>bār<span class="pron"> | bɑːr |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A BOAR</span>
						<span class="meaning-la"> (Lat. aper)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">king William forbade men to kill the stags, and also the boars</span>
							<span class="q-oe">Cyng Willelm forbeād sleān ða heortas swylce eāc ða bāras</span>
							<span class="q-cite"> (Chr. 1087; Ing. 296, 12)</span>
						</li>
						<li>
							<span class="q-la">capio cervos, et apros, et damas, et capreas, et aliquando lepores</span>
							<span class="q-oe">Ic gefeō heortas, and bāras, and rann, and rægan, and hwīlon haran</span>
							<span class="q-cite"> (Coll. Monast. Th. 21, 31: Ælfc. Gr. 8; Som. 7, 14: Ps. Lamb. 79, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Mid bāres tuxe</span>
						<span class="q-cite"> (Lch. i. 244, 8)</span>
					</li>
					<li>
						<span class="q-oe">Bǣres flǣsc etan</span>
						<span class="q-cite"> (iii. 144, 24: i. pp. 358-60)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cearm" d:title="cearm">
		<body>
			<h1>cearm<span class="pron"> | Kæ͜ɑrm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Clamour, noise</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se forhta cearm (cyrm, v. l.) and þǣra folca wōp</span>
							<span class="q-cite"> (Wlfst, 186, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cirm" class="xref-target">cirm</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wyrcness" d:title="wyrcness">
		<body>
			<h1>wyrcness<span class="pron"> | wyr.kness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">work, labour, operation</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Dōnde wircnisse (operationes) in wætrum miclum</span>
							<span class="q-cite"> (Ps. Surt. 106, 23)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">working, doing, operation</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðurh swā hwylces bēne swā hē gehǣled sī, ðysses geleāfa and wyrcnes (operatio) sī gelȳfed Gode andfenge</span>
							<span class="q-cite"> (Bd. 2, 2 ; S. 502, 23)</span>
						</li>
						<li>
							<span class="q-oe">His geearnunge oft ðurh godcunde wyrcnesse (operationem) mid miclum mægenum scīnaþ</span>
							<span class="q-cite"> (3, 19; S. 550, 16)</span>
						</li>
						<li>
							<span class="q-oe">Ða ðe lǣrdon ǣnne willan and āne wyrcnesse beōn on Drihtne Hǣlende</span>
							<span class="q-cite"> (5, 19; S. 639, 34)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">II a.</span>
								<span class="meaning-en">working, performance of something</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Wyrcnes heofonlīcra mægena operatio virtutum</span>
									<span class="q-cite"> (Bd. 1, 7 ; S. 479, 9)</span>
								</li>
								<li>
									<span class="q-oe">Mid wuudra wyrcnesse</span>
									<span class="q-cite"> (2, 3 ; S. 505, 1 : 3, 13; S. 538, 39)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣ-fest" d:title="ǣ-fest">
		<body>
			<h1>ǣ-fest<span class="pron"> | æː.fest |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fast or firm in the law, religious, devout</span>
						<span class="meaning-la"> (Lat. religiosus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">erat vir multum religiosus</span>
							<span class="q-oe">Wæs se mon swȳðe ǣfest</span>
							<span class="q-cite"> (Bd. 4, 24; S. 598, 20)</span>
						</li>
						<li>
							<span class="q-la">religiosa poemata facere tentabant</span>
							<span class="q-oe">Ongunnon ǣfeste leōþ wyrcean</span>
							<span class="q-cite"> (id; S. 596, 38)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ǣ-fæst" class="xref-target">ǣ-fæst</a>, <a href="x-dictionary:r:ǣw-fæst" class="xref-target">ǣw-fæst</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tīgere (?)" d:title="tīgere (?)">
		<body>
			<h1>tīgere (?)<span class="pron"> | tiː.Ge.re |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:bufan-tīgere" class="xref-target">bufan-tīgere</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hrǣctan" d:title="hrǣctan">
		<body>
			<h1>hrǣctan<span class="pron"> | xræːk.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To eructate, retch</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the stomach is extended and they eructate frequently</span>
							<span class="q-oe">Biþ siō wamb āþened and hrǣctaþ gelōme</span>
							<span class="q-cite"> (L. M. 2, 28; Lchdm. ii. 224, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="friþi[g]end" d:title="friþi[g]end">
		<body>
			<h1>friþi[g]end<span class="pron"> | fri.θi, g, end |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A protector</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">adjutor et protector noster est</span>
							<span class="q-oe">Hē ys ūre friðigend and ūre gescyldend</span>
							<span class="q-cite"> (Ps. Th. 32, 17)</span>
						</li>
						<li>
							<span class="q-la">adjutor meus et liberator meus esto</span>
							<span class="q-oe">Þū eart mīn friðiend and mīn gefultumend and mīn gescyldend</span>
							<span class="q-cite"> (39, 21)</span>
						</li>
						<li>
							<span class="q-oe">Uton lufian ūre cyrican, for ðām heō bið ūre friðiend and werigend wið þæt micele fȳr on dōmes dæg</span>
							<span class="q-cite"> (Wlfst. 239, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-friþi(g)end" class="xref-target">ge-friþi(g)end</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mēþ-ness" d:title="mēþ-ness">
		<body>
			<h1>mēþ-ness<span class="pron"> | meːθ.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Weariness, lassitude</span>
						<span class="meaning-la"> (Lat. lassitudine)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">lassitudine</span>
							<span class="q-oe">Mēðnisse</span>
							<span class="q-cite"> (Txts. 181, 55)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fætt" d:title="fætt">
		<body>
			<h1>fætt<span class="pron"> | fætt |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Covered with gold, gilt, golden, ornamented</span>
						<span class="meaning-la"> (Lat. bracteātus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">with precious treasures of rich gold</span>
							<span class="q-oe">Sincgestreōnum fættan goldes</span>
							<span class="q-cite"> (Beo. Th. 2190; B. 1093: 4484; B. 2246)</span>
						</li>
						<li>
							<span class="q-en">with rich gold</span>
							<span class="q-oe">Fættan golde</span>
							<span class="q-cite"> (4210; B. 2102)</span>
						</li>
						<li>
							<span class="q-en">whence bear ye your ornamented shields?</span>
							<span class="q-oe">Hwanon ferigeaþ gē fætte scyldas</span>
							<span class="q-cite"> (672; B. 333)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fæted" class="xref-target">fæted</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hylced" d:title="ge-hylced">
		<body>
			<h1>ge-hylced<span class="pron"> | je.xyl.Ked |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Divaricatus</span>
						<span class="meaning-la"> (Lat. Divaricatus)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cwēmednes" d:title="ge-cwēmednes">
		<body>
			<h1>ge-cwēmednes<span class="pron"> | je.kweː.med.nes |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">in beneplacitis eorum</span>
							<span class="q-oe">On gecwēmednessum heora</span>
							<span class="q-cite"> (Ps. L. 140, 5)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">¶</span>
								<span class="sub-heading">ánum tó gecwemednesse to the delight of a person, so as to please a person</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">cum saltasset et placuisset Herodi simulque recumbentibus</span>
									<span class="q-oe">Heō plegode him eallum tō gecwēmednysse</span>
									<span class="q-cite"> (Mk. 6, 22), Hml. Th. i. 480, 31)</span>
								</li>
								<li>
									<span class="q-oe">Sē ðe leahtras begǣð deōfle tō gecwēmednysse</span>
									<span class="q-cite"> (ii. 110, 27: S. 13, 271)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weler" d:title="weler">
		
		
		
		<body>
			<h1>weler<span class="pron"> | we.ler |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A lip</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">masculine or uncertain</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">labium</span>
									<span class="q-oe">Weler labium</span>
									<span class="q-cite"> (Wrt. Voc. i. 70, 48)</span>
								</li>
								<li>
									<span class="q-la">labrum</span>
									<span class="q-oe">Wæler labrum</span>
									<span class="q-cite"> (64, 53)</span>
								</li>
								<li>
									<span class="q-la">labium</span>
									<span class="q-oe">Welor labium</span>
									<span class="q-cite"> (282, 69: ii. 51, 67)</span>
								</li>
								<li>
									<span class="q-la">album</span>
									<span class="q-oe">Neoðera welor album</span>
									<span class="q-cite"> (7, 79)</span>
								</li>
								<li>
									<span class="q-la">labio</span>
									<span class="q-oe">Weolure labio</span>
									<span class="q-cite"> (Lchdm. i. lxx, 4)</span>
								</li>
								<li>
									<span class="q-la">labia</span>
									<span class="q-oe">Weleras labia</span>
									<span class="q-cite"> (Ps. Spl. 11, 2, 4: 65, 12: Ps. Th. 62, 5: 65, 12: Kent. Gl. 1002)</span>
								</li>
								<li>
									<span class="q-oe">Weleras (weloras, Cott. MSS.)</span>
									<span class="q-cite"> (Past. 15; Swt. 91, 17)</span>
								</li>
								<li>
									<span class="q-oe">Weleras (welras, v. l.)</span>
									<span class="q-cite"> (R. Ben. 2, 22)</span>
								</li>
								<li>
									<span class="q-oe">Weoloras</span>
									<span class="q-cite"> (Ps. Th. 30, 20)</span>
								</li>
								<li>
									<span class="q-la">labiorum</span>
									<span class="q-oe">Welera labiorum</span>
									<span class="q-cite"> (Ps. Spl. 20, 2)</span>
								</li>
								<li>
									<span class="q-la">labiis</span>
									<span class="q-oe">Welerum labiis</span>
									<span class="q-cite"> (62, 6: 119, 2: Mt. Kmbl. 15, 8: Mk. Skt. 7, 6: Homl. Th. ii. 450, 26)</span>
								</li>
								<li>
									<span class="q-la">labellis</span>
									<span class="q-oe">Welerum labellis</span>
									<span class="q-cite"> (Wrt. Voc. ii. 51, 68)</span>
								</li>
								<li>
									<span class="q-la">labiis</span>
									<span class="q-oe">Wælerum labiis</span>
									<span class="q-cite"> (Rtl. 174, 17)</span>
								</li>
								<li>
									<span class="q-oe">Walerum</span>
									<span class="q-cite"> (179, 11)</span>
								</li>
								<li>
									<span class="q-la">buccis, buccellis</span>
									<span class="q-oe">Welrum buccis, buccellis</span>
									<span class="q-cite"> (Wrt. Voc. ii. 126, 66)</span>
								</li>
								<li>
									<span class="q-la">labellis</span>
									<span class="q-oe">Welrum labellis</span>
									<span class="q-cite"> (Hpt. Gl. 507, 46)</span>
								</li>
								<li>
									<span class="q-la">labiis</span>
									<span class="q-oe">Weolorum labiis</span>
									<span class="q-cite"> (Ps. Th. 11, 2: 20, 2)</span>
								</li>
								<li>
									<span class="q-oe">Wiþ sārum weolorum, gesmire mid hunige ða weoloras</span>
									<span class="q-cite"> (Lchdm. ii. 54, 20)</span>
								</li>
								<li>
									<span class="q-la">labia</span>
									<span class="q-oe">Weleras labia</span>
									<span class="q-cite"> (Ps. Spl. 11, 3: Homl. Th. i. 568, 33: Exon. Th. 363, 15; Wal. 54)</span>
								</li>
								<li>
									<span class="q-oe">Weoloras</span>
									<span class="q-cite"> (Ps. Th. 11, 3)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">in Ps. Surt., and occasionally elsewhere, the word is feminine</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">lying lips</span>
									<span class="q-la">labium mentiens</span>
									<span class="q-oe">Wēgende welere lying lips</span>
									<span class="q-cite"> (Kent. Gl. 596)</span>
								</li>
								<li>
									<span class="q-la">labia</span>
									<span class="q-oe">Welure labia</span>
									<span class="q-cite"> (Ps. Surt. 11, 3)</span>
								</li>
								<li>
									<span class="q-oe">Weolure</span>
									<span class="q-cite"> (62, 6: 65, 14: 70, 23)</span>
								</li>
								<li>
									<span class="q-oe">Weolere</span>
									<span class="q-cite"> (30, 19: 62, 4)</span>
								</li>
								<li>
									<span class="q-oe">Weolre</span>
									<span class="q-cite"> (11, 5: 118, 171)</span>
								</li>
								<li>
									<span class="q-la">labiorum</span>
									<span class="q-oe">Weolera labiorum</span>
									<span class="q-cite"> (20, 3: 58, 13)</span>
								</li>
								<li>
									<span class="q-la">labiis</span>
									<span class="q-oe">Weolerum labiis</span>
									<span class="q-cite"> (58, 8: 118, 13: 119, 2: 139, 3)</span>
								</li>
								<li>
									<span class="q-la">labia</span>
									<span class="q-oe">Weolure labia</span>
									<span class="q-cite"> (11, 4)</span>
								</li>
								<li>
									<span class="q-la">labia mea non prohibebo</span>
									<span class="q-oe">Ic ne wirne mīne welora labia mea non prohibebo</span>
									<span class="q-cite"> (Past. 49; Swt. 380, 10)</span>
								</li>
								<li>
									<span class="q-oe">Gif mannes mūð sār siē, genim betonican . . . lege on ða weolore</span>
									<span class="q-cite"> (Lchdm. ii. 48, 29)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">nominative sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A lip</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cynnig" d:title="cynnig">
		<body>
			<h1>cynnig<span class="pron"> | Kyn.niG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Of good family, noble</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">generosis (natalibus)</span>
							<span class="q-oe">Of cynnigum</span>
							<span class="q-cite"> (An. Ox. 7, 299: 8, 230)</span>
						</li>
						<li>
							<span class="q-oe">Cynningum, æþelum</span>
							<span class="q-cite"> (4149)</span>
						</li>
						<li>
							<span class="q-oe">Cynnegum</span>
							<span class="q-cite"> (Angl. xiii. 36, 240)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gleāwlic" d:title="gleāwlic">
		<body>
			<h1>gleāwlic<span class="pron"> | glæ͜ɑː.wliK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-en">thus skilled in spiritual mysteries they told the victor (Constantine) as they were taught by Sylvester</span>
						<span class="q-oe">Þus gleāwlice (or adv.?) gāstgerȳnum sægdon sigerōfum, swā fram Siluestre līrde wǣron</span>
						<span class="q-cite"> (El. 189)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fliēman" d:title="ge-fliēman">
		<body>
			<h1>ge-fliēman<span class="pron"> | je.fli͜yː.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To cause to flee, to drive away</span>
						<span class="meaning-la"> (Lat. fugare)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-flȳman" class="xref-target">ge-flȳman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fant-wæter" d:title="fant-wæter">
		<body>
			<h1>fant-wæter<span class="pron"> | fɑnt.wæ.ter |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ær þan þe gē þæt hǣþene cild fullian on þām fantwætere, ofergeōt ðīnne līchaman mid fantwætere</span>
						<span class="q-cite"> (Hml. Th. ii. 346, 14, 24)</span>
					</li>
					<li>
						<span class="q-oe">Bedȳp on fontwætre gehālgodum</span>
						<span class="q-cite"> (Lch. ii. 344, 23)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ceāst" d:title="ceāst">
		<body>
			<h1>ceāst<span class="pron"> | Kæ͜ɑːst |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Strife, contention, murmuring, sedition, scandal</span>
						<span class="meaning-la"> (Lat. lis, rixa, seditio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">in strife</span>
							<span class="q-oe">On ceāste</span>
							<span class="q-cite"> (L. Alf. 18; Th. i. 48, note 34)</span>
						</li>
						<li>
							<span class="q-la">si in inutili rixa hominem occident, x annas jejunet</span>
							<span class="q-oe">Gif he þurh unnytte ceāste man ofsleā fæste x geār</span>
							<span class="q-cite"> (L. Ecg. P. iv. 68, § 22; Th. ii. 230, 29)</span>
						</li>
						<li>
							<span class="q-en">he shall not stir up strife</span>
							<span class="q-oe">Ne he ceaste ne astirige</span>
							<span class="q-cite"> (L. Ælf. P. 50; Th. ii. 386, 12)</span>
						</li>
						<li>
							<span class="q-la">seditio</span>
							<span class="q-oe">Folcslīte vel ǣswīcung, sacu, ceāst</span>
							<span class="q-cite"> (Ælfc. Gl. 15; Som. 58, 39; Wrt. Voc. 21, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Strife, contention, murmuring, sedition, scandal</span>
						<span class="meaning-la"> (Lat. lis, rixa, seditio)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ceās" class="xref-target">ceās</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣ-ceaster" d:title="sǣ-ceaster">
		<body>
			<h1>sǣ-ceaster<span class="pron"> | sæː.Kæ͜ɑ.ster |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:sǣ-burh" class="xref-target">sǣ-burh</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-þryccan" d:title="for-þryccan">
		<body>
			<h1>for-þryccan<span class="pron"> | for.θryk.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to injure or destroy by pressure</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">literal</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Mid þȳ fylle ðæs wāges forþryccende (opprimens) hē geþrǣste ǣnne þāra muneca</span>
											<span class="q-cite"> (Gr. D. 125, 6)</span>
										</li>
										<li>
											<span class="q-oe">Ic wille mē segnian, ac ic ne mæg, for ðon ðe ic eom forseted and forðrycced (premor) mid þām scyllum þisses dracan</span>
											<span class="q-cite"> (325, 5)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">to torture</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Beōð þā earman sāwla āhangene ofer þā hātestan līgeas, and þǣr þonne beōð forþriccende (-ede?) and gebundene</span>
											<span class="q-cite"> (Ll. Th. ii. 400, 22)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to close up an opening</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þā tōslitenan wunda heō forþrycceþ</span>
									<span class="q-cite"> (Lch. i. 356, 15)</span>
								</li>
								<li>
									<span class="q-oe">Mūð his forðrycca (-ðrycga, L., dyttan, W. S. opprimere)</span>
									<span class="q-cite"> (Lk. R. 11, 53)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-healfheāfod" d:title="ofer-healfheāfod">
		<body>
			<h1>ofer-healfheāfod<span class="pron"> | o.fer.xæ͜ɑlf.xæ͜ɑː.fod |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the upper half of the head</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">anciput ... occiput ... sinciput</span>
							<span class="q-oe">Forheāfod anciput, æfteweard heāfod occiput, oferhealfheāfod sinciput</span>
							<span class="q-cite"> (Wrt. Voc. i. 42, 42-44)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-wunden" d:title="be-wunden">
		<body>
			<h1>be-wunden<span class="pron"> | be.wun.den |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">wrapped, enwrapped</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-windan" class="xref-target">be-windan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hosp" d:title="hosp">
		<body>
			<h1>hosp<span class="pron"> | xosp |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Reproach, opprobrium, contempt, contumely, insult, blasphemy</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hosp opprobrium</span>
							<span class="q-cite"> (Ps. Spl. 14, 4: 21, 5)</span>
						</li>
						<li>
							<span class="q-la">quæ procedunt de labiis meis, non faciam irrita</span>
							<span class="q-oe">Ða ðe forþgewēteþ of welerum mīnum nā ic dō hosp</span>
							<span class="q-cite"> (88, 34)</span>
						</li>
						<li>
							<span class="q-la">respexit auferre opprobrium meum</span>
							<span class="q-oe">Hē geseah mīnne hosp āfyrran</span>
							<span class="q-cite"> (Lk. Skt. 1, 25)</span>
						</li>
						<li>
							<span class="q-en">this day have I rolled away the reproach of Egypt from off you</span>
							<span class="q-oe">Nū tō dæg ic ādyde ðæra Egiptiscra hosp fram eōwrum cynne</span>
							<span class="q-cite"> (Jos. 5, 9)</span>
						</li>
						<li>
							<span class="q-oe">Hǣðenra hosp</span>
							<span class="q-cite"> (Judth. 11; Thw. 24, 30; Jud. 215: Exon. 10 b; Th. 11, 16; Cri. 171: 29 a; Th. 88, 22; Cri. 1444)</span>
						</li>
						<li>
							<span class="q-en">they with contumely despised his teaching</span>
							<span class="q-oe">Hī mid hospe his lāre forsāwon</span>
							<span class="q-cite"> (Homl. Th. ii. 110, 5)</span>
						</li>
						<li>
							<span class="q-en">said contemptuously</span>
							<span class="q-oe">Cwæþ mid hospe</span>
							<span class="q-cite"> (Homl. Swt. 3, 216)</span>
						</li>
						<li>
							<span class="q-en">then cried out Julian blaspheming and miserably died</span>
							<span class="q-oe">Ðā hrȳmde Julianus mid hospe and earmlīce gewāt</span>
							<span class="q-cite"> (275)</span>
						</li>
						<li>
							<span class="q-en">whomsoever they wished to hold up to contempt, they said of him that he was a Samaritan</span>
							<span class="q-oe">Swā hwilcne swā hī tō hospe habban woldon hī cwǣdon be ðam ðæt hē wǣre Samaritanisc</span>
							<span class="q-cite"> (Homl. Th. ii. 228, 32)</span>
						</li>
						<li>
							<span class="q-en">then were they made a reproach</span>
							<span class="q-oe">Ðonne wurdon hī tō hospe gedōne</span>
							<span class="q-cite"> (Ælfc. T. 12; Grn. 6, 22)</span>
						</li>
						<li>
							<span class="q-en">the unrighteous hold in contempt those that are better skilled in right than themselves</span>
							<span class="q-oe">Unrihtwīse habbaþ on hospe ða ðe him sindon rihtes wīsran</span>
							<span class="q-cite"> (Bt. Met. Fox 4, 87; Met. 4, 44)</span>
						</li>
						<li>
							<span class="q-en">to reproach opprobriously</span>
							<span class="q-oe">Hospe gereccan</span>
							<span class="q-cite"> (Exon. 70 a; Th. 260, 21; Jul. 300: 90 a; Th. 337, 17; Gn. Ex. 66)</span>
						</li>
						<li>
							<span class="q-en">anybody would put up with all kinds of hardships and affronts on condition that he might be accounted the son of some great man</span>
							<span class="q-oe">Menigfealde earfoþnyssa and hospas wolde gehwā eāðelīce forberan wið ðan ðæt hē mōste sumum rīcan men tō bearne geteald beōn</span>
							<span class="q-cite"> (Homl. Th. i. 56, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rǣd-bana" d:title="rǣd-bana">
		<body>
			<h1>rǣd-bana<span class="pron"> | ræːd.bɑ.nɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">One who contrives a person's death, but is not the actual perpetrator</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if he be said to be the actual perpetrator of homicide, or the deviser of it</span>
							<span class="q-oe">Gif man secge ðæt hē wǣre dǣdbana oððe rǣdbana</span>
							<span class="q-cite"> (L. Eth. ix. 23; Th. i. 344, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bǣde-wēg" d:title="bǣde-wēg">
		
		<body>
			<h1>bǣde-wēg<span class="pron"> | bæː.de.weːG |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A cup</span>
						<span class="meaning-la"> (Lat. poculum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">she poured out the bitter cup</span>
							<span class="q-oe">Heō scencte bittor bǣde-wēg</span>
							<span class="q-cite"> (Exon. 47a; Th. 161, 13; Gū. 958)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
