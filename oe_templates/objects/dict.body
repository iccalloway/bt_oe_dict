			<h1>Gomorringas<span class="pron"> | go.mor.rin.gɑs |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The people of Gomorrha</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">terra Gomorræorum</span>
							<span class="q-oe">Eorþe gomorringa</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 10, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="deāþ-cwylmende" d:title="deāþ-cwylmende">
		
		<body>
			<h1>deāþ-cwylmende<span class="pron"> | dæ͜ɑːθ.kwyl.men.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Put to death, destroyed, killed</span>
						<span class="meaning-la"> (Lat. mortificātus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">possīde fīlios mortificatōrum</span>
							<span class="q-oe">Geāhna bearn adȳdra oððe deāþcwylmmendra</span>
							<span class="q-cite"> (Ps. Lamb. 78, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fern-lic" d:title="fern-lic">
