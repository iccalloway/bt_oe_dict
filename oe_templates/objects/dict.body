<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brim-stæþ" d:title="brim-stæþ">
		<body>
			<h1>brim-stæþ<span class="pron"> | brim.stæθ |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sea-shore</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Streāmwelm hwīleð, beātaþ brimstæþo</span>
							<span class="q-cite"> (An. 496)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-wyrd" d:title="un-wyrd">
		<body>
			<h1>un-wyrd<span class="pron"> | un.wyrd |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Bad fortune, misfortune</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gyf him þince ðæt hē leād habbe, sum unwird him byð tōweard</span>
							<span class="q-cite"> (Lchdm. iii. 170, 5)</span>
						</li>
						<li>
							<span class="q-la">ut jam me imparem fortunae ietibus non arbitrer</span>
							<span class="q-oe">Ðæt mē nū þyncþ ðætte ic ðās unwyrd āræfnan mæg ðe mē on becumen is</span>
							<span class="q-cite"> (Bt. 22, 1; Fox 76, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sæc-dōm" d:title="sæc-dōm">
