<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āfærþ" d:title="āfærþ">
		<body>
			<h1>āfærþ<span class="pron"> | ɑː.færθ |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">he shall lead out</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">āfærþ</span>
							<span class="q-cite"> (Ps. Spl. 51, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:afaran II" class="xref-target">afaran II</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hōd" d:title="hōd">
		<body>
			<h1>hōd<span class="pron"> | xoːd |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Hood</span>
						<span class="meaning-la"> (Lat. capitium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hood capitium</span>
							<span class="q-cite"> (Wrt. Voc. ii. 102, 65)</span>
						</li>
						<li>
							<span class="q-oe">Hōd</span>
							<span class="q-cite"> (128, 49: 13, 22)</span>
						</li>
						<li>
							<span class="q-oe">Ðonne þū cuglan habban wylle, þonne wege þū þīnne earmellan and fōh tō þīnum hōde</span>
							<span class="q-cite"> (Tech. ii. 127, 17)</span>
						</li>
						<li>
							<span class="q-oe">Nim þū þē be þīnum bode</span>
							<span class="q-cite"> (129, 4)</span>
						</li>
						<li>
							<span class="q-la">si evangelium legit, cucullum vel cappam super humeros dejiciat</span>
							<span class="q-oe">Gif hē godspel ræde lecge him þæne hōd ofer þā sculdra</span>
							<span class="q-cite"> (Ll. Th. ii. 140, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-siōn" d:title="be-siōn">
		<body>
			<h1>be-siōn<span class="pron"> | be.si͜oːn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to look about</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that he look not about him</span>
							<span class="q-oe">Ðæt he hine ne besiō</span>
							<span class="q-cite"> (Bt. 35, 6; Fox 170, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-seōn" class="xref-target">be-seōn</a>
