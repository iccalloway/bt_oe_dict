<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="borcian" d:title="borcian">
		<body>
			<h1>borcian<span class="pron"> | bor.Ki.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ade, sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To bark</span>
						<span class="meaning-la"> (Lat. latrare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it barked: thanked willingly</span>
							<span class="q-oe">Hiō borcade: þancode willum</span>
							<span class="q-cite"> (Exon. 129 a; Th. 495, 11; Rä. 84, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:beorcan" class="xref-target">beorcan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="full-wiht" d:title="full-wiht">
		<body>
			<h1>full-wiht<span class="pron"> | full.wixt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ðā hwīle ðe fulwiht stondan mōte</span>
						<span class="q-cite"> (Txts. 175, 17: 13)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrðyn" d:title="byrðyn">
		<body>
			<h1>byrðyn<span class="pron"> | byr.θyn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A burthen</span>
						<span class="meaning-la"> (Lat. onus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">meum onus est leve</span>
							<span class="q-oe">Mīn byrðyn ys leōht</span>
							<span class="q-cite"> (Mt. Bos. 11, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:byrðen" class="xref-target">byrðen</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geofon-flōd" d:title="geofon-flōd">
		<body>
			<h1>geofon-flōd<span class="pron"> | Ge͜o.fon.floːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sea or ocean flood</span>
						<span class="meaning-la"> (Lat. maris fluctus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">each ocean flood strictly observes the Lord's command</span>
							<span class="q-oe">Dryhtnes bibod geofonflōda gehwylc georne bihealdeþ</span>
							<span class="q-cite"> (Exon. 54 b; Th. 193, 21; Az. 125)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="and-lang" d:title="and-lang">
		
		<body>
			<h1>and-lang<span class="pron"> | ɑnd.lɑng |</span>
			</h1>
			<div>
				<p>
					<b>preposition (w. genitive)</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">On length, ALONG, by the side of</span>
						<span class="meaning-la"> (Lat. in longum, per)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he will let the blood run down along the altar</span>
							<span class="q-la">decurrere faciet sanguinem super crepidinem altaris</span>
							<span class="q-oe">Lǣte yrnan ðæt blōd nyðer andlang ðæs weofudes</span>
							<span class="q-cite"> (Lev. 1, 15)</span>
						</li>
						<li>
							<span class="q-en">along the desert</span>
							<span class="q-oe">Andlang ðæs [MS. ðas] wēstenes</span>
							<span class="q-cite"> (Jos. 8, 16)</span>
						</li>
						<li>
							<span class="q-en">along the nails</span>
							<span class="q-oe">Andlang ðara nægla</span>
							<span class="q-cite"> (Bd. 3, 17; S. 544, 30)</span>
						</li>
						<li>
							<span class="q-en">the water runs to the river, then along the river to the sea</span>
							<span class="q-oe">Ðæt wæter wyrþ to eā, ðonne andlang eā to sǣ</span>
							<span class="q-cite"> (Bt. 34, 6; Fox 140, 20)</span>
						</li>
						<li>
							<span class="q-en">along the Mase</span>
							<span class="q-oe">Andlang Mæse</span>
							<span class="q-cite"> (Chr. 882; Th. 150, 22, col. 2, 3)</span>
						</li>
						<li>
							<span class="q-en">along the dike</span>
							<span class="q-oe">Andlang dīces</span>
							<span class="q-cite"> (Cod. Dipl. Apndx. 442; A. D. 956; Kmbl. iii. 438, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hām-cūþ" d:title="hām-cūþ">
		<body>
			<h1>hām-cūþ<span class="pron"> | xɑːm.kuːθ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Familiar</span>
						<span class="meaning-la"> (Lat. familiaria loca)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">familiaria loca</span>
							<span class="q-oe">Ða hāmcūþa stōwa</span>
							<span class="q-cite"> (Mt. Kmbl. p. 11, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mynster-gang" d:title="mynster-gang">
		<body>
			<h1>mynster-gang<span class="pron"> | myn.ster.gɑng |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Going into a monastery, entering on a monastic life</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">tunc, si velit, licebit ei id derelinquere, et vitam monasticam sibi eligere</span>
							<span class="q-oe">Heō ðonne mōt gif heō wile ðæt forlǣtan and hyre mynstergang geceōsan</span>
							<span class="q-cite"> (L. Ecg. C. 20; Th. ii. 146, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣmestre" d:title="sǣmestre">
