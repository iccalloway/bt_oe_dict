<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ymb-wlātian" d:title="ymb-wlātian">
		<body>
			<h1>ymb-wlātian<span class="pron"> | ymb.wlɑː.ti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to contemplate, observe</span>
						<span class="meaning-la"> (Lat. contemplor)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">contemplor</span>
							<span class="q-oe">Ic ymbwlātige contemplor</span>
							<span class="q-cite"> (Ælfc. Gr. 25; Zup. 145, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wirgend" d:title="wirgend">
		<body>
			<h1>wirgend<span class="pron"> | wir.Gend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a curser</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wyrgendras, ðæra mūð bið symle mid wyrigunge āfylled</span>
							<span class="q-cite"> (Homl. Skt. i. 17, 42)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">an evil-doer, a malignant person</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">insurgentes in me malignantes audivit auris tua</span>
							<span class="q-oe">Mīne wergend gehȳrde ðīn āgen eāre</span>
							<span class="q-cite"> (Ps. Th. 91, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wær-scipe" d:title="wær-scipe">
		<body>
			<h1>wær-scipe<span class="pron"> | wær.ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Prudence, caution, circumspection, wisdom, in a bad sense, cunning, astuteness</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wærscipe cautela, i. astutia</span>
							<span class="q-cite"> (Wrt. Voc. ii. 129, 77)</span>
						</li>
						<li>
							<span class="q-la">ut simplicitatis bono prudentiam adjungant, quatenus sic securitatem de simplicitate possideant, ut circumspectionem prudentiae non amittant . . . Debet serpentis astutiam columbae simplicitas temperare, quatenus nec seducti per prudentiam calleant</span>
							<span class="q-oe">Ðæt hiē geīcen ða gōd hira ānfealdnesse mid wærscipe, and suā tilige ðære orsorgnesse mid ðære ānfealdnesse ðætte hē ðone ymbeðonc ðæs wærscipes ne forlǣte . . . Ðære culfran biliwitnesse sceal gemetgian ðære nædran wærscipe, ðȳ læs hine se wærscipe gelǣde on tō micle hātheortnesse</span>
							<span class="q-cite"> (Past. 35; Swt. 237, 15-24)</span>
						</li>
						<li>
							<span class="q-oe">Wīsdōm is se hēhsta cræft, and hæfþ on him feōwer ōþre cræftas; ðara is ān wærscipe</span>
							<span class="q-cite"> (Bt. 27, 2; Fox 96, 34: 34, 6; Fox 140, 35: Shrn. 175, 27)</span>
						</li>
						<li>
							<span class="q-oe">Ā gerīst bisceopum wīsdōm and wærscype</span>
							<span class="q-cite"> (L. I. P. 9; Th. ii. 314, 28)</span>
						</li>
						<li>
							<span class="q-oe">Se swicola hæfð ēce wīte, for ðan ðe his wærscype ne dohte</span>
							<span class="q-cite"> (Homl. Skt. i. 19, 177)</span>
						</li>
						<li>
							<span class="q-oe">Þūhte wīsast se ðe wæs swicolost . . . ac wā heom ðæs wærscipes</span>
							<span class="q-cite"> (Wulfst. 268, 19)</span>
						</li>
						<li>
							<span class="q-oe">Hȳ lǣtaþ ðæt tō wærscype, ðæt hȳ ōðre magan swicollīce pǣcan</span>
							<span class="q-cite"> (55, 2, 15)</span>
						</li>
						<li>
							<span class="q-la">cum magna cautela diligere</span>
							<span class="q-oe">Mid micelum wærscype lufian</span>
							<span class="q-cite"> (Anglia xiii. 374, 125)</span>
						</li>
						<li>
							<span class="q-la">consilio</span>
							<span class="q-oe">For wīsdōme and wærscipe</span>
							<span class="q-cite"> (Past. 20; Swt. 149, 16)</span>
						</li>
						<li>
							<span class="q-en">unadvisedly</span>
							<span class="q-oe">Būton wærscipe</span>
							<span class="q-cite"> (Homl. Skt. i. 11, 361)</span>
						</li>
						<li>
							<span class="q-la">circumspectiore cura ac magis instructo adparatu</span>
							<span class="q-oe">Mid māran fultume and mid māran wærscipe</span>
							<span class="q-cite"> (Ors. 3, 8; Swt. 120, 25)</span>
						</li>
						<li>
							<span class="q-oe">Hē hæfde Ȳrlande mid his werscipe gewunnon, and wiðūtan ǣlcon wǣpnon</span>
							<span class="q-cite"> (Chr. 1086; Erl. 222, 18)</span>
						</li>
						<li>
							<span class="q-la">prudentiam</span>
							<span class="q-oe">Ongiet mīnne wīsdōm and mīnne wærscipe</span>
							<span class="q-cite"> (Past. 38; Swt. 273, 9)</span>
						</li>
						<li>
							<span class="q-en">he had not the wisdom to observe true humility in his benefactions</span>
							<span class="q-oe">Ðes sunder-hālga hæfde opene eāgan tō ælmesdǣdum, ac hē næfde nǣnne wærscipe ðæt hē ða sōðan eādmōdnysse on his weldǣdum geheōlde</span>
							<span class="q-cite"> (Homl. Th. ii. 432, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-wær-scipe" class="xref-target">un-wær-scipe</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="līcettere" d:title="līcettere">
		
		<body>
			<h1>līcettere<span class="pron"> | liː.Ket.te.re |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">simulator</span>
						<span class="q-oe">Lēcetere</span>
						<span class="q-cite"> (Kent. Gl. 353)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="BESMA" d:title="BESMA">
		
		<body>
			<h1>BESMA<span class="pron"> | be.smɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A BESOM, broom, an instrument of punishment made of twigs, a rod</span>
						<span class="meaning-la"> (Lat. scopæ, virga)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">scopis mundatam</span>
							<span class="q-oe">Geclǣnsod mid besmum</span>
							<span class="q-cite"> (Mt. Bos. 12, 44)</span>
						</li>
						<li>
							<span class="q-la">invenit eam [domum] scopis mundatam</span>
							<span class="q-oe">He hit [hūs] gemēt mid besmum afeormod</span>
							<span class="q-cite"> (Lk. Bos. 11, 25)</span>
						</li>
						<li>
							<span class="q-en">he [Brutus] gave orders to bind them [his five sons], and scourge them with rods [virgis cecidit, Hay.]</span>
							<span class="q-oe">He [Brutus] hȳ [his fīf suna] hēt gebindan, and mid besman swingan</span>
							<span class="q-cite"> (Ors. 2, 3; Bos. 42, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fylling" d:title="fylling">
		<body>
			<h1>fylling<span class="pron"> | fyl.ling |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">filling of a vessel, &amp;c.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Mid þāre cillan fyliinge (cyllfyllinge, v. l.)</span>
									<span class="q-cite"> (Gr. D. 250, 27)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">completion, complement</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">vi fliccen and ōþer vi tō fyllincge</span>
									<span class="q-cite"> (Nap. 55, 33)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bytt-fylling" class="xref-target">bytt-fylling</a>, <a href="x-dictionary:r:cyll-fylling" class="xref-target">cyll-fylling</a>, <a href="x-dictionary:r:ge-fylling" class="xref-target">ge-fylling</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brȳttian" d:title="brȳttian">
		<body>
			<h1>brȳttian<span class="pron"> | bryːt.ti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To possess, enjoy</span>
						<span class="meaning-la"> (Lat. possidere, frui)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">shall enjoy wealth</span>
							<span class="q-oe">Sculon wēlan bryttian</span>
							<span class="q-cite"> (Cd. 99; Th. 131, 19; Gen. 2178)</span>
						</li>
						<li>
							<span class="q-en">enjoyed the world</span>
							<span class="q-oe">Woruld bryttade</span>
							<span class="q-cite"> (Cd. 62; Th. 74, 22; Gen. 1226)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:brȳtian" class="xref-target">brȳtian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-rǣdfæstlīce" d:title="un-rǣdfæstlīce">
		<body>
			<h1>un-rǣdfæstlīce<span class="pron"> | un.ræːd.fæst.liː.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unadvisedly, without heeding good counsel</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Twā geār hē rīxode unrǣdfæstlīce</span>
							<span class="q-cite"> (Homl. Skt. i. 18, 456)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ān-seld" d:title="ān-seld">
		<body>
			<h1>ān-seld<span class="pron"> | ɑːn.seld |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A place to turn to</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stedefulness" d:title="stedefulness">
		<body>
			<h1>stedefulness<span class="pron"> | ste.de.ful.ness |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:on-stedefulness" class="xref-target">on-stedefulness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fǣtt" d:title="fǣtt">
		<body>
			<h1>fǣtt<span class="pron"> | fæːtt |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">¶</span>
								<span class="meaning-en">as a nickname</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ealdrēd hæfð geunnen Æðestān fǣttan sumne dǣl landes</span>
									<span class="q-cite"> (C. D. iv. 262, 13.)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">of animals intended to be eaten, fatted</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">altilium</span>
									<span class="q-oe">Fǣt heāhfore</span>
									<span class="q-cite"> (Wrt. Voc. i. 23, 50.)</span>
								</li>
								<li>
									<span class="q-la">ad vitulum saginatum</span>
									<span class="q-oe">Tō fēttum stiorce</span>
									<span class="q-cite"> (Kent. Gl. 525.)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of things, plump, full-bodied, substantial</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā beōð fulle of fǣttum leāfum and wel wōsigum</span>
							<span class="q-cite"> (Lch. i. 258, 3.)</span>
						</li>
						<li>
							<span class="q-oe">Hafað seō lǣsse smæle leāf and gehwǣde, and seō ōðer hafað māran leāf and fǣtte</span>
							<span class="q-cite"> (264, 20.)</span>
						</li>
						<li>
							<span class="q-oe">Siō hæfð fǣtte and þicce ǣdra</span>
							<span class="q-cite"> (ii. 242, 16.)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">containing fatty matter, consisting of fat</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Genim fǣttes flǣsces, sele twā snǣda</span>
							<span class="q-cite"> (Lch. ii. 268, 30.)</span>
						</li>
						<li>
							<span class="q-oe">Bið swā sēlre swā hē fǣttron mete ete, and gif hē mæge gedrincan ge ðǣre buteran</span>
							<span class="q-cite"> (iii. 22, 14.)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">III a.</span>
								<span class="meaning-en">referring to fluids, oleaginous, unctuous</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">crasso (crassa olei pinguedine, Ald.)</span>
									<span class="q-oe">Ðȳ fǣttan</span>
									<span class="q-cite"> (Wrt. Voc. ii. 83, 67 : 18, 52.)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">rich (of food)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">pingue jus</span>
							<span class="q-oe">Fǣtt broþ</span>
							<span class="q-cite"> (Coll. M. 29, 13.)</span>
						</li>
						<li>
							<span class="q-la">pinguia</span>
							<span class="q-oe">Fētto</span>
							<span class="q-cite"> (Kent. Gl. 788.)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">fertile, productive, rich (soil)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðeōs wyrt byþ cenned on fǣttum landum and begānum</span>
							<span class="q-cite"> (Lch. i. 254, 11.)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">VI.</span>
						<span class="meaning-en">well supplied with what is needful or desirable, rich in good things</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Æt fruman ðes middangeard wæs ðeōnde, . . . on spēda genihtsumnysse fǣtt</span>
							<span class="q-cite"> (Hml. Th. i. 614, 19.)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:frǣ-fǣtt" class="xref-target">frǣ-fǣtt</a>, <a href="x-dictionary:r:ofer-fǣtt" class="xref-target">ofer-fǣtt</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leāh-hrycg" d:title="leāh-hrycg">
		<body>
			<h1>leāh-hrycg<span class="pron"> | læ͜ɑːx.xrydʒː |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The ridge of a lea</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Tō ðæm ealdan lǣghrycge</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. iii. 437, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gefylled" d:title="un-gefylled">
		<body>
			<h1>un-gefylled<span class="pron"> | un.Ge.fyl.led |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unfilled, unsatisfied</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nos ad constantiam, nostris moribus alienam, inexpleta hominum cupiditas alligabit?</span>
							<span class="q-oe">Ic eom getogen tō fremdum þeāwum ðurh ða ungefyldan (-gefylledan, Cott. MS.) gītsunge woruldmonna</span>
							<span class="q-cite"> (Bt. 7, 3; Fox 20, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dihtaþ" d:title="dihtaþ">
		<body>
			<h1>dihtaþ<span class="pron"> | dix.tɑθ |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 3sg: -dihtaþ</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">dictates</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:dihtan" class="xref-target">dihtan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="deāþ-lēg" d:title="deāþ-lēg">
		<body>
			<h1>deāþ-lēg<span class="pron"> | dæ͜ɑːθ.leːG |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A death flame</span>
						<span class="meaning-la"> (Lat. letālis flamma)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the death-flame shall seize each creature</span>
							<span class="q-oe">Wihta gehwylce deāþlēg nimeþ</span>
							<span class="q-cite"> (Exon. 22 a; Th. 61, 12; Cri. 983)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gebeōr" d:title="gebeōr">
		<body>
			<h1>gebeōr<span class="pron"> | Ge.be͜oːr |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">conuiuam</span>
						<span class="q-oe">(conuiuam) beōn witan</span>
						<span class="q-cite"> (Scint. 158, 11)</span>
					</li>
					<li>
						<span class="q-oe">Wæs his gewuna ꝥ hē wolde swȳþe lytel drincan, þeāh hē mid gebeōrum blīðe wǣre</span>
						<span class="q-cite"> (Vis. Lfc. 24)</span>
					</li>
					<li>
						<span class="q-oe">Se cyning bebeād þām gebeōrum eallum ꝥ hī blīþe wǣron æt his gebeōr-scipe, and ꝥ ǣlc mann drunce þæs deōrwurðan wīnes be þām þe hē sylf wolde</span>
						<span class="q-cite"> (Hml, A. 92, 20)</span>
					</li>
					<li>
						<span class="q-oe">Gemētte hē gebeōras blīðe æt þām hūse, . . . and sæt mid þām gebeōrum blissigende samod.</span>
						<span class="q-cite"> (Hml. S. 26, 225)</span>
					</li>
					<li>
						<span class="q-oe">Drihten mid sēlran wīne þā gebeōras gegladode</span>
						<span class="q-cite"> (Hml. Th. ii. 54, 30)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-hwirfedlic" d:title="for-hwirfedlic">
		
