<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bȳgan" d:title="bȳgan">
		<body>
			<h1>bȳgan<span class="pron"> | byː.ɣɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:bīgan" class="xref-target">bīgan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="segl-gird" d:title="segl-gird">
		<body>
			<h1>segl-gird<span class="pron"> | seɣl.Gird |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a sail-yard, yard of a ship</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Segl–gærd antemna</span>
							<span class="q-cite"> (Wrt. Voc. ii. 100, 30)</span>
						</li>
						<li>
							<span class="q-oe">Segelgyrd antenna</span>
							<span class="q-cite"> (i. 48, 17 : antenna vel temo, 56, 39)</span>
						</li>
						<li>
							<span class="q-oe">Mæst sceal on ceōle, segelgyrd (Grein takes this == sail-girt, and as applying to the mast) seomian</span>
							<span class="q-cite"> (Menol. Fox 509 ; Gn. C. 25)</span>
						</li>
						<li>
							<span class="q-oe">Ða twegen endas ðære seglgyrde cornua</span>
							<span class="q-cite"> (Wrt. Voc. i. 56, 40 : 48, 18)</span>
						</li>
						<li>
							<span class="q-oe">Segelgyrda antennarum</span>
							<span class="q-cite"> (ii. 5, 41 : 88, 25)</span>
						</li>
						<li>
							<span class="q-oe">Segelgyrdena, mæsta antennarum</span>
							<span class="q-cite"> (Hpt. Gl. 529, 18)</span>
						</li>
						<li>
							<span class="q-oe">Segelgyrdas antemnas</span>
							<span class="q-cite"> (97, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">the cross rod from which a banner hangs (? v. segel, III)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Segelgyrd labara</span>
							<span class="q-cite"> (Wrt. Voc. ii. 78, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-getǣse" d:title="un-getǣse">
		<body>
			<h1>un-getǣse<span class="pron"> | un.Ge.tæː.se |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Inconvenient, disagreeable, troublesome, obnoxious</span>
						<span class="meaning-la"> (Lat. infestus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ungetǣse infestus</span>
							<span class="q-cite"> (Wrt. Voc. ii. 45, 46)</span>
						</li>
						<li>
							<span class="q-la">aut injucundum, aut noxium</span>
							<span class="q-oe">Oððe hit ðē deraþ oððe hit ðē unwynsum biþ, oððe ungetēse (-getǣse, Cott. MS.) oððe frēcenlīc</span>
							<span class="q-cite"> (Bt. 14, 1; Fox 42, 13)</span>
						</li>
						<li>
							<span class="q-la">gloriam petis? sed per aspera quaeque distractus, securus esse desistis</span>
							<span class="q-oe">Gilpes ðū girnest? ac ðū hine ne miht habban orsorgne, for ðam ðū scealt habban simle hwæthweg wiþerweardes and ungetēses (-getǣses, Cott. MS.)</span>
							<span class="q-cite"> (32, 1; Fox 114, 20)</span>
						</li>
						<li>
							<span class="q-oe">Ða cyningas ðe æfter Rōmuluse rīcsedon wǣron forcūðran ðonne hē wǣre, and ðǣm folcum lāðran and ungetǣsran</span>
							<span class="q-cite"> (Ors. 2, 2; Swt. 66, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="būtū" d:title="būtū">
		<body>
			<h1>būtū<span class="pron"> | buː.tuː |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Both</span>
						<span class="meaning-la"> (Lat. ambo)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">then both [the two] shall be preserved</span>
							<span class="q-oe">Ðonne beōþ būtū gehealden</span>
							<span class="q-cite"> (Mk. Bos. 2, 22)</span>
						</li>
						<li>
							<span class="q-en">then both [the two] were a grief to Isaac and Rebecca</span>
							<span class="q-oe">Ðā būtū abulgon Isaace and Rebeccan</span>
							<span class="q-cite"> (Gen. 26, 35: Lk. Bos. l, 6, 7)</span>
						</li>
						<li>
							<span class="q-en">we both [lit. we two both] speak to him</span>
							<span class="q-oe">Wit him būtū sprecaþ</span>
							<span class="q-cite"> (Cd. 27; Th. 36, 20; Gen. 574: 39; Th. 52, 4; Gen. 838: 40; Th. 52, 22; Gen. 847)</span>
						</li>
						<li>
							<span class="q-en">where they both [lit. they two both] sat</span>
							<span class="q-oe">Ðǣr hie sǣton būtū</span>
							<span class="q-cite"> (133; Th. 168, 8; Gen. 2779)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bātwā" class="xref-target">bātwā</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="healfpenig-wurþ" d:title="healfpenig-wurþ">
		<body>
			<h1>healfpenig-wurþ<span class="pron"> | xæ͜ɑlf.pe.niG.wurθ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Healfpeningwurð wexes tō candelmæssan</span>
						<span class="q-cite"> (Wlfst, 117, 1)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="full-æst" d:title="full-æst">
		<body>
			<h1>full-æst<span class="pron"> | full.æst |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Full help, support</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">leader, the greatest of supports, who leads this expedition</span>
							<span class="q-cite"> (Cd. 170; Th. 213, 18; Exod. 554)</span>
						</li>
						<li>
							<span class="q-en">that we might have light and help from the fire</span>
							<span class="q-oe">Ðæt we hæfdon æt ðæm fȳre leōht and fullāste</span>
							<span class="q-cite"> (Nar. 13, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-micelness" d:title="ofer-micelness">
