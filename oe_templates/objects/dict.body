<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ālifian" d:title="ālifian">
		<body>
			<h1>ālifian<span class="pron"> | ɑː.li.fi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To live</span>
						<span class="meaning-la"> (Lat. vivere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he resolved that he would live all the days of his life in clothing of skins</span>
							<span class="q-oe">He geþohte ðæt he wolde on fellenum gegyrelan ealle his dagas his līfes alifian</span>
							<span class="q-cite"> (Guthl. 4; Gdwin. 26, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ālibban" class="xref-target">ālibban</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwæs" d:title="hwæs">
