<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-ārweorþian" d:title="ge-ārweorþian">
		
		<body>
			<h1>ge-ārweorþian<span class="pron"> | je.ɑːr.we͜or.θi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To honour</span>
						<span class="meaning-la"> (Lat. honorificāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mihi nimis honorificāti sunt amīci tui</span>
							<span class="q-oe">Me swīðe geārweorþede syndon freōnd ðīne</span>
							<span class="q-cite"> (Ps. Lamb. 138, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="han-crēd" d:title="han-crēd">
		<body>
			<h1>han-crēd<span class="pron"> | xɑn.kreːd |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">cock-crowing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">concrepante pullorum plausu et sonante gallicinio</span>
							<span class="q-oe">Scyllendre cocca fiþerslehte and . . . hancrēde</span>
							<span class="q-cite"> (An. Ox. 4893)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a division of the night</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Betwux hancrēde læg se hālga wer geedcucod</span>
							<span class="q-cite"> (Hml. Th. ii. 334, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:han-grǣd" class="xref-target">han-grǣd</a>
			</p>
		</body>
	</d:entry>
