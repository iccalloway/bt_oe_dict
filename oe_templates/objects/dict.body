				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">expers (periculi)</span>
						<span class="q-oe">Ordǣle</span>
						<span class="q-cite"> (An. Ox. 3286)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-borgian" d:title="ā-borgian">
		<body>
			<h1>ā-borgian<span class="pron"> | ɑː.bor.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-oe">brȳdguma ðæs, and hit āborgian hīs frȳnd</span>
							<span class="q-cite"> (2; Th. i. 254, 9. 11.)</span>
						</li>
					</ul>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="sub-heading">to borrow</span>
								<span class="meaning-en">to borrow</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hit gelamp ðæt hire fæter āborgude .xxx. punda æt Godan</span>
									<span class="q-cite"> (Ch. Th. 201, 15.)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Tiig" d:title="Tiig">
