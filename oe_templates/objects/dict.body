<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-nyrwian" d:title="ge-nyrwian">
		
		<body>
			<h1>ge-nyrwian<span class="pron"> | je.nyr.wi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede, sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed, past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To make narrow, compress, oppress</span>
						<span class="meaning-la"> (Lat. co-arto)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">co-arto</span>
							<span class="q-oe">Ic genyrwige co-arto</span>
							<span class="q-cite"> (Ælfc. Gr. 47; Som. 48, 56)</span>
						</li>
						<li>
							<span class="q-la">inimici tui coangustabunt te</span>
							<span class="q-oe">Ðīne fȳnd dē genyrwaþ</span>
							<span class="q-cite"> (Lk. Bos. 19, 43)</span>
						</li>
						<li>
							<span class="q-la">neque urgeat super me puteus os suum</span>
							<span class="q-oe">Ne genyrwe ofer me pyt mūþ his</span>
							<span class="q-cite"> (Ps. Spl. 68, 19)</span>
						</li>
						<li>
							<span class="q-la">anxiatus est super me spiritus meus</span>
							<span class="q-oe">Genyrwyd [C], geniered [T] is ofer me gāst mīn</span>
							<span class="q-cite"> (142, 4)</span>
						</li>
						<li>
							<span class="q-en">so narrowed</span>
							<span class="q-oe">Swā genyrwod</span>
							<span class="q-cite"> (Btwk. Scrd. 21, 5)</span>
						</li>
						<li>
							<span class="q-en">hardly constrained</span>
							<span class="q-oe">Hearde genyrwad</span>
							<span class="q-cite"> (Exon. 13 a; Th. 23, 6; Cri. 364)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wīs-hygdig" d:title="wīs-hygdig">
		<body>
			<h1>wīs-hygdig<span class="pron"> | wiːs.xyɣ.diG |</span>
			</h1>
