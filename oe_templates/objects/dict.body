<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gafelian" d:title="gafelian">
		<body>
			<h1>gafelian<span class="pron"> | gɑ.fe.li.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To rent</span>
						<span class="meaning-la"> (Lat. condūcĕre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I give thereto two hides which Eadric rents</span>
							<span class="q-oe">Ic geann ðārto twegra hīda ðe Eādrīc gafelaþ</span>
							<span class="q-cite"> (Cod. Dipl. 699; A. D. 997; Kmbl. iii. 305, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-gafelod" class="xref-target">ge-gafelod</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ealdor-dēma" d:title="ealdor-dēma">
		<body>
			<h1>ealdor-dēma<span class="pron"> | æ͜ɑl.dor.deː.mɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a supreme judge, a prince</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:aldor-dēma" class="xref-target">aldor-dēma</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-dǣlan" d:title="for-dǣlan">
		<body>
			<h1>for-dǣlan<span class="pron"> | for.dæː.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To deal out, expend</span>
						<span class="meaning-la"> (Lat. dispensāre, erogāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">quæ in medicos erogāverat omnem substantiam suam</span>
							<span class="q-oe">Seō fordǣlde on lǣcas eall ðæt heō āhte</span>
							<span class="q-cite"> (Lk. Bos. 8, 43)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-dingan" d:title="ge-dingan">
		<body>
			<h1>ge-dingan<span class="pron"> | je.din.gɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to press, throw oneself with force</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gedinð appetit</span>
							<span class="q-cite"> (Kent. Gl. 1155)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-gerēfa" d:title="under-gerēfa">
		<body>
			<h1>under-gerēfa<span class="pron"> | un.der.Ge.reː.fɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An under-officer</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gerēfa consul, undergerēfa proconsul</span>
							<span class="q-cite"> (Wrt. Voc, i. 18, 5)</span>
						</li>
						<li>
							<span class="q-en">the pro-prefect</span>
							<span class="q-oe">Se undergerēfa</span>
							<span class="q-cite"> (Homl. Skt. i. 4, 332: 7, 216)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tō-dǣlness" d:title="tō-dǣlness">
