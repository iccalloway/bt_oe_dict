		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-hȳdan" d:title="for-hȳdan">
		<body>
			<h1>for-hȳdan<span class="pron"> | for.xyː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To hide</span>
						<span class="meaning-la"> (Lat. abscondere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">abscondērunt mīhi lāqueos</span>
							<span class="q-oe">Forhȳddan meinwitgyrene abscondērunt mīhi lāqueos</span>
							<span class="q-cite"> (Ps. Th. 139, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feolufer" d:title="feolufer">
