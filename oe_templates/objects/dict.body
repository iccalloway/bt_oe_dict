<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-mǣgas" d:title="ge-mǣgas">
		
		<body>
			<h1>ge-mǣgas<span class="pron"> | je.mæː.ɣɑs |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Fratres gebrōþor, et aliquando ge-mǣgas</span>
						<span class="q-cite"> (Wrt. Voc. ii. 39, 46)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:sib-gemāgas" class="xref-target">sib-gemāgas</a>, <a href="x-dictionary:r:ge-mīēgþ" class="xref-target">ge-mīēgþ</a>
			</p>
