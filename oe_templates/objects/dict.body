					<p>
						<span class="meaning-en">a lock of wool</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Loca floccus</span>
							<span class="q-cite"> (Txts. 64, 448)</span>
						</li>
					</ul>
				</li>
			</ol>
