			<p class="xref">See also: <a href="x-dictionary:r:hwilc-ness" class="xref-target">hwilc-ness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wudu-telga" d:title="wudu-telga">
		<body>
			<h1>wudu-telga<span class="pron"> | wu.du.tel.ɣɑ |</span>
