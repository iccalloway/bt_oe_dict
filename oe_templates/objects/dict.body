<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hreōw-ness" d:title="hreōw-ness">
		<body>
			<h1>hreōw-ness<span class="pron"> | xre͜oːw.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Penitence, repentance, sorrow, contrition</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">post pœnitentiæ contritionem</span>
							<span class="q-oe">Æfter his dǣdbōte hreōwnysse</span>
							<span class="q-cite"> (L. Ecg. P. Th. ii. 170, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hreōwnisse [hrēunisse, Rush.] pœnitentiam</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 11, 21)</span>
						</li>
						<li>
							<span class="q-oe">Hreōnisse</span>
							<span class="q-cite"> (3, 8)</span>
						</li>
						<li>
							<span class="q-oe">Hreāwnise</span>
							<span class="q-cite"> (21, 29: Mk. Skt. Lind. 6, 12)</span>
						</li>
						<li>
							<span class="q-oe">Hreōunisse pœnitentia</span>
							<span class="q-cite"> (Rtl. 8, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-līþan" d:title="for-līþan">
		<body>
			<h1>for-līþan<span class="pron"> | for.liː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -lāþ, pl: -liton, pl: -liþon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -liden, past participle sg: -liþen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To suffer shipwreck</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">naufragaverant</span>
							<span class="q-oe">Forliþan naufragaverant</span>
							<span class="q-cite"> (An. Ox. 4490: 4621)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:for-liden" class="xref-target">for-liden</a>
			</p>
		</body>
