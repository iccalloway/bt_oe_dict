<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-þrāwan" d:title="be-þrāwan">
		<body>
			<h1>be-þrāwan<span class="pron"> | be.θrɑː.wɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to twist</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">fila scirpea conlita</span>
							<span class="q-oe">Riscene weocan beþrāwene</span>
							<span class="q-cite"> (Germ. 391, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hearm-plega" d:title="hearm-plega">
		<body>
			<h1>hearm-plega<span class="pron"> | xæ͜ɑrm.ple.ɣɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">Facta est rixa inter pastores gregum Abram et Lot, Gen. 13, 7</span>
						<span class="q-oe">Oft wǣron teōnan wǣrfæstra wera weredum gemǣne, heardum hearmplega</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wyrcean" d:title="wyrcean">
		<body>
			<h1>wyrcean<span class="pron"> | wyr.Kæ͜ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-en">the king observed where the river might be obstructed</span>
						<span class="q-oe">the king observed where the river might be obstructed</span>
						<span class="q-cite"> (Chr. 896; Th. 173, 36, col. 1)</span>
					</li>
					<li>
						<span class="q-en">he had barricaded all the entrances against him</span>
						<span class="q-oe">He hæfde ealle ða geatu fōrworht into him</span>
						<span class="q-cite"> (Chr. 901; Erl. 96, 31)</span>
					</li>
					<li>
						<span class="q-en">the ways of these hell-doors are obstructed</span>
						<span class="q-oe">Synt ðissa heldōra wegas fōrworhte</span>
						<span class="q-cite"> (Cd. 19; Th. 24, 21; Gen. 381)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="strengðu" d:title="strengðu">
		
		<body>
			<h1>strengðu<span class="pron"> | streng.θu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Strength</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">i. virtus</span>
							<span class="q-oe">Strengð acha</span>
							<span class="q-cite"> (Wrt. Voc. i. 17, 27)</span>
						</li>
						<li>
							<span class="q-la">vis</span>
							<span class="q-oe">Seō strengð</span>
							<span class="q-cite"> (Gl. Prud. 71)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="sub-heading">referring to living beings</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">strength, power to do, fortitude, power to bear, firmness, vigour</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">fortitudo capitis mei</span>
											<span class="q-oe">Strengþu heāfdes mīnes</span>
											<span class="q-cite"> (Ps. Th. 59, 6 : 117, 14)</span>
										</li>
										<li>
											<span class="q-oe">Mægnes strengðu</span>
											<span class="q-cite"> (Exon. Th. 239, 23; Ph. 625)</span>
										</li>
										<li>
											<span class="q-la">fortitudo</span>
											<span class="q-oe">Mōdes strengð</span>
											<span class="q-cite"> (Wulfst. 51, 7)</span>
										</li>
										<li>
											<span class="q-oe">Fortitudo, ðæt is strængð oððe ānrēdnyss, þurh ða sceal seō sāwul forbæran earfoðnysse mid ānrǣdum mōde</span>
											<span class="q-cite"> (Homl. Skt. i. 1, 165)</span>
										</li>
										<li>
											<span class="q-la">vigor</span>
											<span class="q-oe">Strængþ</span>
											<span class="q-cite"> (Hymn. Surt. 10, 10)</span>
										</li>
										<li>
											<span class="q-la">fortitudo mea</span>
											<span class="q-oe">Strengcþ. mīn</span>
											<span class="q-cite"> (Ps. Spl. 17, 1)</span>
										</li>
										<li>
											<span class="q-la">robur</span>
											<span class="q-oe">Strenð</span>
											<span class="q-cite"> (Kent. Gl. 795)</span>
										</li>
										<li>
											<span class="q-oe">Ic eōw healde strengðu staþolfæstre</span>
											<span class="q-cite"> (Exon. Th. 31, 3; Cri. 490)</span>
										</li>
										<li>
											<span class="q-oe">In ðære gǣstes strengðu</span>
											<span class="q-cite"> (40, 14; Cri. 638)</span>
										</li>
										<li>
											<span class="q-la">comparari fortitudini tuae</span>
											<span class="q-oe">Beōn wiðmeten ðinre strengðe</span>
											<span class="q-cite"> (Deut. 3, 24: Ps. Spl. 38, 14)</span>
										</li>
										<li>
											<span class="q-oe">On strengðe horses</span>
											<span class="q-cite"> (146, 11)</span>
										</li>
										<li>
											<span class="q-la">cum potentia</span>
											<span class="q-oe">Mid strencgðe</span>
											<span class="q-cite"> (Ps. Th. 88, 11)</span>
										</li>
										<li>
											<span class="q-oe">Mid micelre strencðe āfylled hē worhte micele tācna</span>
											<span class="q-cite"> (Homl. Th. i. 44, 23)</span>
										</li>
										<li>
											<span class="q-oe">Swā se fulfremeda wæstm biþ on fulre strencðe þeōnde</span>
											<span class="q-cite"> (ii. 76, 19)</span>
										</li>
										<li>
											<span class="q-oe">Se weard (the angel at the gate of Eden) hafaþ miht and strengðo</span>
											<span class="q-cite"> (Cd. Th. 58, 22; Gen. 950)</span>
										</li>
										<li>
											<span class="q-oe">Ic ðīne strengþu (virtutem) singe</span>
											<span class="q-cite"> (Ps. Th. 58, 16)</span>
										</li>
										<li>
											<span class="q-la">fortitudinem</span>
											<span class="q-oe">Strengðe</span>
											<span class="q-cite"> (Ps. Spl. 58, 18)</span>
										</li>
										<li>
											<span class="q-oe">Hī lǣrdon ðæt hī mōdes strengþo nāman</span>
											<span class="q-cite"> (Bd. 1, 12 ; S. 481, 5)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(1 a)</span>
												<span class="meaning-en">the time when a man is strong, mature years</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">On mīnum cildhāde oððe on mīnre geōgoðe oððe on mīnre strengðe oððe on mīnre ylde</span>
													<span class="q-cite"> (Anglia xi. 102, 2)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">violence, force</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hē ða ongeānwinnendan fǣmnan mid micelre strengðe earfoðlīce ofercom</span>
											<span class="q-cite"> (Ap. Th. 2, 5)</span>
										</li>
										<li>
											<span class="q-la">violentiam</span>
											<span class="q-oe">Strenðe</span>
											<span class="q-cite"> (Kent. Gl. 842)</span>
										</li>
										<li>
											<span class="q-oe">Hiē ongunnon mid sweordum and mid strengþum þyder gān; þohton ðæt hiē woldan ofsleān ða apostolas</span>
											<span class="q-cite"> (Blickl. Homl. 151, 1)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="sub-heading">referring to things</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">strength, efficacy, virtue, beneficial power</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hæfþ hit ða strængðe hyne tō gewyrmenne</span>
											<span class="q-cite"> (Lchdm. i. 116, 1)</span>
										</li>
										<li>
											<span class="q-oe">Ðās sylfan strengþe heō hafaþ gewylled wið ðæs migþan earfoðlīcnyssa</span>
											<span class="q-cite"> (284, 3)</span>
										</li>
										<li>
											<span class="q-oe">Hæfþ ðeōs wyrt ealle heora strengða</span>
											<span class="q-cite"> (244, 1)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="sub-heading">of that which is hard to bear</span>
										<span class="meaning-en">strength, violence, severity, force</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ðī laes seō strengð ðære wyrte ða gōman bærne</span>
											<span class="q-cite"> (Lchdm. i. 316, 20)</span>
										</li>
										<li>
											<span class="q-oe">Wið āttres strenðe (strengðe, MS. B. ), genim ðās wyrte . . . heō oferswið ealle strenðe ðæs āttres</span>
											<span class="q-cite"> (114, 13-15)</span>
										</li>
										<li>
											<span class="q-oe">Ne mæg man ǣfre for his strengðe ðysne wyrttrnman syllan þicgean on sundrum</span>
											<span class="q-cite"> (260, 18)</span>
										</li>
										<li>
											<span class="q-oe">Hē sceal upweard licgean, ðȳ læs hē ða strengþe ðyssæ lācnunge ongite</span>
											<span class="q-cite"> (300, 21)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:mægen-strengðu" class="xref-target">mægen-strengðu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rōþer" d:title="rōþer">
		<body>
			<h1>rōþer<span class="pron"> | roː.θer |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Rōþra ł ārena tīum remorum tractibus</span>
						<span class="q-cite"> (An. Ox. 36)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="semnend(-ed)-lic" d:title="semnend(-ed)-lic">
		<body>
			<h1>semnend(-ed)-lic<span class="pron"> | sem.nend, ed, liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sudden</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">subita caecitate percussus</span>
							<span class="q-oe">Slagen mid sæmnedlicre (semnendlicre, v. l.) blindnesse</span>
							<span class="q-cite"> (Gr. D. 235, 3)</span>
						</li>
						<li>
							<span class="q-la">in subito stupore</span>
							<span class="q-oe">In þǣre fǣrlican (symnenlican and fǣrlican, v. l.) wafunge</span>
							<span class="q-cite"> (284, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:samnunga" class="xref-target">samnunga</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-fæst" d:title="-fæst">
		<body>
			<h1>-fæst<span class="pron"> | fæst |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ǣrend-fæst" class="xref-target">ǣrend-fæst</a>, <a href="x-dictionary:r:eorþ-fæst" class="xref-target">eorþ-fæst</a>, <a href="x-dictionary:r:sceam-fæst" class="xref-target">sceam-fæst</a>, <a href="x-dictionary:r:weder-fæst" class="xref-target">weder-fæst</a>, <a href="x-dictionary:r:wīf-fæst" class="xref-target">wīf-fæst</a>, <a href="x-dictionary:r:wīte-fæst" class="xref-target">wīte-fæst</a>, <a href="x-dictionary:r:word-fæst" class="xref-target">word-fæst</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eorþ-ling" d:title="eorþ-ling">
		<body>
			<h1>eorþ-ling<span class="pron"> | e͜orθ.ling |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bird, </span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:irþling" class="xref-target">irþling</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hweorfan" d:title="hweorfan">
		<body>
			<h1>hweorfan<span class="pron"> | xwe͜or.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -hwearf, pl: -hwurfon, pl: -hweorfon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -hworfen</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">where there is motion from one place to another</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to move about, wander</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þā gāstas þe for Gode hweorfað</span>
									<span class="q-cite"> (Gn. C. 59)</span>
								</li>
								<li>
									<span class="q-oe">Lond-rihtes — mōt monna ǣghwylc īdel hweorfan</span>
									<span class="q-cite"> (B. 2888)</span>
								</li>
								<li>
									<span class="q-oe">Holt hweorfende</span>
									<span class="q-cite"> (Rä, 57, 3)</span>
								</li>
								<li>
									<span class="q-la">spatiantes</span>
									<span class="q-oe">Hweorfende</span>
									<span class="q-cite"> (Wrt. Voc. ii. 83, 74)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1 a)</span>
										<span class="sub-heading">fig. of non-material objects</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Mīn hyge hweorfeð ofer hreðer locan, mīn mōdsefa. . . hweorfeð wīde</span>
											<span class="q-cite"> (Seef. 58-60)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">where the point to or from which motion is directed is marked</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">of living creatures</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hwiðer hweorfað wē (whither shall we turn) . . . gif wē swīcað þē ?</span>
											<span class="q-cite"> (An. 405)</span>
										</li>
										<li>
											<span class="q-oe">Hwearf hē tō healle swā hē hraðost meahte</span>
											<span class="q-cite"> (Az. 166: Sat. 190)</span>
										</li>
										<li>
											<span class="q-oe">Hwurfon hæleð geonge tō þām hǣðenan foran</span>
											<span class="q-cite"> (Dan. 434)</span>
										</li>
										<li>
											<span class="q-oe">Hē wæs miclum geswenced ǣr hē þanon hwurfe</span>
											<span class="q-cite"> (Chr. 982 ; P. 124, 29)</span>
										</li>
										<li>
											<span class="q-oe">Þū scealt hweorfan of earde þīnum</span>
											<span class="q-cite"> (Gen. 1018 : Wal. 81)</span>
										</li>
										<li>
											<span class="q-oe">Hweorfan tō þis enge lond</span>
											<span class="q-cite"> (Cri. 31)</span>
										</li>
										<li>
											<span class="q-oe">Þider hweorfan</span>
											<span class="q-cite"> (Dan. 203)</span>
										</li>
										<li>
											<span class="q-la">postea quam Roman venit</span>
											<span class="q-oe">Hē him siþþan hwearf tō Rōme</span>
											<span class="q-cite"> (Ors. 5, 12 ; S. 242, 27)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">of an inanimate object</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Þæt fȳr scȳde tō þām þe þā scylde worhton, hwearf (hweorf, MS. ) on þā hǣðenan hæftas fram þām hālgum cnihton</span>
											<span class="q-cite"> (Dan. 267)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(2 α)</span>
										<span class="sub-heading">where the point to which is that from which motion originally took place, to return, go back</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Gǣstas hweorfað in bānfatu</span>
											<span class="q-cite"> (Ph. 519)</span>
										</li>
										<li>
											<span class="q-la">post Babylonian rediit</span>
											<span class="q-oe">Hē siþþan hwearf hāmweard tō Babylonia</span>
											<span class="q-cite"> (Ors. 3, 9; S. 136, 3)</span>
										</li>
										<li>
											<span class="q-oe">Paulinus huerf eft tō Cantwarum (hwearf eft tō Cent rediit Cantiam, Bd. 2, 20 ; Sch. 186, 24)</span>
											<span class="q-cite"> (Chr. 633 ; P. 24, 20)</span>
										</li>
										<li>
											<span class="q-la">rediit ipse solus</span>
											<span class="q-oe">Þā hwearf sē āna in tō him</span>
											<span class="q-cite"> (Bd. 4, 3; Sch. 357, 21: 5, 19; Sch. 660, 22)</span>
										</li>
										<li>
											<span class="q-la">sociis ad ecclesiam reuersis</span>
											<span class="q-oe">His gefēran hwurfan tō cyricean</span>
											<span class="q-cite"> (4, 3 ; Sch. 352, 14)</span>
										</li>
										<li>
											<span class="q-en">the women returned with delight</span>
											<span class="q-oe">Hwurfon wīf on willan</span>
											<span class="q-cite"> (Gen. 2086)</span>
										</li>
										<li>
											<span class="q-la">reuertentes dicite</span>
											<span class="q-oe">Gē nū eft hweorfað (hwurfað, v. l.) and biddað</span>
											<span class="q-cite"> (Bd. 4, 3; Sch. 357, 8)</span>
										</li>
										<li>
											<span class="q-la">cum patriam reuerteretur</span>
											<span class="q-oe">Þonne hē eft tō his ēðle hweorfan (hwurfan, v. l.) wolde</span>
											<span class="q-cite"> (5, 19; Sch. 659, 23)</span>
										</li>
										<li>
											<span class="q-oe">Wæs Maria eft hweorfende tō hire hūse</span>
											<span class="q-cite"> (Bl. H. 139, 3)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">where the space through which or into which, or the line along which, motion is directed is given</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Mægen monna cynnes hweorfað on wīdne lēg</span>
									<span class="q-cite"> (Cri. 958 : Gū. 784)</span>
								</li>
								<li>
									<span class="q-oe">Hwearf heo bī bence</span>
									<span class="q-cite"> (B. 1188)</span>
								</li>
								<li>
									<span class="q-oe">Hæleða bearn sculon on þæt līg tō þē hweorfan</span>
									<span class="q-cite"> (Gen. 754: Sat. 419)</span>
								</li>
								<li>
									<span class="q-oe">Wand hē him ūp þanon, hwearf him þurh þā helldora</span>
									<span class="q-cite"> (Gen. 447)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="meaning-en">of the passage to the next world</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gāstas hweorfon, sōhtou swegles dreāmas</span>
									<span class="q-cite"> (An. 640)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of the course of events, to proceed</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif seō wyrd swā hweorfan mōt on yfelra manna gewill</span>
							<span class="q-cite"> (Bt. 4; F. 8, 18)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to turn</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">of persons, to direct the mind to or from a person or subject</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Būton se mon hweorfe tō gōde</span>
									<span class="q-cite"> (Bt. 31, 2 ; F. 112, 28)</span>
								</li>
								<li>
									<span class="q-oe">Lǣtaþ hine eft hweorfan tō minium lārum</span>
									<span class="q-cite"> (3, 1; F. 4, 24)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">of things, to pass to or from the possession of a person</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þonne þā þing hwām from hweorfende beōð, hē hī sceal mid þām mǣstan sāre his mōdes forlǣtan. . . And hȳ þē willaþ on murcnunga gebringan þonne hiē þē fram hweorfaþ</span>
									<span class="q-cite"> (Bt. 7, 2 ; F. 18, 16-20)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">to change (intrans. and trans. )</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="GYRN-WRACU" d:title="GYRN-WRACU">
		<body>
			<h1>GYRN-WRACU<span class="pron"> | Gyrn.wrɑ.ku |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Revenge for injury, vengeance</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-lendiscness" d:title="in-lendiscness">
		<body>
			<h1>in-lendiscness<span class="pron"> | in.len.diʃ.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Incolatus, peregrinatio</span>
						<span class="meaning-la"> (Lat. Incolatus, peregrinatio)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-þeōd" d:title="un-þeōd">
		<body>
			<h1>un-þeōd<span class="pron"> | un.θe͜oːd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ne lyste ðē fægeres wīfes and wel gelēredes and seō ðīnum willum and wel unþeōd (underþeōd? subject)</span>
						<span class="q-cite"> (Shrn. 183, 10)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="seax-ben[n]" d:title="seax-ben[n]">
		<body>
			<h1>seax-ben[n]<span class="pron"> | sæ͜ɑks.ben, n |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:six-ben[n]" class="xref-target">six-ben[n]</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="līsing" d:title="līsing">
		<body>
			<h1>līsing<span class="pron"> | liː.sing |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A freedman</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Līsingas and þeōwe</span>
							<span class="q-cite"> (Chart. Th. 592, 1)</span>
						</li>
						<li>
							<span class="q-oe">Būton ðam ceorle ðe on gafollande sit, and heora [the Danes] liēsingum [lȳsingum]; ða syndan efendȳre, ǣgðer tō cc. sciłł.</span>
							<span class="q-cite"> (L. A. G. 2; Th. i. 154, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="anga" d:title="anga">
		<body>
			<h1>anga<span class="pron"> | ɑn.gɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sting</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">aculeus libidinis</span>
							<span class="q-oe">Se anga ðǣre wrǣnnesse</span>
							<span class="q-cite"> (Past. 309, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:onga" class="xref-target">onga</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-bȳsgian" d:title="ge-bȳsgian">
		
		
		<body>
			<h1>ge-bȳsgian<span class="pron"> | je.byːs.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To occupy, busy, afflict, trouble, vex, oppress, overcome, agitate, weaken, destroy</span>
						<span class="meaning-la"> (Lat. occupare, affligere, turbare, vexare, opprimere, corripere, conficere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">saltem negligentia nos occuparet</span>
							<span class="q-oe">He mid gȳmeleāste hūru us gebȳsgaþ</span>
							<span class="q-cite"> (Bd. Whelc. 310, 20)</span>
						</li>
						<li>
							<span class="q-en">when they busy themselves with worldly treasures</span>
							<span class="q-oe">Ðonne hī hī gebȳsgiaþ mid woruldlīcum hordum</span>
							<span class="q-cite"> (Homl. Th. i. 524, 14)</span>
						</li>
						<li>
							<span class="q-en">I am a busy flame, with fire occupied</span>
							<span class="q-oe">Ic eom lēg bȳsig, fȳre gebȳsgad</span>
							<span class="q-cite"> (Exon. 108 a; Th. 412, 21; Rā. 31, 3)</span>
						</li>
						<li>
							<span class="q-en">in mind afflicted</span>
							<span class="q-oe">Mōde gebȳsgad</span>
							<span class="q-cite"> (Exon. 87 b; Th. 328, 20; Vy. 20 : 47 b; Th. 162, 34; Gū. 985)</span>
						</li>
						<li>
							<span class="q-en">the strength of the valiant is much troubled</span>
							<span class="q-oe">Is mōdigra mægen miclum gebȳsgod</span>
							<span class="q-cite"> (Andr. Kmbl. 790; An. 395)</span>
						</li>
						<li>
							<span class="q-la">vexatus est Moyses propter eos</span>
							<span class="q-oe">Moyses wearþ gebȳsgad for heora yfelum</span>
							<span class="q-cite"> (Ps. Th. 105, 25 : 76, 6)</span>
						</li>
						<li>
							<span class="q-en">oppressed with years</span>
							<span class="q-oe">Wintrum gebȳsgad</span>
							<span class="q-cite"> (Exon. 58 a; Th. 208, 28; Ph. 162 : 62 a; Th. 227, 25; Ph. 428)</span>
						</li>
						<li>
							<span class="q-en">with disease oppressed</span>
							<span class="q-oe">Ādle gebȳsgad</span>
							<span class="q-cite"> (49 a; Th. 170, 10; Gū. 1109)</span>
						</li>
						<li>
							<span class="q-en">with sleep overcome</span>
							<span class="q-oe">Slǣpe gebiesgad</span>
							<span class="q-cite"> (Exon. 96 a; Th. 358, 2; Pa. 39)</span>
						</li>
						<li>
							<span class="q-en">water falls not there, agitated in air</span>
							<span class="q-oe">Ne ðǣr wæter fealleþ lyfte gebȳsgad</span>
							<span class="q-cite"> (Exon. 56 b; Th. 201, 26; Ph. 62)</span>
						</li>
						<li>
							<span class="q-en">the mind of the disciple was greatly agitated through his lord's words</span>
							<span class="q-oe">Wearþ mōdgeþanc miclum gebīsgad, þurh ðæs þeōdnes word, ombehtþegne</span>
							<span class="q-cite"> (50 a; Th. 173, 34; Gū. 1170)</span>
						</li>
						<li>
							<span class="q-en">the fiend shall be destroyed, made very still</span>
							<span class="q-oe">Sceaða biþ gebȳsigod, swīðe gestilled</span>
							<span class="q-cite"> (Salm. Kmbl. 234; Sal. 116)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sūþan-eāsterne" d:title="sūþan-eāsterne">
		<body>
			<h1>sūþan-eāsterne<span class="pron"> | suː.θɑn.æ͜ɑː.ster.ne |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">South-eastern</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">transtulit austrum de coelo</span>
							<span class="q-oe">Hē ferade sūþaneāsterne wind of heofenan</span>
							<span class="q-cite"> (Ps. Lamb. 77, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sūþ-eāsterne" class="xref-target">sūþ-eāsterne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-beseōndlīc" d:title="un-beseōndlīc">
