<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ealdor-ner" d:title="ealdor-ner">
		
		<body>
			<h1>ealdor-ner<span class="pron"> | æ͜ɑl.dor.ner |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A life-salvation, life's safety, refuge, asylum</span>
						<span class="meaning-la"> (Lat. vitæ servātio, refugium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he come to them for mercy and for their life's salvation</span>
							<span class="q-oe">Cwom him to āre and to ealdor-nere</span>
							<span class="q-cite"> (Exon. 53 b; Th. 189, 4; Az. 54)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ner" class="xref-target">ner</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æf-þunca" d:title="æf-þunca">
