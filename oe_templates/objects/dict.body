<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣfric" d:title="ǣfric">
		<body>
			<h1>ǣfric<span class="pron"> | æː.friK |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ǣfr-ǣlc" class="xref-target">ǣfr-ǣlc</a>
