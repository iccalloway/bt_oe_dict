<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geond-drencan" d:title="geond-drencan">
		<body>
			<h1>geond-drencan<span class="pron"> | Ge͜ond.dren.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">inebriari uino</span>
						<span class="q-oe">Beōn gynddrencede of wīne</span>
						<span class="q-cite"> (Chrd. 115, 9)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hiwung" d:title="ge-hiwung">
		
		<body>
			<h1>ge-hiwung<span class="pron"> | je.xi.wung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A form, fashion, shape, position, predicament</span>
						<span class="meaning-la"> (Lat. figmentum, catēgoria)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ipse cognĕvit figmentum nostrum</span>
							<span class="q-oe">He oncneōw gehywunge ūre</span>
							<span class="q-cite"> (Ps. Spl. C. 102, 13)</span>
						</li>
						<li>
							<span class="q-oe">Gehiwunge catēgoriæ</span>
							<span class="q-cite"> (Cot. 57)</span>
						</li>
						<li>
							<span class="q-en">Lord, thou knowest my fashioning</span>
							<span class="q-oe">Drihten, ðū wāst mīne geheowunga</span>
							<span class="q-cite"> (Blickl. Homl. 89, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wimpel" d:title="wimpel">
		
		<body>
			<h1>wimpel<span class="pron"> | wim.pel |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An article of woman's dress, a wimple</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Winpel vel orl ricinum</span>
							<span class="q-cite"> (Wrt. Voc. i. 17, I)</span>
						</li>
						<li>
							<span class="q-la">anaboladium amictorium lineum feminarum, quo humeri operiuntur</span>
							<span class="q-oe">Winpel anabala</span>
							<span class="q-cite"> (26, I)</span>
						</li>
						<li>
							<span class="q-la">cyclade auro texta</span>
							<span class="q-oe">Wimple goldgewefenum cyclade auro texta</span>
							<span class="q-cite"> (Hpt. Gl. 506, 63)</span>
						</li>
						<li>
							<span class="q-oe">Wimplum cycladibus</span>
							<span class="q-cite"> (480, 71: 486, 41: mafortibus, i. velaminibus, 526, 52 : Anglia xiii. 37, 293)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cyte" d:title="cyte">
		
		<body>
			<h1>cyte<span class="pron"> | Ky.te |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:cīte" class="xref-target">cīte</a>
			</p>
