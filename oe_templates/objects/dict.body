<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gebed-giht" d:title="gebed-giht">
		<body>
			<h1>gebed-giht<span class="pron"> | Ge.bed.Gixt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Bed-time</span>
						<span class="meaning-la"> (Lat. conticinium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Cwyltīd vel gebedgiht conticinium</span>
							<span class="q-cite"> (Ælfc. Gl. 16; Som. 58, 63; Wrt. Voc. 21, 50)</span>
						</li>
					</ul>
				</li>
			</ol>
