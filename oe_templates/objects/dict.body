<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fīf-leāf" d:title="fīf-leāf">
		<body>
			<h1>fīf-leāf<span class="pron"> | fiːf.læ͜ɑːf |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fiveleaf, cinquefoil; potemilla reptans, quinquefŏlium</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Fīfleāfe</span>
							<span class="q-cite"> (Ælfc. Gl. 43; Som. 64, 54; Wrt. Voc. 31, 64: 68, 69: 79, 33: 286, 40: Herb. 3; Lchdm. i. 86, 20)</span>
						</li>
						<li>
							<span class="q-en">juice of fiveleaf</span>
							<span class="q-oe">Fīfleāfan seāw juice of fiveleaf</span>
							<span class="q-cite"> (Herb. 3, 2; Lchdm. i. 86, 24)</span>
						</li>
						<li>
							<span class="q-en">take the root of fiveleaf</span>
							<span class="q-oe">Genim fīfleāfan wyrtwalan take the root of fiveleaf</span>
							<span class="q-cite"> (Herb. 3, 3; Lchdm. i. 86, 28)</span>
						</li>
						<li>
							<span class="q-en">take the herb fiveleaf</span>
							<span class="q-oe">Genim fīfleāfan ða wyrt take the herb fiveleaf</span>
							<span class="q-cite"> (Herb. 3, 5; Lchdm. i. 88, 3, 9, 11, 14, 17, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bismer-līc" d:title="bismer-līc">
		
		<body>
			<h1>bismer-līc<span class="pron"> | bi.smer.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Disgraceful, ignominious, dirty, unpleasant</span>
						<span class="meaning-la"> (Lat. turpis, ignominiosus, fœdus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">with the most disgraceful oath</span>
							<span class="q-oe">Mid ðam bismerlīcestan āþe</span>
							<span class="q-cite"> (Ors. 4, 3; Bos. 79, 39: 1, 7; Bos. 29, 35)</span>
						</li>
						<li>
							<span class="q-en">we enjoin, that a man abstain from ignominious tonsures</span>
							<span class="q-oe">We lǣraþ, ðæt man geswīce bismorlīcra efesunga</span>
							<span class="q-cite"> (L. Edg. C. 20; Th. ii. 248, 16)</span>
						</li>
						<li>
							<span class="q-en">in the most unpleasant province</span>
							<span class="q-oe">On ðone bismerlīcostan eard</span>
							<span class="q-cite"> (Ors. 3, 11; Bos. 73, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fiþer-hīwe" d:title="fiþer-hīwe">
		<body>
			<h1>fiþer-hīwe<span class="pron"> | fi.θer.xiː.we |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Having four forms</span>
						<span class="meaning-la"> (Lat. quadriformis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">quadriformis</span>
							<span class="q-oe">Mid fiðerhīwum</span>
							<span class="q-cite"> (An. Ox. 177)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-leōsan" d:title="for-leōsan">
		<body>
			<h1>for-leōsan<span class="pron"> | for.le͜oː.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to lose</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">with acc.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ne forleōsaþ hī þone willan</span>
									<span class="q-cite"> (Bt. 36, 7; F. 184, 27)</span>
								</li>
								<li>
									<span class="q-oe">Titus sǣde þæt hē þone dæg forlure þe hē nōht tō gōde on ne gedyde</span>
									<span class="q-cite"> (Chr. 81; P. 8, 8)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">with dat. (inst.)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē nǣfre forlȳst ðām leānum</span>
									<span class="q-cite"> (Bt. 36, 7; F. 184, 25)</span>
								</li>
								<li>
									<span class="q-oe">Forliēst</span>
									<span class="q-cite"> (37, 2; F. 188, 25)</span>
								</li>
								<li>
									<span class="q-oe">Hē dōme forleās</span>
									<span class="q-cite"> (B. 1470)</span>
								</li>
								<li>
									<span class="q-oe">Þæt hē elne forleōse</span>
									<span class="q-cite"> (Gn. Ex. 188)</span>
								</li>
								<li>
									<span class="q-oe">Ic þām leānum forloren hæfde</span>
									<span class="q-cite"> (B. 2145)</span>
								</li>
								<li>
									<span class="q-oe">Sȳ his spǣce forloren</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sceōtan" d:title="sceōtan">
		<body>
			<h1>sceōtan<span class="pron"> | ʃe͜oː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="meaning-en">the weapon is the subject</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā ðone ilcan welegan mon se strǣl sceāt, ðæt hē sōna deād wæs</span>
							<span class="q-cite"> (Blickl. Homl. 199, 23)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to shoot, make an object move rapidly, push (cf. to shoot a bolt)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðonne man ða sulh forþ drīfe, and ða forman furh on sceōte</span>
							<span class="q-cite"> (Lchdm. i. 404, 2)</span>
						</li>
						<li>
							<span class="q-oe">Belūcaþ ða ǣrenan gatu and tōforan on sceōtaþ ða ȳsenan scyttelsas</span>
							<span class="q-cite"> (Nicod. 27; Thw. 15, 15)</span>
						</li>
						<li>
							<span class="q-oe">Hē lēt dragan up ðæne deādan Harald and hine on fen sceōtan</span>
							<span class="q-cite"> (Chr. 1040; Erl. 166, 24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III a.</span>
						<span class="meaning-en">to give a person help in escaping (cf. Icel. skjōta einum brott, undan to let a person escape)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gyf hine man teō ðæt hē hine (the criminal) ūt sceōte</span>
							<span class="q-cite"> (L. Edg. H. 6; Th. i. 260, 9)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">to shoot, move rapidly, dart, run, plunge, rush</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(a)</span>
								<span class="sub-heading">of living things</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Swā swā dēþ se ðe his feōndum ofer sumne weall ætfleōn wile, ðonne cēpþ hē hwǣr se weall unhēhst sȳ, and ðǣr ofer scȳt</span>
									<span class="q-cite"> (Homl. Th. i. 484, 11)</span>
								</li>
								<li>
									<span class="q-la">misit se in mare</span>
									<span class="q-oe">Hē scēt innan sǣ</span>
									<span class="q-cite"> (Jn. Skt. 21, 7)</span>
								</li>
								<li>
									<span class="q-oe">Hē unscrȳdde hine sylfne and scǣt into ðam mere</span>
									<span class="q-cite"> (Homl. Skt. i. 11, 211)</span>
								</li>
								<li>
									<span class="q-oe">Ān culfre scǣt (sceāt, MS. V.) of ðam fȳre into ðære eā</span>
									<span class="q-cite"> (3, 73)</span>
								</li>
								<li>
									<span class="q-en">they ran upon him with one accord (Acts vii. 57)</span>
									<span class="q-oe">Hi ānmōdlīce him tō scuton</span>
									<span class="q-cite"> (Homl. Th. i. 46, 34: 404, 4: ii. 496, 19)</span>
								</li>
								<li>
									<span class="q-la">utrumque latus erat animabus hominum plenum, quae vicissim hinc inde videbantur quasi tempestatis impetu jactari, Bd. 5, 12</span>
									<span class="q-oe">Seō dene wæs āfylled mid manna sāwlum ða scuton of ðam fȳre into ðam cyle</span>
									<span class="q-cite"> (350, 10)</span>
								</li>
								<li>
									<span class="q-oe">Gif ðū Godes sunu sȳ, sceōt ādūn (mitte te deorsum, Mt. 4, 6) ... Ðæt wǣre swīðe gilplīc dǣd, gif Grist scute ðā ādūn</span>
									<span class="q-cite"> (i. 170, 1, 21)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(b)</span>
								<span class="sub-heading">of inanimate things</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">in torrentem, qui de monte descendit</span>
									<span class="q-oe">On ða burnan ðe of ðam munt scȳtt</span>
									<span class="q-cite"> (Deut. 9, 21)</span>
								</li>
								<li>
									<span class="q-la">Tyrrheni maris faucibus oceani aestus immittitur</span>
									<span class="q-oe">Ðǣr sciēt se Wendelsǣ up of ðæm gārsecge</span>
									<span class="q-cite"> (Ors. 1, 1; Swt. 8, 25)</span>
								</li>
								<li>
									<span class="q-oe">Scȳt</span>
									<span class="q-cite"> (Swt. 8, 32)</span>
								</li>
								<li>
									<span class="q-oe">Seō eā scȳt ūt on ðone gārsecg</span>
									<span class="q-cite"> (Swt. 14, 14)</span>
								</li>
								<li>
									<span class="q-oe">Ðǣr ocærburna ūtt scȳt on sǣ</span>
									<span class="q-cite"> (Cod. Dip. Kmbl. iii. 175, 31: 424, 4)</span>
								</li>
								<li>
									<span class="q-oe">Seō lacu ūt scyt</span>
									<span class="q-cite"> (422, 14, 26)</span>
								</li>
								<li>
									<span class="q-oe">Ðonne ða wolcnan sceōtaþ betweōn hyre (the sun) and ðē</span>
									<span class="q-cite"> (Shrn. 201, 25)</span>
								</li>
								<li>
									<span class="q-oe">Him on gafol forlēt feōwer wellan scīre sceōtan</span>
									<span class="q-cite"> (Exon. Th. 420, 1; Rä. 39, 4)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(c)</span>
								<span class="sub-heading">of speech</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">though the remark burst from him involuntarily</span>
									<span class="q-oe">Hē ðæs geanwyrde wes ætforan eallum ðām mannum ðe ðǣr gegaderode wǣron, ðeāh him ðæt word of scute his unnþances</span>
									<span class="q-cite"> (Chr. 1055; Erl. 189, 6)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">to run (of a road, etc.)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">per viam, quae ducit ad puteum</span>
							<span class="q-oe">On ðam wege ðe scȳtt tō ðam pytte</span>
							<span class="q-cite"> (Gen. 24, 62)</span>
						</li>
						<li>
							<span class="q-oe">Tō ðere fyrh ðe scȳt sūþrihte tō ðære miclan strǣt ... Ōþ ðone weg ðe scȳt tō fealuwes leā ... tō ðam wege ðe scȳt tō ðam hricgge</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. iii. 422, 4-19, 20, 25)</span>
						</li>
						<li>
							<span class="q-oe">Ōþ ðæt se weall eāst sciāt</span>
							<span class="q-cite"> (ii. 86, 20)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">VI.</span>
						<span class="meaning-en">to refer a case to a person or court</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðus wrāt Hieronimus. Gif hwā elles secge, wē sceōtaþ tō him</span>
							<span class="q-cite"> (Homl. Th. ii. 306, 19)</span>
						</li>
						<li>
							<span class="q-oe">Ðā nolde he, būtan hit man sceōte tō scīregemōte</span>
							<span class="q-cite"> (Chart. Th. 288, 19)</span>
						</li>
						<li>
							<span class="q-oe">Gif preōst dōm tō lǣwedum sceōte, ðe hē tō gehādedum scolde</span>
							<span class="q-cite"> (L. N. P. L. 5; Th. ii. 290, 22)</span>
						</li>
						<li>
							<span class="q-oe">Wē lǣraþ, ðæt nān sacu ðe betweox preōstan sī ne beō gescoten tō woruldmanna sōme, ac sēman heora āgene gefēran, oððe sceōtan tō ðam biscope</span>
							<span class="q-cite"> (L. Edg. C. 7; Th. ii. 246, 5: L. I. P. 10; Th. ii. 316, 36)</span>
						</li>
						<li>
							<span class="q-oe">Se engel andwyrde: Uton sceōtan tō Godes dōme</span>
							<span class="q-cite"> (Homl. Th. ii. 338, 33)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">VII.</span>
						<span class="meaning-en">to advance money, contribute, pay (cf. scot)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē forgeaf Middel-Sexon ðæt feoh ðæt hē heom fore sceāt</span>
							<span class="q-cite"> (Chart. Th. 551, 12)</span>
						</li>
						<li>
							<span class="q-oe">Sceōte ǣlc gegylda ǣnne gyldsester fulne clǣnes hwǣtes</span>
							<span class="q-cite"> (606, 6)</span>
						</li>
						<li>
							<span class="q-oe">Sceōte man ælmessan</span>
							<span class="q-cite"> (Wulfst. 170, 18)</span>
						</li>
						<li>
							<span class="q-oe">Sceōte man æt ǣghwilcre hīde pænig oððe pæniges weorð</span>
							<span class="q-cite"> (181, 4)</span>
						</li>
						<li>
							<span class="q-oe">Wē cwǣdon ðæt ūre ǣlc scute .iiii. pæng tō ūre gemǣne þearfe ... and forgyldon ðæt yrfe ðe syððan genumen wǣre ðe wē ðæt feoh scuton</span>
							<span class="q-cite"> (L. Ath. V. 2; Th. i. 230, 15-17)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">VIII.</span>
						<span class="meaning-en">to shoot (of sharp pain)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wið sceōtendum wenne</span>
							<span class="q-cite"> (Lchdm. ii. 324, 25: iii. 30, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-sceōtan" class="xref-target">ā-sceōtan</a>, <a href="x-dictionary:r:be-sceōtan" class="xref-target">be-sceōtan</a>, <a href="x-dictionary:r:for-sceōtan" class="xref-target">for-sceōtan</a>, <a href="x-dictionary:r:ge-sceōtan" class="xref-target">ge-sceōtan</a>, <a href="x-dictionary:r:of-sceōtan" class="xref-target">of-sceōtan</a>, <a href="x-dictionary:r:ōþ-sceōtan" class="xref-target">ōþ-sceōtan</a>, <a href="x-dictionary:r:þurh-sceōtan" class="xref-target">þurh-sceōtan</a>, <a href="x-dictionary:r:un-sceōtan" class="xref-target">un-sceōtan</a>, <a href="x-dictionary:r:under-sceōtan" class="xref-target">under-sceōtan</a>, <a href="x-dictionary:r:scotian" class="xref-target">scotian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brōðor-gyld" d:title="brōðor-gyld">
		<body>
			<h1>brōðor-gyld<span class="pron"> | broː.θor.Gyld |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Brother-retribution, vengeance for brothers</span>
						<span class="meaning-la"> (Lat. fratrum cædis retributio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">in vengeance for their brothers</span>
							<span class="q-oe">On hyra brōðorgyld [brōðra gyld, Thorpe]</span>
							<span class="q-cite"> (Cd. 153; Th. 190, 15; Exod. 199)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-midleahtrian" d:title="ge-midleahtrian">
		<body>
			<h1>ge-midleahtrian<span class="pron"> | je.mid.læ͜ɑx.tri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To reproach</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ne forte auferat tibi gratiam, et convitietur tibi</span>
							<span class="q-oe">Þe lǣs hē āfyrre þē gyfe, and hē (þē ?) sī gemidleahtrud</span>
							<span class="q-cite"> (Scint. 200, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ord" d:title="ord">
		<body>
			<h1>ord<span class="pron"> | ord |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I a.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">in illis spinarum aculeis</span>
							<span class="q-oe">On þām ordum þāra þorna</span>
							<span class="q-cite"> (Gr. D. 101, 16)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">eorum mortis auctor fit</span>
							<span class="q-oe">Hē bið heora deāðes ord</span>
							<span class="q-cite"> (Chrd. 92, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="elp" d:title="elp">
		<body>
			<h1>elp<span class="pron"> | elp |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">an elephant</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ylp" class="xref-target">ylp</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-þungen" d:title="ge-þungen">
		<body>
			<h1>ge-þungen<span class="pron"> | je.θun.Gen |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Grown, thriven, advanced [morally, mentally, etc.], excellent, pious, noble, perfect</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">perfect in its limbs</span>
							<span class="q-oe">Leomum geþungen</span>
							<span class="q-cite"> (Exon. 64 a; Th. 241, 1; Ph. 649)</span>
						</li>
						<li>
							<span class="q-en">in mature growth</span>
							<span class="q-oe">On geþungenum wæstme</span>
							<span class="q-cite"> (Homl. Th. ii. 76, 25)</span>
						</li>
						<li>
							<span class="q-la">emeritus, provectus</span>
							<span class="q-oe">Geþungen</span>
							<span class="q-cite"> (Ælfc. Gl. 82; Som. 73, 52; Wrt. Voc. 47, 56)</span>
						</li>
						<li>
							<span class="q-la">quia nulla ratione conveniat tanto regi</span>
							<span class="q-oe">Ðæt nǣnig þing ne gedafenade swā æþelum cyninge and swā geþungenum</span>
							<span class="q-cite"> (Bd. 2, 12; S. 514, 38: 2, 1; 501, 34: Homl. Th. ii. 122, 14: 126, 28)</span>
						</li>
						<li>
							<span class="q-la">virum bonum el aptum episcopatu</span>
							<span class="q-oe">Gōdne wer and geþungenne to biscophāde</span>
							<span class="q-cite"> (Bd. 3, 29; S. 561, 11: 4, 23; S. 594, 6)</span>
						</li>
						<li>
							<span class="q-la">veracem ac religiosum hominem</span>
							<span class="q-oe">Sum ǣfast mann and geþungen</span>
							<span class="q-cite"> (3, 19; S. 549, 24)</span>
						</li>
						<li>
							<span class="q-la">sacerdos quietus</span>
							<span class="q-oe">Sum geþungen and gedēfe sacerd</span>
							<span class="q-cite"> (Nar. 37, 25)</span>
						</li>
						<li>
							<span class="q-la">mens sobria</span>
							<span class="q-oe">Mōd geþungen</span>
							<span class="q-cite"> (Ps. Stev. ii. 202, 7)</span>
						</li>
						<li>
							<span class="q-en">he was very excellent in his conduct</span>
							<span class="q-oe">Wæs he swīðe geþungen on his þeāwum</span>
							<span class="q-cite"> (Blickl. Homl. 217, 6: Judth. 11; Thw. 23, 19; Jud. 129)</span>
						</li>
						<li>
							<span class="q-en">the queen excellent of mind</span>
							<span class="q-oe">Cwēn mōde geþungen</span>
							<span class="q-cite"> (Beo. Th. 1252; B. 624)</span>
						</li>
						<li>
							<span class="q-en">an illustrious minister</span>
							<span class="q-oe">Þegen geþungen</span>
							<span class="q-cite"> (Andr. Kmbl. 1055; An. 528: Exon. 69 b; Th. 258, 8; Jul. 262)</span>
						</li>
						<li>
							<span class="q-en">I have named the most distinguished</span>
							<span class="q-oe">Ic ða geþungnestan nemde</span>
							<span class="q-cite"> (Chr. 897; Erl. 95, 6: 905; Erl. 98, 30)</span>
						</li>
						<li>
							<span class="q-en">have me as the most excellent wife</span>
							<span class="q-oe">Hafa ðū me to ðan geþungennestan wīfe</span>
							<span class="q-cite"> (Shrn. 40, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nǣdel" d:title="nǣdel">
		<body>
			<h1>nǣdel<span class="pron"> | næː.del |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:nǣdl" class="xref-target">nǣdl</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þicfildan" d:title="þicfildan">
		<body>
			<h1>þicfildan<span class="pron"> | θik.fil.dɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-þicfyldan" class="xref-target">ge-þicfyldan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="toll" d:title="toll">
		<body>
			<h1>toll<span class="pron"> | toll |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">IV.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Toll and teām sȳ āgifen into þām mynstre</span>
							<span class="q-cite"> (Cht. E. 236, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ster-melda" d:title="ster-melda">
		<body>
			<h1>ster-melda<span class="pron"> | ster.mel.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The word occurs in the following apparently corrupt passage</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if a freeman steal a man; if he (the man who has been stolen) come back to give information of the theft, let him make his charge against the thief when the latter is present; let him (the thief) clear himself if he can</span>
							<span class="q-oe">Gif frigman mannan forstele gif hē eft cuma stermelda secge an andweardne gecænne hine gif hē mǣge</span>
							<span class="q-cite"> (L. H. E. 5; Th. i. 28, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="īdel-hende" d:title="īdel-hende">
		<body>
			<h1>īdel-hende<span class="pron"> | iː.del.xen.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Empty-handed, empty</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">none shall appear before me empty</span>
							<span class="q-la">nec apparebis in conspectu meo vacuus</span>
							<span class="q-oe">Ne cum ðū tō mīnum hūse īdelhende</span>
							<span class="q-cite"> (Ex. 34, 20)</span>
						</li>
						<li>
							<span class="q-la">vacuus appropinquat</span>
							<span class="q-oe">Gif hē cume īdelhende tō si</span>
							<span class="q-cite"> (Past. 49, 2 ; Swt. 379, 21)</span>
						</li>
						<li>
							<span class="q-en">he shall be destitute of all his possessions</span>
							<span class="q-oe">Hē biþ ealra his ǣhta īdelhende</span>
							<span class="q-cite"> (Blickl. Homl. 49, 26)</span>
						</li>
						<li>
							<span class="q-oe">Nō īdelhende bona of ðam goldsele gongan wolde</span>
							<span class="q-cite"> (Beo. Th. 4169; B. 2081)</span>
						</li>
						<li>
							<span class="q-la">nequaquam vacuum abire patieris</span>
							<span class="q-oe">Ne lǣt ðū hine gān īdelhende fram ðē</span>
							<span class="q-cite"> (Deut. 15, 13)</span>
						</li>
						<li>
							<span class="q-la">dimiserunt eum inanem</span>
							<span class="q-oe">Forleōrton hine īdelhende</span>
							<span class="q-cite"> (Lk. Skt. Lind. 20, 10, 11)</span>
						</li>
						<li>
							<span class="q-la">cum egrediemini, non exibitis vacui</span>
							<span class="q-oe">Ðonne gē ūt faraþ ne fare gē īdelhende</span>
							<span class="q-cite"> (Ex. 3, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="galere" d:title="galere">
		<body>
			<h1>galere<span class="pron"> | gɑ.le.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An enchanter</span>
						<span class="meaning-la"> (Lat. incantātor)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Galere incantātor</span>
							<span class="q-cite"> (Wrt. Voc. 74, 38)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="salt-haga" d:title="salt-haga">
