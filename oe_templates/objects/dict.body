<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heolfrig" d:title="heolfrig">
		<body>
			<h1>heolfrig<span class="pron"> | xe͜ol.friG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gory, bloody</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">gory armour</span>
							<span class="q-oe">Heolfrig herereāf</span>
							<span class="q-cite"> (Judth. 12; Thw. 26, 8; Jud. 317: 11; Thw. 23, 20; Jud. 130)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hyþ" d:title="hyþ">
		
		<body>
			<h1>hyþ<span class="pron"> | xyθ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Lyte jactura, hȳd commodum</span>
						<span class="q-cite"> (Wrt. Voc. i. 74, 52)</span>
					</li>
					<li>
						<span class="q-la">quicquid cum modo (but commodo has been read) et temperamento fit, salutare est</span>
						<span class="q-oe">Swā hwæt on hȳðþe and on temprunge byð hālwende hit ys</span>
						<span class="q-cite"> (Scint. 54, 19)</span>
					</li>
					<li>
						<span class="q-la">ei laboris sui commodum dedit</span>
						<span class="q-oe">Tō þām ꝥ hē him gedyde sume getǣse hȳðða his geswinces</span>
						<span class="q-cite"> (Gr. D. 39, 27)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hȳþþa" class="xref-target">ge-hȳþþa</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="emn-līce" d:title="emn-līce">
		<body>
			<h1>emn-līce<span class="pron"> | emn.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Equally, evenly</span>
						<span class="meaning-la"> (Lat. æquāliter, æque)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that all praise him equally</span>
							<span class="q-oe">Ðæt hine ealle emnlīce hērian</span>
							<span class="q-cite"> (Ps. Th. 32, 1: Bt. 13 ; Fox 38, 34, MS. Cot.)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:efenr-līce" class="xref-target">efenr-līce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="steppan" d:title="steppan">
		<body>
			<h1>steppan<span class="pron"> | step.pɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:stæppan" class="xref-target">stæppan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mēse" d:title="mēse">
		<body>
			<h1>mēse<span class="pron"> | meː.se |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a table at which a meal is taken</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðæs abbodes mȳse sceal ā beōn gemǣne þearuum and elþeōdegum mannum</span>
							<span class="q-cite"> (R. Ben. 93, 3)</span>
						</li>
						<li>
							<span class="q-la">suspendatur a mensa</span>
							<span class="q-oe">Sȳ hē āscyred fram gemǣnre mȳsan þigene</span>
							<span class="q-cite"> (49, 15)</span>
						</li>
						<li>
							<span class="q-la">a meme consortio</span>
							<span class="q-oe">Fram meōsan and fram gefērǣdene</span>
							<span class="q-cite"> (R. Ben. I. 56, 9 : 77, 9 ; 106, 12)</span>
						</li>
						<li>
							<span class="q-oe">Hē tō Furtunates mȳsan (beōde, v. l.) becōm</span>
							<span class="q-cite"> (Gr. D. 62, 8)</span>
						</li>
						<li>
							<span class="q-oe">Gebrōðra gereorde æt hyra mȳsum (meōsan mensis, R. Ben. l. 69, 2) ne sceal beōn būtan hāligre rǣdinge</span>
							<span class="q-cite"> (R. Ben. 62, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlīwsian" d:title="hlīwsian">
		<body>
			<h1>hlīwsian<span class="pron"> | xliːw.si.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:hleōwsian" class="xref-target">hleōwsian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-scyhtan" d:title="ā-scyhtan">
		<body>
			<h1>ā-scyhtan<span class="pron"> | ɑː.ʃyx.tɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:scyhtan" class="xref-target">scyhtan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-tyllan" d:title="be-tyllan">
		<body>
			<h1>be-tyllan<span class="pron"> | be.tyl.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To lure, decoy</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cum exercitum ad uastandam Pictorum prouinciam duxisset, iniroductus est, simulantibus fugam hostibus, in angustias</span>
							<span class="q-oe">Þā gelǣdde hē here in Peohtas, þā gelīccetton hī fleām for him, and hine betyldon (-tilldon, -telldon v. ll. ) on nearo fasten</span>
							<span class="q-cite"> (Bd. 4, 26 ; Sch. 506, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:tyllan" class="xref-target">tyllan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nam-cūþ" d:title="nam-cūþ">
		<body>
			<h1>nam-cūþ<span class="pron"> | nɑm.kuːθ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Having the name well-known, celebrated, famous, of note, of renown</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nabochodonossor se namcūþa cining</span>
							<span class="q-cite"> (Ælfc. T. Grn. 8, 15)</span>
						</li>
						<li>
							<span class="q-en">a bit of every well-known plant</span>
							<span class="q-oe">Æ´lcre namcūþre wyrte dǣl</span>
							<span class="q-cite"> (Lchdm. i. 398, 9)</span>
						</li>
						<li>
							<span class="q-oe">Twegen sacerdas ðe ǣr on līfe wǣron swīðe namcūþe</span>
							<span class="q-cite"> (Homl. Th. ii. 342, 3)</span>
						</li>
						<li>
							<span class="q-oe">Heāhfæderas namcūþe weras (the twelve patriarchs)</span>
							<span class="q-cite"> (Ælfc. T. Grn. 5, 2: R. Ben. 33, 20)</span>
						</li>
						<li>
							<span class="q-en">in those assemblies, though advisedly they were made in places of note</span>
							<span class="q-oe">On ðām gemōtan ðeāh rǣdlīce wurðan on namcūðan stōwan</span>
							<span class="q-cite"> (L. Eth. ix. 37; Th. i. 348, 18)</span>
						</li>
						<li>
							<span class="q-en">the name of the rich man is better known in his country than that of the poor man</span>
							<span class="q-oe">Se rīca biþ namcūðre on his leōde ðonne se þearfa</span>
							<span class="q-cite"> (Homl. Th. i. 330, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ymb-sǣlan" d:title="ymb-sǣlan">
		<body>
			<h1>ymb-sǣlan<span class="pron"> | ymb.sæː.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to bind round, tie round</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">circumdaretur</span>
							<span class="q-oe">Siē unbunden (ymbunden, Lind.) ł unsǣled (=ymbsǣled)</span>
							<span class="q-cite"> (Mk. Skt. Rush. 9, 42)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tȳdre" d:title="tȳdre">
		
		<body>
			<h1>tȳdre<span class="pron"> | tyː.dre |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:tīdre" class="xref-target">tīdre</a>, <a href="x-dictionary:r:on-tȳdre" class="xref-target">on-tȳdre</a>, <a href="x-dictionary:r:un-tȳdre" class="xref-target">un-tȳdre</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flāh" d:title="flāh">
		<body>
			<h1>flāh<span class="pron"> | flɑːx |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Insidious, artful, deceitful, fraudulent</span>
						<span class="meaning-la"> (Lat. subdŏlus, fraudŭlentus, infestus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">when the deceitful impious fiend knows that</span>
							<span class="q-oe">Ðonne ðæt gecnāweþ flāh feōnd gemāh</span>
							<span class="q-cite"> (Exon. 97a; Th. 362, 19; Wal. 39)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gesilt" d:title="un-gesilt">
		<body>
			<h1>un-gesilt<span class="pron"> | un.Ge.silt |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unsalted</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Swīnen smeru ungesylt</span>
							<span class="q-cite"> (Lchdm. i. 146, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-silt" class="xref-target">un-silt</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sciran" d:title="sciran">
		<body>
			<h1>sciran<span class="pron"> | ʃi.rɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to make clear what is hidden or obscure, declare, tell, make known</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Drihten ðæt ongeat and geseah, ðæt se deōfol ðone Iudas lǣrde, ðæt hē hine belǣwde. Ac ðæt hē ðeāhhwæðere geðyldelīce ābær and gemetfæstlīce scīrde (did not declare it in terms of strong reprobation)</span>
							<span class="q-cite"> (Homl. As. 154, 68)</span>
						</li>
						<li>
							<span class="q-oe">Gif hiē eallunga forberan ne mǣgen ðæt hiē hit ne scīren, ðonne sprecen hiē ymbe his unþeāwas.</span>
							<span class="q-cite"> (Past. 28; Swt. 198, 9)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt hit sceāden mǣl scȳran mōste, cwealmbealu cȳðan,</span>
							<span class="q-cite"> (Beo. Th. 3883; B. 1939)</span>
						</li>
						<li>
							<span class="q-oe">God ðe soðe shire,</span>
							<span class="q-cite"> (Gen. and Ex. 2036)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to make clear by distinguishing between things, to distinguish, decide</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">disceplavero</span>
							<span class="q-oe">Scīro</span>
							<span class="q-cite"> (Txts. 57, 688)</span>
						</li>
						<li>
							<span class="q-oe">Is gehāten ðæt hē wille cueðan, 'Gewītaþ from mē āwiergde.' Ne scīrþ hē nō hwæðer hē reāfoden oððe hwelc ōðer yfel fremeden (no distinction is made in the sentence between various kinds of evil)</span>
							<span class="q-cite"> (Past. 44; Swt. 329, 7)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt gē ne scīraþ you do not bring out that (the difference between a man in his youth and in mature age) clearly,</span>
							<span class="q-cite"> (Exon. Th. 132, 21 ; Gū. 476)</span>
						</li>
						<li>
							<span class="q-oe">He hēt wurpan ac hē ne scȳrde on hwæðere healfe hī ðæt net wurpan</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sworettan" d:title="sworettan">
		<body>
			<h1>sworettan<span class="pron"> | swo.ret.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">ut cibum suavem saltem suspirando gustarent</span>
						<span class="q-oe">Tō þon ꝥ hī þone swētan mete hūru sworettende and geōmriende onbyrgdon</span>
						<span class="q-cite"> (Gr. D. 170, 10)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flsc-lacu" d:title="flsc-lacu">
		<body>
			<h1>flsc-lacu<span class="pron"> | flʃ.lɑ.ku |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:lacu" class="xref-target">lacu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ābeden" d:title="ābeden">
		<body>
			<h1>ābeden<span class="pron"> | ɑː.be.den |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">asked; pp. of ābiddan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ābiddan" class="xref-target">ābiddan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fela-mōdig" d:title="fela-mōdig">
		<body>
			<h1>fela-mōdig<span class="pron"> | fe.lɑ.moː.diG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Very daring</span>
						<span class="meaning-la"> (Lat. fortissimus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the men bore from the shore the heads of the very bold</span>
							<span class="q-oe">Men from ðæm holmclife hafelan bǣron felamōdigra</span>
							<span class="q-cite"> (Beo. Th. 3278; B. 1637)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hirting" d:title="hirting">
		<body>
			<h1>hirting<span class="pron"> | xir.ting |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Refreshing treatment</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">medicus ... putrida fibrarum procurans ulcera fotu, Ald. 150, 16</span>
							<span class="q-oe">Hyrtinge fotu</span>
							<span class="q-cite"> (An. Ox. 17, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bed-rida" d:title="bed-rida">
		<body>
			<h1>bed-rida<span class="pron"> | bed.ri.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">one bedridden</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bed-reda" class="xref-target">bed-reda</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bār-spreōt" d:title="bār-spreōt">
		<body>
			<h1>bār-spreōt<span class="pron"> | bɑːr.spre͜oːt |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A boar spear</span>
						<span class="meaning-la"> (Lat. venabulum)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bār-spere" class="xref-target">bār-spere</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="glitinian" d:title="glitinian">
		
		<body>
			<h1>glitinian<span class="pron"> | gli.ti.ni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To glitter, glisten, shine</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he saw gold glisten</span>
							<span class="q-oe">Geseah gold glitinian</span>
							<span class="q-cite"> (Beo. Th. 5509; B. 2758)</span>
						</li>
						<li>
							<span class="q-en">she glittered amid the angels as the shining sun</span>
							<span class="q-oe">Heō glytenode on ðæra engla mydle swā scȳnende sunne</span>
							<span class="q-cite"> (Shrn. 149, 7)</span>
						</li>
						<li>
							<span class="q-la">vestimenta ejus facta sunt splendentia</span>
							<span class="q-oe">His reāf wurdon glitiniende</span>
							<span class="q-cite"> (Mk. Skt. 9, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-helan" d:title="for-helan">
		<body>
			<h1>for-helan<span class="pron"> | for.xe.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">with acc.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gif hwilc tūnes man ǣnigne pænig forhele oþþe forhæbbe,</span>
									<span class="q-cite"> (Ll. Th. ii. 300, 5)</span>
								</li>
								<li>
									<span class="q-oe">Nǣnne sacleāsan man forsecgean, ne nǣnne sacne forhelan,</span>
									<span class="q-cite"> (i. 294, 6)</span>
								</li>
								<li>
									<span class="q-oe">Hū magan þā cyningas forhelan hiora unmihte,</span>
									<span class="q-cite"> (Bt. 29, 1; F. 104, 13)</span>
								</li>
								<li>
									<span class="q-oe">Ic þē ārecce, nāht ne forhelende (-hæl-, v. l.),</span>
									<span class="q-cite"> (Hml. S. 23 b, 319)</span>
								</li>
								<li>
									<span class="q-oe">Hit forholen beōn ne mihte,</span>
									<span class="q-cite"> (Gr. D. 60, 20)</span>
								</li>
								<li>
									<span class="q-oe">Hū nytt bið se forholena cræft?,</span>
									<span class="q-cite"> (Past. 377, 7)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1 a)</span>
										<span class="meaning-en">with dat. of person from whom something is concealed</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ꝥ hē ðæs hālgan hǣse forhule (-hǣle, v. l.) his hlāforde,</span>
											<span class="q-cite"> (Hml. S. 21, 81)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">with clause (and dat. of person)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē forhæl him ðæt hē hine eft ðreātian wolde,</span>
									<span class="q-cite"> (Past. 185, 24)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hȳrnes" d:title="ge-hȳrnes">
		<body>
			<h1>ge-hȳrnes<span class="pron"> | je.xyːr.nes |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A hearing, report</span>
						<span class="meaning-la"> (Lat. auditus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">audietis, et non intelligetis</span>
							<span class="q-oe">Of gehȳrnysse gē gehȳraþ, and gē ne ongytaþ</span>
							<span class="q-cite"> (Mt. Bos. 13, 14 : Blickl. Homl. 55, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hȳrnes" class="xref-target">hȳrnes</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hrīðeren" d:title="hrīðeren">
		<body>
			<h1>hrīðeren<span class="pron"> | xriː.θe.ren |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Of cattle</span>
						<span class="meaning-la"> (Lat. bovinus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">take ox-flesh</span>
							<span class="q-oe">Genim hrȳðeren flǣsc</span>
							<span class="q-cite"> (L. M. 2, 7; Lchdm. ii. 186, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þreāpung" d:title="þreāpung">
		<body>
			<h1>þreāpung<span class="pron"> | θræ͜ɑː.pung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Rebuke, reproof</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">correpti mens repente ad odium proruit, si hanc immoderata increpatio, plus quam debuit, affligit</span>
							<span class="q-oe">Ðæt geðreātade mōd bið suīðe raðe gehwierfed tō fiōunga gif him mon tō ungemetlīce mid ðære ðreāpunga (ðreāwunga, Cott. MSS.) oferfylgð suīður ðonne mon ðyrfe</span>
							<span class="q-cite"> (Past. 21; Swt. 167, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:þreāpian" class="xref-target">þreāpian</a>, <a href="x-dictionary:r:þreāpung" class="xref-target">þreāpung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ymb-sittend" d:title="ymb-sittend">
		<body>
			<h1>ymb-sittend<span class="pron"> | ymb.sit.tend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">One living on the borders of another's country, a neighbour</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif ic ðæt gefricge, ðæt ðec ymbsittend (those that sit on thy borders) egesan þȳwaþ</span>
							<span class="q-cite"> (Beo. Th. 3658; B. 1827)</span>
						</li>
						<li>
							<span class="q-oe">Him ǣghwylc ðara ymbsittendra hȳran sceolde</span>
							<span class="q-cite"> (18; B. 9: Elen. Kmbl. 65; El. 33)</span>
						</li>
						<li>
							<span class="q-oe">Ymbesittendra</span>
							<span class="q-cite"> (Beo. Th. 5461; B. 2734)</span>
						</li>
						<li>
							<span class="q-la">facti sumus in opprobrium vicinis nostris</span>
							<span class="q-oe">Wē synd gewordene eallum edwītstæf ymbsittendum</span>
							<span class="q-cite"> (Ps. Th. 78, 4:88, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eā-rixe" d:title="eā-rixe">
		<body>
			<h1>eā-rixe<span class="pron"> | æ͜ɑː.rik.se |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A water-rush</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">take roots of water-rushes</span>
							<span class="q-oe">Nim eārixena wyrtruman</span>
							<span class="q-cite"> (Lchdm. iii. 122, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eā-risc" class="xref-target">eā-risc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōre" d:title="fōre">
		<body>
			<h1>fōre<span class="pron"> | foː.re |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -fōre, dative sg: -fōre, accusative sg: -fōre</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">gen. dat. acc. of fōr a going, journey, course, approach</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fōr" class="xref-target">fōr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hǣþ-cole" d:title="hǣþ-cole">
		<body>
			<h1>hǣþ-cole<span class="pron"> | xæːθ.ko.le |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Cassis, galea</span>
						<span class="meaning-la"> (Lat. Cassis, galea)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ēcan" d:title="ēcan">
		
		
		
		<body>
			<h1>ēcan<span class="pron"> | eː.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -ēce, 2sg: -ēcest, 3sg: -ēcþ, pl: -ēcaþ</b>
				</p>
				<p>
					<b class="ending">past: sg: -ēcte, pl: -ēcton, pl: -ēhton</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ēced</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To EKE, increase, prolong, add</span>
						<span class="meaning-la"> (Lat. augēre, appōněre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thou shalt increase thy wretchedness</span>
							<span class="q-oe">Dū scealt ēcan ðīne yrmþu</span>
							<span class="q-cite"> (Andr. Kmbl. 2767; An. 1386)</span>
						</li>
						<li>
							<span class="q-en">ye increase your poverty</span>
							<span class="q-oe">Gē ēcaþ eōwre ermþe</span>
							<span class="q-cite"> (Bt. 26, 2; Fox 94, 9)</span>
						</li>
						<li>
							<span class="q-en">that augments his misery</span>
							<span class="q-oe">Ðæt ēcþ his ermþa</span>
							<span class="q-cite"> (29, 1; Fox 102, 19)</span>
						</li>
						<li>
							<span class="q-en">he prolonged the speech with verse</span>
							<span class="q-oe">Ēcte ðæt spell mid leōþe</span>
							<span class="q-cite"> (12; Fox 36, 6: Ps. Th. 104, 20)</span>
						</li>
						<li>
							<span class="q-la">apŏsuērunt adhuc peccāre ei</span>
							<span class="q-oe">Hī hira firena furður ēhton</span>
							<span class="q-cite"> (77, 19)</span>
						</li>
						<li>
							<span class="q-la">ut non appōnat ultra magnificāre se hŏmo sŭper terram</span>
							<span class="q-oe">Ðæt se awyrgeda ne ēce, ðæt he hine leng myclie ofer eorþan</span>
							<span class="q-cite"> (9, 38)</span>
						</li>
						<li>
							<span class="q-la">quid dētur tĭbi aut quid appōnātur tĭbi a lingua dŏlōsa?</span>
							<span class="q-oe">Hwæt biþ ðē ealles seald oððe ēced swā from ðære inwitfullan yflan tungan</span>
							<span class="q-cite"> (119, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:æt-ēcan" class="xref-target">æt-ēcan</a>, <a href="x-dictionary:r:ge-ēcan" class="xref-target">ge-ēcan</a>, <a href="x-dictionary:r:to-ēcan" class="xref-target">to-ēcan</a>, <a href="x-dictionary:r:to-æt-ēcan" class="xref-target">to-æt-ēcan</a>, <a href="x-dictionary:r:to-ge-ēcan" class="xref-target">to-ge-ēcan</a>, <a href="x-dictionary:r:to-æt-ȳcnys" class="xref-target">to-æt-ȳcnys</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mūs" d:title="mūs">
		<body>
			<h1>mūs<span class="pron"> | muːs |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se micela ylp . . . ondrǣt him for þearle, gif hē gesihð āne mūs, ðeāh ðe seō mūs ne mage his micelnysse derian.</span>
							<span class="q-cite"> (Hml. A. 64, 258.)</span>
						</li>
						<li>
							<span class="q-oe">Wiþ weartum, genim hundes micgean and mūse blōd, meng tōsomne, smire mid,</span>
							<span class="q-cite"> (Lch. ii. 322, 12.)</span>
						</li>
						<li>
							<span class="q-la">mures Indici in castra pergebant uulpibus similes,</span>
							<span class="q-oe">Cwōman Indisce mȳs īn þā fyrd in foxa gelīcnisse</span>
							<span class="q-cite"> (Nar. 16, 5.)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="folc-stede" d:title="folc-stede">
		<body>
			<h1>folc-stede<span class="pron"> | folk.ste.de |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a battle-place, battle-field</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scrīn" d:title="scrīn">
		<body>
			<h1>scrīn<span class="pron"> | ʃriːn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a chest, coffer, casket, box in which precious things are kept</span>
						<span class="meaning-la"> (Lat. arca vel scrinium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Scrīn arca vel scrinium</span>
							<span class="q-cite"> (Wrt. Voc. i. 26, 49)</span>
						</li>
						<li>
							<span class="q-oe">capsella</span>
							<span class="q-cite"> (33, 62)</span>
						</li>
						<li>
							<span class="q-oe">arca</span>
							<span class="q-cite"> (80, 79)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt hālige scrīn the ark of the covenant.</span>
							<span class="q-cite"> (Homl. Th. ii. 214, 35: Jos. 4, 7)</span>
						</li>
						<li>
							<span class="q-oe">Godes scrīn</span>
							<span class="q-cite"> (7, 6: Num. 14, 10)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt scrīn</span>
							<span class="q-cite"> (Jos. 3, 8, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hē ( Judas) hæfde scrīn (loculos) and baer ða þing ðe man sende</span>
							<span class="q-cite"> (Jn. Skt. 12, 6: 13, 29)</span>
						</li>
						<li>
							<span class="q-oe">Hire scrīn mid hiræ hāligdōmæ</span>
							<span class="q-cite"> (Chart. Th. 553, 12)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a receptacle for the relics of a saint, a shrine</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se earm wearð gelēd on scrine of seolfre āsmiðod on Sancte Petres mynstre</span>
							<span class="q-cite"> (Swt. A. S. Rdr. 99, 143)</span>
						</li>
						<li>
							<span class="q-oe">Ðā þwōh man ða hālgan bān, and bær intō ðære cyrcan on scrīne</span>
							<span class="q-cite"> (100, 158)</span>
						</li>
						<li>
							<span class="q-la">ego tuli reliquias beatae Margaretae et reposui in scrinio, quod feci de lapide</span>
							<span class="q-oe">Ic genam ða reliquias ðære hālgan fǣmnan and hī gesætte on scrīn ðæt ic sylf ǣr of stāne geworhte</span>
							<span class="q-cite"> (Nar. 49, 7)</span>
						</li>
						<li>
							<span class="q-oe">Ðā gebrohte se bisceop ealle ða hālgan bān on gelimplīcum scrȳnum, and gelōgodon hī up on cyrcan</span>
							<span class="q-cite"> (Homl. Skt. i. 11, 275)</span>
						</li>
						<li>
							<span class="q-oe">Ðā wolde se cāsere wyrcan him eallum (the seven sleepers) gyldene scrȳn</span>
							<span class="q-cite"> (Homl. Th. ii. 426, 22)</span>
						</li>
						<li>
							<span class="q-oe">Hī nāmen ðære (in the minster) twā gildene scrīnes and .lx. seolferne</span>
							<span class="q-cite"> (Chr. 1070; Erl. 209, 11)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a cage in which a criminal is confined</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hig Pilatum on ānum ȳsenum scrȳne gebrohton on ðære byrig Damascum, and hyne myd scrȳne myd eallum on feastum cwearterne beclȳsdon</span>
							<span class="q-cite"> (St. And. 38, 8: 44, 19)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣg-wern" d:title="ǣg-wern">
		<body>
			<h1>ǣg-wern<span class="pron"> | æːj.wern |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ǣg-hwǣr" class="xref-target">ǣg-hwǣr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dirn-licgan" d:title="dirn-licgan">
		<body>
			<h1>dirn-licgan<span class="pron"> | dirn.lidʒ.dʒɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to fornicate, commit adultery</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">omnes qui fornicantur</span>
							<span class="q-oe">Alle ðā dernliggað</span>
							<span class="q-cite"> (Ps. Srt. 72, 27)</span>
						</li>
						<li>
							<span class="q-la">ne adulteris</span>
							<span class="q-oe">Ꝥ ðū ne dernelice</span>
							<span class="q-cite"> (Mk. L. R. 10, 19)</span>
						</li>
						<li>
							<span class="q-la">mecharum</span>
							<span class="q-oe">Dyrnlicendra</span>
							<span class="q-cite"> (Wrt. Voc. ii. 55, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:dyrn-licgan" class="xref-target">dyrn-licgan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-þegnian" d:title="under-þegnian">
		<body>
			<h1>under-þegnian<span class="pron"> | un.der.θe.ɣni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-la"> (Lat. subministrare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">subministrat</span>
							<span class="q-oe">Underþēnaþ subministrat</span>
							<span class="q-cite"> (Scint. 5, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-wæterian" d:title="ge-wæterian">
		<body>
			<h1>ge-wæterian<span class="pron"> | je.wæ.te.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to supply animals with water</span>
							</p>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to water plants (lit. or fig.)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ðonne grēwð ðæt</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="freōnd-scipe" d:title="freōnd-scipe">
		
		<body>
			<h1>freōnd-scipe<span class="pron"> | fre͜oːnd.ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">FRIENDSHIP</span>
						<span class="meaning-la"> (Lat. amīcitia)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">our friendship is now as it had not been</span>
							<span class="q-oe">Is nū swā hit nō wǣre freōndscipe uncer</span>
							<span class="q-cite"> (Exon. 115 a; Th. 443, 4; Kl. 25)</span>
						</li>
						<li>
							<span class="q-en">let him forfeit the friendship of us all, and all that he has</span>
							<span class="q-oe">Þolige ūre ealra freōndscipes, and ealles ðæs ðe he āge</span>
							<span class="q-cite"> (L. Ed. 8; Th. i. 164, 4: L. Ath. i. 26; Th. i. 214, 5)</span>
						</li>
						<li>
							<span class="q-en">by my friendship</span>
							<span class="q-oe">Be mīnum freōndscipe</span>
							<span class="q-cite"> (i. prm; Th. i. 194, 5; L. Edg. S. 1; Th. i. 272, 5)</span>
						</li>
						<li>
							<span class="q-en">by the friendship of these monks</span>
							<span class="q-oe">Fram ðyssa muneca freōndscipe</span>
							<span class="q-cite"> (Bd. 3, 5; S. 526, 18)</span>
						</li>
						<li>
							<span class="q-en">they confirmed full friendship</span>
							<span class="q-oe">Man fullne freōndscipe gefæstnode</span>
							<span class="q-cite"> (Chr. 1014; Erl. 150, 14: 1016; Erl. 159, 3)</span>
						</li>
						<li>
							<span class="q-en">that peace and friendship be lawfully observed</span>
							<span class="q-oe">Ðæt man friþ and freōndscipe rihtlīce healde</span>
							<span class="q-cite"> (L. Eth. v. 1; Th. i. 304, 10: vi. 8; Th. i. 316, 28)</span>
						</li>
						<li>
							<span class="q-en">ye might foster friendship</span>
							<span class="q-oe">Git mōston freōndscype fremman</span>
							<span class="q-cite"> (Exon. 123 a; Th. 473, 21; Bo. 18)</span>
						</li>
						<li>
							<span class="q-en">he joins many people together with friendship</span>
							<span class="q-oe">Se gefēhþ fela folca tosomne mid freōndscipe</span>
							<span class="q-cite"> (Bt. Met. Fox 11, 179; Met. 11, 90)</span>
						</li>
						<li>
							<span class="q-en">new friendships</span>
							<span class="q-oe">Freōndscipas niwe</span>
							<span class="q-cite"> (Somn. 203; Lchdm. iii. 210, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fāmig" d:title="fāmig">
		
		<body>
			<h1>fāmig<span class="pron"> | fɑː.miG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">spumea mulctra</span>
						<span class="q-oe">Fāmbige melcingfata</span>
						<span class="q-cite"> (Germ. 390, 66)</span>
					</li>
					<li>
						<span class="q-la">spumosis (remorum) tractibus</span>
						<span class="q-oe">Ðǣm fāmigum drohtum</span>
						<span class="q-cite"> (Wrt. Voc. ii. 75, 13: Hpt. Gl. 406, 67)</span>
					</li>
					<li>
						<span class="q-oe">Fǣmigum</span>
						<span class="q-cite"> (An. Ox. 34: 4334: Hpt. Gl. 507, 71)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="filiende" d:title="filiende">
		<body>
			<h1>filiende<span class="pron"> | fi.li͜yn.de |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:fīlian" class="xref-target">fīlian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gliwian" d:title="gliwian">
		<body>
			<h1>gliwian<span class="pron"> | gli.wi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To adorn[?]</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Me gliwedon wrætlīc weorc smiþa</span>
							<span class="q-cite"> (Exon. 107 a; Th. 408, 17; Rä. 27, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scip-hlæst" d:title="scip-hlæst">
		<body>
			<h1>scip-hlæst<span class="pron"> | ʃip.xlæst |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">the body of (fighting) men on a ship</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Claudius consul contra hostem profectus superatus est. Et ipse quidem cum triginta navibus Lilybaeum confugit</span>
							<span class="q-oe">Claudius se consul fōr an Pūnice and him Hannibal ūt on sǣ ongeān com and ealle ofslōg būton .xxx. sciphlæsta ða ōþflugon tō Libeum ðæm īglande</span>
							<span class="q-cite"> (Ors. 4, 6; Swt. 178, 32)</span>
						</li>
						<li>
							<span class="q-oe">Hēr gefeaht Ecgbryht cyning wið .xxxv. sciphlæsta</span>
							<span class="q-cite"> (Chr. 833; Erl. 64, 19: 837; Erl. 66, 5: 840; Erl. 66, 19)</span>
						</li>
						<li>
							<span class="q-oe">Ælfrēd cyning gefeaht wið .vii. sciphlæstas and hiera ān gefēng and ða ōðru gefliēmde</span>
							<span class="q-cite"> (875; Erl. 78, 6)</span>
						</li>
						<li>
							<span class="q-oe">Ælfrēd cyning gefeaht wið feōwer sciphlæstas Deniscra monna, and ðara scipa tū genam</span>
							<span class="q-cite"> (882; Erl. 82, 10)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a ship of burden, a transport</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">oneraria</span>
							<span class="q-oe">Sciplæst oneraria</span>
							<span class="q-cite"> (Wrt. Voc. i. 63, 71)</span>
						</li>
						<li>
							<span class="q-la">honeraria</span>
							<span class="q-oe">Scyphlæst honeraria</span>
							<span class="q-cite"> (ii. 43, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stīga" d:title="stīga">
		<body>
			<h1>stīga<span class="pron"> | stiː.ɣɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A path</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Faestin vel ānstīgan, festin (-s, MS.) vel ānstīga termofilas</span>
							<span class="q-cite"> (Txts. 104, 1042)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:stīg" class="xref-target">stīg</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="deōfel-seōcnys" d:title="deōfel-seōcnys">
