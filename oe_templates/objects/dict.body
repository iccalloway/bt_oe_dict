<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-witfæst" d:title="ge-witfæst">
		<body>
			<h1>ge-witfæst<span class="pron"> | je.wit.fæst |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Of sound mind</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">no possessed person that was not in his right mind again</span>
							<span class="q-oe">Nǣnig deōfolseōc ðæt he eft wel gewitfæst nǣre</span>
							<span class="q-cite"> (Guthl. 15; Gdwin. 66, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sweoþol" d:title="sweoþol">
