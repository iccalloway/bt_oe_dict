<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="blīds" d:title="blīds">
		<body>
			<h1>blīds<span class="pron"> | bliːds |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">joy, gladness</span>
					</p>
