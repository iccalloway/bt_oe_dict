<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dreahnian" d:title="dreahnian">
		<body>
			<h1>dreahnian<span class="pron"> | dræ͜ɑ.xni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To strain out, drain</span>
						<span class="meaning-la"> (Lat. excolāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">drain [it] out through a woollen cloth</span>
							<span class="q-oe">Dreahna ūt þurh wyllene clāþ</span>
							<span class="q-cite"> (Lchdm. iii. 72, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:drehnigean" class="xref-target">drehnigean</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gafol-mǣd" d:title="gafol-mǣd">
		<body>
			<h1>gafol-mǣd<span class="pron"> | gɑ.fol.mæːd |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A meadow, the mowing of which was part of the gafol due from the churls on an estate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Healfne æcer gauolmǣde</span>
							<span class="q-cite"> (Th. Chart. 145, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wǣfels" d:title="wǣfels">
		
		<body>
			<h1>wǣfels<span class="pron"> | wæː.fels |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A covering, wrap, cloak, veil</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wǣfels tegmen</span>
							<span class="q-cite"> (Ælfc. Gr. 9, 12; Zup. 41, 1)</span>
						</li>
						<li>
							<span class="q-oe">Wǣfelses ł scȳtan sindonis</span>
							<span class="q-cite"> (Hpt. Gl. 494, 13)</span>
						</li>
						<li>
							<span class="q-oe">Wǣfel(se), basincge chlamide</span>
							<span class="q-cite"> (456, 46)</span>
						</li>
						<li>
							<span class="q-oe">Under wǣfelse velamento, indumento</span>
							<span class="q-cite"> (457, 24)</span>
						</li>
						<li>
							<span class="q-oe">Mid gewefenum wǣfelsa consuta plectra</span>
							<span class="q-cite"> (462, 63)</span>
						</li>
						<li>
							<span class="q-oe">Hī wǣdligende on ānum wāclīcum wǣfelse fērdon</span>
							<span class="q-cite"> (Homl. Th. i. 62, 29)</span>
						</li>
						<li>
							<span class="q-oe">On wǣfelse (tegmine) fyþera ðīnra</span>
							<span class="q-cite"> (Ps. Spl. 35, 8)</span>
						</li>
						<li>
							<span class="q-oe">Oferbrǣdels ł wǣfels opertorium</span>
							<span class="q-cite"> (Ps. Lamb. 101, 27)</span>
						</li>
						<li>
							<span class="q-oe">Ðam ðe wylle niman ðīne tunecan, lǣt him tō ðīnne wǣfels (pallium)</span>
							<span class="q-cite"> (Mt. Kmbl. 5, 40: Gen. 39, 12: 24, 65: Ap. Th. 11, 27)</span>
						</li>
						<li>
							<span class="q-oe">Ælmesgedāl dǣle man gelōme, mete ðām ofhingredum, wǣfels ðām nacedum</span>
							<span class="q-cite"> (Wulfst. 74, 4)</span>
						</li>
						<li>
							<span class="q-oe">Wēfels pallium</span>
							<span class="q-cite"> (Kent. Gl. 968)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ewerdla" d:title="ewerdla">
		<body>
			<h1>ewerdla<span class="pron"> | e.werd.lɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">damage</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:æf-werdla" class="xref-target">æf-werdla</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hūs-wist" d:title="hūs-wist">
		<body>
			<h1>hūs-wist<span class="pron"> | xuːs.wist |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A house, household</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">introibo in domum tuam</span>
							<span class="q-oe">Ic ingange on ðīnum hūswiste ł into ðīnum hūse</span>
							<span class="q-cite"> (Ps. Lamb. 5, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sang-bōc" d:title="sang-bōc">
		<body>
			<h1>sang-bōc<span class="pron"> | sɑng.boːk |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a music-book, a book with the notes marked for singing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nota ðæt is mearcung. Ðæra mearcunga sind manega and mislīce gesceapene, ǣgðer ge on sangbōcum ge on leōþcræfte</span>
							<span class="q-cite"> (Ælfc. Gr. 50, 15; Som. 51, 20)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">one of the service books, containing 'besides the canticles, the hymns which were used in the Anglo-Saxon churches.'</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðæt synd ða hālgan bēc ... sangbōc ...</span>
							<span class="q-cite"> (L. Ælfc. C. 21; Th. ii. 350, 13)</span>
						</li>
						<li>
							<span class="q-oe">Mæssepreōst sceal habban ... sang-bōc ...</span>
							<span class="q-cite"> (L. Ælfc. P. 44; Th. ii. 384, 1)</span>
						</li>
						<li>
							<span class="q-oe">Nū sindon ðǣr (in the church at Exeter) ii. fulle sangbēc.</span>
							<span class="q-cite"> (Chart. Th. 430, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-sceap" d:title="for-sceap">
		<body>
			<h1>for-sceap<span class="pron"> | for.ʃæ͜ɑp |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">What is for- or mis-shapen a fault, crime</span>
						<span class="meaning-la"> (Lat. malefactum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the serpent incited me to crime</span>
							<span class="q-oe">Me nædre to forsceape scyhte</span>
							<span class="q-cite"> (Cd. 42; Th. 55, 22; Gen. 898)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwilc-ness" d:title="hwilc-ness">
		<body>
			<h1>hwilc-ness<span class="pron"> | xwilk.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Quality</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sume synd qualitalis ðe getācniaþ hwilcnysse</span>
							<span class="q-cite"> (Ælfc. Gr. 38; Som. 40, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hwilcness" class="xref-target">ge-hwilcness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-wunung" d:title="in-wunung">
		<body>
			<h1>in-wunung<span class="pron"> | in.wu.nung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">In-dwelling, residence</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Forlǣtað hī þone godcundan þeōwdōm and þæs mynstres inwununge</span>
							<span class="q-cite"> (Chrd. 10, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:on-wunung" class="xref-target">on-wunung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Deōr-hām" d:title="Deōr-hām">
		<body>
			<h1>Deōr-hām<span class="pron"> | de͜oːr.xɑːm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">DERHAM, Gloucestershire, DEREHAM, Norfolk</span>
						<span class="meaning-la"> (Lat. locōrum nōmen in agris Glocestriæ et Norfolciæ)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they slew three kings at the place which is called Derham</span>
							<span class="q-oe">Hī iii ciningas ofslōgon in ðære stōwe ðe is gecweden Deōrhām</span>
							<span class="q-cite"> (Chr. 577; Erl. 19, 21)</span>
						</li>
						<li>
							<span class="q-en">in this year [A. D. 798] the body of Wihtburh was found at Dereham, all whole and uncorrupted, five and fifty years after she had departed from this life</span>
							<span class="q-oe">On ðysum geāre Wihtburge līchama wearþ gefunden eal gehāl and unformolsnod æt [MS. a] Deōrhām, æfter fīf and fīfti geāran ðæs [MS. þas] ðe heō of ðysum līfe [MS. liue] gewāt</span>
							<span class="q-cite"> (Chr. 798; Th. 105, 15-21, col. 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gihsinga" d:title="gihsinga">
		<body>
			<h1>gihsinga<span class="pron"> | Gix.sin.gɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-la"> (Lat. exugia)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="all-wihta" d:title="all-wihta">
		<body>
			<h1>all-wihta<span class="pron"> | ɑll.wix.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">all beings</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Protector of all creatures</span>
							<span class="q-oe">Helm allwihta</span>
							<span class="q-cite"> (Cd. 64; Th. 78, 9; Gen. 1290)</span>
						</li>
						<li>
							<span class="q-en">Lord of all creatures</span>
							<span class="q-oe">Meotud allwihta</span>
							<span class="q-cite"> (Exon. 53a; Th. 185, 9; Az. 5)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eall-wihta" class="xref-target">eall-wihta</a>, <a href="x-dictionary:r:wiht" class="xref-target">wiht</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Galleas" d:title="Galleas">
		<body>
			<h1>Galleas<span class="pron"> | gɑl.læ͜ɑs |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Gauls, the French</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:Gallias" class="xref-target">Gallias</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-stenc" d:title="un-stenc">
		<body>
			<h1>un-stenc<span class="pron"> | un.stenk |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bad smell, stench</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">foetor ingenti complet putredine nares</span>
							<span class="q-oe">Hȳ mid nosan ne magon nāht geswæccan būtan unstences ormǣtnesse</span>
							<span class="q-cite"> (Dōm. L. 207)</span>
						</li>
						<li>
							<span class="q-oe">Niht elles gestincan būton unstenca ormǣtnessa</span>
							<span class="q-cite"> (Wulfst. 139, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weōd" d:title="weōd">
		<body>
			<h1>weōd<span class="pron"> | we͜oːd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A useless or injurious plant, a weed</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">faenum agri, quod in clibanum mittitur</span>
							<span class="q-oe">Æceres weōd, ðæt ðe bið on ofen āsend</span>
							<span class="q-cite"> (Mt. Kmbl. 6, 30)</span>
						</li>
						<li>
							<span class="q-oe">Hwonan hæfð hit ðæt weōd (zizania) ?</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 13, 27)</span>
						</li>
						<li>
							<span class="q-oe">Is āwriten ðæt hē sēwe ðæt weōd on ða gōdan ǣceras</span>
							<span class="q-cite"> (Past. 47 ; Swt. 357, 17)</span>
						</li>
						<li>
							<span class="q-oe">Ðā æteāwde ða weōd</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 13, 26, 25, 29, 30)</span>
						</li>
						<li>
							<span class="q-oe">Mōtan ealle weōda nū wyrtum āspringan.</span>
							<span class="q-cite"> (Lchdm. iii. 36, 26)</span>
						</li>
						<li>
							<span class="q-oe">Swā hwā swā wille sāwan westmbǣre land, ātiō ǣrest of ealle ða weōd ðe hē gesiō, ðæt ðām æcerum derigen</span>
							<span class="q-cite"> (Bt. 23; Fox 78, 23 : Met. 12, 4, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-weōd" class="xref-target">un-weōd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-ter" d:title="ge-ter">
		<body>
			<h1>ge-ter<span class="pron"> | je.ter |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A tearing</span>
						<span class="meaning-la"> (Lat. dilaceratio)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-embehtan" d:title="ge-embehtan">
