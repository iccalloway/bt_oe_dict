			<p class="xref">See also: <a href="x-dictionary:r:nīd-" class="xref-target">nīd-</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wudu-wēsten" d:title="wudu-wēsten">
		<body>
			<h1>wudu-wēsten<span class="pron"> | wu.du.weː.sten |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">wild woodland</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā flugon ða Bryt-Walas to ðām wuduwēstenum</span>
							<span class="q-cite"> (Chr. pref. ; Erl. 5, 12 note)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wudu-fæstenn" class="xref-target">wudu-fæstenn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-molten" d:title="ge-molten">
		<body>
			<h1>ge-molten<span class="pron"> | je.mol.ten |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">molten, melted</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-meltan" class="xref-target">ge-meltan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-streāgung" d:title="ge-streāgung">
		<body>
			<h1>ge-streāgung<span class="pron"> | je.stræ͜ɑː.ɣung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Vegetatio</span>
						<span class="meaning-la"> (Lat. Vegetatio)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Eāstre" d:title="Eāstre">
		
		<body>
			<h1>Eāstre<span class="pron"> | æ͜ɑː.stre |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On þāra Eāstrana mǣrsunge</span>
							<span class="q-cite"> (Bd. 3, 17; Sch. 272, 5)</span>
						</li>
						<li>
							<span class="q-la">usque in Pascha</span>
							<span class="q-oe">Oð Eāstru</span>
							<span class="q-cite"> (Chrd, 23, 36)</span>
						</li>
						<li>
							<span class="q-oe">Ǽr Eāstrun</span>
							<span class="q-cite"> (115, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fealu" d:title="fealu">
