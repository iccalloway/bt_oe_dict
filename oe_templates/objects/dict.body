<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cyric-tūn" d:title="cyric-tūn">
		<body>
			<h1>cyric-tūn<span class="pron"> | Ky.riK.tuːn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ciric-tūn" class="xref-target">ciric-tūn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bær" d:title="bær">
		<body>
			<h1>bær<span class="pron"> | bær |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Add</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Bær without clothes</span>
							<span class="q-cite"> (Rä. 32, 22)</span>
						</li>
						<li>
							<span class="q-oe">Bare (nudam) rōde bar (mudus) folgaþ</span>
							<span class="q-cite"> (Scint. 218, 15)</span>
						</li>
						<li>
							<span class="q-oe">Hē læg on þǣre baran flōra</span>
							<span class="q-cite"> (Hml. S. 31, 853)</span>
						</li>
						<li>
							<span class="q-oe">Wīsdōm geseōn bærne</span>
							<span class="q-cite"> (Shrn. 186, 30)</span>
						</li>
						<li>
							<span class="q-oe">Hine lyst bet cyssan ōðerne on bær līc þonne þēr þǣr clāðas betweōnan beōð</span>
							<span class="q-cite"> (185, 31: 186, 1)</span>
						</li>
						<li>
							<span class="q-oe">Hē eōde ofer byrnende glēda mid his barum fōtum</span>
							<span class="q-cite"> (Hml. S. 5, 378)</span>
						</li>
						<li>
							<span class="q-oe">Hē tōbræc hire ceaflas mid his barum handum</span>
							<span class="q-cite"> (Ælfc. T. Grn. 7, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āhwelfan" d:title="āhwelfan">
		<body>
			<h1>āhwelfan<span class="pron"> | ɑː.xwel.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to cast down, cover over</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āhwylfan" class="xref-target">āhwylfan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="horsian" d:title="horsian">
		<body>
			<h1>horsian<span class="pron"> | xor.si.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To horse, provide with horses</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the people of Wessex provided the Danes with horses</span>
							<span class="q-oe">West Seaxe horsodon ðone here</span>
							<span class="q-cite"> (Chr. 1015; Erl. 153, 1)</span>
						</li>
						<li>
							<span class="q-oe">Hē beād ðæt man sceolde his here metian and horsian</span>
							<span class="q-cite"> (1013; Erl. 148. 3: 1014; Erl. 151, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-horsian" class="xref-target">be-horsian</a>, <a href="x-dictionary:r:ge-horsian" class="xref-target">ge-horsian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="SPELL-BŌC" d:title="SPELL-BŌC">
		<body>
			<h1>SPELL-BŌC<span class="pron"> | spell.boːk |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:SPIC" class="xref-target">SPIC</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fiet-mon" d:title="fiet-mon">
		<body>
			<h1>fiet-mon<span class="pron"> | fi͜yt.mon |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a sailor</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:flot-man" class="xref-target">flot-man</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwēsan" d:title="hwēsan">
		<body>
			<h1>hwēsan<span class="pron"> | xweː.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -hweōs</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To wheeze, make a noise in breathing, to breathe hard</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if he breathes with difficulty</span>
							<span class="q-oe">Gif hē mid earfoþnysse hwēst</span>
							<span class="q-cite"> (Lchdm. iii. 122, 3)</span>
						</li>
						<li>
							<span class="q-oe">Hē hwēst swȳðe hefelīce</span>
							<span class="q-cite"> (126, 9)</span>
						</li>
						<li>
							<span class="q-en">he wheezed terribly</span>
							<span class="q-oe">Hē egeslīce hweōs</span>
							<span class="q-cite"> (Homl. Th. i. 86, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nāðor" d:title="nāðor">
		<body>
			<h1>nāðor<span class="pron"> | nɑː.θor |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">selfra, 14, 1</span>
						<span class="q-cite"> (Fox 42, 9)</span>
					</li>
					<li>
						<span class="q-oe">Hiē nāðer næfdon siððan, ne heora namon ne heora anweald</span>
						<span class="q-cite"> (Ors. 3, 1 ; Swt. 98, 7)</span>
					</li>
					<li>
						<span class="q-oe">Se ðe nāðor nele, ne leornian ne tǣcan</span>
						<span class="q-cite"> (Ælfc. Gr. pref. ; Som. 1, 34)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:nāðer" class="xref-target">nāðer</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="LĀÞ" d:title="LĀÞ">
		<body>
			<h1>LĀÞ<span class="pron"> | lɑːθ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Loathsome, hateful, hostile, grievous, painful</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lōma" d:title="lōma">
