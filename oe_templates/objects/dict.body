<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-gitol" d:title="ofer-gitol">
		
		<body>
			<h1>ofer-gitol<span class="pron"> | o.fer.Gi.tol |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Forgetful, oblivious</span>
						<span class="meaning-la"> (Lat. oblitus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non sum oblitus</span>
							<span class="q-oe">Ne eom ic ofergitol (-gittul, Ps. Th.) non sum oblitus</span>
							<span class="q-cite"> (Ps. Spl. 118, 61: 9, 19 : 9 second, 13)</span>
						</li>
						<li>
							<span class="q-oe">Ofergittol</span>
							<span class="q-cite"> (Ps. Th. 118, 41)</span>
						</li>
						<li>
							<span class="q-oe">Worda ðīnra ofergittul</span>
							<span class="q-cite"> (118, 15)</span>
						</li>
						<li>
							<span class="q-oe">Ofergyttol</span>
							<span class="q-cite"> (118, 43)</span>
						</li>
						<li>
							<span class="q-oe">Ne sȳ ofergyttol ac gemyndig</span>
							<span class="q-cite"> (R. Ben. 24, 1)</span>
						</li>
						<li>
							<span class="q-oe">Nā ofergeotol ðara gebeda his þearfena</span>
							<span class="q-cite"> (Ps. Th. 9, 12)</span>
						</li>
						<li>
							<span class="q-oe">Ofergeottul</span>
							<span class="q-cite"> (102, 2)</span>
						</li>
						<li>
							<span class="q-la">obliviosus</span>
							<span class="q-oe">Ofergeatul</span>
							<span class="q-cite"> (Rtl. 29, 7)</span>
						</li>
						<li>
							<span class="q-la">obliti non sumus</span>
							<span class="q-oe">Ofergeotele wē ne sind</span>
							<span class="q-cite"> (Ps. Surt. 43, 18)</span>
						</li>
						<li>
							<span class="q-oe">Ofergeotulæ (-geotole, Ps. Th. )</span>
							<span class="q-cite"> (43, 21)</span>
						</li>
						<li>
							<span class="q-oe">Ofergeotole</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 16, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ban-segn" d:title="ban-segn">
