					<p>
						<span class="meaning-en">Not accomplished, not done</span>
						<span class="meaning-la"> (Lat. infectum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ungeffremed infectum</span>
							<span class="q-cite"> (Wrt. Voc. ii. 87, 36)</span>
						</li>
						<li>
							<span class="q-oe">Ungefremed</span>
							<span class="q-cite"> (L. Ath. i. proem.; Th. i. 198, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
