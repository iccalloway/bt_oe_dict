<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æmete" d:title="æmete">
		
		<body>
			<h1>æmete<span class="pron"> | æ.me.te |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An EMMET, ant</span>
						<span class="meaning-la"> (Lat. formica)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Æmete formica</span>
							<span class="q-cite"> (Wrt. Voc. 23, 78)</span>
						</li>
						<li>
							<span class="q-en">take emmet's eggs</span>
							<span class="q-oe">Æmettan ægru genīm</span>
							<span class="q-cite"> (L. M. 1, 87; Lchdm, ii. 156, 6)</span>
						</li>
						<li>
							<span class="q-oe">Æmytte formica</span>
							<span class="q-cite"> (Somn. 108)</span>
						</li>
						<li>
							<span class="q-en">take emmets</span>
							<span class="q-oe">Nīme æmettan</span>
							<span class="q-cite"> (L. M. 3, 34; Lchdm, ii. 328, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leāf-hlystend" d:title="leāf-hlystend">
		<body>
			<h1>leāf-hlystend<span class="pron"> | læ͜ɑːf.xly.stend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A catechumen</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">[Ge?] leāfhlestend catechumenus</span>
							<span class="q-cite"> (Hpt. Gl. 457, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:geleāfhlystend" class="xref-target">geleāfhlystend</a>
