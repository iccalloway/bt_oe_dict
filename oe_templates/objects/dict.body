<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-drencan" d:title="on-drencan">
		<body>
			<h1>on-drencan<span class="pron"> | on.dren.kɑn |</span>
			</h1>
