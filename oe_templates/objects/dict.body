<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gēsne" d:title="gēsne">
		<body>
			<h1>gēsne<span class="pron"> | Geː.sne |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Lacking, wanting, destitute, lifeless</span>
						<span class="meaning-la"> (Lat. expers, egenus, destitutus, exanimis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the foul corpse lay lifeless</span>
							<span class="q-oe">Læg se fūla leāp gēsne</span>
							<span class="q-cite"> (Judth. 10; Thw. 23, 8; Jud. 112)</span>
						</li>
						<li>
							<span class="q-en">he then found his goldgiver void of spirit, deprived of life</span>
							<span class="q-oe">He funde ðā on bedde his goldgifan gǣstes gēsne, līfes belidenne</span>
							<span class="q-cite"> (12; Thw. 25, 26; Jud. 279)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gǣsne" class="xref-target">gǣsne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wēstness" d:title="wēstness">
