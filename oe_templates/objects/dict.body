<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bān-loca" d:title="bān-loca">
		<body>
			<h1>bān-loca<span class="pron"> | bɑːn.lo.kɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bone inclosure, the skin, body</span>
						<span class="meaning-la"> (Lat. ossium clausura, caro)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">lest the point enter in under the skin</span>
							<span class="q-oe">Ðȳ-læs se ord ingebuge under bānlocan</span>
							<span class="q-cite"> (Exon. 19a; Th. 48, 10; Cri. 769)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heona" d:title="heona">
		<body>
			<h1>heona<span class="pron"> | xe͜o.nɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:heonan" class="xref-target">heonan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-hildness" d:title="ā-hildness">
		<body>
			<h1>ā-hildness<span class="pron"> | ɑː.xild.ness |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">declinatio</span>
						<span class="q-oe">ā-hildness glosses declinatio</span>
						<span class="q-cite"> (Ps. Rdr. 72, 4)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="al-wealda" d:title="al-wealda">
		
		<body>
			<h1>al-wealda<span class="pron"> | ɑl.wæ͜ɑl.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">All-powerful, almighty</span>
						<span class="meaning-la"> (Lat. omnipotens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Alwalda God all-powerful God</span>
							<span class="q-cite"> (Exon. 25a; Th. 73, 17; Cri. 1191: 27b; Th. 83, 33; Cri. 1365)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eal-wealda" class="xref-target">eal-wealda</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dryht-leōþ" d:title="dryht-leōþ">
		<body>
			<h1>dryht-leōþ<span class="pron"> | dryxt.le͜oːθ |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A lordly song</span>
						<span class="meaning-la"> (Lat. nōbile carmen)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">king David sang a lordly song of him</span>
							<span class="q-oe">Be ðam David cyning dryhtleōþ agōl</span>
							<span class="q-cite"> (Elen. Kmbl. 684; El, 342)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-dīþan" d:title="ge-dīþan">
		
		<body>
			<h1>ge-dīþan<span class="pron"> | je.diː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to put to death, kill</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">morte moriatur</span>
							<span class="q-oe">Mið deāðe gedēðed sē</span>
							<span class="q-cite"> (Mk. L. R. 7, 10)</span>
						</li>
						<li>
							<span class="q-la">qua morte esset moriturus</span>
							<span class="q-oe">Of huælcum deāðe uēre sweltende ł gedēðet</span>
							<span class="q-cite"> (Jn. L. 12, 33)</span>
						</li>
						<li>
							<span class="q-la">ut interfaerentur</span>
							<span class="q-oe">Þte UNCERTAIN hiā woere gedēðed ł gecuelledo</span>
							<span class="q-cite"> (Lk. L. R. 23, 32)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to mortify (in the theological sense)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mortificatos carne</span>
							<span class="q-oe">Þte UNCERTAIN ūsig āgēfe Gode gidēðed līchome</span>
							<span class="q-cite"> (Rtl. 21, 32)</span>
						</li>
						<li>
							<span class="q-oe">Gidēðod</span>
							<span class="q-cite"> (25, 43)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:dīdan" class="xref-target">dīdan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wild-deōr" d:title="wild-deōr">
		
		<body>
			<h1>wild-deōr<span class="pron"> | wild.de͜oːr |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A wild animal, wild beast</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wilddeor fera</span>
							<span class="q-cite"> (Wrt. Voc. i. 22, 39)</span>
						</li>
						<li>
							<span class="q-oe">Ðis wilddeōr (wildeōr, v. l.) well fremaþ</span>
							<span class="q-cite"> (Lchdm. i. 330, 7)</span>
						</li>
						<li>
							<span class="q-oe">Wildeōr fera</span>
							<span class="q-cite"> (Wrt. Voc. i. 77, 76)</span>
						</li>
						<li>
							<span class="q-oe">Ne mæg hit wæter ne wildeōr beswīcan</span>
							<span class="q-cite"> (Salm. Kmbl. 571; Sal. 285)</span>
						</li>
						<li>
							<span class="q-oe">Wildiōr leena</span>
							<span class="q-cite"> (Kent. Gl. 989)</span>
						</li>
						<li>
							<span class="q-oe">Wildeōr bestiae</span>
							<span class="q-cite"> (Bd. 3, 23 ; S. 554, 24: Coll. Monast. Th. 22, 23)</span>
						</li>
						<li>
							<span class="q-oe">Swā hwæt swā wilddeōr ābiton</span>
							<span class="q-cite"> (Gen. 31, 39: 37, 20)</span>
						</li>
						<li>
							<span class="q-oe">Wildeōr</span>
							<span class="q-cite"> (Blickl. Homl. 95, 16 : Ex. 22, 13)</span>
						</li>
						<li>
							<span class="q-oe">Wildeōr bestiae agri</span>
							<span class="q-cite"> (23, II)</span>
						</li>
						<li>
							<span class="q-oe">Ealra wuda wildeōr omnes ferae sylvarum</span>
							<span class="q-cite"> (Ps. Th. 49, Ii : 103, 19)</span>
						</li>
						<li>
							<span class="q-oe">Wilddeōra ferarum</span>
							<span class="q-cite"> (Wrt. Voc. ii. 38, 32)</span>
						</li>
						<li>
							<span class="q-oe">Wilddeōra holl and denn lustra</span>
							<span class="q-cite"> (i. 59, 10: Soul Kmbl. 164; Seel. 82)</span>
						</li>
						<li>
							<span class="q-oe">Wildeōra þeāw</span>
							<span class="q-cite"> (Cd. Th. 252, 2; Dan. 572: 255, 10; Dan. 622)</span>
						</li>
						<li>
							<span class="q-oe">Uildeār (-deāra? -dera?) bestiarum</span>
							<span class="q-cite"> (Rtl. 117, 4)</span>
						</li>
						<li>
							<span class="q-oe">Anweald ofer wilddeōrum</span>
							<span class="q-cite"> (Hexam. II; Norm. 18, 16)</span>
						</li>
						<li>
							<span class="q-oe">Hē mid wilddeōrum (cum bestiis) wæs</span>
							<span class="q-cite"> (Mk. Skt. l, 13: Cd. Th. 256, 34; Dan. 650)</span>
						</li>
						<li>
							<span class="q-oe">Wildeorum</span>
							<span class="q-cite"> (Exon. Th. 146, 21 ; Gū. 713)</span>
						</li>
						<li>
							<span class="q-oe">Wildiōrum gelīcran ðonne monnum</span>
							<span class="q-cite"> (Bt. 38, 5 ; Fox 208, I)</span>
						</li>
						<li>
							<span class="q-oe">Ic āfyrre yfel wilddeōr (malas bestias)</span>
							<span class="q-cite"> (Lev. 26, 6)</span>
						</li>
						<li>
							<span class="q-oe">Ealle yfele wilddeōr</span>
							<span class="q-cite"> (Lchdm. i. 202, 13)</span>
						</li>
						<li>
							<span class="q-la">feras</span>
							<span class="q-oe">Wildeōr</span>
							<span class="q-cite"> (Lev. 26, 22 : Ps. Th. 67, 27)</span>
						</li>
						<li>
							<span class="q-oe">Nētena oððe wildeōr</span>
							<span class="q-cite"> (Bt. 38, 2 ; Fox 196, 18)</span>
						</li>
						<li>
							<span class="q-oe">Hwylce wildeōr (feras) swȳþost gefēhst ðū ? Ic gefō heortas, and bāras, and rægan, and hwīlon haran</span>
							<span class="q-cite"> (Coll. Monast. Th. 21, 29)</span>
						</li>
						<li>
							<span class="q-oe">Wyrmas and wildeōr</span>
							<span class="q-cite"> (Beo. Th. 2864; B. 1430)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wilde-deōr" class="xref-target">wilde-deōr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sam-wrǣdness" d:title="sam-wrǣdness">
		<body>
			<h1>sam-wrǣdness<span class="pron"> | sɑm.wræːd.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Combination, union</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">everything that has unity, that, we say, exists, while it maintains its unity, and the union of its parts we call good</span>
							<span class="q-la">omne, quod est, unum esse, ipsumque unum bonum esse didicisti,</span>
							<span class="q-oe">Eall ðæt ðætte ānnesse hæfþ þæt wē secgaþ ðætte sīe ða hwīle ðe hit ætsomne biþ and ða samwrǣdnesse wē hātaþ gōd</span>
							<span class="q-cite"> (Bt. 37, 3; Fox 190, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wrǣd" class="xref-target">wrǣd</a>, <a href="x-dictionary:r:wrǣd-mǣlum" class="xref-target">wrǣd-mǣlum</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bryne-welm" d:title="bryne-welm">
		
		<body>
			<h1>bryne-welm<span class="pron"> | bry.ne.welm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A burning flame, flame of fire, burning heat</span>
						<span class="meaning-la"> (Lat. incendii fervor vel æstus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the gift chair of the Goths was consumed by flames of fire</span>
							<span class="q-oe">Brynewylmum mealt gifstōl Geāta</span>
							<span class="q-cite"> (Beo. Th. 4642; B. 2326: Exon. 42a; Th. 142, 14; Gū. 644)</span>
						</li>
						<li>
							<span class="q-en">in hell they must endure great sorrow from the burning heat</span>
							<span class="q-oe">In helle heō brynewelme bīdan sceolden sāran sorge</span>
							<span class="q-cite"> (Cd. 213; Th. 266, 24; Sat. 27)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þurh-standan" d:title="þurh-standan">
		<body>
			<h1>þurh-standan<span class="pron"> | θurx.stɑn.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to persist, continue</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">secundo die cum nocte subsequent in precibus perstitit</span>
							<span class="q-oe">Þone æftran dæg mid his nihte on bēnum hē þurhstōd</span>
							<span class="q-cite"> (Gr. D. 200, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="firmetan" d:title="firmetan">
		
		<body>
			<h1>firmetan<span class="pron"> | fir.me.tɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:frimdig" class="xref-target">frimdig</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāst-weardes" d:title="eāst-weardes">
		<body>
			<h1>eāst-weardes<span class="pron"> | æ͜ɑːst.wæ͜ɑr.des |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Eastwards</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of direction</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ān scīnende weg mid rihte stige eāstweardes wæs āþæned tō heofonum</span>
									<span class="q-cite"> (Gr. D. 176, 2)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">of position</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē oðstōd eāstweardes wendende</span>
									<span class="q-cite"> (Hml. S. 33 b, 162)</span>
								</li>
								<li>
									<span class="q-oe">Hē geseah þæs wīfes līchaman orsāwle licgende, and þā handa . . . eāstweardes gewende</span>
									<span class="q-cite"> (743)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eāst-weard" class="xref-target">eāst-weard</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-feoht" d:title="ge-feoht">
		<body>
			<h1>ge-feoht<span class="pron"> | je.fe͜oxt |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">bellum vel pugna</span>
							<span class="q-oe">Gefeoht bellum vel pugna</span>
							<span class="q-cite"> (Wrt. Voc. i. 84, 15)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">fighting</span>
								<span class="meaning-en">fighting</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">in a military sense, war</span>
										<span class="meaning-en">in a military sense, war</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">praefeciales</span>
											<span class="q-oe">Gefeohtes bodan praefeciales</span>
											<span class="q-cite"> (Wrt. Voc. i. 36, 7)</span>
										</li>
										<li>
											<span class="q-la">duelli</span>
											<span class="q-oe">Gefeohtes duelli</span>
											<span class="q-cite"> (ii. 96, 27: 27, 28)</span>
										</li>
										<li>
											<span class="q-en">they suddenly attacked Judas</span>
											<span class="q-oe">Hī cōmon fǣrlīce mid gefeohte tō Judan</span>
											<span class="q-cite"> (Hml. S. 25, 653: 670)</span>
										</li>
										<li>
											<span class="q-oe">Þā nān man mid gefeohte ne gefōr</span>
											<span class="q-cite"> (Ors. 1. 2; S. 30, 20)</span>
										</li>
										<li>
											<span class="q-oe">Mid gefeohte sēcan</span>
											<span class="q-cite"> (3, 1; S. 98, 11)</span>
										</li>
										<li>
											<span class="q-oe">Mid gefeohte cnyssan</span>
											<span class="q-cite"> (S. 96, 8)</span>
										</li>
										<li>
											<span class="q-oe">Ymb gefeoht sprecan</span>
											<span class="q-cite"> (Met. 8, 32)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(a α)</span>
												<span class="sub-heading">rendering the personification Mars</span>
												<span class="meaning-en">rendering the personification Mars</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-la">Mavors</span>
													<span class="q-oe">Wīg oððe gefeoht Mavors</span>
													<span class="q-cite"> (Wrt. Voc. ii. 55, 37)</span>
												</li>
												<li>
													<span class="q-la">Martem</span>
													<span class="q-oe">Gefeoht Martem</span>
													<span class="q-cite"> (94, 18: 96, 23: 57, 14)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">fighting between two or more persons</span>
										<span class="meaning-en">fighting between two or more persons</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">of fighting by priests. If a priest slay a man.</span>
											<span class="q-oe">Be prēosta gefeohte. Gif preōst ōðerne man ofsleā</span>
											<span class="q-cite"> (Ll. Th. i. 74, 18)</span>
										</li>
										<li>
											<span class="q-oe">Be gefeohte. Gif hwā gefeohte on cyninges hūse ... Gif hwā on mynstre gefeohte ... And þeāh hit siē on middum felda gefohten</span>
											<span class="q-cite"> (106, 1-10)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">a fight, combat, battle, war</span>
								<span class="meaning-en">a fight, combat, battle, war</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">military, between opposing forces</span>
										<span class="meaning-en">military, between opposing forces</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">pugna</span>
											<span class="q-oe">Næs nā mid Rōmānum ǣr ne siþþan swā heard gefeoht (pugna) swā þǣr wæs</span>
											<span class="q-cite"> (Ors. 5, 7; S. 230, 13)</span>
										</li>
										<li>
											<span class="q-oe">On þǣre frymþe þæs gefeohtes</span>
											<span class="q-cite"> (Bl. H. 203, 5)</span>
										</li>
										<li>
											<span class="q-oe">Se eādiga Michael þǣr wæs tōweard him tō fultome ðā hwīle ðe hiē æt þǣm gefeohte wǣron</span>
											<span class="q-cite"> (205, 3)</span>
										</li>
										<li>
											<span class="q-oe">Æfter þissum gefeohte</span>
											<span class="q-cite"> (Chr. 871; P. 72, 5)</span>
										</li>
										<li>
											<span class="q-la">in bello publico</span>
											<span class="q-oe">On folces gefeohte in bello publico</span>
											<span class="q-cite"> (Ll. Th. ii. 150, 32: 386, 16)</span>
										</li>
										<li>
											<span class="q-oe">Ne gehērde nōn mon ymbe nān gefeoht sprecan</span>
											<span class="q-cite"> (Bt. 15; F. 48, 15)</span>
										</li>
										<li>
											<span class="q-oe">Ungelimplico gefeoht</span>
											<span class="q-cite"> (Bl. H. 107, 28)</span>
										</li>
										<li>
											<span class="q-la">bella</span>
											<span class="q-oe">Gefeoht bella</span>
											<span class="q-cite"> (Wülck. Gl. 255, 6)</span>
										</li>
										<li>
											<span class="q-la">iustum, iniustum, ciuile, plusquam ciuile. Iustum bellum</span>
											<span class="q-oe">Synd feōwer cynna gefeoht iustum, iniustum, ciuile, plusquam ciuile. Iustum bellum is rihtlic gefeoht wið da rēðan flotmenu</span>
											<span class="q-cite"> (Hml. S. 25, 705)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">a fight between two or more persons</span>
										<span class="meaning-en">a fight between two or more persons</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Gif man beforan æðelinge gefeoht āginneð, mid .CL. scillinga gebēte</span>
											<span class="q-cite"> (Ll. Th. i. 332, 3)</span>
										</li>
										<li>
											<span class="q-oe">Mē egleð swȳðe and ūs eallum þā unrihtlican and mænigfealdan gefeoht þe betwux ūs sylfum syndan; þonne cwǣde wē: Gif hwā ǣnigne man ofsleā ...</span>
											<span class="q-cite"> (Ll. Th. i. 246, 24)</span>
										</li>
										<li>
											<span class="q-oe">Be gefeohtum</span>
											<span class="q-cite"> (106, 1 note)</span>
										</li>
										<li>
											<span class="q-oe">Sē þe gefeohtu gesihð, blisse hit openað</span>
											<span class="q-cite"> (Lch. iii. 200, 7)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">figurative, conflict, struggle for victory</span>
								<span class="meaning-en">figurative, conflict, struggle for victory</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">commissio, conflictus</span>
									<span class="q-oe">Gefeoht commissio, conflictus</span>
									<span class="q-cite"> (Wrt. Voc. ii. 132, 22)</span>
								</li>
								<li>
									<span class="q-la">conflictu (vitiorum)</span>
									<span class="q-oe">Gefeohte conflictu (vitiorum)</span>
									<span class="q-cite"> (77, 1)</span>
								</li>
								<li>
									<span class="q-la">qui certat in agone</span>
									<span class="q-oe">Sē ðe gifehtað in gefeht qui certat in agone</span>
									<span class="q-cite"> (Rtl. 60, 15)</span>
								</li>
								<li>
									<span class="q-la">curramus propositum nobis certamen</span>
									<span class="q-oe">Iornia wē forārǣden ūs gifeht curramus propositum nobis certamen</span>
									<span class="q-cite"> (27, 29)</span>
								</li>
								<li>
									<span class="q-la">impugnatione spiritalis nequitiae</span>
									<span class="q-oe">Gifeht gāstlices wōghfulnisse impugnatione spiritalis nequitiae</span>
									<span class="q-cite"> (121, 9)</span>
								</li>
								<li>
									<span class="q-oe">Bið ā wið firenum in gefeoht gearo</span>
									<span class="q-cite"> (Crä. 90)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:flet-gefeoht" class="xref-target">flet-gefeoht</a>, <a href="x-dictionary:r:folc-gefeoht" class="xref-target">folc-gefeoht</a>, <a href="x-dictionary:r:in-gefeoht" class="xref-target">in-gefeoht</a>, <a href="x-dictionary:r:on-gefeoht" class="xref-target">on-gefeoht</a>, <a href="x-dictionary:r:scip-gefeoht" class="xref-target">scip-gefeoht</a>, <a href="x-dictionary:r:sige-gefeoht" class="xref-target">sige-gefeoht</a>, <a href="x-dictionary:r:þurh-gefeoht" class="xref-target">þurh-gefeoht</a>, <a href="x-dictionary:r:ūt-gefeoht" class="xref-target">ūt-gefeoht</a>, <a href="x-dictionary:r:weorold-gefeoht" class="xref-target">weorold-gefeoht</a>, <a href="x-dictionary:r:ge-feaht" class="xref-target">ge-feaht</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Scot-land" d:title="Scot-land">
		<body>
			<h1>Scot-land<span class="pron"> | ʃot.lɑnd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">Ireland, where the Scottas lived before migrating to the country now called Scotland</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On westende (of Europe) is Scotland</span>
							<span class="q-cite"> (Ors. 1, 1; Swt. 8, 27)</span>
						</li>
						<li>
							<span class="q-oe">Ān diācon wearð forþfēred on Sceot-lande (cf. an Scotta eālonde, 215, 21), and ðæs diācones nama wæs Njāl hāten</span>
							<span class="q-cite"> (Wulfst. 205, 16)</span>
						</li>
						<li>
							<span class="q-oe">Hī cōmon on Scotland (Hiberniam) upp</span>
							<span class="q-cite"> (Bd. l, l; S. 474, 10)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">Scotland</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hēr fōr Æþelstān cyning on Scotland (tō Scotlande in Scotiam, MS. F.)</span>
							<span class="q-cite"> (Chr. 934; Erl. 111, 9)</span>
						</li>
						<li>
							<span class="q-oe">Hē (Cnut) fōr tō Scotlande, and Scotta cyng him tō beāh, Mælcolm</span>
							<span class="q-cite"> (1031; Erl. 163, 20)</span>
						</li>
						<li>
							<span class="q-oe">Hē (Fursetis) fērde geond eal Ȳrrland and Scotland</span>
							<span class="q-cite"> (Homl. Th. ii. 346, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:Scottas" class="xref-target">Scottas</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cealc-crundel" d:title="cealc-crundel">
		<body>
			<h1>cealc-crundel<span class="pron"> | tʃæ͜ɑlk.krun.del |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a chalk ravine</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On cealccrundel</span>
							<span class="q-cite"> (C. D. iii. 419, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ācolmōdian" d:title="ācolmōdian">
		<body>
			<h1>ācolmōdian<span class="pron"> | ɑː.kol.moː.di.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-ācolmōdian" class="xref-target">ge-ācolmōdian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wæter-fæsten" d:title="wæter-fæsten">
		<body>
			<h1>wæter-fæsten<span class="pron"> | wæ.ter.fæ.sten |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A place protected by water</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he encamped as near to the Danes as the wood and water, which protected their position, would allow him to find sufficient room</span>
							<span class="q-oe">Hē gewīcode ðǣr ðǣr hē niēhst rȳmet hæfde for wudufæstenne ond for wæterfæstenne</span>
							<span class="q-cite"> (Chr. 894; Erl. 90, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āsǣd" d:title="āsǣd">
		<body>
			<h1>āsǣd<span class="pron"> | ɑː.sæːd |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">said out, related, told</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āsecgan" class="xref-target">āsecgan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swangorness" d:title="swangorness">
		<body>
			<h1>swangorness<span class="pron"> | swɑn.gor.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Heaviness, torpor, sloth, indolence, sluggishness</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic wāt ðæt swongorness hī ofsit and hī mid slǣwþe ofercymþ</span>
							<span class="q-cite"> (Bt. 36, 6; Fox 180, 33)</span>
						</li>
						<li>
							<span class="q-la">pecuniam quippe in sudario ligare est percepta dona sub otio lenti torporis abscondere</span>
							<span class="q-oe">Ðæt is ðæt hē ða Godes gifa becnytte on ðæm sceāte his slǣwðe and hē for his swongornesse hiē gehȳde</span>
							<span class="q-cite"> (Past. 9; Swt. 59, 16)</span>
						</li>
						<li>
							<span class="q-la">somnum quippe oculis dare est intentione cessante subditorum curam negligere . . . Non autem dormire, sed dormitare, est quae quidem reprehenda sunt cognoscere, sed tamen propter mentis taedium dignis ea increpationibus non emendare</span>
							<span class="q-oe">Ðæt is ðonne ðæt mon his eāge lǣte slāpian ðæt mon for his unwīsdōme and for his suongornesse ne mǣge ongietan ða unðeāwas ðara ðe him underðiēdde beōþ. Ne slǣpþ se nō fæsðe ac hnappaþ se ðe gecnāwan mæg hwæt tǣlwierðe biþ and suāðeāh for his mōdes swongornesse oððe rēceliēste forwandaþ ðæt hē bēte his hiēremenn</span>
							<span class="q-cite"> (28; Swt. 195, l-10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feorh-berende" d:title="feorh-berende">
		<body>
			<h1>feorh-berende<span class="pron"> | fe͜orx.be.ren.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Life-bearing, living</span>
						<span class="meaning-la"> (Lat. vītam fērens, vīvens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it will seek each of those bearing life</span>
							<span class="q-oe">Heō wile gesēcan ǣghwylcne feorhberendra</span>
							<span class="q-cite"> (Exon. 110 a; Th. 420, 19; Rä. 40, 6: Cd. 92; Th. 117, 17; Gen. 1955)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stealdan" d:title="stealdan">
		<body>
			<h1>stealdan<span class="pron"> | stæ͜ɑl.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -steōld</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To possess</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic staðolǣhtum steōld</span>
							<span class="q-cite"> (Exon. Th. 353, 33; Reim. 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlāford-leās" d:title="hlāford-leās">
		<body>
			<h1>hlāford-leās<span class="pron"> | xlɑː.ford.læ͜ɑːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Lordless, not having a lord</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">to taunt me that I return home without my lord</span>
							<span class="q-oe">Ætwītan mē ðæt ic hlāfordleās hām sīðie</span>
							<span class="q-cite"> (Byrht. Th. 139, 8; By. 251: Exon. 105 b; Th. 401, 35; Rä. 21, 22: Beo. Th. 5863; B. 2935: Andr. Kmbl. 810; An. 405)</span>
						</li>
						<li>
							<span class="q-en">concerning men who have no lord</span>
							<span class="q-oe">Be hlāfordleāsum mannum</span>
							<span class="q-cite"> (L. Ath. 1. 2; Th. i. 200, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-tygness" d:title="on-tygness">
		<body>
			<h1>on-tygness<span class="pron"> | on.ty.ɣness |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the state of a person in respect to the frequency of the charges brought against him</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Be cirlisces monnes ontygnesse at ðiēfðe</span>
							<span class="q-cite"> (Ll. Lbmn. 22, 23. v. §37)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mēsan" d:title="mēsan">
		<body>
			<h1>mēsan<span class="pron"> | meː.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to feed, eat</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I can eat mightier meals than an old giant</span>
							<span class="q-oe">Ic mēsan mæg meahtelīcor ealdum þyrse</span>
							<span class="q-cite"> (Exon. 111 a; Th. 425, 26; Rä. 41, 62)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:mōs" class="xref-target">mōs</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="costigend" d:title="costigend">
		<body>
			<h1>costigend<span class="pron"> | ko.sti.Gend |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Þone costigend on helle grund besencean</span>
						<span class="q-cite"> (Bl. H. 33, 19)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wīd-mǣre" d:title="wīd-mǣre">
		<body>
			<h1>wīd-mǣre<span class="pron"> | wiːd.mæː.re |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Far-famed, famous, celebrated; in a bad sense, notorious</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of persons</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">quibus optimum quiddam claritas videtur</span>
									<span class="q-oe">Sume teohhiaþ ðæt ðæt betst sȳ, ðæt mon seō foremǣre and wīdmǣre</span>
									<span class="q-cite"> (Bt. 24, 2 ; Fox 82, 10)</span>
								</li>
								<li>
									<span class="q-oe">Wīdmǣre wer . . . hē moncynnes mǣste hæfde mægen and strengo</span>
									<span class="q-cite"> (Cd. Th. 98, 14; Gen. 1630)</span>
								</li>
								<li>
									<span class="q-oe">Wīdmǣre cynn</span>
									<span class="q-cite"> (158, 16 ; Gen. 2618)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">of things</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ān wundorlīc tācn gelamp, swā wīdmǣre ðæt feāwa wǣron on ðære neāwiste ðe ðæt ne gesāwe, oððe ne gehȳrde</span>
									<span class="q-cite"> (Homl. Th. ii. 28, 35)</span>
								</li>
								<li>
									<span class="q-oe">Hū Caudenes Furculus siō stōw wearþ swīþe wīdmǣre for Rōmāna bismere</span>
									<span class="q-cite"> (Ors. 3, 8, tit.; Swt. 3, 10)</span>
								</li>
								<li>
									<span class="q-oe">Wīdmǣre gewin (the war of the apostate angels)</span>
									<span class="q-cite"> (Exon. Th. 317, 1; Mōd. 59)</span>
								</li>
								<li>
									<span class="q-oe">Wīdmǣre blǣst (the fire that shall consume the world)</span>
									<span class="q-cite"> (60, 27; Cri. 976)</span>
								</li>
								<li>
									<span class="q-la">tanto foedior vestra reprehensibilitas appareat</span>
									<span class="q-oe">Swā gē sweotolran and wīdmǣrran gedōð eōwre tǣlweorðlīcnesse</span>
									<span class="q-cite"> (Past. 8 ; Swt. 53, 15)</span>
								</li>
								<li>
									<span class="q-oe">Hafaþ se cantic wīdmǣrost word</span>
									<span class="q-cite"> (Salm. Kmbl. 101; Sal. 50)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cyrc" d:title="cyrc">
		<body>
			<h1>cyrc<span class="pron"> | Kyrk |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A church</span>
						<span class="meaning-la"> (Lat. ecclesia)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Christ's church</span>
							<span class="q-oe">Cristes cyrc Christ's church</span>
							<span class="q-cite"> (Chr. 1066; Erl. 202, 1)</span>
						</li>
						<li>
							<span class="q-en">in the church</span>
							<span class="q-oe">In ðære cyrce in the church</span>
							<span class="q-cite"> (1070; Erl. 209, 40)</span>
						</li>
						<li>
							<span class="q-en">the church</span>
							<span class="q-oe">Ða cyrce the church</span>
							<span class="q-cite"> (1070; Erl. 209, 36)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cyrce" class="xref-target">cyrce</a>, <a href="x-dictionary:r:cyrice" class="xref-target">cyrice</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="foran-lencten" d:title="foran-lencten">
		<body>
			<h1>foran-lencten<span class="pron"> | fo.rɑn.lenk.ten |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the early part of Lent, early spring</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Blōd bið gōd tō lǣtenne on foranlenctene</span>
							<span class="q-cite"> (Lch. ii. 256, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīd-wīs" d:title="nīd-wīs">
		<body>
			<h1>nīd-wīs<span class="pron"> | niːd.wiːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Necessary, due</span>
						<span class="meaning-la"> (Lat. laus debita)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">laus debita</span>
							<span class="q-oe">Lof neādwīs</span>
							<span class="q-cite"> (Hy. Surt. 49. 29)</span>
						</li>
						<li>
							<span class="q-la">debitum, necessarium</span>
							<span class="q-oe">Neādþearflīc ł neādwīs</span>
							<span class="q-cite"> (Hpt. Gl. 424, 52)</span>
						</li>
						<li>
							<span class="q-oe">Swā swā se līchama biþ ontend þurh unālȳfede lustas, swā eāc byrnþ seō sāwul þurh neādwīs wīte</span>
							<span class="q-cite"> (Homl. Th. ii. 338, 19)</span>
						</li>
						<li>
							<span class="q-la">debito emolumento</span>
							<span class="q-oe">Neādwīsum ł neād-þearflīcum gestreōnum</span>
							<span class="q-cite"> (Hpt. Gl. 432, 68)</span>
						</li>
						<li>
							<span class="q-la">grates rependat debitas</span>
							<span class="q-oe">Þances hit āgylde neadwīse</span>
							<span class="q-cite"> (Hy. Surt. 27, 21)</span>
						</li>
						<li>
							<span class="q-la">laudes debitas</span>
							<span class="q-oe">Loft neādwīse</span>
							<span class="q-cite"> (86, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:nīd" class="xref-target">nīd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lāc-līc" d:title="lāc-līc">
		<body>
			<h1>lāc-līc<span class="pron"> | lɑːk.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sacrificial, having the nature of a sacrifice or offering</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">as often as they offered the sacrificial offerings that were then customary</span>
							<span class="q-oe">Swā oft swā hī offrodon ða lāclīcan lāc ðe ðā gewunelīce wǣron</span>
							<span class="q-cite"> (L. Ælfc. P. 39; Th. ii. 380, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hremman" d:title="hremman">
		<body>
			<h1>hremman<span class="pron"> | xrem.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hē mid smeāgungum smeālīce ūs hremð (v. l. dereð)</span>
						<span class="q-cite"> (Hml. S. 13, 59)</span>
					</li>
					<li>
						<span class="q-oe">Þā gecorenan hē hræmde ł gelette (impediuit)</span>
						<span class="q-cite"> (Ps. L. 77, 31)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hremman" class="xref-target">ge-hremman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="snȳting" d:title="snȳting">
		<body>
			<h1>snȳting<span class="pron"> | snyː.ting |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A clearing of the nose, sneezing</span>
						<span class="meaning-la"> (Lat. sternutatio vel sternutamentum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Snȳtingc vel fneōsung sternutatio vel sternutamentum</span>
							<span class="q-cite"> (Wrt. Voc. i. 46, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:snȳtan" class="xref-target">snȳtan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āðexe" d:title="āðexe">
		<body>
			<h1>āðexe<span class="pron"> | ɑː.θek.se |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Āðexe (ādexa) lacerta</span>
						<span class="q-cite"> (Txts. 73, 1182)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hilde-spell" d:title="hilde-spell">
		<body>
			<h1>hilde-spell<span class="pron"> | xil.de.spell |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A warlike speech</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-leōd" d:title="ge-leōd">
		<body>
			<h1>ge-leōd<span class="pron"> | je.le͜oːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">One of a nation, a fellow-countryman, compatriot</span>
						<span class="meaning-la"> (Lat. conterraneus, compatriota)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if any one sell his own countryman</span>
							<span class="q-oe">Gif hwā his āgenne geleōd bebycgge</span>
							<span class="q-cite"> (L. In. 11; Th. i. 110, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣfstian" d:title="ǣfstian">
		<body>
			<h1>ǣfstian<span class="pron"> | æːf.sti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To hasten</span>
						<span class="meaning-la"> (Lat. festinare, accelerare)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ēfstan" class="xref-target">ēfstan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fragian" d:title="fragian">
		<body>
			<h1>fragian<span class="pron"> | frɑ.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to ask</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-fragian" class="xref-target">ge-fragian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forþ-gefaran" d:title="forþ-gefaran">
		<body>
			<h1>forþ-gefaran<span class="pron"> | forθ.Ge.fɑ.rɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -gefōr, pl: -gefōron</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -gefaren</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To go forth, go by, pass</span>
						<span class="meaning-la"> (Lat. transīre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nisi purgātiōnis tempus transīerit</span>
							<span class="q-oe">Nymne seō clǣnsunge tīd forþgefare</span>
							<span class="q-cite"> (Bd. 1, 27; S. 493, 39)</span>
						</li>
						<li>
							<span class="q-en">Wulfric was departed [dead]</span>
							<span class="q-oe">Wulfrīc forþgefaren wæs</span>
							<span class="q-cite"> (Chr. 1061; Th. 329, 37: 560; Erl. 17, 16: Nar. 40, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="DǼL-NIMENDLĪC" d:title="DǼL-NIMENDLĪC">
		<body>
			<h1>DǼL-NIMENDLĪC<span class="pron"> | dæ, l.ni.mend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Participial</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣd-leāp" d:title="sǣd-leāp">
		<body>
			<h1>sǣd-leāp<span class="pron"> | sæːd.læ͜ɑːp |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A basket or other vessel of wood carried on one arm of the husbandman, to bear the seed which he sows with the other, a seed-leap (Essex), seed-lip (Oxford)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">satorium, saticulum</span>
							<span class="q-oe">Hopur or a seed lepe</span>
							<span class="q-cite"> (Prompt. Parv. 246)</span>
						</li>
						<li>
							<span class="q-la">saticulum</span>
							<span class="q-oe">A sedlepe</span>
							<span class="q-cite"> (Wülck. Gl. 609, 28)</span>
						</li>
						<li>
							<span class="q-oe">Sǣdleāp</span>
							<span class="q-cite"> (Anglia ix. 264, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:leāp" class="xref-target">leāp</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlīsa" d:title="hlīsa">
		<body>
			<h1>hlīsa<span class="pron"> | xliː.sɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">in reference to persons</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(l)</span>
								<span class="sub-heading">where knowledge of a person's greatness is widespread</span>
								<span class="meaning-en">fame</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">His hlīsa āsprang tō Syrian lande</span>
									<span class="q-cite"> (Hml. S. 16, 137)</span>
								</li>
								<li>
									<span class="q-oe">Āsprang his hlīsa geond þā land wīde</span>
									<span class="q-cite"> (26, 239)</span>
								</li>
								<li>
									<span class="q-oe">Gif hæleða hwone hlīsan lyste</span>
									<span class="q-cite"> (Met. 10, 1)</span>
								</li>
								<li>
									<span class="q-oe">Sē þe wile wīslīce æfter þām hlīsan spyrian, þonne ongit he swīþe hraþe hū lytel hē bið</span>
									<span class="q-cite"> (Bt. 18, I; F. 60, 28)</span>
								</li>
								<li>
									<span class="q-en">the memory of them passed away along with the great fame (? the Latin is: Periit memoria eorum cum sonitu)</span>
									<span class="q-oe">Heora gemynd onweg gewāt mid þām myclan hlīsan</span>
									<span class="q-cite"> (Ps. Th. 9, 7)</span>
								</li>
								<li>
									<span class="q-oe">Gē þone hlīsan habban tiliaþ ofer þiōda mā þonne eōw þearf siē</span>
									<span class="q-cite"> (Met. 10, 22)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">where a certain character is attributed to a person</span>
								<span class="meaning-en">reputation, repute</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sint tō manienne þā þe yfel dēgellīce dōð and gōd openlīce, þæt hī geþencen hū hrædlīce se eorþlica hlīsa ofergæð (humana judicia quanta velocitate evolant)</span>
									<span class="q-cite"> (Past. 447, 30)</span>
								</li>
								<li>
									<span class="q-oe">Gōd word and gōd hlīsa ælces monnes biþ betera þonne ænig wēla</span>
									<span class="q-cite"> (Bt. 13; F. 38, 23)</span>
								</li>
								<li>
									<span class="q-oe">Iōhannes wæs wanigende on his hlīsan, for þan þe hē wearð oncnāwen wītega, sē þe wæs lytle ær Crīst geteald</span>
									<span class="q-cite"> (Hml. Th. i. 356, 35)</span>
								</li>
								<li>
									<span class="q-oe">Beō ā getreōwra þonne þē mon tō wēne, þȳ læs men wēnan þæt þū nāne næbbe būton wið hlīsan (unless you get credit for it)</span>
									<span class="q-cite"> (Prov. K. 76)</span>
								</li>
								<li>
									<span class="q-oe">Wilnigaþ monige men anwealdes þe hiē woldon habban gōdne hlīsan, þeāh hī his unwyrþe siēn</span>
									<span class="q-cite"> (Bt. 18, I; F. 60, 26)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">¶</span>
										<span class="sub-heading">used of the Deity</span>
										<span class="meaning-en">glory</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">no more glorious attribute has the Maker than his mercy to man</span>
											<span class="q-oe">Næfre hlīsan āh Meotud þan māran þonne hē wið monna bearn wyrceð weldædum</span>
											<span class="q-cite"> (Az. 85)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2 a)</span>
								<span class="sub-heading">where special characteristics are attributed, reputation</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(α)</span>
										<span class="sub-heading">for something, the thing expressed (or implied) by a noun</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hlīsa rumusculus (speciali castimonia)</span>
											<span class="q-cite"> (An. Ox. 717)</span>
										</li>
										<li>
											<span class="q-oe">Hlīse singalre opinio crebra (lectionis assiduitate)</span>
											<span class="q-cite"> (II. 162)</span>
										</li>
										<li>
											<span class="q-oe">Wilnung ungemetlices hlīsan gōdra weorca</span>
											<span class="q-cite"> (Bt. 18, l; F. 60, 24)</span>
										</li>
										<li>
											<span class="q-oe">Hī willað habban þone hlīsan hālgidōmes odorem de se extendere sanctae opinionis quaerunt</span>
											<span class="q-cite"> (Past. 439, 34: Gū. 31)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(β)</span>
										<span class="sub-heading">of being or doing something, with clause</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">His hlīsa weōx . . . þæt hē sōð God wæs</span>
											<span class="q-cite"> (Hml. Th. i. 356, 33)</span>
										</li>
										<li>
											<span class="q-oe">Ne hē ne scrīfe þæs hlīsan būton hū hē ryhtosð wyrce</span>
											<span class="q-cite"> (Past. 323, 17)</span>
										</li>
										<li>
											<span class="q-oe">For þām gōdan hlīsan (þæt hiē gifule þyncen)</span>
											<span class="q-cite"> (339, 25)</span>
										</li>
										<li>
											<span class="q-oe">Monige menn noldan þone hlīsan habban þæt hiē unwīse siēn, nonnulli aestimari hebetes nolunt</span>
											<span class="q-cite"> (67, 2)</span>
										</li>
										<li>
											<span class="q-oe">Monig mon dēð micel fæsten, and hæfð þone hlīsan þæt hē hit dō for forhæfdnesse . . . monig bið āgīeta his gōda, and wilnaþ mid þȳ geearnigan þone hlīsan þæt hē siē rūmgiful saepe sub parsimoniae nomine se tenacia palliat, contraque se effusio sub appetta-tione largitatis occultat</span>
											<span class="q-cite"> (149, 4-8)</span>
										</li>
										<li>
											<span class="q-oe">Hē wæs . . . beorn bōca gleāw. Boitius se hæle hātte, sē þone hlīsan geþah</span>
											<span class="q-cite"> (Met. I. 53)</span>
										</li>
										<li>
											<span class="q-oe">Þone eādegan hlīsan faustam famam (Ald. 161, 12)</span>
											<span class="q-cite"> (Wrt. Voc. ii. 92, 16: 37, 31)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">report of those who no longer exist</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hwæt is hiora here būton se hlīsa ān ?</span>
									<span class="q-cite"> (Met. 10, 54)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="sub-heading">what is told about a person</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Nis ūs se hlīsa tō forswigianne þe be þām eādegan Gregorie þurh ealdra manna sage tō ūs becōm nec silentio praetereunda opinio, quae de beato Gregorio traditione maiorum ad nos usque perlata est</span>
									<span class="q-cite"> (Bd. 2, l; Sch. 108, 20)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">in reference to a thing</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(l)</span>
								<span class="sub-heading">fame of something admirable or remarkable</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se gesæliga hlīsa hire geornfulnesse felix industriae eius rumor</span>
									<span class="q-cite"> (Bd. 4, 23; Sch. 472, 16)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æt-nīman" d:title="æt-nīman">
		<body>
			<h1>æt-nīman<span class="pron"> | æt.niː.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -nam, pl: -nāmon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -numen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To take from, to take away</span>
						<span class="meaning-la"> (Lat. demere, adimere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the glorious father would not take the child away from him</span>
							<span class="q-oe">Ne wolde him beorht fæder bearn ætnīman</span>
							<span class="q-cite"> (Cd. 162 ; Th. 204, 5 ; Exod. 414)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="drēfre" d:title="drēfre">
		
		<body>
			<h1>drēfre<span class="pron"> | dreː.fre |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A disturber, turbulent person</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non sit turbulentus</span>
							<span class="q-oe">Ne sȳ hē drēfre (drǣfend, drēfende, v. ll.)</span>
							<span class="q-cite"> (R. Ben. 121, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:drēfend" class="xref-target">drēfend</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hāthyrtan" d:title="ge-hāthyrtan">
		<body>
			<h1>ge-hāthyrtan<span class="pron"> | je.xɑːt.xyr.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To encourage, embolden</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ūp-lic" d:title="ūp-lic">
		<body>
			<h1>ūp-lic<span class="pron"> | uːp.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(l)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se deāð is for þām ūplic; þeāh se man āstīge ofer þone yfemystan dǣl þæs hȳhstan holtes, swāþeāhhwzðere hiene se deāð gesēceð</span>
									<span class="q-cite"> (Verc. Först. 103, 13)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">in oromate, i. uisione superna</span>
									<span class="q-oe">On ūplicere gesihde</span>
									<span class="q-cite"> (An. Ox. 404)</span>
								</li>
								<li>
									<span class="q-la">ad superos</span>
									<span class="q-oe">Tō þām ūplican līfe</span>
									<span class="q-cite"> (2214)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ārena" d:title="ārena">
