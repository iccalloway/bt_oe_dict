<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eornestlice" d:title="eornestlice">
		<body>
			<h1>eornestlice<span class="pron"> | e͜or.nest.li.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">earnestly</span>
						<span class="meaning-la"> (Lat. studiōse)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eornostlīce" class="xref-target">eornostlīce</a>
			</p>
		</body>
