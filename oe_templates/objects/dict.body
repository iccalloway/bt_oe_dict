			<h1>clawan<span class="pron"> | klɑ.wɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -ic clawe</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To CLAW</span>
						<span class="meaning-la"> (Lat. scalpere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">scalpo</span>
							<span class="q-oe">Ic clawe scalpo</span>
							<span class="q-cite"> (Ælfc. Gr. 28, 4; Som. 31, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hand-hrægl" d:title="hand-hrægl">
