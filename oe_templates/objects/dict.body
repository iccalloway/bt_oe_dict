<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brūn-wyrt" d:title="brūn-wyrt">
		
		<body>
			<h1>brūn-wyrt<span class="pron"> | bruːn.wyrt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">BROWNWORT or water-betony</span>
						<span class="meaning-la"> (Lat. scrofularia aquatica)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">take banewort and brownwort</span>
							<span class="q-oe">Genim bānwyrt and brūnwyrt</span>
							<span class="q-cite"> (L. M. 1, 25; Lchdm. ii. 66, 18)</span>
						</li>
						<li>
							<span class="q-oe">Brūne wyrt</span>
							<span class="q-cite"> (1, 61; Lchdm. ii. 132, 7)</span>
						</li>
						<li>
							<span class="q-en">take brownwort</span>
							<span class="q-oe">Genim brūne wyrt</span>
							<span class="q-cite"> (2, 51; Lchdm. ii. 268, 9, 13: 1, 39; Lchdm. ii. 100, 5: 1, 48; Lchdm. ii. 122, 16)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">wood-betony or brownwort</span>
						<span class="meaning-la"> (Lat. scrofularia nodosa)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">take the broad-leafed brownwort, which grows in woods</span>
							<span class="q-oe">[Genim] ða brūnan wyrt brādleāfan, siō weaxeþ on wuda</span>
							<span class="q-cite"> (L. M. 1, 38; Lchdm. ii. 92, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fēre" d:title="ge-fēre">
		<body>
			<h1>ge-fēre<span class="pron"> | je.feː.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A companion</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Be Aþelbaldes gefēre . . . Aþelbaldes gefēre, þæs nama wæs Ecga, wæs fram þām āwyrgedan gāste unstille</span>
							<span class="q-cite"> (Guth. 60, 9-13)</span>
						</li>
						<li>
							<span class="q-oe">Be Aþelbaldes gefēre . . . cōm Æþelbaldes gefēra þæs nama wæs Ova</span>
							<span class="q-cite"> (66, 20)</span>
						</li>
						<li>
							<span class="q-la">comitem</span>
							<span class="q-oe">Gefēre</span>
							<span class="q-cite"> (Wrt. Voc. ii. 23, 42)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ātter-berende" d:title="ātter-berende">
		<body>
			<h1>ātter-berende<span class="pron"> | ɑːt.ter.be.ren.de |</span>
