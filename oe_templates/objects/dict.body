<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bed-felt" d:title="bed-felt">
		<body>
			<h1>bed-felt<span class="pron"> | bed.felt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Tō bedreāfe (bedd-, v. l.) genihtsumige tō hæbbenne meatte and hwītel and bedfelt (lena) and heāfodbolster</span>
						<span class="q-cite"> (R. Ben. 91, 16)</span>
					</li>
				</ul>
			</div>
