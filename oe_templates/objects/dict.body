<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-crammian" d:title="ā-crammian">
		<body>
			<h1>ā-crammian<span class="pron"> | ɑː.krɑm.mi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">farcire</span>
						<span class="q-oe">Ācrammian (printed -crum-) farcire</span>
						<span class="q-cite"> (Wrt. Voc. ii. 147, 43)</span>
					</li>
				</ul>
			</div>
