<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="All-walda" d:title="All-walda">
		<body>
			<h1>All-walda<span class="pron"> | ɑll.wɑl.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">All-ruler, the Almighty</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eal-wealda" class="xref-target">eal-wealda</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōwer" d:title="fōwer">
		<body>
			<h1>fōwer<span class="pron"> | foː.wer |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">four</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Cnut divided it into four</span>
							<span class="q-oe">Cnut hit todǣlde on fōwer</span>
							<span class="q-cite"> (Chr. 1017; Th. 285, 19, col. 1)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:feōwer" class="xref-target">feōwer</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mete-seax" d:title="mete-seax">
		<body>
			<h1>mete-seax<span class="pron"> | me.te.sæ͜ɑks |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A meat-knife, knife used in cutting food, dagger</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hiene mid heora metseacsum ofsticedon</span>
							<span class="q-cite"> (Ors. 5, 12; Swt. 244, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-bodian" d:title="for-bodian">
