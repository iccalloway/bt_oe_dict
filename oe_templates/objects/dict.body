<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āscyrigendlīc" d:title="āscyrigendlīc">
		<body>
			<h1>āscyrigendlīc<span class="pron"> | ɑː.ʃy.ri.Gend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Disjoining, disjunctive</span>
						<span class="meaning-la"> (Lat. disjunctivus)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gār-secg" d:title="gār-secg">
		<body>
			<h1>gār-secg<span class="pron"> | gɑːr.sedʒː |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">ocean, sea as opposed to land or air</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sæ; mare vel aequor, gārsecg oceanus</span>
							<span class="q-cite"> (Wrt. Voc. i. 41, 64)</span>
						</li>
						<li>
							<span class="q-oe">Folde . . . , gārsecg</span>
							<span class="q-cite"> (Gen. 117)</span>
						</li>
						<li>
							<span class="q-oe">Ealne middangeard yrnbfēran swā gārsecg (oceanus) beligeð</span>
							<span class="q-cite"> (Nar. 20, 15)</span>
						</li>
						<li>
							<span class="q-oe">Swā swā lyft and lagu land ymbclyppaþ, gārsecg embegyrt gumena rīce</span>
							<span class="q-cite"> (Met. 9, 41)</span>
						</li>
						<li>
							<span class="q-oe">Gārsecg fandaþ hwæðer āc hæbbe æðele treōwe</span>
							<span class="q-cite"> (Rūn. 25)</span>
						</li>
						<li>
							<span class="q-oe">Þū gārsecges grundas geworhtes</span>
							<span class="q-cite"> (Hy. 10, 7)</span>
						</li>
						<li>
							<span class="q-oe">Gār-secges gæst (the whale)</span>
							<span class="q-cite"> (Wal. 29)</span>
						</li>
						<li>
							<span class="q-oe">On gārsecge oceano</span>
							<span class="q-cite"> (Wrt. Voc. ii. 64, 68)</span>
						</li>
						<li>
							<span class="q-oe">Seō þridde India līð tō þām micclum gārsecge . . . hæfð on ōðere sīdan þone grimlican gārsecg</span>
							<span class="q-cite"> (Hml. Th. i. 454, 13-15)</span>
						</li>
						<li>
							<span class="q-oe">Hē gesette þone gārsecg on his goldhorde</span>
							<span class="q-cite"> (Ps. Th. 32, 6)</span>
						</li>
						<li>
							<span class="q-oe">Þone wīdgyllan gārsecg</span>
							<span class="q-cite"> (Hml. A. 3, 53: Ph. 289: An. 371)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a particular part of the general body of water, an ocean</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se gārsecg þe man hǣt Brittan-isca . . . on ōðre healfe þæs gārsecges earme is Brittannia</span>
							<span class="q-cite"> (Ors. 1, 1; S. 22, 24)</span>
						</li>
						<li>
							<span class="q-oe">Oð þone gārsecg usque ad oceanum Aeihiopicum</span>
							<span class="q-cite"> (S. 26, 10, 16, 24, 26)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eāst-gārsecg" class="xref-target">eāst-gārsecg</a>, <a href="x-dictionary:r:sūþ-gārsecg" class="xref-target">sūþ-gārsecg</a>, <a href="x-dictionary:r:ūt-gārsecg" class="xref-target">ūt-gārsecg</a>, <a href="x-dictionary:r:secg" class="xref-target">secg</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leax-heāfod" d:title="leax-heāfod">
		<body>
			<h1>leax-heāfod<span class="pron"> | læ͜ɑks.xæ͜ɑː.fod |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">capital</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Lex heāfod capital</span>
							<span class="q-cite"> (Wrt. Voc. ii. 128. 43)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scot" d:title="scot">
		<body>
			<h1>scot<span class="pron"> | ʃot |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a shot, a shooting</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hiē his siððan wǣran swīðe ēhtende ge mid scotum (gesceotum, MS. C.) ge mid stāna torfungum ge mid eallum heora wīgcræftum</span>
							<span class="q-cite"> (Ors. 3, 9 ; Swt. 134, 15)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a shot, missile</span>
					</p>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a rapid movement (v. sceōtan, IV, III, ge-sceōt (read -sceot), II), a rush, dart</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Leax sceal on wǣle mid sceote scrīðan</span>
							<span class="q-cite"> (Menol. Fox 539 ; Gn. C. 40)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">a scot (as in scot and lot, scot-free), a shot (as in to pay one's shot), a contribution, tax</span>
					</p>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">a building</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-sceot" class="xref-target">ge-sceot</a>, <a href="x-dictionary:r:scyte" class="xref-target">scyte</a>, <a href="x-dictionary:r:sāwel-scot" class="xref-target">sāwel-scot</a>, <a href="x-dictionary:r:sele-scot" class="xref-target">sele-scot</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-līðan" d:title="be-līðan">
		<body>
			<h1>be-līðan<span class="pron"> | be.liː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -lāþ, pl: -liðon, pl: -lidon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -liðen, past participle sg: -liden</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To go from, to leave</span>
						<span class="meaning-la"> (Lat. effugere, relinquere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the body of the left by life, i. e. the body of the lifeless</span>
							<span class="q-oe">Līfe belidenes līc the body of the left by life, i. e. the body of the lifeless</span>
							<span class="q-cite"> (Elen. Kmbl. 1752; El. 878 : Exon. 52 a; Th. 182, 18, note; Gū. 1312 : Judth. 12; Thw. 25, 26; Jud. 280)</span>
						</li>
						<li>
							<span class="q-en">the dead</span>
							<span class="q-la">mortuos</span>
							<span class="q-oe">Ða belidenan [MS. behlidenan] the dead</span>
							<span class="q-cite"> (Andr. Kmbl. 2179; An. 1091)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mǣr-stān" d:title="mǣr-stān">
		<body>
			<h1>mǣr-stān<span class="pron"> | mæːr.stɑːn |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A boundary-stone</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðis syndon ða landgemǣro . . , On mǣrstān; of mǣrstāne on ðone ealdan gāran</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. iii. 438, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weorold-welig" d:title="weorold-welig">
		<body>
			<h1>weorold-welig<span class="pron"> | we͜o.rold.we.liG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Rich in this world's goods</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Woruldwelige gītseras</span>
							<span class="q-cite"> (Nap. 71)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="of-lecgan" d:title="of-lecgan">
		<body>
			<h1>of-lecgan<span class="pron"> | of.ledʒ.dʒɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to lay down</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">infixus sum in limo</span>
							<span class="q-oe">Eom ic on lāme oflegd</span>
							<span class="q-cite"> (Ps. Th. 68, l.)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-mearr" d:title="ge-mearr">
		<body>
			<h1>ge-mearr<span class="pron"> | je.mæ͜ɑrr |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Wicked, fraudulent</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if there were any wicked man</span>
							<span class="q-oe">Gif hwā gemearra manna wǣre</span>
							<span class="q-cite"> (L. Edw. 1; Th. i. 160, note 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-mearr" class="xref-target">ge-mearr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bō" d:title="bō">
		
		<body>
			<h1>bō<span class="pron"> | boː |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">both</span>
						<span class="meaning-la"> (Lat. ambo)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:begen" class="xref-target">begen</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hopian" d:title="hopian">
		<body>
			<h1>hopian<span class="pron"> | xo.pi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">petiit ab eo ut eum abbati committeret</span>
						<span class="q-oe">node ꝥ hē hine þām abbode befæste</span>
						<span class="q-cite"> (Gr. D. 27, 23)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:ā-hopian" class="xref-target">ā-hopian</a>, <a href="x-dictionary:r:ge-hopian" class="xref-target">ge-hopian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leōht-berende" d:title="leōht-berende">
		<body>
			<h1>leōht-berende<span class="pron"> | le͜oːxt.be.ren.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Light-bearing, Lucifer, luminous</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Lucifer hāten, leōht-berende</span>
							<span class="q-cite"> (Cd. 221; Th. 287, 15; Sat. 367)</span>
						</li>
						<li>
							<span class="q-la">apparuit clibanus fumans et lampas ignis inter divisiones illas</span>
							<span class="q-oe">Swylce ān ofen eall smōciende and leōhtberende fȳr fērde ofer ða lāc</span>
							<span class="q-cite"> (Gen. 15, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heāfod-beorg" d:title="heāfod-beorg">
		<body>
			<h1>heāfod-beorg<span class="pron"> | xæ͜ɑː.fod.be͜orɣ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A chief hill (?)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On cissan beorg middanweardne . . . ; swā tō heāfodbeorge westeweardon</span>
							<span class="q-cite"> (C. D. v. 179, 26-30)</span>
						</li>
						<li>
							<span class="q-oe">Ðis synt ðā landes meǣre tō Bryningtūne. Ǣrest on heāfdbeorh; ðonne on wyrtwalan . . . swā tō herpaðe; andlang herpaðes tō Imman beorge ; of Imman beorge eft on heāfodbeorge</span>
							<span class="q-cite"> (300, 7-22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sceaþan" d:title="sceaþan">
		<body>
			<h1>sceaþan<span class="pron"> | ʃæ͜ɑ.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -scōd, sg: -sceōd</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -sceaþen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To scathe, hurt, harm, injure</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(a)</span>
								<span class="sub-heading">with dat.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ðē ne sceaþeþ ǣnig</span>
									<span class="q-cite"> (Ps. Th. 90, 7)</span>
								</li>
								<li>
									<span class="q-oe">Oft ic ōðrum scōd</span>
									<span class="q-cite"> (Exon. Th. 401, 22; Rä. 21, 15)</span>
								</li>
								<li>
									<span class="q-oe">Hē tōswengde līges leōman, swā hyra līce ne scōd</span>
									<span class="q-cite"> (189, 16; Az. 60: 197, 9; Az. 187)</span>
								</li>
								<li>
									<span class="q-oe">Se ðe nǣngum scōd</span>
									<span class="q-cite"> (90, l; Cri. 1467)</span>
								</li>
								<li>
									<span class="q-oe">Ðæt ēce nīþ ældum scōd</span>
									<span class="q-cite"> (346, 5; Gn. Ex. 200)</span>
								</li>
								<li>
									<span class="q-oe">Ūs hearde sceōd freōlecu fǣmne (Eve)</span>
									<span class="q-cite"> (Cd. Th. 61, 15; Gen. 997: 245, 17; Dan. 464)</span>
								</li>
								<li>
									<span class="q-oe">Siō hæleþum sceōd (punished?)</span>
									<span class="q-cite"> (Elen. Kmbl. 1415; El. 709)</span>
								</li>
								<li>
									<span class="q-oe">Him ða cwyðe frēcne scōdon</span>
									<span class="q-cite"> (Cd. Th. 96, 20; Gen. 1597)</span>
								</li>
								<li>
									<span class="q-oe">Scōdun</span>
									<span class="q-cite"> (Exon. Th. 134, 30; Gū. 516)</span>
								</li>
								<li>
									<span class="q-oe">Ðæt him feōndes hond æt ðam ȳtemestan ende ne scōde</span>
									<span class="q-cite"> (129, 1; Gū. 414)</span>
								</li>
								<li>
									<span class="q-oe">Sceaþen is mē sāre, frēcne on ferhþe.</span>
									<span class="q-cite"> (Cd. Th. 53, 31; Gen. 869)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(b)</span>
								<span class="sub-heading">with acc.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Oft mec īsern scōd sāre on sīdan</span>
									<span class="q-cite"> (Exon. Th. 485, 14; Rä. 71, 13)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(c)</span>
								<span class="sub-heading">without a case</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">neque nocebo</span>
									<span class="q-oe">Ne ic ne scaþe (scaþeð, MS.)</span>
									<span class="q-cite"> (Ps. Spl. 88, 33)</span>
								</li>
								<li>
									<span class="q-oe">Ðȳ læs scyldhatan sceaþan mihton.</span>
									<span class="q-cite"> (Andr. Kmbl. 2296; An. 1149)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sceþþan" class="xref-target">sceþþan</a>, <a href="x-dictionary:r:sceaþian" class="xref-target">sceaþian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōre-sceāwere" d:title="fōre-sceāwere">
		<body>
			<h1>fōre-sceāwere<span class="pron"> | foː.re.ʃæ͜ɑː.we.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A foreshewer, foreseer</span>
						<span class="meaning-la"> (Lat. prævisor)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Consid. ætātum lunæ in modo genitis</span>
							<span class="q-cite"> (Lye)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="BŌT" d:title="BŌT">
		<body>
			<h1>BŌT<span class="pron"> | boːt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">help, assistance, remedy, cure</span>
						<span class="meaning-la"> (Lat. auxilium, remedium, emendatio, sanatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">here is the remedy, how thou mayest improve shy fields</span>
							<span class="q-oe">Hēr ys seō bōt, hū ðū meaht ðīne æceras bētan</span>
							<span class="q-cite"> (Lchdm. i. 398, 1)</span>
						</li>
						<li>
							<span class="q-en">thou shalt find therein a remedy and perfect healing</span>
							<span class="q-oe">Findest ðū ðǣr æt bōte and ælteowe hǣlo</span>
							<span class="q-cite"> (Herb. 1, 29; Lchdm. i. 80, 6)</span>
						</li>
						<li>
							<span class="q-en">the cure will be quick</span>
							<span class="q-oe">Byþ hræd bōt</span>
							<span class="q-cite"> (Med. ex Quadr. 6, 15; Lchdm. i. 354, 11)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a BOOT, compensation due to an injured person as damages for the wrong sustained, redressing, recompense, an amends, a satisfaction, correction, reparation, restoring, renewing, repentance, an offering</span>
						<span class="meaning-la"> (Lat. compensatio, emendatio, reparatio, oblatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if there be a taking hold of the hair, let there be 50 sceats for compensation</span>
							<span class="q-oe">Gif feaxfang geweorþ, L scætta to bōte</span>
							<span class="q-cite"> (L. Ethb. 33; Th. i. 12, 3)</span>
						</li>
						<li>
							<span class="q-en">for a redressing of his sins</span>
							<span class="q-oe">For bōte his synna</span>
							<span class="q-cite"> (Bd. 4, 25; S. 599, 32: 5, 13; S. 632, 13)</span>
						</li>
						<li>
							<span class="q-en">bring a kid for an offering</span>
							<span class="q-oe">Bringaþ ānne buccan to bōte</span>
							<span class="q-cite"> (Lev. 4, 23, 28: L. Alf. pol. 2; Th. i. 62, 6: Bd. 1, 27; S. 489, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bric-bōt" class="xref-target">bric-bōt</a>, <a href="x-dictionary:r:bricg-bōt" class="xref-target">bricg-bōt</a>, <a href="x-dictionary:r:burh-bōt" class="xref-target">burh-bōt</a>, <a href="x-dictionary:r:hād-bōt" class="xref-target">hād-bōt</a>, <a href="x-dictionary:r:weofod-bōt" class="xref-target">weofod-bōt</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hearm-lic" d:title="hearm-lic">
		<body>
			<h1>hearm-lic<span class="pron"> | xæ͜ɑrm.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">calamitous</span>
						<span class="meaning-la"> (Lat. calamitosa)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">calamitosa</span>
							<span class="q-oe">Ðȳ hearmlican</span>
							<span class="q-cite"> (Wrt. Voc. ii. 18, 49)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="besining" d:title="besining">
		<body>
			<h1>besining<span class="pron"> | be.si.ning |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bending</span>
						<span class="meaning-la"> (Lat. sinuatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Besining sinuatio</span>
							<span class="q-cite"> (Ælfc. Gl. l00; Som. 77, 8; Wrt. Voc. 55, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tō-stencean" d:title="tō-stencean">
		<body>
			<h1>tō-stencean<span class="pron"> | toː.sten.Kæ͜ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to scatter, disperse</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">dispersisti inimicos tuos</span>
							<span class="q-oe">Ðū tōstenctest feōnd ðīne</span>
							<span class="q-cite"> (Ps. Spl. 88, 11 : 43, 13)</span>
						</li>
						<li>
							<span class="q-la">sacrificium superveniens aura dispergeret</span>
							<span class="q-oe">Gif wind tō cōme, ðonne tōstencte hē ða lāc</span>
							<span class="q-cite"> (Past. 33; Swt. 217, 22)</span>
						</li>
						<li>
							<span class="q-oe">Se god-cunda anweald hī (the builders of Babel) tōstencte</span>
							<span class="q-cite"> (Bt. 35, 4; Fox 162, 24: Homl. Th. i. 318, 18)</span>
						</li>
						<li>
							<span class="q-oe">Tōsteng (dissipa) þeōda ðe gefeoht willaþ</span>
							<span class="q-cite"> (Ps. Spl. 67, 34)</span>
						</li>
						<li>
							<span class="q-oe">Ða lāc tōstencean (dispergere)</span>
							<span class="q-cite"> (Past. 33; Swt. 219, 5)</span>
						</li>
						<li>
							<span class="q-oe">Tōstencud biþ ðæt ēde</span>
							<span class="q-cite"> (Mk. Skt. Rush. 14, 27)</span>
						</li>
						<li>
							<span class="q-oe">Tōstenced</span>
							<span class="q-cite"> (Exon. Th. 16, 21 ; Cri. 256)</span>
						</li>
						<li>
							<span class="q-la">dispersae</span>
							<span class="q-oe">Tōstencte</span>
							<span class="q-cite"> (Wrt. Voc. ii. 140, 71)</span>
						</li>
						<li>
							<span class="q-oe">Ðā wǣron tōstencte (dispersi sunt) ealle ða wiðerweardan gāstas</span>
							<span class="q-cite"> (Bd. 5, 12; S. 629, 7: l, 16; S. 484, 14: Bt. 39, 13; Fox 234, 27: Homl. Th. ii. 244, 34)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to destroy the integrity of a whole, dissipate, bring to nought, overthrow</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Tōstencþ (disperdat) Drihten ealle weleras fācnfulle</span>
							<span class="q-cite"> (Ps. Spl. 11, 3)</span>
						</li>
						<li>
							<span class="q-oe">Drihten tōstenceþ (dissipat) geþeaht ðeōda</span>
							<span class="q-cite"> (32, 10)</span>
						</li>
						<li>
							<span class="q-la">dissipabit thesaurum (Prov. 21, 20)</span>
							<span class="q-oe">Tōstencþ gold—hord</span>
							<span class="q-cite"> (Kent. Gl. 793)</span>
						</li>
						<li>
							<span class="q-oe">Se (Edwy) þurh his cildhādes nytenesse his rīce tōstencte and his ānnesse tōdǣlde</span>
							<span class="q-cite"> (Lchdm. iii. 434, 36)</span>
						</li>
						<li>
							<span class="q-oe">Tōstencton (dissipaverunt) unrihtwīse ǣ ðīne</span>
							<span class="q-cite"> (Ps. Spl. 118. 126)</span>
						</li>
						<li>
							<span class="q-oe">Hī munucregol myrdon and mynstra tōstæncton</span>
							<span class="q-cite"> (Chr. 975'; Erl. 127. 21)</span>
						</li>
						<li>
							<span class="q-oe">Ofermōdignyss seō ðe englas cūþe beswīcan, micele mā menn tōstencean (dissipare)</span>
							<span class="q-cite"> (Scint. 83, 13)</span>
						</li>
						<li>
							<span class="q-oe">Gif ys of mannum gēþeaht ðis oððe weorc, sī tostenct (dissoluetur, dissipabitur); gif hit of Gode ys, gē ne māgon tōstencean (dissoluere) (Acts 5, 38, 39)</span>
							<span class="q-cite"> (199, 2-4)</span>
						</li>
						<li>
							<span class="q-la">dissipantis (sua opera, Prov. 18, 9)</span>
							<span class="q-oe">Tōstencendes</span>
							<span class="q-cite"> (Kent. Gl. 639)</span>
						</li>
						<li>
							<span class="q-la">neque erit diluvium dissipans terram</span>
							<span class="q-oe">Ne biþ flōd tōstencende, (-sencende, MS. ) ða eorðan</span>
							<span class="q-cite"> (Gen. 9, 11)</span>
						</li>
						<li>
							<span class="q-la">sine quo voluntatis miserae langueret effectus</span>
							<span class="q-oe">Se yfela willa biþ tōstenced, swā rēcels beforan fȳre, gif mon ðæt weorc þurhtiōn ne mæg (potuisse miserius est)</span>
							<span class="q-cite"> (Bt. 38, 2; Fox 196, 31)</span>
						</li>
						<li>
							<span class="q-la">dissipantur (cogitationes, Prov. 15, 22)</span>
							<span class="q-oe">Sint tōstente</span>
							<span class="q-cite"> (Kent. Gl. 530)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">II a.</span>
								<span class="meaning-en">intrans. To perish</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">disperierunt in Endor</span>
									<span class="q-oe">Hī tostencton on ende</span>
									<span class="q-cite"> (Ps. Spl. 82, 9)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mearc-beorh" d:title="mearc-beorh">
		<body>
			<h1>mearc-beorh<span class="pron"> | mæ͜ɑrk.be͜orx |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -beorges</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A hill which forms part of a boundary</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Predicta tellus his terminis circumcincta. Ǣrest on æscwoldes hlāw: ðonne on gemōtbiorh ... ðonne on mearcbiorh</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. ii. 195, 14)</span>
						</li>
						<li>
							<span class="q-oe">Æt ðæne mearcbeorh</span>
							<span class="q-cite"> (iii. 175, 35)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gemǣr-beorh" class="xref-target">gemǣr-beorh</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-gearwungness" d:title="ge-gearwungness">
