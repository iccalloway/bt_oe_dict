<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ambiht" d:title="ambiht">
		
		<body>
			<h1>ambiht<span class="pron"> | ɑm.bixt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">an office, ministry, service</span>
						<span class="meaning-la"> (Lat. officium)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ambeht" class="xref-target">ambeht</a>
			</p>
