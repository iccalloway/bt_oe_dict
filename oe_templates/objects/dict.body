			<p class="xref">See also: <a href="x-dictionary:r:camel" class="xref-target">camel</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gewritrǣden" d:title="gewritrǣden">
		<body>
			<h1>gewritrǣden<span class="pron"> | Ge.wri.træː.den |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">conveying property</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Cyrographum, i. conscriptio hominis vel manualis scriptio</span>
							<span class="q-oe">Cyrographum, i. conscriptio hominis vel manualis scriptio gewritrǣden vel āgnung</span>
							<span class="q-cite"> (Wrt. Voc. ii. 137, 69)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gecwid-rǣden" class="xref-target">gecwid-rǣden</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="filican" d:title="filican">
