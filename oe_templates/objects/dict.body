<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tāh-spora" d:title="tāh-spora">
		
		<body>
			<h1>tāh-spora<span class="pron"> | tɑːx.spo.rɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The point of the toe(?)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Tāhspura calcis finis</span>
							<span class="q-cite"> (Wrt. Voc. ii. 127, 47)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hand-spora" class="xref-target">hand-spora</a>, <a href="x-dictionary:r:hēl-spure" class="xref-target">hēl-spure</a>, <a href="x-dictionary:r:sporu" class="xref-target">sporu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-frēge" d:title="ge-frēge">
		<body>
			<h1>ge-frēge<span class="pron"> | je.freː.Ge |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Known, celebrated, famous</span>
						<span class="meaning-la"> (Lat. nōtus, cēlebер, fāmōsus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">keep in thy mind how that was known among many men</span>
							<span class="q-oe">Lǣt ðē on gemyndum hū ðæt manegum wearþ fira gefrēge</span>
							<span class="q-cite"> (Andr. Kmbl. 1921; An. 963 : 2240; An. 1121)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-frǣge" class="xref-target">ge-frǣge</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="trepettan" d:title="trepettan">
		
		<body>
			<h1>trepettan<span class="pron"> | tre.pet.tɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:in-trepettan" class="xref-target">in-trepettan</a>
			</p>
		</body>
