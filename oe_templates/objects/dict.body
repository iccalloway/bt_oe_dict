<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="unfriþ-here" d:title="unfriþ-here">
		<body>
			<h1>unfriþ-here<span class="pron"> | un.friθ.xe.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A hostile army, an army that is carrying on hostilities</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Com se ungemetlīca unfriðhere tō Sandwīc</span>
							<span class="q-cite"> (Chr. 1009; Erl. 142, 16)</span>
						</li>
						<li>
							<span class="q-oe">On ðissum geāre wæs ðet gafol gelǣst ðam unfriðehere</span>
							<span class="q-cite"> (1007; Erl. 141, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="HEARM-LEŌÞ" d:title="HEARM-LEŌÞ">
