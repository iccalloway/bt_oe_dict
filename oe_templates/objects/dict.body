			<h1>eorþ-styrennis<span class="pron"> | e͜orθ.sty.ren.nis |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An earthquake</span>
						<span class="meaning-la"> (Lat. terræ mōtus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">terræ mōtus factus est magnus</span>
							<span class="q-oe">Eorþstyrennis gewarþ micelu</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 28, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
