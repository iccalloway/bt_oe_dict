<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gist" d:title="gist">
		
		
		<body>
			<h1>gist<span class="pron"> | Gist |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">hospes</span>
							<span class="q-oe">Gast</span>
							<span class="q-cite"> (Wrt. Voc. ii. 43, 37)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">a stranger</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">hospes eram</span>
									<span class="q-oe">Gest ic wæs</span>
									<span class="q-cite"> (Mt. L. 25, 36, 43, 44)</span>
								</li>
								<li>
									<span class="q-la">non estis hospites . . . sed estis cives sanctorum</span>
									<span class="q-oe">Ne aron giē gestas . . . ah giē aron burgwaro hāligra</span>
									<span class="q-cite"> (Rtl. 82, 30)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">a guest, one who is entertained at another's house</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Si tertia nocte hospitatus fuerit . . . habeat eum ad rectum tanquam de propria familia, quod Anglice dicitur: 'Twā niht gest, þridde niht āgen hēwe,'</span>
									<span class="q-cite"> (Ll. Lbmn. 648, 21)</span>
								</li>
								<li>
									<span class="q-la">hospites</span>
									<span class="q-oe">Gystes</span>
									<span class="q-cite"> (R. Ben. I. 94, 5)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-sār" d:title="un-sār">
		<body>
			<h1>un-sār<span class="pron"> | un.sɑːr |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Not sore, without soreness or pain</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se teter būtan sāre hē ofergǣð ðone līchoman...; se giecða bið suīðe unsār</span>
							<span class="q-cite"> (Past. 11; Swt. 71, 19)</span>
						</li>
						<li>
							<span class="q-oe">Gnīd mid ða tōðreoman, hī beōð clǣne and unsāre</span>
							<span class="q-cite"> (Lchdm. i. 346, 15)</span>
						</li>
						<li>
							<span class="q-en">the swelling becomes more free from pain</span>
							<span class="q-oe">Ðæt geswel wyrð unsārre</span>
							<span class="q-cite"> (ii. 208, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-slūpan" d:title="under-slūpan">
