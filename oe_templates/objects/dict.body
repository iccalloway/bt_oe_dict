<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwæt-hwega" d:title="hwæt-hwega">
		
		<body>
			<h1>hwæt-hwega<span class="pron"> | xwæt.xwe.ɣɑ |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Something, somewhat, a little</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">canta mihi aliquid</span>
							<span class="q-oe">Sing mē hwæthwegu</span>
							<span class="q-cite"> (Bd. 4, 24; S. 597, 12)</span>
						</li>
						<li>
							<span class="q-la">aliquid miræ sanctitatis</span>
							<span class="q-oe">Hwæthugu wundurlīcre hālignesse</span>
							<span class="q-cite"> (3, 9; S. 534, 1)</span>
						</li>
						<li>
							<span class="q-en">something strange</span>
							<span class="q-oe">Hwæthwegu seldcūþes</span>
							<span class="q-cite"> (Bt. 34, 4; Fox 138, 28)</span>
						</li>
						<li>
							<span class="q-la">aliquid</span>
							<span class="q-oe">Hwæthwygo</span>
							<span class="q-cite"> (Nar. 1, 18)</span>
						</li>
						<li>
							<span class="q-oe">Ic hwæthwugo on bōcum geleornode</span>
							<span class="q-cite"> (39, 19)</span>
						</li>
						<li>
							<span class="q-la">aliquid</span>
							<span class="q-oe">Huodhuoegu</span>
							<span class="q-cite"> (Jn. Skt. Lind. 7, 4)</span>
						</li>
						<li>
							<span class="q-la">paulisper, parumper</span>
							<span class="q-oe">Hwæthwega</span>
							<span class="q-cite"> (Ælfc. Gr. 38; Som. 41, 65)</span>
						</li>
						<li>
							<span class="q-oe">Hē hwæthwego fram ðam wage ða limu āhōf</span>
							<span class="q-cite"> (Guthl. 20; Gdwin. 82, 27; Homl. Th. ii. 90, 29)</span>
						</li>
						<li>
							<span class="q-oe">Hwæthwega ufor gān</span>
							<span class="q-cite"> (32, 22)</span>
						</li>
						<li>
							<span class="q-en">somewhat separated</span>
							<span class="q-oe">Hwæthwegu tōdǣled</span>
							<span class="q-cite"> (Bt. 34, 6; Fox 142, 14)</span>
						</li>
						<li>
							<span class="q-la">aliquantulum</span>
							<span class="q-oe">Hwæthwiga</span>
							<span class="q-cite"> (Ps. Th. 89, 15)</span>
						</li>
						<li>
							<span class="q-oe">Hwæthwygu</span>
							<span class="q-cite"> (93, 8)</span>
						</li>
						<li>
							<span class="q-oe">Hwæthwugu</span>
							<span class="q-cite"> (Bt. Met. Fox 221; Met. 20, 111)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ange" d:title="ange">
		
		
		<body>
			<h1>ange<span class="pron"> | ɑn.Ge |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Narrow, straitened, vexed, troubled, sorrowful</span>
						<span class="meaning-la"> (Lat. angustus, anxius, vexatus, tristis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">this narrow place</span>
							<span class="q-oe">Ðes ænga stede</span>
							<span class="q-cite"> (Cd. 18; Th. 23, 9; Gen. 356)</span>
						</li>
						<li>
							<span class="q-en">it is narrow above</span>
							<span class="q-oe">Ufan hit is enge</span>
							<span class="q-cite"> (Exon. 116 a; Th. 446, 14; Dōm. 22)</span>
						</li>
						<li>
							<span class="q-en">then the king was greatly troubled in his mind</span>
							<span class="q-oe">Ðā wæs ðam cynge swīðe ange on his mode</span>
							<span class="q-cite"> (Ors. 2, 5; Bos. 48, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-beātan" d:title="ge-beātan">
		<body>
			<h1>ge-beātan<span class="pron"> | je.bæ͜ɑː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to pound</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Genim pipor and gebeāt</span>
							<span class="q-cite"> (Lch. ii. 32, 2: 64, 19: 72, 2)</span>
						</li>
						<li>
							<span class="q-la">battuitum</span>
							<span class="q-oe">Gibeātoen, gebeātten, -beāten</span>
							<span class="q-cite"> (Txts. 44, 140)</span>
						</li>
						<li>
							<span class="q-oe">Gebeāten</span>
							<span class="q-cite"> (Wrt. Voc. i. 288, 10: ii. 11, 63: martisa, 59, 31)</span>
						</li>
						<li>
							<span class="q-oe">Heortes horn tō dūste gebeāten</span>
							<span class="q-cite"> (Lch. i. 334, 11)</span>
						</li>
						<li>
							<span class="q-oe">Gebeāten swīðe smale</span>
							<span class="q-cite"> (358, 9)</span>
						</li>
						<li>
							<span class="q-oe">Betonican seāw gebeātenre</span>
							<span class="q-cite"> (ii. 30, 3)</span>
						</li>
						<li>
							<span class="q-oe">Nim mucgwyrte gebeātene</span>
							<span class="q-cite"> (i. 380, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-gebeāten" class="xref-target">un-gebeāten</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-gyrdan" d:title="for-gyrdan">
		<body>
			<h1>for-gyrdan<span class="pron"> | for.Gyr.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To girdle, enclose</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē Bretenlond mid dīce forgyrde from sǣ oþ sǣ</span>
							<span class="q-cite"> (Chr. 189; P. 9, note 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wīþig-brōc" d:title="wīþig-brōc">
		<body>
			<h1>wīþig-brōc<span class="pron"> | wiː.θiG.broːk |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A brook by which willows grow</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">In wīðibrōc</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. iii. 380, 2)</span>
						</li>
						<li>
							<span class="q-oe">On wīðigbrōch</span>
							<span class="q-cite"> (202, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="felt-wurma" d:title="felt-wurma">
		<body>
			<h1>felt-wurma<span class="pron"> | felt.wur.mɑ |</span>
			</h1>
