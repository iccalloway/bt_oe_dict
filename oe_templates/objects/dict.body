<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-niman" d:title="ā-niman">
		<body>
			<h1>ā-niman<span class="pron"> | ɑː.ni.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to take, accept, retain</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">si ipsa verba tenere voluissem</span>
							<span class="q-oe">Gif ic þā word āniman wolde</span>
							<span class="q-cite"> (Gr. D. 9, 15)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to take away, remove</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þā ānam hē þæt fūr fram manna bearnum</span>
							<span class="q-cite"> (Wlfst. 213, 10: 221, 32)</span>
						</li>
						<li>
							<span class="q-oe">Ānimað, ānimað hraðe þā rēþan wiccan</span>
							<span class="q-cite"> (Hml. S. 7, 209)</span>
						</li>
						<li>
							<span class="q-la">ut dubitationis occasionem legentibus subtraham</span>
							<span class="q-oe">Ic wille āniman and āteōn fram þām þe þās bōc rǣdaþ þone intingan ǣlcre tweōnge</span>
							<span class="q-cite"> (Gr. D. 9, 5)</span>
						</li>
						<li>
							<span class="q-oe">Ǣlc tǣl siē ānumen (tollatur) fram eōw</span>
							<span class="q-cite"> (Past. 222, 9)</span>
						</li>
						<li>
							<span class="q-oe">Of his heortan onweg ānumen</span>
							<span class="q-cite"> (Bl. H. 55, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swōlig" d:title="swōlig">
		<body>
			<h1>swōlig<span class="pron"> | swoː.liG |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Burning, heat</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Swōlig caumatio</span>
							<span class="q-cite"> (Wrt. Voc. ii. 130, 8)</span>
						</li>
						<li>
							<span class="q-oe">Hāt lyft and swōlga (sultriness?) bringaþ ādle on ðam milte, ðonne se mon wyrð tō swīþe forhǣt</span>
							<span class="q-cite"> (Lchdm. ii. 244, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þorian" d:title="þorian">
		<body>
			<h1>þorian<span class="pron"> | θo.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to dare</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Thorie dosmui (domui?)</span>
							<span class="q-cite"> (Wrt. Voc. ii. 141, 82)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mǣne" d:title="mǣne">
		<body>
			<h1>mǣne<span class="pron"> | mæː.ne |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þā synleahtras þe ūs forbodene synd, þæt is . . . leāsunga and mǣne āþas</span>
							<span class="q-cite"> (Wlfst. 135, 3)</span>
						</li>
						<li>
							<span class="q-oe">Ic eom anddetta mǣnra āða</span>
							<span class="q-cite"> (Angl. xi. 101, 35)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wīgwǣpen" d:title="wīgwǣpen">
		<body>
			<h1>wīgwǣpen<span class="pron"> | wiːɣ.wæː.pen |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A weapon of war</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ælce wīgwǣpna and æghwylce woruldsaca lǣte man stille</span>
							<span class="q-cite"> (Wulfst. 170, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scipe" d:title="scipe">
		<body>
			<h1>scipe<span class="pron"> | ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē nān þing him sylfum of his campdōmes scipe on his seōde ne heōld</span>
							<span class="q-cite"> (Hml. S. 31, 55)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-scipe" class="xref-target">ge-scipe</a>, <a href="x-dictionary:r:land-scipe" class="xref-target">land-scipe</a>, <a href="x-dictionary:r:mægen-scipe" class="xref-target">mægen-scipe</a>, <a href="x-dictionary:r:sin-scipe" class="xref-target">sin-scipe</a>, <a href="x-dictionary:r:tūn-scipe" class="xref-target">tūn-scipe</a>, <a href="x-dictionary:r:waeter-scipe" class="xref-target">waeter-scipe</a>, <a href="x-dictionary:r:weorold-scipe" class="xref-target">weorold-scipe</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ȳþ-lid" d:title="ȳþ-lid">
