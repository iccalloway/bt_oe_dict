<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eln-gemet" d:title="eln-gemet">
		<body>
			<h1>eln-gemet<span class="pron"> | eln.Ge.met |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An ell-measure, the length of an ell, two feet?</span>
						<span class="meaning-la"> (Lat. cubitalis mensura, ulnae mensura)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">make the vessel fifty wide, thirty high, three hundred long, of ell measures</span>
							<span class="q-oe">Ðæt fær gewyrc fīftiges wīd, þrittiges heāh, þreō hund lang elngemeta</span>
							<span class="q-cite"> (Cd. 65; Th. 79, 10; Gen. 1309)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eln" class="xref-target">eln</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-āscunung" d:title="on-āscunung">
