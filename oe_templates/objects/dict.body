<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fyndel" d:title="fyndel">
		<body>
			<h1>fyndel<span class="pron"> | fyn.del |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A device, invention</span>
						<span class="meaning-la"> (Lat. ad inventionem)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ad inventionem</span>
							<span class="q-oe">Tō fyndele</span>
							<span class="q-cite"> (Scint. 108, 12)</span>
						</li>
						<li>
							<span class="q-oe">Gyf hī hyra fyndele (adinuentionem) þrīstfulle gecuran</span>
							<span class="q-cite"> (Angl. xiii. 369, 54)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hyge-rōf" d:title="hyge-rōf">
		<body>
			<h1>hyge-rōf<span class="pron"> | xy.Ge.roːf |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Stout, strong of mind or heart, magnanimous</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bi-gang" d:title="bi-gang">
		
		<body>
			<h1>bi-gang<span class="pron"> | bi.gɑng |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a course, way, passage, circuit</span>
						<span class="meaning-la"> (Lat. cursus, via, tenor, circuitus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the course of seasons</span>
							<span class="q-oe">Tīda bigong</span>
							<span class="q-cite"> (Exon. 11 a; Th. 15, 13; Cri. 235)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">an undertaking, business, exercise, religious worship</span>
						<span class="meaning-la"> (Lat. negotium, exercitatio, cultus)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-gang" class="xref-target">be-gang</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hleōwung" d:title="hleōwung">
