<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-wītnigend-līce" d:title="un-wītnigend-līce">
		
		<body>
			<h1>un-wītnigend-līce<span class="pron"> | un.wiːt.ni.Gend.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">With impunity</span>
						<span class="meaning-la"> (Lat. inpune)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Unwītnigendlīce oððe būtan wīte inpune</span>
							<span class="q-cite"> (Ælfc. Gr. 38; Zup. 233, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
