				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Incomprehensible</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Deum majestate incomprehensibilem</span>
							<span class="q-oe">God on ðrymme unbeseōndlīcne (-fōndlīcne?)</span>
							<span class="q-cite"> (Bd. 3, 22; S. 552, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
