<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nā-hwǣrn" d:title="nā-hwǣrn">
		
		<body>
			<h1>nā-hwǣrn<span class="pron"> | nɑː.xwæːrn |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">No-where</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non usquam</span>
							<span class="q-oe">Nāwem</span>
							<span class="q-cite"> (Wrt. Voc. ii. 61, 9 : 95, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ǣgwērn" class="xref-target">ǣgwērn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wiþ-winnan" d:title="wiþ-winnan">
		<body>
			<h1>wiþ-winnan<span class="pron"> | wiθ.win.nɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -wann, pl: -wunnon</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To strive against, resist</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">eum obsistentem fortiter</span>
							<span class="q-oe">Went hē mid ealle cræfte ongēn ðæs ōðres geðyld, ðe him ðonne giet wiðwind</span>
							<span class="q-cite"> (Past. 33; Swt. 227, 7)</span>
						</li>
						<li>
							<span class="q-la">cunctis quae dicebat contradicere laborabant</span>
							<span class="q-oe">Eallum his wordum hī wiðcwǣdon and wiþwunnan</span>
							<span class="q-cite"> (Bd. 2, 2; S. 503, 17)</span>
						</li>
						<li>
							<span class="q-la">non est igitur aliquid, quod summo huic bono possit obsistere. Non, inquam, arbitror</span>
							<span class="q-oe">'Nis nān wuht ðe mæge swā heāgum gōde wiþcweþan.' Ðā cwæþ ic: 'Nē wēne ic ðæt ǣnig wuht siē ðe wiþwinne'</span>
							<span class="q-cite"> (Bt. 35, 4; Fox 160, 31)</span>
						</li>
						<li>
							<span class="q-oe">Hwæt wilt ðū cweþan, gif hwā nylle wiþwinnan</span>
							<span class="q-cite"> (36, 6; Fox 182, 6)</span>
						</li>
						<li>
							<span class="q-la">potentiam bene regit qui et tenere illam noverit et impugnare</span>
							<span class="q-oe">Ðone anwald maeg wel reccan se ðe ǣgðer ge hine habban cann ge wiðwinnan</span>
							<span class="q-cite"> (Past. 17; Swt. 113, 21)</span>
						</li>
						<li>
							<span class="q-la">quamvis multum renitens</span>
							<span class="q-oe">Ðeāh ðe hē swȳþe wiþwinnende wǣre</span>
							<span class="q-cite"> (Bd. 4, 28; S. 606, 17)</span>
						</li>
						<li>
							<span class="q-oe">Ða biscepas sǣdon ðæt ealle godas him irre wǣren and wiðwinnende</span>
							<span class="q-cite"> (Ors. 3, 7; Swt. 114, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wiþer-winnan" class="xref-target">wiþer-winnan</a>, <a href="x-dictionary:r:wiþ" class="xref-target">wiþ</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="adeliht" d:title="adeliht">
		<body>
			<h1>adeliht<span class="pron"> | ɑ.de.lixt |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Þǣm adelihtum cenosis</span>
						<span class="q-cite"> (Wrt. Voc. ii. 20, 16)</span>
					</li>
					<li>
						<span class="q-oe">Adlihtum</span>
						<span class="q-cite"> (97, 16)</span>
					</li>
					<li>
						<span class="q-oe">Cenosas þā fennigan meras, i. paludes paludosas vel adelihtan, fūlan lutosas, fetidas, immundas</span>
						<span class="q-cite"> (130, 68)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-rār" d:title="-rār">
