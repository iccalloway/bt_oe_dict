<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣ-lǣte" d:title="ǣ-lǣte">
		<body>
			<h1>ǣ-lǣte<span class="pron"> | æː.læː.te |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A desert</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ǣlǣtan (ā-, Wrt.) deserta, s. vocata quae mm seruntur</span>
							<span class="q-cite"> (Wrt. Voc. ii. 139, 14)</span>
						</li>
						<li>
							<span class="q-oe">Wēstensetlan ðe feor fram mannum gewītað and wēste stōwa and ǣlǣtu lufiaþ</span>
							<span class="q-cite"> (R. Ben. 134, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A desert</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hand-bōc" d:title="hand-bōc">
		<body>
			<h1>hand-bōc<span class="pron"> | xɑnd.boːk |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A hand-book, manual</span>
						<span class="meaning-la"> (Lat. manualis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hand-bōc manualis</span>
							<span class="q-cite"> (Wrt. Voc. 81, 46)</span>
						</li>
						<li>
							<span class="q-en">the holy books: psalter and epistle-book ... book of canticles and manual</span>
							<span class="q-oe">Ða hālgan bēc saltere and pistolbōc ... sangbōc and handbōc</span>
							<span class="q-cite"> (L. Ælf. C. 21; Th. ii. 350, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sweor-sceacel" d:title="sweor-sceacel">
