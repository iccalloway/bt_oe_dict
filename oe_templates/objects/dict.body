<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-reāfigend" d:title="be-reāfigend">
		<body>
			<h1>be-reāfigend<span class="pron"> | be.ræ͜ɑː.fi.Gend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A spoiler, robber</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Eālā þū sǣ, manna be-reāfigend and unscæððigra beswtcend</span>
							<span class="q-cite"> (Ap. Th. ll, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frymþ(e)līce" d:title="frymþ(e)līce">
		<body>
			<h1>frymþ(e)līce<span class="pron"> | frymθ, e, liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
