<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frum" d:title="frum">
		<body>
			<h1>frum<span class="pron"> | frum |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Vigorous, strenuous, prompt, quick, rapid</span>
						<span class="meaning-la"> (Lat. strēnuus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it was swift in its course, more rapid than birds</span>
							<span class="q-oe">Swift wæs on fōre, fuglum frumra</span>
							<span class="q-cite"> (Exon. 113 b; Th. 434, 21; Rä. 52, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:from" class="xref-target">from</a>
			</p>
		</body>
	</d:entry>
