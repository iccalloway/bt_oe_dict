<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þeac-līce" d:title="þeac-līce">
		
		<body>
			<h1>þeac-līce<span class="pron"> | θæ͜ɑK.liː.tʃe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:þearllīce, II" class="xref-target">þearllīce, II</a>
			</p>
