			<h1>LEAHTER<span class="pron"> | læ͜ɑx.ter |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fault, vice, sin, crime; vitium</span>
						<span class="meaning-la"> (Lat. vitium)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="midd" d:title="midd">
		<body>
			<h1>midd<span class="pron"> | midd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Mid, middle</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Midde niht, midnight</span>
						</li>
						<li>
							<span class="q-oe">On middan, in the midst</span>
						</li>
						<li>
							<span class="q-oe">On middeweardan, in the middle part</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="yslende" d:title="yslende">
		<body>
			<h1>yslende<span class="pron"> | y.slen.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">sending forth sparks</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Yslendra favillantium</span>
							<span class="q-cite"> (Wrt. Voc. ii. 147, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-hogiendlic" d:title="for-hogiendlic">
		
		<body>
			<h1>for-hogiendlic<span class="pron"> | for.xo.Gi͜ynd.liK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Contemptible, despicable</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Forhogigendlic contemptibilis</span>
							<span class="q-cite"> (Scint. 62, 7: 125, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þele" d:title="þele">
