<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ār-weorþ-līce" d:title="ār-weorþ-līce">
		
		<body>
			<h1>ār-weorþ-līce<span class="pron"> | ɑːr.we͜orθ.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Honourably, reverently, solemnly, kindly</span>
						<span class="meaning-la"> (Lat. honorifice, reverenter, solemniter, clementer)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ār-weorþe" class="xref-target">ār-weorþe</a>, <a href="x-dictionary:r:-wurþlīce" class="xref-target">-wurþlīce</a>, <a href="x-dictionary:r:-wyrþlīce" class="xref-target">-wyrþlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mān-wyrhta" d:title="mān-wyrhta">
		<body>
			<h1>mān-wyrhta<span class="pron"> | mɑːn.wyrx.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A worker of wickedness, a sinner</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">peccatores</span>
							<span class="q-oe">Mānwyrhtan</span>
							<span class="q-cite"> (Ps. Th. 93, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gagol-bǣrnes" d:title="gagol-bǣrnes">
		
		
		<body>
			<h1>gagol-bǣrnes<span class="pron"> | gɑ.ɣol.bæːr.nes |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Wantonness, luxury, riot</span>
						<span class="meaning-la"> (Lat. lascivia, luxuria)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-swungen" d:title="be-swungen">
		<body>
			<h1>be-swungen<span class="pron"> | be.swun.Gen |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">beaten; pp. of be-swingan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-swingan" class="xref-target">be-swingan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-blissung" d:title="ge-blissung">
		<body>
			<h1>ge-blissung<span class="pron"> | je.blis.sung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">cum magna hilaritate</span>
						<span class="q-oe">Mid mycelre geblissunge</span>
						<span class="q-cite"> (Angl. xiii. 367, 28)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="oster-hlāf" d:title="oster-hlāf">
		<body>
			<h1>oster-hlāf<span class="pron"> | o.ster.xlɑːf |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An oyster-patty</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Osterhlāfas sint tō forbeōdanne</span>
							<span class="q-cite"> (Lchdm. ii. 210, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sīdan" d:title="sīdan">
		<body>
			<h1>sīdan<span class="pron"> | siː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">From a wide area</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Of gehwilcum stōwum wȳdan and sȳdan gegaderod</span>
							<span class="q-cite"> (Cod. Dip. B. ii. 389, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:next word" class="xref-target">next word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nearu-līce" d:title="nearu-līce">
		
		<body>
			<h1>nearu-līce<span class="pron"> | næ͜ɑ.ru.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">anxietate febrium urgetur</span>
							<span class="q-oe">Heō nearolīce (angsumlīce, v.l.) geþreād wæs mid feferādle</span>
							<span class="q-cite"> (Gr. D. 29, 21)</span>
						</li>
						<li>
							<span class="q-la">cum huc illucque anxius pergeret</span>
							<span class="q-oe">Þā eōde hē hider and þider nearolīce geswænced in his geþōhte</span>
							<span class="q-cite"> (251, 24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">closely, tightly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">strictim (moecham mamis strictim tollentis obuncat, Aid. 164. 3)</span>
							<span class="q-oe">Nearolīce</span>
							<span class="q-cite"> (An. Ox. 18 b, 90)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">illiberally (?), evilly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ne anhyre ðū ꝥ nearolīce (nequiter) þū dō. Þe nearolīce (nequiter) dōþ beōð ge-teōrode</span>
							<span class="q-cite"> (Ps. Rdr. 36, 8-9)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:nearu-þanc" class="xref-target">nearu-þanc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dæg-rīm" d:title="dæg-rīm">
		<body>
			<h1>dæg-rīm<span class="pron"> | dæj.riːm |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A number of days, a course of days</span>
						<span class="meaning-la"> (Lat. dierum numerus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he knew the better that his life's end was passed, his days' number</span>
							<span class="q-oe">Wiste ðe geornor ðæt his aldres wæs ende gegongen, dōgora dægrīm</span>
							<span class="q-cite"> (Beo. Th. 1650; B. 823)</span>
						</li>
						<li>
							<span class="q-en">upon the island where Apollo's daughter dwelt a number of days</span>
							<span class="q-oe">Upon ðæt īgland ðǣr Apollines dōhtor wunode dægrīmes worn</span>
							<span class="q-cite"> (Bt. Met. Fox 26, 66; Met. 26, 33: Cd. 47; Th. 60, 1; Gen. 975: 67; Th. 80, 20; Gen. 1331)</span>
						</li>
						<li>
							<span class="q-en">in his number of days</span>
							<span class="q-oe">On his dægrīme</span>
							<span class="q-cite"> (Exon. 83 b; Th. 314, 10; Mōd. 12)</span>
						</li>
						<li>
							<span class="q-en">wise in number of days</span>
							<span class="q-oe">Dægrīme frōd</span>
							<span class="q-cite"> (130 a; Th. 498, 15; Rä. 88, 2: Cd. 99; Th. 131, 9; Gen. 2173)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stōr" d:title="stōr">
		<body>
			<h1>stōr<span class="pron"> | stoːr |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Frankincense, storax</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðes stōr hoc thus</span>
							<span class="q-cite"> (Ælfc. Gr. 9, 33 ; Zup. 59, 14 : Wrt. Voc. i. 81, 25)</span>
						</li>
						<li>
							<span class="q-oe">Stōr ðe biþ of gewringe stacten</span>
							<span class="q-cite"> (20, 28)</span>
						</li>
						<li>
							<span class="q-oe">Hī him geoffrodon gold and rēcels and myrran . . . se stōr getācnode ðæt hē is sōð God</span>
							<span class="q-cite"> (Homl. Th. i. 116, 9)</span>
						</li>
						<li>
							<span class="q-oe">Āne hand fulle stōres</span>
							<span class="q-cite"> (Lev. 2, 2)</span>
						</li>
						<li>
							<span class="q-la">sumite modicum storacis</span>
							<span class="q-oe">Nymeþ stōr</span>
							<span class="q-cite"> (Gen. 43, 11)</span>
						</li>
						<li>
							<span class="q-la">qui offerebant incensum</span>
							<span class="q-oe">Ða ðe offrodon ðone stōr</span>
							<span class="q-cite"> (Num. 16, 35)</span>
						</li>
						<li>
							<span class="q-oe">Brimne stōr and hwītne rȳcels</span>
							<span class="q-cite"> (Lchdm. iii. 14, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:stēran" class="xref-target">stēran</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-gnīdan" d:title="for-gnīdan">
		
		<body>
			<h1>for-gnīdan<span class="pron"> | for.gniː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 3sg: -gnīt</b>
				</p>
				<p>
					<b class="ending">past: 1sg: -gnād, 3sg: -gnād, 2sg: -gnide, pl: -gnidon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -gniden</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To rub together, dash or throw down, break</span>
						<span class="meaning-la"> (Lat. contĕrĕre, allīdĕre, elīdĕre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">contrīvit lignum fīnium eōrum</span>
							<span class="q-oe">He forgnād oððe he tobrytte treōw gemǣru heora</span>
							<span class="q-cite"> (Ps. Lamb. 104, 33, 16: Ps. Spl. 106, 16)</span>
						</li>
						<li>
							<span class="q-la">laqueus contrītus est, et nos līběrāti sŭmus</span>
							<span class="q-oe">Grin forgniden is, and we alȳsde synd</span>
							<span class="q-cite"> (Ps. Spl. 123, 7)</span>
						</li>
						<li>
							<span class="q-la">cor contrītum Deus non despĭcies</span>
							<span class="q-oe">Heorte forgnidene God nā beheōld</span>
							<span class="q-cite"> (Ps. Spl. 50, 18)</span>
						</li>
						<li>
							<span class="q-la">allīdit illum</span>
							<span class="q-oe">He forgnīt hine</span>
							<span class="q-cite"> (Mk. Bos. 9, 18)</span>
						</li>
						<li>
							<span class="q-la">quia allīsisti me</span>
							<span class="q-oe">Forðon ðū forgnide me</span>
							<span class="q-cite"> (Ps. Spl. 101, 11)</span>
						</li>
						<li>
							<span class="q-la">Dŏmĭnus erĭgit omnes elīsos</span>
							<span class="q-oe">Drihten arǣreþ ealle forgnidene</span>
							<span class="q-cite"> (Ps. Spl. 144, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="spornettan" d:title="spornettan">
		<body>
			<h1>spornettan<span class="pron"> | spor.net.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To strike with the feet, kick</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non calcitres</span>
							<span class="q-oe">Ne spornette ðū</span>
							<span class="q-cite"> (Wrt. Voc. ii. 60, 61: 80, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-swyru" d:title="ge-swyru">
		<body>
			<h1>ge-swyru<span class="pron"> | je.swy.ru |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Hills</span>
						<span class="meaning-la"> (Lat. colles)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-sweoru" class="xref-target">ge-sweoru</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Eald-Seaxe" d:title="Eald-Seaxe">
		<body>
			<h1>Eald-Seaxe<span class="pron"> | æ͜ɑld.sæ͜ɑk.se |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Þāra cynna monig hē wiste on Germanie wesan, þanon Engle and Seaxan cumene wǣron þe nū on Breotone eardiað. Wǣron Frysan, Dene, Ealdseaxan (Ald-, v. l.)</span>
						<span class="q-cite"> (Bd. 5, 9; Sch. 590, 9)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-segel" d:title="in-segel">
		<body>
			<h1>in-segel<span class="pron"> | in.se.Gel |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a seal attached to a document as evidence of authenticity</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Seō sprǣc wearð ðām cynge cūð. Ðā ðā him seō talu cūð wæs, ðā sende hē gewrit and his insegl tō ðām arcebisceope</span>
							<span class="q-cite"> (C.D. iv. 266, 19)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a seal placed on a lock, receptacle, &amp;c., so that an opening cannot be effected without breaking it</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">apothecam clausit, atque impresso sigillo proprio munitam reliquit</span>
							<span class="q-oe">Hē beleāc þæt wīnern and āsette his āgen insegl on ꝥ loc and forlēt hit swā belocen</span>
							<span class="q-cite"> (Gr. D. 59, 5)</span>
						</li>
						<li>
							<span class="q-oe">Þā insægla wǣron tō swutelunge ... þā fēng se portgerēfa tō þǣre tēge, and hē hī uninsæglode</span>
							<span class="q-cite"> (Hml. S. B. 758-765)</span>
						</li>
						<li>
							<span class="q-oe">Hī ðæt gewrit mid twām sylfrenan inseglum (insæglan, 756) on ānre teāge geinsegledon</span>
							<span class="q-cite"> (343)</span>
						</li>
						<li>
							<span class="q-la">Omnitenens sigillum manifestandi militis sui in aeternae memorationis indicium praemisit</span>
							<span class="q-oe">Cōm tācn of heofenum, and þæt bearn swytelīce mid inseglum beclȳsde</span>
							<span class="q-cite"> (Guth. Gr. 104, 13)</span>
						</li>
						<li>
							<span class="q-oe">Unȳðe þē wæs þæt þū hit eall ne mihtest mid inseglum beclȳsan</span>
							<span class="q-cite"> (Wlfst. 259, 20)</span>
						</li>
						<li>
							<span class="q-oe">Bōc mid seofon inseglum (sigillis) geinseglode ... þā bōc untȳnan and hire inseglu tōbrecan</span>
							<span class="q-cite"> (Gr. D. 332, 22-24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a seal, an engraved stamp of hard material to make an impression upon wax, &amp;c.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sicut necdum perfecte sculpta sigilla conspicimus</span>
							<span class="q-oe">Þonne wē sceāwiað þā inseglu and onlīcnessa þe þonne gȳt fullfremedlīce ne beōð āgrafene</span>
							<span class="q-cite"> (Gr. D. 283, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wiþerweard-ness" d:title="wiþerweard-ness">
		<body>
			<h1>wiþerweard-ness<span class="pron"> | wi.θer.wæ͜ɑrd.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">hostility, contention, opposition</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nis ðǣr ege, ne geflit, ne yrre, ne nǣnig wiþerweardnes</span>
							<span class="q-cite"> (Blickl. Homl. 25, 32)</span>
						</li>
						<li>
							<span class="q-en">he (David) was greedy for the death of the good man (Uriah), who was without any crime against him and had shewn no hostility to him</span>
							<span class="q-oe">Hē wearð grǣdig ðæs gōdan deāþes būtan ǣlcre scylde and ǣlcre wiðerweardnesse wið hine</span>
							<span class="q-cite"> (Past. 3; Swt. 37, 2)</span>
						</li>
						<li>
							<span class="q-la">cum aemulo</span>
							<span class="q-oe">Mid wiðerwurdnessa</span>
							<span class="q-cite"> (Hpt. Gl. 405, 32)</span>
						</li>
						<li>
							<span class="q-oe">Sume sace wyðerwyrdnesse hit getācnaþ</span>
							<span class="q-cite"> (Lchdm. iii. 198, 13)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">perversity, frowardness, depravity, arrogance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">perversius</span>
							<span class="q-oe">Wiðirweardnis ł wyrs</span>
							<span class="q-cite"> (Mt. Kmbl. p. 2, 1)</span>
						</li>
						<li>
							<span class="q-la">arrogantie</span>
							<span class="q-oe">Wiþerwerdnysse</span>
							<span class="q-cite"> (Anglia xiii. 371, 83)</span>
						</li>
						<li>
							<span class="q-oe">Wyþerwyrdnysse</span>
							<span class="q-cite"> (369, 56)</span>
						</li>
						<li>
							<span class="q-la">pravis</span>
							<span class="q-oe">Wiðirwordnisum</span>
							<span class="q-cite"> (Rtl. 91, 24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">unfavourable condition, adverse circumstance, adversity</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">adversa fortuna, adversitas</span>
							<span class="q-oe">Seō wiþerweardnes</span>
							<span class="q-cite"> (Bt. 20; Fox 72, 5, 9, 12)</span>
						</li>
						<li>
							<span class="q-oe">Nān yfel ne mæg ðē geneālǣcan, ac ǣlc wiðerweardnys gewīteþ fram ðīnre sāwle</span>
							<span class="q-cite"> (Basil admn. 1; Norm. 34, 10)</span>
						</li>
						<li>
							<span class="q-oe">Ðū ðē ne anhebbe on ofermētto on ðīnre gesundfulnesse, ne eft ðē ne geortrȳwe nānes gōdes on nānre wiþerweardnesse</span>
							<span class="q-cite"> (Bt. 6; Fox 16, 1)</span>
						</li>
						<li>
							<span class="q-la">in aduersitate</span>
							<span class="q-oe">On wiberwerdnesse</span>
							<span class="q-cite"> (Wülck. Gl. 252, 4)</span>
						</li>
						<li>
							<span class="q-oe">Wiðirwordnise</span>
							<span class="q-cite"> (Rtl. 14, 20)</span>
						</li>
						<li>
							<span class="q-la">qui prospera mundi postposuit, qui nulla adversa pertimescit</span>
							<span class="q-oe">Hē ðisses middangeardes orsorgnesse ne gīmð, ne him nāne wiðerweardnesse ne andrǣt ðisse worolde</span>
							<span class="q-cite"> (Past. 10; Swt. 61, 8: 33; Swt. 219, 2)</span>
						</li>
						<li>
							<span class="q-oe">Hē sǣde ge hwylce wiþerwardnesse (-wordnesse, Bd. M. 330, 10), ge eft hwylce frōfre on ðām wiþerweardnessum (-wordnissum, Bd. M.) him becom</span>
							<span class="q-cite"> (Bd. 4, 22; S. 592, 17)</span>
						</li>
						<li>
							<span class="q-oe">Geþyld on wiðerwerdnyssum</span>
							<span class="q-cite"> (Scint. 12, 12)</span>
						</li>
						<li>
							<span class="q-la">in adversitatibus</span>
							<span class="q-oe">On wiþerwerdnyssum</span>
							<span class="q-cite"> (62, 2)</span>
						</li>
						<li>
							<span class="q-oe">Ða getreōwfullan for Godes ege ealle līfes wiðerweardnesse (universa contraria) forþyldigian scylun</span>
							<span class="q-cite"> (R. Ben. 27, 7)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">contrariety, diversity</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Seō wiþerweardnes ðe wē ǣr ymbe sprǣcon</span>
							<span class="q-cite"> (Bt. 21; Fox 74, 32: Met. 11, 78)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wiþer-weard" class="xref-target">wiþer-weard</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="an-bīdian" d:title="an-bīdian">
		<body>
			<h1>an-bīdian<span class="pron"> | ɑn.biː.di.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ude</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To abide, wait, wait for, expect</span>
						<span class="meaning-la"> (Lat. morari, commorari, expectare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ut pertgrinaritur ibi</span>
							<span class="q-oe">Wolde ðǣr on ælþeōdignisse anbīdian</span>
							<span class="q-cite"> (Gen. 12, 10)</span>
						</li>
						<li>
							<span class="q-la">me expectant justi donec retribuas mihi</span>
							<span class="q-oe">Me anbīdiaþ rihtwīse ōþ-ðæt ðū afyldest me</span>
							<span class="q-cite"> (Ps. Spl. 141, 10)</span>
						</li>
						<li>
							<span class="q-la">expectabam eum</span>
							<span class="q-oe">Ic anbīdude hine</span>
							<span class="q-cite"> (54, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="strapul" d:title="strapul">
		<body>
			<h1>strapul<span class="pron"> | strɑ.pul |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A covering for the leg, kind of trouser</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Strapulas tubroces (tubrucus lanea ocrea, ocreis aut calceis coriaceis superimponi solita, Migne) vel brace</span>
							<span class="q-cite"> (Wrt. Voc. i. 25, 61)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þeox" d:title="þeox">
		<body>
			<h1>þeox<span class="pron"> | θe͜oks |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a spear</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ferratis venabulis</span>
							<span class="q-oe">Īsenum bārsperum ł þioxum</span>
							<span class="q-cite"> (Hpt. Gl. 423, 68)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-wyrmede" d:title="-wyrmede">
		<body>
			<h1>-wyrmede<span class="pron"> | wyr.me.de |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:deāg-wyrmede" class="xref-target">deāg-wyrmede</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="GE-RǼDE" d:title="GE-RǼDE">
