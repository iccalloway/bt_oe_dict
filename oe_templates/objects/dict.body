<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scīn-hiw" d:title="scīn-hiw">
		
		<body>
			<h1>scīn-hiw<span class="pron"> | ʃiːn.xiw |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A form produced by magic, phantom, spectre</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">prestigium</span>
							<span class="q-oe">Scīnhiw prestigium</span>
							<span class="q-cite"> (Wrt. Voc. i. 21, 61)</span>
						</li>
						<li>
							<span class="q-la">fantasma</span>
							<span class="q-oe">Scīnhiw</span>
							<span class="q-cite"> (ii. 33, 82)</span>
						</li>
						<li>
							<span class="q-oe">Scīnlāc vel [scīn]hiw fantasia, i. imaginatio, delusio mentis</span>
							<span class="q-cite"> (147, 42)</span>
						</li>
						<li>
							<span class="q-la">ferale monstrum</span>
							<span class="q-oe">Rēþlic scīnhiw ferale monstrum</span>
							<span class="q-cite"> (147, 53: Hymn. Surt. 142, 12)</span>
						</li>
						<li>
							<span class="q-oe">Ne eom ic nā scinnhiw (phantasma), swā swā gē wēnaþ</span>
							<span class="q-cite"> (Homl. Th. ii. 388, 26)</span>
						</li>
						<li>
							<span class="q-la">faniasiae</span>
							<span class="q-oe">Scīnhiowes</span>
							<span class="q-cite"> (Ps. Surt. ii. p. 190, 11)</span>
						</li>
						<li>
							<span class="q-la">phantasmate</span>
							<span class="q-oe">Scīnhiwe[s]</span>
							<span class="q-cite"> (Wrt. Voc. ii. 67, 5)</span>
						</li>
						<li>
							<span class="q-oe">Scīnhiwe</span>
							<span class="q-cite"> (34, 1)</span>
						</li>
						<li>
							<span class="q-la">prestigias</span>
							<span class="q-oe">Wiccecræftas, scīnhiw prestigias</span>
							<span class="q-cite"> (66, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þrȳþ-gesteald" d:title="þrȳþ-gesteald">
