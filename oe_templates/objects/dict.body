<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Sadducēisc" d:title="Sadducēisc">
		<body>
			<h1>Sadducēisc<span class="pron"> | sɑd.du.Keː.iʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sadducean</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē hēt ða Saducēiscan stylle beōn</span>
							<span class="q-cite"> (Mt. Kmbl. 22, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sige-tiber" d:title="sige-tiber">
		<body>
			<h1>sige-tiber<span class="pron"> | si.Ge.ti.ber |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sacrifice for victory</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wolde līge gesyllan his swǣsne sunu tō sigetibre</span>
							<span class="q-cite"> (Cd. Th. 203, 12 ; Exod. 402)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sigor-tiber" class="xref-target">sigor-tiber</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wiþer-hlinian" d:title="wiþer-hlinian">
		<body>
			<h1>wiþer-hlinian<span class="pron"> | wi.θer.xli.ni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To lean against</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wiðerhlingende, uuidirhliniendae, uuidirlinienti innitentes</span>
							<span class="q-cite"> (Txts. 71, 1098)</span>
						</li>
						<li>
							<span class="q-oe">Wiþerhlyniende</span>
							<span class="q-cite"> (Wrt. Voc. ii. 48, 78)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wel-hwilc" d:title="wel-hwilc">
		<body>
			<h1>wel-hwilc<span class="pron"> | wel.xwilk |</span>
			</h1>
			<div>
				<p>
					<b>pronoun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">carnales quique dubitant</span>
						<span class="q-oe">Wellhwylce men tweōað</span>
						<span class="q-cite"> (Gr. D. 260, 21)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrþere" d:title="byrþere">
		<body>
			<h1>byrþere<span class="pron"> | byr.θe.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -byrþres</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bearer, carrier, supporter</span>
						<span class="meaning-la"> (Lat. portarius, vespillo, fulcimen)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Christ chose the mean ass for his bearer</span>
							<span class="q-oe">Crist ðone wācan assan geceās him to byrþre</span>
							<span class="q-cite"> (Homl. Th. i. 210, 16)</span>
						</li>
						<li>
							<span class="q-en">the bearers bare him to the grave</span>
							<span class="q-oe">Ða byrþeras hine to byrgenne fēredon</span>
							<span class="q-cite"> (i. 492, 27)</span>
						</li>
						<li>
							<span class="q-en">the infirmity of his nature had need of some supporter</span>
							<span class="q-oe">Seō untrumnys his gecyndes behōfode sumes byrþres</span>
							<span class="q-cite"> (i. 308, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-blāwness" d:title="ā-blāwness">
		<body>
			<h1>ā-blāwness<span class="pron"> | ɑː.blɑːw.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Upblowing, inflation</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wiþ āblāunesse ðæs innoþes</span>
							<span class="q-cite"> (Lch. ii. 170, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-swīðestre" d:title="ofer-swīðestre">
		<body>
			<h1>ofer-swīðestre<span class="pron"> | o.fer.swiː.θe.stre |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A conqueror</span>
						<span class="meaning-la"> (Lat. victrix)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þīfe-þorn" d:title="þīfe-þorn">
		<body>
			<h1>þīfe-þorn<span class="pron"> | θiː.fe.θorn |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Slīt mid þefoþorne (cf. þorn, 106, 5)</span>
						<span class="q-cite"> (Lch. ii. 52, 8)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hēn" d:title="ge-hēn">
		<body>
			<h1>ge-hēn<span class="pron"> | je.xeːn |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fallen, low</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ða gehēno kaduca</span>
							<span class="q-cite"> (Rtl. 189, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:heān" class="xref-target">heān</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="clerc" d:title="clerc">
		
		<body>
			<h1>clerc<span class="pron"> | klerk |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">one of the secular (as opposed to monastic) clergy</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic secge þē, lā cleric, on þīn eāre</span>
							<span class="q-cite"> (Angl. viii. 300, 14)</span>
						</li>
						<li>
							<span class="q-oe">On gewittnesse Byrhtstānes mæssepreōstes and on clerices þe þis gewrāt</span>
							<span class="q-cite"> (Cht. E. 255, 30)</span>
						</li>
						<li>
							<span class="q-oe">Wolde ic ꝥ þā ǣðela(n) clericas āsceōcon fram heora andgites orðance ǣlce sleacnysse</span>
							<span class="q-cite"> (Angl. viii. 301, 4)</span>
						</li>
						<li>
							<span class="q-oe">Ūs þingð tō langsum ꝥ wē ealne þisne cwide on Englisc clericum geswutelion</span>
							<span class="q-cite"> (300, 7)</span>
						</li>
						<li>
							<span class="q-oe">Hē was underfange of þām hādesmannum þe him ealra uneāðest was, ꝥ was clerican</span>
							<span class="q-cite"> (Chr. 995; P. 128, 20)</span>
						</li>
						<li>
							<span class="q-oe">Hē ongan tō tellende þām pāpan eal embe þā clericas</span>
							<span class="q-cite"> (P. 130, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cliroc" class="xref-target">cliroc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flītan" d:title="flītan">
		<body>
			<h1>flītan<span class="pron"> | fliː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">disceptant</span>
							<span class="q-oe">Flītat</span>
							<span class="q-cite"> (Wrt. Voc. ii. 106, 41)</span>
						</li>
						<li>
							<span class="q-la">Disceptant, lacerant, i. contendunt</span>
							<span class="q-oe">flītaþ</span>
							<span class="q-cite"> (140, 59)</span>
						</li>
						<li>
							<span class="q-la">certavi, coteiendi</span>
							<span class="q-oe">Ic flāt</span>
							<span class="q-cite"> (130, 28)</span>
						</li>
						<li>
							<span class="q-la">disceptavimus</span>
							<span class="q-oe">Wē flitan</span>
							<span class="q-cite"> (28, 20)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="sub-heading">of action</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">to strive as an opponent</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">semper adversum Dominum contendisti</span>
											<span class="q-oe">Ǣfre gē fliton and wunnon ongeān Drihten</span>
											<span class="q-cite"> (Deut. 9, 7)</span>
										</li>
										<li>
											<span class="q-la">semper conlentiose egistis contra Dominum</span>
											<span class="q-oe">Æfre gē fliton ongēn God</span>
											<span class="q-cite"> (31, 27)</span>
										</li>
										<li>
											<span class="q-la">exercebantur (adversum me; cf. me wiðerwearde wǣron ealle, Ps. Th. 68, 13)</span>
											<span class="q-oe">Hȳ fliton</span>
											<span class="q-cite"> (Bl. Gl.)</span>
										</li>
										<li>
											<span class="q-la">contra quos valeatis vos extenders semper invenitis</span>
											<span class="q-oe">Ðū findst wid hwone ðū meaht flītan</span>
											<span class="q-cite"> (Past. 331, 5)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(1a)</span>
												<span class="sub-heading">of abstract objects</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Hū micel wǣre ꝥ gecamp þe wann on þæi mannes breōstum ; þǣr fleāt (feaht, v. l. pugnabat) betweoh him seō eādmōdnys . . . and seō ārfaestnys</span>
													<span class="q-cite"> (Gr. D. 18, 6)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">to strive as a competitor</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">obsecrans ut mihi certandi cum illis copia daretur</span>
											<span class="q-oe">Ðā hālsade ic ꝥ mē wǣre lȳfnes seald tō ærnenne and tō flītanne mid him</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāga-swind" d:title="eāga-swind">
		<body>
			<h1>eāga-swind<span class="pron"> | æ͜ɑː.ɣɑ.swind |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<p>
					<b class="ending">genitive pl: -na</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the eyelid, the cheek</span>
						<span class="meaning-la"> (Lat. gēna)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ātrendlian" d:title="ātrendlian">
		<body>
			<h1>ātrendlian<span class="pron"> | ɑː.trend.li.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To trundle, roll</span>
						<span class="meaning-la"> (Lat. volutare, provolvere)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-ecgede" d:title="-ecgede">
		<body>
			<h1>-ecgede<span class="pron"> | edʒ.dʒe.de |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:feōwer-ecgede" class="xref-target">feōwer-ecgede</a>, <a href="x-dictionary:r:fīf-ecgede" class="xref-target">fīf-ecgede</a>, <a href="x-dictionary:r:fiþer-ecgede" class="xref-target">fiþer-ecgede</a>, <a href="x-dictionary:r:ge-ecgede" class="xref-target">ge-ecgede</a>, <a href="x-dictionary:r:scearp-ecgede" class="xref-target">scearp-ecgede</a>, <a href="x-dictionary:r:twi-ecgede(-ode)" class="xref-target">twi-ecgede(-ode)</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nam-bōc" d:title="nam-bōc">
		<body>
			<h1>nam-bōc<span class="pron"> | nɑm.boːk |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A book in which names are written, a register</span>
						<span class="meaning-la"> (Lat. albo)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nombēc albo</span>
							<span class="q-cite"> (Wrt. Voc. ii. 3, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="breōst" d:title="breōst">
		<body>
			<h1>breōst<span class="pron"> | bre͜oːst |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">his mind</span>
						<span class="q-cite"> (33; Th. 44, 27; Gen. 715)</span>
					</li>
					<li>
						<span class="q-la">tu nostrorum pectorum solus investigator es</span>
						<span class="q-oe">Ðū ūra breōsta āna aspyrigend eart</span>
						<span class="q-cite"> (Hymn. Surt. 33, 21)</span>
					</li>
					<li>
						<span class="q-la">judex aderis rimari facta pectoris</span>
						<span class="q-oe">Dēma ðū ætbist smēgan dǣda breōstes</span>
						<span class="q-cite"> (36, 20)</span>
					</li>
					<li>
						<span class="q-la">imple superna gratia quæ tu creasti pectora</span>
						<span class="q-oe">Gefyll mid heofonlīcre gyfe ðe ðū gesceōpe breōst</span>
						<span class="q-cite"> (92, 9)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:byled-breōst" class="xref-target">byled-breōst</a>, <a href="x-dictionary:r:fōre-" class="xref-target">fōre-</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-gēman" d:title="ge-gēman">
		<body>
			<h1>ge-gēman<span class="pron"> | je.Geː.mɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-gīman" class="xref-target">ge-gīman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lesan" d:title="lesan">
		<body>
			<h1>lesan<span class="pron"> | le.sɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -læs, pl: -lǣson</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -lesen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To lease [= glean dialect.], gather, collect</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">earthly power never sows virtues, but collects and gathers vices</span>
							<span class="q-oe">Se eorþlīca anweald nǣfre ne sǣwþ cræftas ac lisþ and gadraþ unþeāwas</span>
							<span class="q-cite"> (Bt. 27, 1; Fox 94, 25)</span>
						</li>
						<li>
							<span class="q-en">if ye gather herbs on Sunday</span>
							<span class="q-oe">Gif gē lesaþ wyrte on Sunnandæg</span>
							<span class="q-cite"> (Wulfst. 231, 18)</span>
						</li>
						<li>
							<span class="q-en">I collected</span>
							<span class="q-oe">Ic læs</span>
							<span class="q-cite"> (Elen. Kmbl. 2474; El. 1238)</span>
						</li>
						<li>
							<span class="q-en">they kept on all the while collecting and joining to themselves all the sailors they found</span>
							<span class="q-oe">Hī lǣson ǣfre forþ mid heom ealle ða butsecarlas ðe heō gemētton</span>
							<span class="q-cite"> (Chr. 1052; Erl. 184, 15)</span>
						</li>
						<li>
							<span class="q-la">nec remanentes spicas colligetis, sed pauperibus et peregrinis dimittetis eas</span>
							<span class="q-oe">Ne gē ne gaderion ða eār ðe bæftan eōw beōþ ac lǣtaþ þearfan and ūtācymene hig lesan</span>
							<span class="q-cite"> (Lev. 23, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-lesan" class="xref-target">ā-lesan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cleofian" d:title="ge-cleofian">
		<body>
			<h1>ge-cleofian<span class="pron"> | je.kle͜o.fi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To cleave, adhere, stick</span>
						<span class="meaning-la"> (Lat. adhærēre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">adhæsit pāvimento anima mea</span>
							<span class="q-oe">Geþeōdde oððe gecleofede on fīōre sāwle mīn</span>
							<span class="q-cite"> (Ps. Lamb. 118, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bōc-æceras" d:title="bōc-æceras">
		<body>
			<h1>bōc-æceras<span class="pron"> | boːk.æ.Ke.rɑs |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hiis terminis circumtdata terra ... in acquilone, burhware bōcaceras</span>
						<span class="q-cite"> (C. D. v. 186, 34)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āteāh" d:title="āteāh">
		<body>
			<h1>āteāh<span class="pron"> | ɑː.tæ͜ɑːx |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">drew out or away, went, came</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āteōn" class="xref-target">āteōn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-bedda" d:title="ge-bedda">
		<body>
			<h1>ge-bedda<span class="pron"> | je.bed.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1 a)</span>
								<span class="sub-heading">of a husband</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ælc wīf ðe cild gebǣre ... sceolde forhabban ... fram hire gebeddan</span>
									<span class="q-cite"> (Hml. Th. i. 134, 20)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hafað him þrȳ gebeddan, ꝥ is greōt and molde and wyrmas</span>
							<span class="q-cite"> (Verc. Först. 92, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-resta" class="xref-target">ge-resta</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āblācian" d:title="āblācian">
		
		<body>
			<h1>āblācian<span class="pron"> | ɑː.blɑː.Ki.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To be or look pale, grow pale</span>
						<span class="meaning-la"> (Lat. pallere, obrigescere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">obriguerunt</span>
							<span class="q-oe">Ablācodon</span>
							<span class="q-cite"> (Ex. 22, 16? Lye)</span>
						</li>
						<li>
							<span class="q-la">palleo</span>
							<span class="q-oe">Ic blācige</span>
							<span class="q-cite"> (Ælfc. Gr. 26, 2; Som. 28, 42)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cīping" d:title="cīping">
		<body>
			<h1>cīping<span class="pron"> | Kiː.ping |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">trading, marketing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the smith met this Eadsige's man āmarketing</span>
							<span class="q-oe">Se smið gemētte on cȳpincge þæs Eādzies mann</span>
							<span class="q-cite"> (Hml. S. 21, 75)</span>
						</li>
						<li>
							<span class="q-la">mercaturam exercere</span>
							<span class="q-oe">Þām dǣdbētan nis ālȳfed nǣnige cȳpinge tō drīfenne</span>
							<span class="q-cite"> (Ll. Th. ii. 170, 11)</span>
						</li>
						<li>
							<span class="q-la">in mercatu mercaturam exercere</span>
							<span class="q-oe">On ceāpstōwe cȳpinge begān</span>
							<span class="q-cite"> (174, 19)</span>
						</li>
						<li>
							<span class="q-oe">Cȳpinge wyrcan</span>
							<span class="q-cite"> (Cht. E. 231, 21)</span>
						</li>
						<li>
							<span class="q-oe">Cīpinge anginnan</span>
							<span class="q-cite"> (Lch. iii. 178, 2)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="meaning-en">dues paid for trading, market-dues</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Uillae mercimonium, quod Anglice ðæs tūnes cȳping appellatur, censusque omnis ciuilis aecclesiae, cum omnibus commodis, deseruiat</span>
									<span class="q-cite"> (C. D. v. 158, 37)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">merchandise</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mercimonium (or under I, if a gloss on Ald. 56, 15:--Spirituale exercetur mercimonium. Cf. An. Ox. 4807)</span>
							<span class="q-oe">Cēping</span>
							<span class="q-cite"> (Wrt. Voc. ii. 57, 18)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a market, market-place</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Cēping mercatum, scipmanna myrt þe cēping teloneum</span>
							<span class="q-cite"> (Wrt. Voc. i. 37, 9, 10)</span>
						</li>
						<li>
							<span class="q-oe">Hē cōm intō þǣre cȳpinge þǣr gehwilce men heora ceāp be[ceāpod]an</span>
							<span class="q-cite"> (Hml. S. 23, 527)</span>
						</li>
						<li>
							<span class="q-oe">Hī hine ātugan tōmiddes þǣre cȳpinge</span>
							<span class="q-cite"> (609)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cēping" class="xref-target">cēping</a>, <a href="x-dictionary:r:cȳping" class="xref-target">cȳping</a>, <a href="x-dictionary:r:ceāpung" class="xref-target">ceāpung</a>, <a href="x-dictionary:r:flǣsc-cīping" class="xref-target">flǣsc-cīping</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wel-gelīcod" d:title="wel-gelīcod">
		<body>
			<h1>wel-gelīcod<span class="pron"> | wel.Ge.liː.kod |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">well-pleasing, much liked</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic nāt for hwī eōw sindon þā ǣrran gewin swā welgelīcad</span>
							<span class="q-cite"> (Ors. 3, 7 ; S. 120, 2)</span>
						</li>
						<li>
							<span class="q-la">in beneplacito populi tui</span>
							<span class="q-oe">On welgelīcodon folces ðīnes</span>
							<span class="q-cite"> (Ps. Vos. 105, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eald-ealdfæder" d:title="eald-ealdfæder">
		<body>
			<h1>eald-ealdfæder<span class="pron"> | æ͜ɑld.æ͜ɑld.fæ.der |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a great-grandfather</span>
						<span class="meaning-la"> (Lat. proavus)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-þryscan" d:title="ge-þryscan">
		<body>
			<h1>ge-þryscan<span class="pron"> | je.θry.ʃɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ðæt geswinc hiera āgenra welora hiē geðryscð (-ðrycð, v. l.)</span>
					</li>
					<li>
						<span class="q-la">premit</span>
						<span class="q-oe">Se feōnd ðæt mōd mid grimmum edleāne geðryscð</span>
						<span class="q-cite"> (Past. 238, 15-17)</span>
					</li>
					<li>
						<span class="q-la">premat</span>
						<span class="q-oe">Ðætte siō unliēfde byrðen ðissa eorðlicena sorga hī ne geðrysce</span>
						<span class="q-cite"> (401, 6)</span>
					</li>
					<li>
						<span class="q-oe">Geðrysced (-ðryced, v. l.) mid ðǣre hefignesse his synna</span>
						<span class="q-cite"> (269, 9)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stirfan" d:title="stirfan">
		<body>
			<h1>stirfan<span class="pron"> | stir.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to kill</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-styrfan" class="xref-target">ā-styrfan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cneōrisn" d:title="cneōrisn">
		<body>
			<h1>cneōrisn<span class="pron"> | kne͜oː.risn |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A generation, race, family</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Cneōrisn Caines. . . mē þæt cynn hafað ābolgen</span>
							<span class="q-cite"> (Gen. 1256)</span>
						</li>
						<li>
							<span class="q-la">Christi generatio sic erat</span>
							<span class="q-oe">Þus wæs Crīstes cneōres (cneōrisn, v. l.)</span>
							<span class="q-cite"> (Mt. 1, 18)</span>
						</li>
						<li>
							<span class="q-oe">Mīn Drihten, wē ealle forlēton ūre cneōrisne and wǣron þē fylgende</span>
							<span class="q-cite"> (Bl. H. 229, 21)</span>
						</li>
						<li>
							<span class="q-oe">Mē eādige cwǣdon ealle cneōrisna</span>
							<span class="q-cite"> (7, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="byrðen-mǣlum" d:title="byrðen-mǣlum">
		<body>
			<h1>byrðen-mǣlum<span class="pron"> | byr.θen.mæː.lum |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">By burdens</span>
						<span class="meaning-la"> (Lat. oneribus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se dēma hǣt his englas gadrian ðone coccel byrðen-</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wemming" d:title="wemming">
		<body>
			<h1>wemming<span class="pron"> | wem.ming |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Pollution, defilement</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">lenocinii, seductionis</span>
							<span class="q-oe">Wemmincge (wēmincge? v. wēman)</span>
							<span class="q-cite"> (Hpt. Gl. 507, 20)</span>
						</li>
						<li>
							<span class="q-oe">Wiðute wemmunge</span>
							<span class="q-cite"> (H. M. 13, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-wemming" class="xref-target">ge-wemming</a>, <a href="x-dictionary:r:un-wemming" class="xref-target">un-wemming</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="more" d:title="more">
		
		<body>
			<h1>more<span class="pron"> | mo.re |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hē leofode on wǣstene be wyrta morum lange</span>
						<span class="q-cite"> (Hml. S. 31, 195)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-heāpian" d:title="ge-heāpian">
		<body>
			<h1>ge-heāpian<span class="pron"> | je.xæ͜ɑː.pi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To heap together, pile up</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">coacervassent</span>
							<span class="q-oe">Geheāpodan</span>
							<span class="q-cite"> (Wrt. Voc. ii. 15, 12)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">to heap up material (used figuratively)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">avaro . . . terrena lucra cum pondere peccati cumulare</span>
									<span class="q-oe">Ðæt se gītsere him on geheāpige ða byrðenne eorðlicra æhta</span>
									<span class="q-cite"> (Past. 329, 20)</span>
								</li>
								<li>
									<span class="q-la">mensuram bonam confertam et coagitatam</span>
									<span class="q-oe">Gōd gemet and full, geheāpod</span>
									<span class="q-cite"> (Lk. 6, 38: Wrt. Voc. ii. 133, 13)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">to accumulate, get a large amount of</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">coacervat (divitias usuris)</span>
									<span class="q-oe">Geheāpað</span>
									<span class="q-cite"> (Kent, Gl. 1045)</span>
								</li>
								<li>
									<span class="q-la">accumulet</span>
									<span class="q-oe">Gihappia ( = ?giheāpie)</span>
									<span class="q-cite"> (Rtl. 85, 29)</span>
								</li>
								<li>
									<span class="q-la">concinuatas (cf. concinnatas (i. multiplicatas) factiones (i. falsitates), Ald. 38, 15, congregatas</span>
									<span class="q-oe">Geheāpod</span>
									<span class="q-cite"> (Wrt. Voc. ii. 136, 20)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="meaning-en">to gather together (?), assemble (v. heāp a number of people)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Geheāpod</span>
									<span class="q-cite"> (Bl. H. 175, 17)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mægþ-bōt" d:title="mægþ-bōt">
		<body>
			<h1>mægþ-bōt<span class="pron"> | mæɣθ.boːt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The fine to be paid by an unmarried woman</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the fine to be paid by an unmarried woman be the same as that by a free man (for the same offence)</span>
							<span class="q-oe">Mægþbōt sī swā friges mannes</span>
							<span class="q-cite"> (L. Ethb. 74 j Th. i. 20, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efen-þrowung" d:title="efen-þrowung">
		<body>
			<h1>efen-þrowung<span class="pron"> | e.fen.θro.wung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">de compassione proximi</span>
						<span class="q-oe">Be efenþrowunge nīhstan</span>
						<span class="q-cite"> (Scint. 147, 8: 148, 12)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gyrn" d:title="gyrn">
		<body>
			<h1>gyrn<span class="pron"> | Gyrn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Grief, affliction, trouble, evil, calamity, injury</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">grief will be appointed me</span>
							<span class="q-oe">Me biþ gyrn witod</span>
							<span class="q-cite"> (Exon. 104 b; Th. 396, 18; Rä. 16, 6)</span>
						</li>
						<li>
							<span class="q-en">grief after joy</span>
							<span class="q-oe">Gyrn æfter gomene</span>
							<span class="q-cite"> (Beo. Th. 3554; B. 1775)</span>
						</li>
						<li>
							<span class="q-en">rescued from the popular hate, from calamity</span>
							<span class="q-oe">Alȳsed of leōdhete of gyrme</span>
							<span class="q-cite"> (Andr. Kmbl. 2301; An. 1152: 3168; An. 1587)</span>
						</li>
						<li>
							<span class="q-en">mournfully he cries out, sighs forth his grief</span>
							<span class="q-oe">He gilleþ geōmorlīce and his gyrn sefaþ</span>
							<span class="q-cite"> (Salm. Kmbl. 536; Sat. 267)</span>
						</li>
						<li>
							<span class="q-en">affliction through death</span>
							<span class="q-oe">Gyrn þurh gāstgedāl</span>
							<span class="q-cite"> (Exon. 45 a; Th. 153, 31; Gū. 834)</span>
						</li>
						<li>
							<span class="q-en">requite now with evil her contempt of our gods' might</span>
							<span class="q-oe">Gyldaþ nū mid gyrne ðæt heō goda ussa meaht forhogde</span>
							<span class="q-cite"> (74 b; Th. 279, 25; Jul. 619)</span>
						</li>
						<li>
							<span class="q-en">for that the children greviously paid</span>
							<span class="q-oe">Ðæs ða byre siððan gyrne onguldon</span>
							<span class="q-cite"> (61 b; Th. 226, 23)</span>
						</li>
						<li>
							<span class="q-en">torments numberless, grim troubles</span>
							<span class="q-oe">Wīta unrīm grimra gyrna</span>
							<span class="q-cite"> (68 a; Th. 252, 34; Jul. 173: 39 a; Th. 129, 7; Gū. 417)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gryn" class="xref-target">gryn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-sweorfan" d:title="for-sweorfan">
		<body>
			<h1>for-sweorfan<span class="pron"> | for.swe͜or.fɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to wipe out, destroy</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sweorfan" class="xref-target">sweorfan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="162" d:title="162">
		<body>
			<h1>162</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðæt hē nāuðer ne nānum men ne ōlicce, ne hē nānes monnes ōleccunga ne rēce</span>
							<span class="q-cite"> (Past. 383, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-serc" d:title="under-serc">
		<body>
			<h1>under-serc<span class="pron"> | un.der.serk |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An under-garment, shirt</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dōm-leās" d:title="dōm-leās">
		<body>
			<h1>dōm-leās<span class="pron"> | doːm.læ͜ɑːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Inglorious, powerless, hapless</span>
						<span class="meaning-la"> (Lat. inglōrius, impotens, infortūnātus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">nobles shall hear of your inglorious deed</span>
							<span class="q-oe">Æðelingas gefricgean dōmleāsan dǣd</span>
							<span class="q-cite"> (Beo. Th. 5772; B. 2890)</span>
						</li>
						<li>
							<span class="q-en">now we shall ever wage powerless war</span>
							<span class="q-oe">Sceolon nū ǣfre dreōgan dōmleāse gewinn</span>
							<span class="q-cite"> (Cd. 218; Th. 279, 3; Sat. 232)</span>
						</li>
						<li>
							<span class="q-en">death tore them all away, hapless they fell</span>
							<span class="q-oe">Ealle swylt fornam, druron dōmleāse</span>
							<span class="q-cite"> (Andr. Kmbl. 1989; An. 997)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-līcettan" d:title="ge-līcettan">
		<body>
			<h1>ge-līcettan<span class="pron"> | je.liː.Ket.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -te</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to imitate</span>
						<span class="meaning-la"> (Lat. simulare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">simulare (gestit simulare sui perpendicula patris, Ald. 158, 4)</span>
							<span class="q-oe">Gelīccetton</span>
							<span class="q-cite"> (Wrt. Voc. ii. 91, 66)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to make a thing appear like something better than it is, to give an appearance of goodness to a thing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðonne hwā on ðā leāsunga befēhð, ðonne ne mæg hē of, ac sceal ðonne niēde ðencean hū hē hiē gelīcettan mæge</span>
							<span class="q-cite"> (Past. 239, 13)</span>
						</li>
						<li>
							<span class="q-la">saepe inordinata remissio pietas creditur, et effrenata ira spiritalis zeli virtus aestimatur</span>
							<span class="q-oe">Oft ungemetlico forgifnes bið gelīcet, ðæt mon wēneð ðæt hit siē mildheortnes, ond oft ungemetlicu irsung bið gelīcet, ðæt menn wēnað þæt hit siē ryhtwīslic anda</span>
							<span class="q-cite"> (Past. 149, 9-11)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">II a.</span>
								<span class="sub-heading">to make to appear like to (tó)</span>
								<span class="meaning-en">to make to appear like to (tō)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">scire rector debeat, quod plerumque vitia virtutes se esse mentiuntur</span>
									<span class="q-oe">Sceal se reccere witan ðæt ðā unðeāwas beōð oft gelīccette (-līcette, v. l.) tō gōdum ðeāwum and tō mægenum ðurh leāsunga</span>
									<span class="q-cite"> (Past. 149, 3)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to act as if doing what is not really done, to pretend</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">qui bona occulte faciunt, et tamen quibusdam factis publice de se mala opinari permittunt</span>
							<span class="q-oe">Ðā ðe gōd diēgellīce dōð, and swā ðeāh on sumum weorcum gelīccetað ðæt hī openlīce yfel dōn</span>
							<span class="q-cite"> (Past. 449, 21)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">to obtain by false pretences</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ut apud imperitum vulgus scientiae sibi nomen extorqueant</span>
							<span class="q-oe">Ðæt hiē gegītsien and gelīcetten æt ðǣm ungetȳdum folce wīsdōmes naman</span>
							<span class="q-cite"> (Past. 365, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-wirgedlic" d:title="ā-wirgedlic">
		<body>
			<h1>ā-wirgedlic<span class="pron"> | ɑː.wir.Ged.liK |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:āwyrgedlic" class="xref-target">āwyrgedlic</a>, <a href="x-dictionary:r:ā-wirgendlic" class="xref-target">ā-wirgendlic</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-behelod" d:title="un-behelod">
		<body>
			<h1>un-behelod<span class="pron"> | un.be.xe.lod |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Uncovered, naked</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nudatus</span>
							<span class="q-oe">Hē læg on his getelde unbehelod</span>
							<span class="q-cite"> (Gen. 9, 21, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-slægen" d:title="for-slægen">
		<body>
			<h1>for-slægen<span class="pron"> | for.slæ.Gen |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">slain</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:for-sleān" class="xref-target">for-sleān</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bearn-eācnigende" d:title="bearn-eācnigende">
		<body>
			<h1>bearn-eācnigende<span class="pron"> | bæ͜ɑrn.æ͜ɑː.kni.Gen.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Being with child, pregnant</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Bearneācnigende wīf forbūgan</span>
							<span class="q-cite"> (Hml. Th. ii. 94, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wæter-scipe" d:title="wæter-scipe">
		<body>
			<h1>wæter-scipe<span class="pron"> | wæ.ter.ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A body of water, a piece of water, water</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">aqua, molendinum, ortus</span>
							<span class="q-oe">Gif hit beōn mæg, swā sceal mynster beōn gestaþelod, ðæt ealle neādbehēfe þing ðǣr binnan wunien, ðæt is wæterscipe, mylen, wyrtūn</span>
							<span class="q-cite"> (R. Ben. 127, 5)</span>
						</li>
						<li>
							<span class="q-oe">On ðære neāwiste næs nān wæterscipe.</span>
							<span class="q-cite"> (Jud. 15, 8)</span>
						</li>
						<li>
							<span class="q-oe">Ðis is se wæterscipe, ðe ūs God tō frōfre gehēt . . . ðæs wæterscipes welsprynge is on hefonrīce</span>
							<span class="q-cite"> (Past. 65 ; Swt. 467, 28)</span>
						</li>
						<li>
							<span class="q-la">colimbus, i. aquaeductus</span>
							<span class="q-oe">Wæterscipes hūs colimbus, i. aquaeductus</span>
							<span class="q-cite"> (Wrt. Voc. i. 57, 56)</span>
						</li>
						<li>
							<span class="q-la">scorpiones consuetam petentes aquationem</span>
							<span class="q-oe">Ðā cwōmon ðǣr scorpiones swā hiē ǣr gewunelīce wǣron ðæs wæterscipes</span>
							<span class="q-cite"> (Nar. 13, 11)</span>
						</li>
						<li>
							<span class="q-la">ut facilior aquatoribus esset accessus ad flumen</span>
							<span class="q-oe">Ðæt monnum wǣre ðȳ ēþre tō ðæm wæterscipe tō ganganne</span>
							<span class="q-cite"> (12, 20)</span>
						</li>
						<li>
							<span class="q-oe">Wæs swīþe wynsum wǣta ūt flōwende . . . Wæs ongeān ðyssum wæterscipe glæsen fæt</span>
							<span class="q-cite"> (Blickl. Homl. 209, 4)</span>
						</li>
						<li>
							<span class="q-oe">Wæs ðām gebrōðrum micel frēcednys tō āstīgenne tō wæterscipe, and cōmon tō ðam hālgan were biddende ðæt hē ða mynstra gehendor ðam wæterscipe timbrian sceolde</span>
							<span class="q-cite"> (Homl. Th. ii. 160, 29-31)</span>
						</li>
						<li>
							<span class="q-la">constituit centenarios per singulos fontes</span>
							<span class="q-oe">Hē heora wæterscipe mid weardmannum besette</span>
							<span class="q-cite"> (Anglia x. 94, 172)</span>
						</li>
						<li>
							<span class="q-oe">Ðone weterscype ðe hē into Nīwan mynstre be ðes cinges leāfan geteāh</span>
							<span class="q-cite"> (Chart. Th. 232, 3)</span>
						</li>
						<li>
							<span class="q-oe">Hwalas . . . ða ðe lagostreāmas, wæterscipe wecgaþ</span>
							<span class="q-cite"> (Cd. Th. 240, 19; Dan. 389)</span>
						</li>
						<li>
							<span class="q-oe">Ūre Drihten gesceōp ealle wæterscypas and ða wīdgillan sæ</span>
							<span class="q-cite"> (Hexam. 4; Norm. 6, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bȳend" d:title="bȳend">
		<body>
			<h1>bȳend<span class="pron"> | byː.end |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:būend" class="xref-target">būend</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æl-Þeōd" d:title="æl-Þeōd">
		
		<body>
			<h1>æl-Þeōd<span class="pron"> | æl.θe͜oːd |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A foreign nation, foreign people, foreigners</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">when the rich are among foreigners or in their own country</span>
							<span class="q-oe">Donne ða rīcan beōþ oððe on ælþeōde oððe on hiora āgenre gecȳððe</span>
							<span class="q-cite"> (Bt. 27, 3 ; Fox 98, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:el-þeōd" class="xref-target">el-þeōd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-hanga" d:title="-hanga">
		<body>
			<h1>-hanga<span class="pron"> | xɑn.gɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:līc-h" class="xref-target">līc-h</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="morþor-hof" d:title="morþor-hof">
		<body>
			<h1>morþor-hof<span class="pron"> | mor.θor.xof |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A place of torment or extreme misery (hell)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rēce-leās" d:title="rēce-leās">
		<body>
			<h1>rēce-leās<span class="pron"> | reː.Ke.læ͜ɑːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Būtan geþylde and þeāwfæstnysse wē yrsiað . . . and lythwōn þencað hū wē sceolon æt Gode miltsunge begitan nū wē swā rēceleāse syndon and swā rēþe ūs betwȳnan</span>
						<span class="q-cite"> (Hml. S. 28, 141)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sand-hyll" d:title="sand-hyll">
		<body>
			<h1>sand-hyll<span class="pron"> | sɑnd.xyll |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a sand-hill</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sondhyllas alga (cf. waar alga, 99, 69, wāra sablonum, strand sablo, Hpt. Gl. 502, 76)</span>
							<span class="q-cite"> (Wrt. Voc. ii. 99, 73)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hyse-beorþor" d:title="hyse-beorþor">
		
		<body>
			<h1>hyse-beorþor<span class="pron"> | xy.se.be͜or.θor |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The bearing of male offspring, the offspring itself, a young man</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">puerperium</span>
							<span class="q-oe">Hyseberþor puerperium</span>
							<span class="q-cite"> (Mone B. 3894)</span>
						</li>
						<li>
							<span class="q-oe">Hyseborþor</span>
							<span class="q-cite"> (4975)</span>
						</li>
						<li>
							<span class="q-oe">Hysebeorþ[or]</span>
							<span class="q-cite"> (Wrt. Voc. ii. 94, 42)</span>
						</li>
						<li>
							<span class="q-en">they would hurt the head of the man</span>
							<span class="q-oe">Woldon on ðam hysebeorþre [cf. 2253, se geonga] heafolan gescēnan</span>
							<span class="q-cite"> (Andr. Kmbl. 2285; An. 1144)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:beorþor" class="xref-target">beorþor</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scip-rōwend" d:title="scip-rōwend">
		<body>
			<h1>scip-rōwend<span class="pron"> | ʃip.roː.wend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">One who rows in a ship, a sailor, one of a crew</span>
						<span class="meaning-la"> (Lat. nauta)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sciprōwend nauta</span>
							<span class="q-cite"> (Wrt. Voc. ii. 61, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fela-specolnys" d:title="fela-specolnys">
		
		<body>
			<h1>fela-specolnys<span class="pron"> | fe.lɑ.spe.kol.nys |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Talkativeness, loquacity</span>
						<span class="meaning-la"> (Lat. loquācĭtas)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="firwitgeorn-ness" d:title="firwitgeorn-ness">
		<body>
			<h1>firwitgeorn-ness<span class="pron"> | fir.wit.Ge͜orn.ness |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">melius est mori quam fornicari</span>
						<span class="q-oe">Sēlre bið men þæt hē swelte, þonne hē his līchoman fyrwetgyrnessum gewenige</span>
						<span class="q-cite"> (Verc. Först. 130, 11)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hetol" d:title="hetol">
		<body>
			<h1>hetol<span class="pron"> | xe.tol |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">applied to persons</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">of disposition, malignant</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se (Jove) wearð hetol feōnd (hetol and þrymlic, Sal. K. p. 121, 24). Hē āflȳmde his āgene fæder, . . . and wolde hine forfaran georne</span>
									<span class="q-cite"> (Wlfst. 106. 9)</span>
								</li>
								<li>
									<span class="q-oe">Þ UNCERTAIN hetole wīf (Jezebel)</span>
									<span class="q-cite"> (Hml. S. 18, 194)</span>
								</li>
								<li>
									<span class="q-oe">Leōdnatan hetele</span>
									<span class="q-cite"> (Wlfst. 310, 4)</span>
								</li>
								<li>
									<span class="q-oe">Ðā hǣðenan þe him hetole wǣron</span>
									<span class="q-cite"> (Hml, S. 25, 685)</span>
								</li>
								<li>
									<span class="q-oe">Cwǣdon þā weardmenn tō þām hetelum Jūdēiscum</span>
									<span class="q-cite"> (Hml. A. 79, 176)</span>
								</li>
								<li>
									<span class="q-oe">Þā hǣðengildon þe þǣr heteloste wǣron</span>
									<span class="q-cite"> (Hml. S. 29, 166)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">of appearance, having a malicious expression, that shows ill-will</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se nīðfulla wer wyrð geswutelod ðurh his hātheortnysse on hetolum and-wlitan</span>
									<span class="q-cite"> (Hex. 46, 31)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of an animal, ferocious</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">rabidis, i. ferocibus (molossi rictibus)</span>
							<span class="q-oe">Hetelum</span>
							<span class="q-cite"> (An. Ox. 3640)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">of punishment, severe</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sȳ hē gewītnod mid hetolre steōre</span>
							<span class="q-cite"> (R. Ben 67, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-hetol" class="xref-target">un-hetol</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-āsendan" d:title="in-āsendan">
		<body>
			<h1>in-āsendan<span class="pron"> | in.ɑː.sen.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To send in</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">summiserunt grabatum</span>
							<span class="q-oe">Hī ināsendan ðæt bed</span>
							<span class="q-cite"> (Mk. Skt. 2, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="drȳ-lāc" d:title="drȳ-lāc">
		<body>
			<h1>drȳ-lāc<span class="pron"> | dryː.lɑːk |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">sorcery, magic</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif þīne æceras nellaþ wel wexan oþþe þǣr hwilc ungedēfe þing on gedōn bið on drȳ ( = drȳlāce) oððe on lyblāce</span>
							<span class="q-cite"> (Lch. i. 398, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="alȳsed" d:title="alȳsed">
		<body>
			<h1>alȳsed<span class="pron"> | ɑ.lyː.sed |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-en">he released the sons of men from the prison of devils</span>
						<span class="q-oe">locan deōfla he released the sons of men from the prison of devils</span>
						<span class="q-cite"> (Elen. Kmbl. 361; El. 181)</span>
					</li>
					<li>
						<span class="q-la">quæ non rapui tunc exsolvebam</span>
						<span class="q-oe">Da ðe ic na reāfode ðā ic alȳsde</span>
						<span class="q-cite"> (Ps. Spl. C. 68, 6: 48, 7)</span>
					</li>
					<li>
						<span class="q-la">liberatus sis ab illo</span>
						<span class="q-oe">Ðū beō fram him alȳsed</span>
						<span class="q-cite"> (Lk. Bos. 12, 58)</span>
					</li>
					<li>
						<span class="q-en">then was helm and byrnie loosed from the active chief</span>
						<span class="q-oe">Ðā wæs of ðæm hrōran helm and byrne alȳsed</span>
						<span class="q-cite"> (Beo. Th. 3264; B. 1630)</span>
					</li>
					<li>
						<span class="q-la">liberati sumus</span>
						<span class="q-oe">We synt alȳsde</span>
						<span class="q-cite"> (Ps. Th. 123, 7: 107, 5)</span>
					</li>
					<li>
						<span class="q-la">ut liberentur</span>
						<span class="q-oe">Ðæt hī wǣron alȳsede</span>
						<span class="q-cite"> (59, 4)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="haran-specel" d:title="haran-specel">
		
		<body>
			<h1>haran-specel<span class="pron"> | xɑ.rɑn.spe.Kel |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">viper's bugloss</span>
						<span class="meaning-la"> (Lat. echium vulgare)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wācness" d:title="wācness">
		<body>
			<h1>wācness<span class="pron"> | wɑː.kness |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ne sceole wē forseōn þearfena wācnysse.</span>
						<span class="q-cite"> (Hml. Th. I. 336, l.)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="iū-wine" d:title="iū-wine">
		<body>
			<h1>iū-wine<span class="pron"> | i.uː.wi.ne |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A friend of old or former times</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">knows that his friends of old are committed to earth</span>
							<span class="q-oe">Wāt his iūwine eorþan forgiefene</span>
							<span class="q-cite"> (Exon. 82 b; Th. 311, 15 ; Seef. 92)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heāfod-wærc" d:title="heāfod-wærc">
		<body>
			<h1>heāfod-wærc<span class="pron"> | xæ͜ɑː.fod.wærk |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Pain in the head</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-āwriten" d:title="un-āwriten">
		<body>
			<h1>un-āwriten<span class="pron"> | un.ɑː.wri.ten |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unwritten</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Thomes ðrowunge wē forlǣtaþ unāwritene</span>
							<span class="q-cite"> (Homl. Th. ii. 520, 9)</span>
						</li>
						<li>
							<span class="q-la">cautionem</span>
							<span class="q-oe">Unāwritten</span>
							<span class="q-cite"> (Lk. Skt. Lind. 16, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gelæccan" d:title="gelæccan">
		<body>
			<h1>gelæccan<span class="pron"> | Ge.læk.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to take, catch fish, &amp;c.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">On ðām ǣrran fixnoðe wurdon swā fela gelæhte þæt þæt net tōbærst . . . On ðām æftran fixnoðe wurdon gelæhte micele and manega fixas, and þæt net āþolode</span>
									<span class="q-cite"> (Hml. Th. ii. 290, 16-21)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">to take, pick up food</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">catelli edunt de micis, Mt. 15, 27</span>
									<span class="q-oe">Þā hwelpas gelæccað þā cruman</span>
									<span class="q-cite"> (Hml. Th. ii. 50, 31)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="meaning-en">to take as a possession, get, receive</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Judas ðā gelæhte þæs Appollonies swurd . . . and hē wann mid þām on ǣlcum gefeohte</span>
									<span class="q-cite"> (Hml. S. 25, 295)</span>
								</li>
								<li>
									<span class="q-oe">Ðū and Æðelmǣr swylcera gewrita mē bǣdon, and of handum gelæhton</span>
									<span class="q-cite"> (p. 4, 39)</span>
								</li>
								<li>
									<span class="q-oe">Hū hī mihton ðām cāsere gecwēman ꝥ hī sumne scætt æt him gelæhton</span>
									<span class="q-cite"> (23, 55)</span>
								</li>
								<li>
									<span class="q-la">non sufficiant ut unusquisque modicum quid accipiat, Jn. 6, 7</span>
									<span class="q-oe">Ne mihte hyra ǣlc ānne bitan of ðām gelæccan</span>
									<span class="q-cite"> (Hml. Th. i. 182, 11)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(5)</span>
								<span class="meaning-en">to take a person preparatory to action, to take and do something</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gelahte hine of ðǣm folce sundurlīce</span>
									<span class="q-cite"> (Mk. L. 7, 33)</span>
								</li>
								<li>
									<span class="q-oe">Gelæhte hine Petrus ongann geðreādtaige hine</span>
									<span class="q-cite"> (8, 32)</span>
								</li>
								<li>
									<span class="q-oe">Se Hǣlend gelahte cnæht sette hine nēh him</span>
									<span class="q-cite"> (Lk. L. 9, 47)</span>
								</li>
								<li>
									<span class="q-oe">Gehlahte</span>
									<span class="q-cite"> (14, 4)</span>
								</li>
								<li>
									<span class="q-oe">Gelahte se groefa ðone Hǣlend and geswanng</span>
									<span class="q-cite"> (Jn. L. R. 19, 1)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">with the idea of violence or haste.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to take a person, seize, apprehend, capture</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">apprehendit</span>
									<span class="q-oe">Nǣnig monn hine gelahte</span>
									<span class="q-cite"> (Jn. L. R. 8, 20)</span>
								</li>
								<li>
									<span class="q-la">comprehenderunt</span>
									<span class="q-oe">Embehtmenn gefēngon ł gelahton ðone Hǣlend</span>
									<span class="q-cite"> (18, 12)</span>
								</li>
								<li>
									<span class="q-la">nos diripiebant sibi, Ps. L. 43, 11</span>
									<span class="q-oe">Hī ūs gegripon ł gelahton him</span>
								</li>
								<li>
									<span class="q-oe">Þæt folc his cēpte and hine gelæhton</span>
									<span class="q-cite"> (Hml. Th. ii. 506, 7)</span>
								</li>
								<li>
									<span class="q-en">take him alive or dead</span>
									<span class="q-oe">Hē wolde Wulnōð gelæccan cucene oððe deādne</span>
									<span class="q-cite"> (Chr. 1009; P. 138, note 9)</span>
								</li>
								<li>
									<span class="q-oe">Ōsrēd gelæht wæs and ofslagen</span>
									<span class="q-cite"> (792; P. 55, 29)</span>
								</li>
								<li>
									<span class="q-oe">Daniel se wītega wearð gelæht</span>
									<span class="q-cite"> (Ælfc. T. Grn. 9, 38)</span>
								</li>
								<li>
									<span class="q-oe">Wurdon sume his men gelæhte of Frencyscan mannan</span>
									<span class="q-cite"> (Chr. 1075; P. 210, 15)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1 a)</span>
										<span class="meaning-en">to seize with an implement</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hī woldon mē gelæccan mid heora tangum</span>
											<span class="q-cite"> (Hml. Th. ii. 350, 34)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to take from, rescue</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Dauid gelæhte þæt scēp of ðām deōrum</span>
									<span class="q-cite"> (Ælfc. T. Grn. 7, 24)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">to lay hold of a person who struggles</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē feōll tō þǣre eorðan mid egeslicum anginne, and hine gelæhton ðe ðār nēh wǣron</span>
									<span class="q-cite"> (Chr. 1042; P. 162, 14)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="meaning-en">of an animal, to take, seize</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">rapit</span>
									<span class="q-oe">Cymð se yfela and gelæhð hit</span>
									<span class="q-cite"> (Hml. Th. ii. 90, 24)</span>
								</li>
								<li>
									<span class="q-oe">Ān wulf gelæhte mīnne brōðor</span>
									<span class="q-cite"> (Hml. S. 30, 330)</span>
								</li>
								<li>
									<span class="q-la">rapiat</span>
									<span class="q-oe">Gelecce swā swā leō</span>
									<span class="q-cite"> (Ps. L. 7, 3)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(5)</span>
								<span class="meaning-en">to seize, lay hands on; snatch up</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gelæhton þā weardmenn his wealdleðer fæste, þæt hē mid fleāme ne burste</span>
									<span class="q-cite"> (Ælfc. T. Grn. 18, 14)</span>
								</li>
								<li>
									<span class="q-oe">Gif hwilc man ꝥ wǣpn gelæcce and hwylcne hearm þǣr mid gewyrce</span>
									<span class="q-cite"> (Ll. Th. i. 418, 8)</span>
								</li>
								<li>
									<span class="q-la">arripiat</span>
									<span class="q-oe">Ne nān ne gedyrstlǣce þæt hē fǣrlīce bōc gelæcce, and þǣr būtan foresceāwunge onginne tō rǣdenne</span>
									<span class="q-cite"> (R. Ben. 62, 5)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(6)</span>
								<span class="meaning-en">to obtain by force</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē gelæcð ðurh strece þæt heofenlice rīce</span>
									<span class="q-cite"> (Hml. Th. i. 360, 9)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(7)</span>
								<span class="meaning-en">to take, carry off</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē fela goldhordas forð mid him gelæhte</span>
									<span class="q-cite"> (Hml. S. 25, 11)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(8)</span>
								<span class="meaning-en">of disease, feeling, &amp;c., to seize, catch</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hine gelæhte wundrung</span>
									<span class="q-cite"> (Hml. S. 23, 501)</span>
								</li>
								<li>
									<span class="q-oe">Hine gelæhte unāsecgendlic ādl</span>
									<span class="q-cite"> (Hml. Th. i. 86, 3)</span>
								</li>
								<li>
									<span class="q-la">cupiditatis petulantia captus, An. Ox. 5291</span>
									<span class="q-oe">Of gyrninge gālscipe gelæht</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(9)</span>
								<span class="meaning-en">to catch a disease</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þæt bærnet þe hē gelæhte æt ðām unrihtwisum were</span>
									<span class="q-cite"> (Hml. Th. ii. 346, 25)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hræfnes fōt" d:title="hræfnes fōt">
		<body>
			<h1>hræfnes fōt<span class="pron"> | xræ.fnes, foːt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hraebnes (hræfnæs, hraefnes) foot quinquefolium</span>
						<span class="q-cite"> (Txts. 90, 848)</span>
					</li>
					<li>
						<span class="q-oe">Hraefnaes fōt</span>
						<span class="q-cite"> (106, 1084)</span>
					</li>
					<li>
						<span class="q-oe">Hræfnes fōt quinquefila</span>
						<span class="q-cite"> (Wrt. Voc. i. 68, 27: Lch. iii. 30, 4)</span>
					</li>
					<li>
						<span class="q-oe">Hrefnes fōt</span>
						<span class="q-cite"> (ii. 38, 16: 326, 1)</span>
					</li>
					<li>
						<span class="q-oe">Hræmnes fōt</span>
						<span class="q-cite"> (iii. 12, 14)</span>
					</li>
					<li>
						<span class="q-oe">Hremnes fōt</span>
						<span class="q-cite"> (i. 382, 16)</span>
					</li>
					<li>
						<span class="q-oe">Hremmes fōt polipedium</span>
						<span class="q-cite"> (Wrt. Voc. i. 79, 13: An. Ox. 56, 384)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-findan" d:title="in-findan">
		<body>
			<h1>in-findan<span class="pron"> | in.fin.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -fand</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To find, discover</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">quærite et invenietis</span>
							<span class="q-oe">Soecaþ gē and gē infindes</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 7, 7)</span>
						</li>
						<li>
							<span class="q-la">invenit vacantem</span>
							<span class="q-oe">Infund restende</span>
							<span class="q-cite"> (12, 44)</span>
						</li>
						<li>
							<span class="q-la">ego non invenio in eo causam</span>
							<span class="q-oe">Ic ne infand in him intinga</span>
							<span class="q-cite"> (Jn. Skt. Rush. 19, 6)</span>
						</li>
						<li>
							<span class="q-la">inventa est</span>
							<span class="q-oe">Infunden wæs</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 1, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:on-findan" class="xref-target">on-findan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-lūtian" d:title="ge-lūtian">
		<body>
			<h1>ge-lūtian<span class="pron"> | je.luː.ti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To lie hid</span>
						<span class="meaning-la"> (Lat. lātēre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that I may not lie hid in this wide hall</span>
							<span class="q-oe">Ðæt ic gelūtian ne mæg on ðyssum sīdan sele</span>
							<span class="q-cite"> (Cd. 216; Th. 273, 2; Sat. 130)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="pīs-līce" d:title="pīs-līce">
		
		<body>
			<h1>pīs-līce<span class="pron"> | piːs.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Heavily</span>
						<span class="meaning-la"> (Lat. graviter)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Pīslīce ł hefiglice, graviter</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 13, 15 : Lk. Skt. Lind. Rush. 11, 53)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efen-þwær" d:title="efen-þwær">
