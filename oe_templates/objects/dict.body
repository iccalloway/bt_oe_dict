<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lǣþþu" d:title="lǣþþu">
		<body>
			<h1>lǣþþu<span class="pron"> | læːθ.θu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">quidam vir gravissima adversarii sui aemulatione laborabat, cujus ad hoc usque odium prorupit, ut. . .</span>
						<span class="q-oe">Hī mē sǣdon ꝥ sum wer wunne on þǣre hefigestan hatunge his gesacan, þæs lǣþþu (lǣðð, v. l.) and feōndscipe forð weōx tō þon swīðe ꝥ . . .</span>
						<span class="q-cite"> (Gr. D. 158, 27)</span>
					</li>
					<li>
						<span class="q-oe">Mid wordum laeððu (odii)</span>
						<span class="q-cite"> (Ps. Srt. 108, 3)</span>
					</li>
					<li>
						<span class="q-oe">Laeððu unrehtwīsre odio iniquo</span>
						<span class="q-cite"> (24, 19)</span>
					</li>
					<li>
						<span class="q-oe">Lǣðu odium</span>
						<span class="q-cite"> (35, 3)</span>
					</li>
					<li>
						<span class="q-la">ejus odia humiliter declinavit</span>
						<span class="q-oe">Hē beseah eādmōdlīce þā lǣþþe (lǣððo, v. l.) and feōndscipe þæs æfstigan mæssepreōstes</span>
						<span class="q-cite"> (Gr. D. 119, 23)</span>
					</li>
					<li>
						<span class="q-oe">Ꝥ wē hī lufian and lǣððe tō nabban</span>
						<span class="q-cite"> (Hml. S. 16, 265)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlēp-" d:title="hlēp-">
