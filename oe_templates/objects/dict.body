<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fealdan" d:title="ge-fealdan">
		<body>
			<h1>ge-fealdan<span class="pron"> | je.fæ͜ɑl.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to wrap up, roll up</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">malitiosae mentis duplicitas sese intra se colligit</span>
									<span class="q-oe">Ðæt yfelwillende mōd gefielt hit self twyfeald oninnan him selfum, and siō twyfealdnes ðæs yflan willan hiene selfne twyfealdne gefielt oninnan him selfum</span>
									<span class="q-cite"> (Past. 242, 6-9)</span>
								</li>
								<li>
									<span class="q-la">ad semetipsa duplicitatis perversitate corda replicuntur</span>
									<span class="q-oe">Hē gefielt his mōd mid wōre twiefealdnesse</span>
									<span class="q-cite"> (245, 15)</span>
								</li>
								<li>
									<span class="q-oe">Ān clīwen suīðe nearwe gefealden (involutum)</span>
									<span class="q-cite"> (241, 24)</span>
								</li>
								<li>
									<span class="q-oe">Gefalden bōc volumen</span>
									<span class="q-cite"> (Mt. p. 1, 7)</span>
								</li>
								<li>
									<span class="q-oe">Ne bið gifalden non flectetur</span>
									<span class="q-cite"> (Rtl. 84, 53)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1 a)</span>
										<span class="meaning-en">to involve, implicate</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Nǣnig man compigende Gode gifalde hine (inplicat se) gimōtum woruldlicum</span>
											<span class="q-cite"> (Rtl. 60, 11)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to roll about</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē gefeald hine uolutabatur</span>
									<span class="q-cite"> (Mk. R. 9, 20)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-fildan" class="xref-target">ge-fildan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-fiþerian" d:title="ge-fiþerian">
		<body>
			<h1>ge-fiþerian<span class="pron"> | je.fi.θe.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">pennata</span>
						<span class="q-oe">Gefiþerede</span>
						<span class="q-cite"> (Ps. L. 77, 27)</span>
					</li>
					<li>
						<span class="q-la">pennatorum</span>
						<span class="q-oe">Ge-fiðeradra</span>
						<span class="q-cite"> (Kent. Gl. 2)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
