<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-snīðan" d:title="ge-snīðan">
		<body>
			<h1>ge-snīðan<span class="pron"> | je.sniː.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to lie down</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">accumbere facerent omnes</span>
							<span class="q-oe">Dætte gesniða [Rush. gesnide] gedydon alle ut accumbere facerent omnes</span>
							<span class="q-cite"> (Mk. Skt. Lind. 6, 39)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þǣr-æt" d:title="þǣr-æt">
		<body>
			<h1>þǣr-æt<span class="pron"> | θæːr.æt |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Thereat</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">His horsbǣr wæs fram his discipulum gehealden, and monige unfrume ðǣræt hǣlo onfēngon</span>
							<span class="q-cite"> (Bd. 4, 6; S. 574, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-weorc" d:title="in-weorc">
		<body>
			<h1>in-weorc<span class="pron"> | in.we͜ork |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Indoor work</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On wintra . . . mænige inweorc wyrcean, ðerhsan, wudu cleōfan</span>
							<span class="q-cite"> (Angl. ix. 261, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="corn-hūs" d:title="corn-hūs">
		<body>
			<h1>corn-hūs<span class="pron"> | korn.xuːs |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A corn-house, granary</span>
						<span class="meaning-la"> (Lat. granarium)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wēsten" d:title="wēsten">
		<body>
			<h1>wēsten<span class="pron"> | weː.sten |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">God lǣdde hine ðurh ðæt wēsten</span>
						<span class="q-cite"> (Past. 304, 7)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:feld-wēsten" class="xref-target">feld-wēsten</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-weallan" d:title="ge-weallan">
		<body>
			<h1>ge-weallan<span class="pron"> | je.wæ͜ɑl.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to boil, be hot</span>
						<span class="meaning-la"> (Lat. fervescere, fervere)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-scyrþ" d:title="be-scyrþ">
		<body>
			<h1>be-scyrþ<span class="pron"> | be.ʃyrθ |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">shaves; 3rd pers. pres. of be-sceran</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-sceran" class="xref-target">be-sceran</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rysel" d:title="rysel">
		<body>
			<h1>rysel<span class="pron"> | ry.sel |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">fat</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cada arvina; cadula guttae quae cadunt ex pingui carne, cum assatur; frusta ex adipe, Migne</span>
							<span class="q-oe">Hrisel cada, lytel hrisel cadula</span>
							<span class="q-cite"> (Wrt. Voc. i. 44, 1)</span>
						</li>
						<li>
							<span class="q-oe">Hrysel arvina vel adeps vel axungia vel abdomen</span>
							<span class="q-cite"> (20)</span>
						</li>
						<li>
							<span class="q-oe">Rysele, smerewe ausungia, i. aruina</span>
							<span class="q-cite"> (An. Ox. 2762)</span>
						</li>
						<li>
							<span class="q-oe">Gemæstra swīna rysele scrofarum auxungia</span>
							<span class="q-cite"> (23, 28)</span>
						</li>
						<li>
							<span class="q-oe">Mæng wiþ ealdne rysele</span>
							<span class="q-cite"> (Lch. ii. 62, 28: 130, 19)</span>
						</li>
						<li>
							<span class="q-oe">Genim ealdne rysle</span>
							<span class="q-cite"> (180, 4)</span>
						</li>
						<li>
							<span class="q-la">offerent adipem qui operit vitalia</span>
							<span class="q-oe">Bringon þone rysle þe þā heortgesīda mid beōð oferwrigen</span>
							<span class="q-cite"> (Lev. 3, 3)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">resin</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hryseles, tyrewan resinę, i. bituminis</span>
							<span class="q-cite"> (An. Ox. 4027)</span>
						</li>
						<li>
							<span class="q-la">resinas uel sulphur uiderit, grandes molestias significat</span>
							<span class="q-oe">Ryselas oððe swefel gesihð, hefige teōnan getācnað</span>
							<span class="q-cite"> (Lch. ii. 210, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wære-līce" d:title="wære-līce">
		
		<body>
			<h1>wære-līce<span class="pron"> | wæ.re.liː.tʃe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:wearglīce" class="xref-target">wearglīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-bregdan" d:title="on-bregdan">
		
		<body>
			<h1>on-bregdan<span class="pron"> | on.breɣ.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -brægd, sg: -brǣd, pl: -brugdon, pl: -brudon</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">with dat. acc. (?), To move quickly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the Phenix thrice moves its head (bowing to the sun; igniferum caput ter venerata)</span>
							<span class="q-oe">Heāfde onbrygdeþ þriwa āscæceþ</span>
							<span class="q-cite"> (Exon. Th. 207, 18; Ph. 143)</span>
						</li>
						<li>
							<span class="q-en">Grendel opened the door violently and stepped on to the floor of the hall</span>
							<span class="q-oe">Onbrǣd recedes mūþan raþe æfter ðon on flōr treddode</span>
							<span class="q-cite"> (Beo. Th. 1450; B. 723)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">intrans. To move (oneself) quickly, to start (from sleep)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">postero die matutino expergefactus diluculo</span>
							<span class="q-oe">Ðā on morgne mid ðȳ hit dagode ðā onbrǣd ic</span>
							<span class="q-cite"> (Nar. 30, 30: Bd. 3, 27; S. 559, 16)</span>
						</li>
						<li>
							<span class="q-oe">Ðā onbrǣd Gūþlāc of ðam slǣpe</span>
							<span class="q-cite"> (Guthl. 6; Gdwin. 42, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hē of slǣpe onbrægd</span>
							<span class="q-cite"> (Elen. Kmbl. 150; El. 75)</span>
						</li>
						<li>
							<span class="q-oe">Swā hē of hefigum slǣpe onbrude</span>
							<span class="q-cite"> (Bd. 5, 19; S. 640, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cinn" d:title="cinn">
		<body>
			<h1>cinn<span class="pron"> | Kinn |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A kind</span>
						<span class="meaning-la"> (Lat. genus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">flying kind</span>
							<span class="q-la">volatile</span>
							<span class="q-oe">Fleōgende cinn flying kind</span>
							<span class="q-cite"> (Gen. 1, 20)</span>
						</li>
						<li>
							<span class="q-en">creeping kind</span>
							<span class="q-la">reptilia</span>
							<span class="q-oe">Creōpende cinn creeping kind</span>
							<span class="q-cite"> (1, 24)</span>
						</li>
						<li>
							<span class="q-en">after its kind</span>
							<span class="q-oe">Æfter his cinne after its kind</span>
							<span class="q-cite"> (1, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:cyn" class="xref-target">cyn</a>, <a href="x-dictionary:r:cynn" class="xref-target">cynn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-scamian" d:title="ge-scamian">
		<body>
			<h1>ge-scamian<span class="pron"> | je.ʃɑ.mi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">To be ashamed, to blush</span>
						<span class="meaning-la"> (Lat. erubescere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">avertantur retrorsum et erubescant, qui vŏlunt mihi măla</span>
							<span class="q-oe">Sȳn gecyrred underbæc and gescamian, ða ðe wyllaþ me yfelu</span>
							<span class="q-cite"> (Ps. Spl. 69, 3)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">To shame, cause or bring shame to</span>
						<span class="meaning-la"> (Lat. pudēre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it shall shame the wicked</span>
							<span class="q-la">erubescant impii</span>
							<span class="q-oe">Sceal gescamian ða unrihtwīsan</span>
							<span class="q-cite"> (Ps. Th. 30, 20)</span>
						</li>
						<li>
							<span class="q-en">let it shame them</span>
							<span class="q-la">erubescant</span>
							<span class="q-oe">Gescamige hī</span>
							<span class="q-cite"> (Ps. Spl. 82, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-sceamian" class="xref-target">ge-sceamian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sund-gird" d:title="sund-gird">
		
		
		<body>
			<h1>sund-gird<span class="pron"> | sund.Gird |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A rod to measure the depth of water, a sounding-pole</span>
						<span class="meaning-la"> (Lat. bolis, bolidis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">bolis</span>
							<span class="q-oe">Sundgyrd bolis</span>
							<span class="q-cite"> (Wrt. Voc. i. 63, 67)</span>
						</li>
						<li>
							<span class="q-la">bolidis</span>
							<span class="q-oe">Sundgyrd bolidis</span>
							<span class="q-cite"> (Wrt. Voc. i. 57, 7)</span>
						</li>
						<li>
							<span class="q-la">bolides</span>
							<span class="q-oe">Sundgerd in scipe vel metrāp bolides</span>
							<span class="q-cite"> (Wrt. Voc. ii. 102, 14)</span>
						</li>
						<li>
							<span class="q-la">bolidis</span>
							<span class="q-oe">Sundgyrd on scipe vel metrāp bolidis</span>
							<span class="q-cite"> (Wrt. Voc. ii. 126, 46; 11, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:sund-līne" class="xref-target">sund-līne</a>, <a href="x-dictionary:r:sund-rāp" class="xref-target">sund-rāp</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Wald" d:title="Wald">
		<body>
			<h1>Wald<span class="pron"> | wɑld |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-en">with hard fighting</span>
						<span class="q-oe">Heardre hilde</span>
						<span class="q-cite"> (Elen. Kmbl. 165; El. 83: Judth. 12; Thw. 25, 36; Jud. 294)</span>
					</li>
					<li>
						<span class="q-en">many hard battles have I experienced</span>
						<span class="q-oe">Fela ic gebād heardra hilda</span>
						<span class="q-cite"> (Fins. Th. 52; Fin. 26: Andr. Kmbl. 2980; An. 1493)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hās" d:title="hās">
		<body>
			<h1>hās<span class="pron"> | xɑːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Hoarse</span>
						<span class="meaning-la"> (Lat. raucus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hās raucus</span>
							<span class="q-cite"> (Ælfc. Gr. 30; Som. 34, 38)</span>
						</li>
						<li>
							<span class="q-la">habeo quendam puerum qui modo raucus est</span>
							<span class="q-oe">Ic hæbbe sumne cnapan ðe nū hās ys</span>
							<span class="q-cite"> (Coll. Monast. Th. 19, 29)</span>
						</li>
						<li>
							<span class="q-la">raucæ factæ sunt fauces meæ</span>
							<span class="q-oe">Mē syndan gōman hāse</span>
							<span class="q-cite"> (Ps. Th. 68, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cænnan" d:title="ge-cænnan">
		<body>
			<h1>ge-cænnan<span class="pron"> | je.Kæn.nɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-cennan" class="xref-target">ge-cennan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-mengan" d:title="for-mengan">
		<body>
			<h1>for-mengan<span class="pron"> | for.men.gɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To join together, mingle</span>
						<span class="meaning-la"> (Lat. conjungĕre)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:mengan" class="xref-target">mengan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="smoc[c]" d:title="smoc[c]">
		<body>
			<h1>smoc[c]<span class="pron"> | smok, k |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A smock, shift</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">colobium</span>
							<span class="q-oe">Smoc vel syrc colobium</span>
							<span class="q-cite"> (Wrt. Voc. i. 25, 60)</span>
						</li>
						<li>
							<span class="q-la">colobium, dictum quia longum est et sine manicis</span>
							<span class="q-oe">Loþa, hom vel smoc colobium, dictum quia longum est et sine manicis</span>
							<span class="q-cite"> (ii. 134, 37)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æsceda" d:title="æsceda">
		<body>
			<h1>æsceda<span class="pron"> | æ.ʃe.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A farrago, mixture, perfume</span>
						<span class="meaning-la"> (Lat. migma)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æfte-weard" d:title="æfte-weard">
		<body>
			<h1>æfte-weard<span class="pron"> | æf.te.wæ͜ɑrd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-en">in the latter part of the psalm</span>
							<span class="q-oe">On æfteweardum ðǣm sealme</span>
							<span class="q-cite"> (Ps. Th. 38, arg.)</span>
						</li>
						<li>
							<span class="q-oe">On æftewyrdne December, and on foreweardan Ianuarie ðām mōnþe</span>
							<span class="q-cite"> (Lch. iii. 154, 12.)</span>
						</li>
					</ul>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="sub-heading">substantive use</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">On æfteweardan ðæs regoles</span>
									<span class="q-cite"> (Hml. S. 3, 150.)</span>
								</li>
								<li>
									<span class="q-oe">On æfteweardan ylde heō bið on bedde lange licgende</span>
									<span class="q-cite"> (Lch. iii. 184, 6.)</span>
								</li>
								<li>
									<span class="q-oe">Hand sceal habban h on forewerdan and d on æfteweardan</span>
									<span class="q-cite"> (Ælfc. Gr. Z. 292, 3.)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="castel-men" d:title="castel-men">
		<body>
			<h1>castel-men<span class="pron"> | kɑ.stel.men |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive pl: -manna</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Castle-men</span>
						<span class="meaning-la"> (Lat. castellani)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the castle-men who were in England came against him</span>
							<span class="q-oe">Ða castelmen ðe wǣron on Engla lande him togeānes cōmon [MS. comen]</span>
							<span class="q-cite"> (Chr. 1075; Erl. 213, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-blǣstan" d:title="on-blǣstan">
		<body>
			<h1>on-blǣstan<span class="pron"> | on.blæː.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">glosses inrumpere</span>
						<span class="meaning-la"> (Lat. inrumpere)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="CNAPA" d:title="CNAPA">
		
		<body>
			<h1>CNAPA<span class="pron"> | knɑ.pɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a boy, young man, KNAVE</span>
						<span class="meaning-la"> (Lat. puer, juvenis, adolescens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he gave it [a calf] to his young man and the young man slew it</span>
							<span class="q-oe">He betǣhte hys cnapan and se cnapa hit ofslōh</span>
							<span class="q-cite"> (Gen. 18, 7)</span>
						</li>
						<li>
							<span class="q-la">dedit puero bibere</span>
							<span class="q-oe">Heō sealde ðam cnapan drincan</span>
							<span class="q-cite"> (21, 19: 22, 19: 42, 22: 48, 16: Homl. Th. i. 186, 14)</span>
						</li>
						<li>
							<span class="q-la">habeo quemdam puerum</span>
							<span class="q-oe">Ic hæbbe sumne cnapan</span>
							<span class="q-cite"> (Coll. Monast. Th. 19, 27)</span>
						</li>
						<li>
							<span class="q-la">Abraham ducens secum duos juvenes abiit in locum</span>
							<span class="q-oe">Abraham fērde mid twām cnapum to fyrlenum lande</span>
							<span class="q-cite"> (Gen. 22, 3, 5)</span>
						</li>
						<li>
							<span class="q-la">da puero tuo</span>
							<span class="q-oe">Syle cnapan [cnafan C.] ðīnum</span>
							<span class="q-cite"> (Ps. Spl. 85, 15)</span>
						</li>
						<li>
							<span class="q-la">mulier molesta erat adolescenti</span>
							<span class="q-oe">Ðæt wīf wearþ wrāþ ðam cnapan</span>
							<span class="q-cite"> (Gen. 39, 10)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a servant</span>
						<span class="meaning-la"> (Lat. servus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he ordered his servant to look towards the sea</span>
							<span class="q-oe">He hēt his cnapan behealdan to ðære sǣ</span>
							<span class="q-cite"> (Bd. de nat. rerum; Wrt. popl. science 18, 23; Lchdm. iii. 276, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:þeōw-cnapa" class="xref-target">þeōw-cnapa</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āter" d:title="āter">
		<body>
			<h1>āter<span class="pron"> | ɑː.ter |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">poison</span>
						<span class="meaning-la"> (Lat. venenum)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ātor" class="xref-target">ātor</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-wendness" d:title="on-wendness">
		<body>
			<h1>on-wendness<span class="pron"> | on.wend.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">change</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðære godcundnesse nǣnig onwendnesse on carcerne wæs of ðære menniscan gecynde</span>
							<span class="q-cite"> (Blickl. Homl. 19, 24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">turning, movement (v. onwendan, IV)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">commotionem capitis</span>
							<span class="q-oe">Onwendnisse heāfdes</span>
							<span class="q-cite"> (Ps. Surt. 43, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-brocen" d:title="ge-brocen">
		<body>
			<h1>ge-brocen<span class="pron"> | je.bro.Ken |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">broken; pp. of ge-brecan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-brecan" class="xref-target">ge-brecan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣfen-lāc" d:title="ǣfen-lāc">
		<body>
			<h1>ǣfen-lāc<span class="pron"> | æː.fen.lɑːk |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An evening sacrifice</span>
						<span class="meaning-la"> (Lat. vespertinum sacrificium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">elevatio manuum mearum sacrificium vespertinum</span>
							<span class="q-oe">Swylce ahafenes handa mīnra, ðonne ic ǣfenlāc secge</span>
							<span class="q-cite"> (Ps. Th. 140, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="blōd" d:title="blōd">
		<body>
			<h1>blōd<span class="pron"> | bloːd |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Deād blōd cruor</span>
						<span class="q-cite"> (Wrt. Voc. ii. 16, 57)</span>
					</li>
					<li>
						<span class="q-oe">Heō sǣde ꝥ hire blōd forlǣten wǣre on earme</span>
						<span class="q-cite"> (Bd. 5, 3; Sch. 563, 2)</span>
					</li>
					<li>
						<span class="q-oe">Swīðe unwīslīce gē dydon, þæt gē sceoldon on feōwernihtne mōnan blōd lǣtan</span>
						<span class="q-cite"> (Sch. 564, 6: Lch. iii. 184, 11)</span>
					</li>
					<li>
						<span class="q-oe">Ǣr him mon blōd lǣte, þām þe fela blōdes hæfþ</span>
						<span class="q-cite"> (ii. 210, 16)</span>
					</li>
					<li>
						<span class="q-oe">Blōd wanian</span>
						<span class="q-cite"> (iii. 184, 16)</span>
					</li>
					<li>
						<span class="q-oe">Wer blōda vir sanguinum</span>
						<span class="q-cite"> (Ps. L. 5, 8: Ps. Spl. 25, 9)</span>
					</li>
					<li>
						<span class="q-oe">Handa mid manna blōdum befȳlede</span>
						<span class="q-cite"> (Angl. xi. 113, 36)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:mōnaþ-blōd" class="xref-target">mōnaþ-blōd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frēcen" d:title="frēcen">
		<body>
			<h1>frēcen<span class="pron"> | freː.Ken |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">peril</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:frēcne" class="xref-target">frēcne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-hǣlu" d:title="un-hǣlu">
		
		<body>
			<h1>un-hǣlu<span class="pron"> | un.xæː.lu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">bad health, disease, sickness, infirmity</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(a)</span>
								<span class="sub-heading">of persons</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Se oferdrenc fordēð ðæs mannes gesundfulnysse and unhǣl becymð of ðam drence</span>
									<span class="q-cite"> (Ælfc. T. Grn. 21, 38)</span>
								</li>
								<li>
									<span class="q-oe">Oferfyll bið ðæs līchaman unhǣl</span>
									<span class="q-cite"> (Wulfst. 242, 4)</span>
								</li>
								<li>
									<span class="q-oe">Būton ðē unhǣl oððe yld derige</span>
									<span class="q-cite"> (247, 34)</span>
								</li>
								<li>
									<span class="q-oe">Ða diōfla gelǣrdon hiē, ðæt ða ðe on unhǣle wǣran, ðæt hiē hāle for hiē cwealdon</span>
									<span class="q-cite"> (Ors. 4, 4; Swt. 164, 17)</span>
								</li>
								<li>
									<span class="q-oe">Gif ðū wile hāl beōn, drinc ðē gedeftlīce; ǣlc oferfyl fēt unhǣlo</span>
									<span class="q-cite"> (Prov. Kmbl. 61)</span>
								</li>
								<li>
									<span class="q-la">languorem</span>
									<span class="q-oe">Unhǣlo</span>
									<span class="q-cite"> (Mt. Kmbl. Lind. 4, 23)</span>
								</li>
								<li>
									<span class="q-la">crucem</span>
									<span class="q-oe">Unhǣlo</span>
									<span class="q-cite"> (16, 24)</span>
								</li>
								<li>
									<span class="q-oe">Ðām ðe under hȳ migaþ ... ða unhǣle heō gehǣlþ</span>
									<span class="q-cite"> (Lchdm. i. 360, 9)</span>
								</li>
								<li>
									<span class="q-oe">Ðās unhǣle (blotch)</span>
									<span class="q-cite"> (ii. 76, 16)</span>
								</li>
								<li>
									<span class="q-la">infirmitates</span>
									<span class="q-oe">Untrymmnise ł unhǣlo</span>
									<span class="q-cite"> (Mt. Kmbl. Lind. 8, 17)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(b)</span>
								<span class="sub-heading">of animals, unsoundness</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gif mon hwelcne ceāp gebygeþ and hē ðonne onfinde him hwelce unhǣlo on binnan .xxx. nihta</span>
									<span class="q-cite"> (L. In. 56; Th. i. 138, 11)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">misfortune, mishap</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sorge ne cūðon, wonsceaft wera, wiht unhǣlo</span>
							<span class="q-cite"> (Beo. Th. 241; B. 120)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æd-leān" d:title="æd-leān">
		<body>
			<h1>æd-leān<span class="pron"> | æd.læ͜ɑːn |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a reward</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ed-leān" class="xref-target">ed-leān</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fugles" d:title="fugles">
		<body>
			<h1>fugles<span class="pron"> | fu.ɣles |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">of a bird or fowl</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">of a bird or fowl</span>
							<span class="q-oe">fugles</span>
							<span class="q-cite"> (Exon. 17 a; Th. 41, 11; Cri. 654)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fugel" class="xref-target">fugel</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gælæþ" d:title="gælæþ">
		
		<body>
			<h1>gælæþ<span class="pron"> | Gæ.læθ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A cage to sell or punish bondmen in</span>
						<span class="meaning-la"> (Lat. catasta)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gæleþ catasta</span>
							<span class="q-cite"> (Wrt. Voc. 288, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sylen" d:title="sylen">
		<body>
			<h1>sylen<span class="pron"> | sy.len |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:selen" class="xref-target">selen</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ofer-gemet" d:title="ofer-gemet">
		<body>
			<h1>ofer-gemet<span class="pron"> | o.fer.Ge.met |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">vide ergo ne impudenter velis satis Deum nosse, qui Alypium non satis nosti</span>
						<span class="q-oe">Lōca nū þæt þū ofergemet ne wilnige, nū ðū hī (God and Alypius) tōgædere metest, woldest cunnan God swā swā Alippius</span>
						<span class="q-cite"> (Solil. H. 17, 9)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fylstend" d:title="fylstend">
		<body>
			<h1>fylstend<span class="pron"> | fyl.stend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A helper</span>
						<span class="meaning-la"> (Lat. adiutor meus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Deus meus adiutor meus</span>
							<span class="q-oe">God mīn fylstend mīn</span>
							<span class="q-cite"> (Ps. L. 17, 3: 61, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-fylstend" class="xref-target">ge-fylstend</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="BRǢÞ" d:title="BRǢÞ">
		
		<body>
			<h1>BRǢÞ<span class="pron"> | bræːθ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An odour, a scent, smell good or bad, a savour, BREATH</span>
						<span class="meaning-la"> (Lat. odor, odoramen)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">odoratus est Dominus odorem suavitatis</span>
							<span class="q-oe">God underfēng ðære wynsumnysse brǣþ</span>
							<span class="q-cite"> (Gen. 8, 21)</span>
						</li>
						<li>
							<span class="q-en">the plaster [lit. chalk] began to smell excessively, and Jovian was smothered with the smell</span>
							<span class="q-oe">Ongan se cealc mid ungemete stincan, ðā wearþ Iuuinianus mid ðam brǣþe ofsmorod</span>
							<span class="q-cite"> (Ors. 6, 32; Bos. 129, 12)</span>
						</li>
						<li>
							<span class="q-la">odor</span>
							<span class="q-oe">Brēþ</span>
							<span class="q-cite"> (Ælfc. Gl. 70; Wrt. Voc. 42, 58)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ǣðm" class="xref-target">ǣðm</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flet-sittend" d:title="flet-sittend">
		<body>
			<h1>flet-sittend<span class="pron"> | flet.sit.tend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A court-resident</span>
						<span class="meaning-la"> (Lat. in aula sēdens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">there was a feast fairly arranged to the court-residents</span>
							<span class="q-oe">Ðā wæs flet-sittendum fægere gereorded</span>
							<span class="q-cite"> (Beo. Th. 3580; B. 1788)</span>
						</li>
						<li>
							<span class="q-en">whom I heard the court-residents call Freaware</span>
							<span class="q-oe">Ða ic Freāware fletsīttende nemnan hȳrde</span>
							<span class="q-cite"> (4049; B. 2022)</span>
						</li>
						<li>
							<span class="q-en">there were full jugs carried along the benches to the court-residents</span>
							<span class="q-oe">Ðǣr wǣron boren æfter bencum orcas fulle fletsittendum</span>
							<span class="q-cite"> (Judth. 10; Thw. 21, 15; Jud. 19: 21, 24; Jud. 33)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="SENDEÞ" d:title="SENDEÞ">
		<body>
			<h1>SENDEÞ<span class="pron"> | sen.deθ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:SEOFON" class="xref-target">SEOFON</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="helerung" d:title="helerung">
		<body>
			<h1>helerung<span class="pron"> | xe.le.rung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The turning of a balance</span>
						<span class="meaning-la"> (Lat. trutinæ inclinatio)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:helur-bled" class="xref-target">helur-bled</a>, <a href="x-dictionary:r:heolorian" class="xref-target">heolorian</a>, <a href="x-dictionary:r:heolra" class="xref-target">heolra</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æt-springan" d:title="æt-springan">
		
		<body>
			<h1>æt-springan<span class="pron"> | æt.sprin.gɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -sprang, sg: -spranc, pl: -sprungon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -sprungen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To spring out</span>
						<span class="meaning-la"> (Lat. prosilire)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the blood sprang out</span>
							<span class="q-oe">Blōd ætspranc</span>
							<span class="q-cite"> (Beo. Th. 2247; B. 1121)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="norþeāst-hyrne" d:title="norþeāst-hyrne">
		<body>
			<h1>norþeāst-hyrne<span class="pron"> | nor.θæ͜ɑːst.xyr.ne |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a north-east corner</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Stōd þǣr ān rōd on ðǣre eorðan on ðām norðeāsthyrnan</span>
							<span class="q-cite"> (Vis. Lfc. 71)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frum-weorc" d:title="frum-weorc">
		<body>
			<h1>frum-weorc<span class="pron"> | frum.we͜ork |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An ancient work, the work of the creation</span>
						<span class="meaning-la"> (Lat. opus priscum, res in principio creata)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they would at once proclaim the father of creation's works</span>
							<span class="q-oe">Woldon hie ædre gecȳðan frumweorca fæder</span>
							<span class="q-cite"> (Andr. Kmbl. 1607; An. 805)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stalu" d:title="stalu">
		<body>
			<h1>stalu<span class="pron"> | stɑ.lu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">theft, stealing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">stealing loves not any delay</span>
							<span class="q-oe">Stalu ne lufaþ nāne yldinge</span>
							<span class="q-cite"> (Homl. Th. i. 220, 9)</span>
						</li>
						<li>
							<span class="q-oe">Be stale. Gif hwā stalie</span>
							<span class="q-cite"> (L. In. 7; Th. i. 106, 14)</span>
						</li>
						<li>
							<span class="q-oe">Gif hwā Godes cyricean brece for stale</span>
							<span class="q-cite"> (L. Ecg. P. iv. 24; Th. ii. 210, 30: Blickl. Homl. 75, 31)</span>
						</li>
						<li>
							<span class="q-oe">Sum wer wæs betogen ðæt hē wǣre on stale</span>
							<span class="q-cite"> (Homl. Skt. i. 21, 265)</span>
						</li>
						<li>
							<span class="q-oe">Se ðe cyricean ǣhte mid stale āfyrde</span>
							<span class="q-cite"> (Bd. 2, 5; S. 506, 30)</span>
						</li>
						<li>
							<span class="q-oe">Sume stale fremmaþ</span>
							<span class="q-cite"> (1, 27; S. 490 9, 5)</span>
						</li>
						<li>
							<span class="q-oe">Of ðære heortan cumaþ stale (stala, MS. A.)</span>
							<span class="q-cite"> (Mt. Kmbl. 25, 19: Mk. Skt. 7, 22)</span>
						</li>
						<li>
							<span class="q-oe">Ða heāfodleahtras sind ... leāsgewitnyssa, stala</span>
							<span class="q-cite"> (Homl. Th. ii. 592, 5)</span>
						</li>
						<li>
							<span class="q-la">furtum</span>
							<span class="q-oe">Stala</span>
							<span class="q-cite"> (Wrt. Voc. ii. 38, 31)</span>
						</li>
						<li>
							<span class="q-oe">Mōna se syxteōða nānum þingum nytlīc nymþe stalum</span>
							<span class="q-cite"> (Lchdm. iii. 192, 7)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">what is stolen</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Stalu biþ funden</span>
							<span class="q-cite"> (186, 14: 188, 2)</span>
						</li>
						<li>
							<span class="q-oe">Gif hē næbbe, hwæt hē wið ðære stale sylle, sylle man hine wið feō</span>
							<span class="q-cite"> (Ex. 22, 3)</span>
						</li>
						<li>
							<span class="q-oe">Gif preōst mycele stale forstele</span>
							<span class="q-cite"> (L. Ecg. C. 11; Th. ii. 140, 14)</span>
						</li>
						<li>
							<span class="q-oe">Gif hwylc man medeme þing stele, āgyfe ða stale ðam ðe hig āhte</span>
							<span class="q-cite"> (L. Ecg. P. ii. 25; Th. ii. 192, 20: iv. 24; Th. ii. 212, 1)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">a fine payable for theft</span>
					</p>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">anything done by stealth</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðæt scs Petrus on dæge folce be Criste sǣde, ðonne wrāt scs Marcus ðæt on niht, and hē ðæt hæl sce Petre; for ðon his godspell is swā cweden, furtum laudabile, hergendlīco stalo</span>
							<span class="q-cite"> (Shrn. 74, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-stalu" class="xref-target">ge-stalu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ālǣdan" d:title="ālǣdan">
		<body>
			<h1>ālǣdan<span class="pron"> | ɑː.læː.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to lead, lead out, withdraw, take away</span>
						<span class="meaning-la"> (Lat. ducere, producere, educere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">eduxi te de terra</span>
							<span class="q-oe">Ic alǣdde ðē of lande</span>
							<span class="q-cite"> (Ps. Spl. 80, 9: Ps. Th. 80, 10: 142, 12: 103, 14: Cd. 73; Th. 90, 15; Gen. 1495)</span>
						</li>
						<li>
							<span class="q-en">I am led out from the light</span>
							<span class="q-oe">Ic eom alǣded fram leōhte</span>
							<span class="q-cite"> (Cd. 217; Th. 275, 27; Sat. 178: Ps. Spl. 108, 22)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to be produced, brought forth, to grow</span>
						<span class="meaning-la"> (Lat. produci)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">thou permittest fodder to be produced from the earth for cattle</span>
							<span class="q-oe">Ðū of foldan fōdder neātum lǣtest alǣdan</span>
							<span class="q-cite"> (Ps. Th. 103, 13)</span>
						</li>
						<li>
							<span class="q-en">as it from an egg had been brought forth</span>
							<span class="q-oe">Swylce he of ægerum ūt alǣde</span>
							<span class="q-cite"> (Exon. 593; Th. 214, 3; Ph. 233: 59b; Th. 215, 11; Ph. 251)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-siht" d:title="ge-siht">
		<body>
			<h1>ge-siht<span class="pron"> | je.sixt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">faculty of seeing</span>
						<span class="meaning-la"> (Lat. visus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gesihð visus, hlyst auditus</span>
							<span class="q-cite"> (Wrt. Voc. i. 42, 54)</span>
						</li>
						<li>
							<span class="q-oe">Blind sceal his eāgna þolian, oftigen bið him torhtre gesihðe</span>
							<span class="q-cite"> (Gn. Ex. 40)</span>
						</li>
						<li>
							<span class="q-la">caecis uisum</span>
							<span class="q-oe">Blindum gesihðo</span>
							<span class="q-cite"> (Lk. L. 4, 18)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="sub-heading">the exercising of the faculty, a seeing</span>
								<span class="meaning-en">the exercising of the faculty, a seeing</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">'Hiē God geseōð.' On þǣre gesihðe wesað ealle geleāffulle</span>
									<span class="q-cite"> (Bl. H. 13, 27)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">sight (lit. or fig. ) of a person or object</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(l)</span>
								<span class="sub-heading">where the person sees</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">with gen. of person</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">On wera gesiehðe</span>
											<span class="q-cite"> (An. 620)</span>
										</li>
										<li>
											<span class="q-la">ad (regis) presentiam</span>
											<span class="q-oe">Tō gesyþþe</span>
											<span class="q-cite"> (An. Ox. 3015)</span>
										</li>
										<li>
											<span class="q-la">ante conspectum suum</span>
											<span class="q-oe">Fore gesigðe his</span>
											<span class="q-cite"> (Lk. L. 9, 52)</span>
										</li>
										<li>
											<span class="q-oe">Fram Nerōnes gesyhþe</span>
											<span class="q-cite"> (Bl. H. 189, 36)</span>
										</li>
										<li>
											<span class="q-oe">Hī ne mōston cuman on his eāgon gesihðe</span>
											<span class="q-cite"> (Chr. 1048; P. 174, 10)</span>
										</li>
										<li>
											<span class="q-oe">Hiē gestōdon on gesihþe þæs eādigan Andreas</span>
											<span class="q-cite"> (Bl. H. 243, 6)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">with dat.</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">non proposuerunt Deum ante conspectum suum</span>
											<span class="q-oe">Hī nā heom God setton on gesyhðe</span>
											<span class="q-cite"> (Ps. Th. 53, 3)</span>
										</li>
										<li>
											<span class="q-oe">Him wæs ān on gesyhðe engel</span>
											<span class="q-cite"> (Dan. 273)</span>
										</li>
										<li>
											<span class="q-oe">Cain gewāt gongan Gode of gesyhðe</span>
											<span class="q-cite"> (Gen. 1050)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(c)</span>
										<span class="sub-heading">with other constructions</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hī āsetton on gesyhðe sigebeāmas þrȳ fore Elenan cneō</span>
											<span class="q-cite"> (El. 847)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">where the person or object is seen</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Æt þǣre gesyhðe þæs sigebeāmes</span>
									<span class="q-cite"> (El. 965)</span>
								</li>
								<li>
									<span class="q-oe">Hwilce þū gesihðe hæfst cræfta</span>
									<span class="q-cite"> (Gen. 617)</span>
								</li>
								<li>
									<span class="q-oe">Hē hiē gelǣdeþ on sibbe gesyhþe</span>
									<span class="q-cite"> (Bl. H. 79, 34)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">eyes together with the faculty of sight</span>
						<span class="meaning-la"> (Lat. visus, oculi)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">uisum leuabimus</span>
							<span class="q-oe">Wē ūsse gesyhð (ūre gesyhðe, v.l.) upp āhōfon</span>
							<span class="q-cite"> (Bd. 5, J; Sch. 552, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hē ne mihte bedydrian Martines gesihðe</span>
							<span class="q-cite"> (Hml. S. 31, 824)</span>
						</li>
						<li>
							<span class="q-oe">Þ UNCERTAIN nǣron gewemmede Martines gesihþa on ōðra manna deāðe</span>
							<span class="q-cite"> (127)</span>
						</li>
						<li>
							<span class="q-en">with eyes in so many ways defiled</span>
							<span class="q-oe">Þ UNCERTAIN ic þīne anlīcnysse sceāwige mid swā mænigfealdum besmitenum gesihþum</span>
							<span class="q-cite"> (23 b, 435)</span>
						</li>
						<li>
							<span class="q-la">oculi Domini spectilantur bonos et malos</span>
							<span class="q-oe">Godes gesyhða behealdað ǣgðer ge gōde ge yfele</span>
							<span class="q-cite"> (R. Ben. 25, 13)</span>
						</li>
						<li>
							<span class="q-oe">God ðā hǣðenan ðeōda ætforan heora gesihðum ādwǣscte</span>
							<span class="q-cite"> (Hml. Th. i. 46, 20)</span>
						</li>
						<li>
							<span class="q-la">uisus (mortalium uisus aufugiunt)</span>
							<span class="q-oe">Gesiþþe</span>
							<span class="q-cite"> (An. Ox. 3170)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">a looking at, look</span>
						<span class="meaning-la"> (Lat. obtutus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">obtutus</span>
							<span class="q-oe">Gesihð</span>
							<span class="q-cite"> (Wrt. Voc. ii. 62, 42)</span>
						</li>
						<li>
							<span class="q-la">obtutibus</span>
							<span class="q-oe">Gesihþum</span>
							<span class="q-cite"> (An. Ox. 406)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">what is seen, a sight</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(l)</span>
								<span class="sub-heading">seen with the bodily eye</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">uisionem</span>
									<span class="q-oe">Æfter ðǣre angelica gesihða</span>
									<span class="q-cite"> (Jn. p. 8, 3)</span>
								</li>
								<li>
									<span class="q-en">the cross seen in the sky</span>
									<span class="q-oe">Cyning wæs þȳ blīþra . . . þurh þā fægeran gesyhð</span>
									<span class="q-cite"> (El. 98)</span>
								</li>
								<li>
									<span class="q-oe">Nǣnigum men giē cueðe ðone gesihða</span>
									<span class="q-cite"> (Mt. L. 17, 9)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">seen in sleep or in ecstasy, a vision</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">impleatur visio et prophetia</span>
									<span class="q-oe">Gesihð and wītegunga beōð gefyllede</span>
									<span class="q-cite"> (Hml. Th. ii. 14, 15)</span>
								</li>
								<li>
									<span class="q-oe">Wæs S. Michael þǣm bisceope on gesihþe æteōwed</span>
									<span class="q-cite"> (Bl. H. 205, 35)</span>
								</li>
								<li>
									<span class="q-la">in oromate (i. uisione superna) extaseos</span>
									<span class="q-oe">On ūplicere gesihþe geleōrednesse</span>
									<span class="q-cite"> (An. Ox. 404)</span>
								</li>
								<li>
									<span class="q-la">in uisione, i. in somno</span>
									<span class="q-oe">Gesiþþe</span>
									<span class="q-cite"> (2107)</span>
								</li>
								<li>
									<span class="q-la">quo uisu</span>
									<span class="q-oe">Þā hē slēp, þā geseah hē Crīst . . . Ðā hē þā gesihþe geseah</span>
									<span class="q-cite"> (Bl. H. 215, 31)</span>
								</li>
								<li>
									<span class="q-oe">Ic þē hāte þæt þū þās gesyhðe secge mannum</span>
									<span class="q-cite"> (Kr. 96)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:lim-gesihþ" class="xref-target">lim-gesihþ</a>, <a href="x-dictionary:r:siī-sib gesihþ" class="xref-target">siī-sib gesihþ</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-strewian" d:title="ge-strewian">
		
