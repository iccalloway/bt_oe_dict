<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æt-bredan" d:title="æt-bredan">
		<body>
			<h1>æt-bredan<span class="pron"> | æt.bre.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 3sg: -ætbryt</b>
				</p>
				<p>
					<b class="ending">past: sg: -bræd, pl: -brudon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -broden, past participle sg: -breden</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To take away, withdraw, set at liberty, to enlarge, release, rescue</span>
						<span class="meaning-la"> (Lat. tollere, eri-pere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">diabolus tollit verbum</span>
							<span class="q-oe">Se deōfol ætbryt ðæt word</span>
							<span class="q-cite"> (Lk. Bos. 8, 12)</span>
						</li>
						<li>
							<span class="q-la">tulistis clavem scientiæ</span>
							<span class="q-oe">Ge ætbrudon ðæs ingehȳdes cǣge</span>
							<span class="q-cite"> (11, 52)</span>
						</li>
						<li>
							<span class="q-la">quod habet auferetur ab eo</span>
							<span class="q-oe">Ðæt ðe he hæfþ him biþ ætbroden</span>
							<span class="q-cite"> (Mt. Bos. 13, 12: 21, 43: Ex. 22, 10)</span>
						</li>
						<li>
							<span class="q-la">quem abstulerant servi ejus</span>
							<span class="q-oe">Ðe hys wealas him ætbrudon</span>
							<span class="q-cite"> (Gen. 21, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bredan" class="xref-target">bredan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þeāf" d:title="þeāf">
