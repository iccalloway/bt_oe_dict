<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-mennisclīc" d:title="un-mennisclīc">
		<body>
			<h1>un-mennisclīc<span class="pron"> | un.men.niʃ.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Inhuman</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nimis e natura dictum est, nescio quem filios invenisse tortores</span>
							<span class="q-oe">Wē hērdon on ealdum spellum, ðæt sum sunu ofslōge his fæder, ic nāt hūmeta, būton wē witon ðæt hit unmennislīc (-līcu, Cott. MS.) dǣd wæs</span>
							<span class="q-cite"> (Bt. 31, 1; Fox 112, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Þǣra diācona wæs se forma Stephanus" d:title="Þǣra diācona wæs se forma Stephanus">
		<body>
			<h1>Þǣra diācona wæs se forma Stephanus<span class="pron"> | θæː.rɑ, di.ɑː.ko.nɑ, wæs, se, for.mɑ, step.xɑ.nus |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(2 a)</span>
								<span class="sub-heading">where age is marked</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Wæs ān twelf geāra, ōþer nigan geāra, and se þridda seofan geāra</span>
									<span class="q-cite"> (Shrn. 58, 12)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">forming part of an ordinal</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">On ðǣm siofan-and-hundsiofantiogoðan psalme</span>
									<span class="q-cite"> (Past. 465, 4)</span>
								</li>
								<li>
									<span class="q-oe">Se seofan-and-hundeahtatigeða</span>
									<span class="q-cite"> (R. Ben. 37, 18)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(4)</span>
								<span class="sub-heading">the abstract number seven</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Twīa seofon beōð feōwertȳne</span>
									<span class="q-cite"> (Angl. viii. 302, 45)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-gripe" d:title="on-gripe">
		<body>
			<h1>on-gripe<span class="pron"> | on.gri.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
