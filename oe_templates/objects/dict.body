<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-spannan" d:title="ge-spannan">
		
		<body>
			<h1>ge-spannan<span class="pron"> | je.spɑn.nɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -speōn</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -spannen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To join, span, clasp, fasten</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the leader clasped his helm</span>
							<span class="q-oe">Gūþweard grīmhelm gespeōn</span>
							<span class="q-cite"> (Cd. 151; Th. 188, 27; Exod. 174)</span>
						</li>
						<li>
							<span class="q-en">then the emperor ordered to harness four wild horses to a chariot</span>
							<span class="q-oe">Ðā hēht cāsere gesponnan fiōwer wildo hors to scride</span>
							<span class="q-cite"> (Shrn. 71, 34)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:spannan" class="xref-target">spannan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gæfel-geroefa" d:title="gæfel-geroefa">
		
