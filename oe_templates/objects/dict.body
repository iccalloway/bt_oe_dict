		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="scop-cræft" d:title="scop-cræft">
		<body>
			<h1>scop-cræft<span class="pron"> | ʃop.kræft |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The poet's art, poetry</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sceop poeta, ic leornige sceopcræft (scop-) poetor</span>
							<span class="q-cite"> (Ælfc. Gr. 36 ; Zup. 215, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīw-hwirfed" d:title="nīw-hwirfed">
		<body>
			<h1>nīw-hwirfed<span class="pron"> | niːw.xwir.fed |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">newly converted</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nīhwurfed ł nīlǣred neophytus</span>
							<span class="q-cite"> (Hpt. G1. 48o, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Ǣw" d:title="Ǣw">
