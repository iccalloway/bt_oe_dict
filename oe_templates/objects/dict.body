<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-þeōstrian" d:title="for-þeōstrian">
		<body>
			<h1>for-þeōstrian<span class="pron"> | for.θe͜oː.stri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To darken, be dark</span>
						<span class="meaning-la"> (Lat. obscūrāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">mīsit tenebras et obscūrāvit</span>
							<span class="q-oe">He asende þeōstru and forþeōstrade oððe swearc</span>
							<span class="q-cite"> (Ps. Lamb. 104, 28)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āþȳstrian" class="xref-target">āþȳstrian</a>
			</p>
		</body>
