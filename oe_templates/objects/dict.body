<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cocer" d:title="cocer">
		<body>
			<h1>cocer<span class="pron"> | ko.Ker |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a quiver</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Coker faretra</span>
							<span class="q-cite"> (Wrt. Voc. i. 35, 23)</span>
						</li>
						<li>
							<span class="q-oe">Seō lufu cocor (faretram) and bogan and flān forlēt</span>
							<span class="q-cite"> (Prud. 51)</span>
						</li>
						<li>
							<span class="q-oe">Hī fyllaþ heora coceras mid flānum</span>
							<span class="q-cite"> (Ps. Th. 10, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æt-gædere" d:title="æt-gædere">
		<body>
			<h1>æt-gædere<span class="pron"> | æt.Gæ.de.re |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Together</span>
						<span class="meaning-la"> (Lat. una, simul)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Twā beōþ ætgædere grmdende.</span>
							<span class="q-cite"> (Lk. Bos. 17, 35)</span>
						</li>
						<li>
							<span class="q-oe">tweye [wym-men] schulen be gryndinge to gidere,</span>
							<span class="q-cite"> (Wyc.)</span>
						</li>
						<li>
							<span class="q-en">his kindred is together</span>
							<span class="q-oe">His mǣgþe biþ ætgædere</span>
							<span class="q-cite"> (Bt. Met. Fox 20, 320; Met. 20, 160)</span>
						</li>
						<li>
							<span class="q-en">the javelins stood altogether</span>
							<span class="q-oe">Gāras stōdon samod ætgædere</span>
							<span class="q-cite"> (Beo. Th. 664; Bi 329)</span>
						</li>
						<li>
							<span class="q-en">blood and water both together</span>
							<span class="q-oe">Blod and wæter bu tū ætgædre</span>
							<span class="q-cite"> (Exon. 70a; Th. 260, 5; Ju. 292)</span>
						</li>
						<li>
							<span class="q-en">they [men] reviled us two, both together</span>
							<span class="q-oe">Bismærede ungket [ = uncit] men, bā ætgædre</span>
							<span class="q-cite"> (Runic Inscrip. Kmbl, 354, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:gædere" class="xref-target">gædere</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣ-hlȳp" d:title="ǣ-hlȳp">
		
		<body>
			<h1>ǣ-hlȳp<span class="pron"> | æː.xlyːp |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A transgression, breach of the law, an assault</span>
						<span class="meaning-la"> (Lat. legis transgressio, aggressus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se ðe ǣ-hlīp gewyrce</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fieder" d:title="fieder">
		<body>
			<h1>fieder<span class="pron"> | fi͜y.der |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a father</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fæder" class="xref-target">fæder</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wip-geondan" d:title="wip-geondan">
		<body>
			<h1>wip-geondan<span class="pron"> | wip.Ge͜on.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>preposition</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Beyond</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">omnis regio circum Iordanen</span>
							<span class="q-oe">Eal ðæt rīce wiðgeondan Iordanen</span>
							<span class="q-cite"> (Mt. Kmbl. 3, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wilm-hāt" d:title="wilm-hāt">
		<body>
			<h1>wilm-hāt<span class="pron"> | wilm.xɑːt |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Burning hot</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Him brego engla wylmhātne līg tō wræce sende</span>
							<span class="q-cite"> (Cd. Th. 156, 5 ; Gen. 2584)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bēce" d:title="bēce">
		<body>
			<h1>bēce<span class="pron"> | beː.Ke |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Boecae, boeccae, boece aesculus</span>
						<span class="q-cite"> (Txts. 36, 22)</span>
					</li>
					<li>
						<span class="q-oe">fagus</span>
						<span class="q-cite"> (62, 417)</span>
					</li>
					<li>
						<span class="q-oe">Bēccae, boece esculus</span>
						<span class="q-cite"> (60, 391)</span>
					</li>
					<li>
						<span class="q-oe">Bēce</span>
						<span class="q-cite"> (Wrt. Voc. ii. 7, 9)</span>
					</li>
					<li>
						<span class="q-oe">fagus</span>
						<span class="q-cite"> (34, 71)</span>
					</li>
					<li>
						<span class="q-oe">Tō þaere mearcbēcean, of ðǣre bēcean</span>
						<span class="q-cite"> (C. D. B. i. 295, 9)</span>
					</li>
					<li>
						<span class="q-oe">On þā ealdan mearcebēcan</span>
						<span class="q-cite"> (296, 26)</span>
					</li>
					<li>
						<span class="q-oe">Bēcum fagis</span>
						<span class="q-cite"> (Wrt. Voc. ii. 34, 72)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:mearc-bēce" class="xref-target">mearc-bēce</a>, <a href="x-dictionary:r:bōcce" class="xref-target">bōcce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nytan" d:title="nytan">
		<body>
			<h1>nytan<span class="pron"> | ny.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">ne witan</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic nāt nescio</span>
							<span class="q-cite"> (Jn. Skt. 9, 25)</span>
						</li>
						<li>
							<span class="q-oe">Nāt ic hwile wundorlīc þing</span>
							<span class="q-cite"> (Shrn. 36, 18)</span>
						</li>
						<li>
							<span class="q-oe">Gif ðū nāst if you do not know</span>
							<span class="q-cite"> (Ælfc. Gr. 50, 17; Som. 51, 34)</span>
						</li>
						<li>
							<span class="q-oe">Gyt nyton hwæt gyt biddaþ</span>
							<span class="q-cite"> (Mk. Skt. 10, 38)</span>
						</li>
						<li>
							<span class="q-oe">Wē witon ðæt God spæc wið Moyses; nyte wē hwanon ðes is</span>
							<span class="q-cite"> (Jn. Skt. 9, 29)</span>
						</li>
						<li>
							<span class="q-oe">Wē nyton (nutu wē, Lind. : niton wē, Rush.)</span>
							<span class="q-cite"> (Mt. Kmbl. 21, 27)</span>
						</li>
						<li>
							<span class="q-oe">Gē neton</span>
							<span class="q-cite"> (Exon. Th. 282, 9; Jul. 660)</span>
						</li>
						<li>
							<span class="q-oe">Ic wiste ðæt ðū ūt āfaren wǣre, ac ic nyste hū feor</span>
							<span class="q-cite"> (Bt. 5, 1; Fox 8, 33)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt ðæt ic ǣr sǣde ðæt ic nyste (Cott. MS. nesse) ... Ðū sǣdest ðæt ðū nystest (Cott. MS. nesse)</span>
							<span class="q-cite"> (34, 12; Fox 154, 12-13)</span>
						</li>
						<li>
							<span class="q-oe">Ðū nysstest (Cott. MS. nesse) . . . ic nyste (Cott. MS. nysse)</span>
							<span class="q-cite"> (35, 2; Fox 156, 33-34)</span>
						</li>
						<li>
							<span class="q-oe">Ðū nestest</span>
							<span class="q-cite"> (5, 3; Fox 12, 34)</span>
						</li>
						<li>
							<span class="q-oe">Hē nyste</span>
							<span class="q-cite"> (Past. 15; Swt. 91, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hī nysðon (nyston, MS. A.)</span>
							<span class="q-cite"> (Mt. Kmbl. 24, 39)</span>
						</li>
						<li>
							<span class="q-oe">Wē neston</span>
							<span class="q-cite"> (Blickl. Homl. 17, 12)</span>
						</li>
						<li>
							<span class="q-oe">Wēnst ðū ðæt ic nyte</span>
							<span class="q-cite"> (Bt. 5, 3; Fox 12, 17)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt hē nān ryht andwyrde nyte</span>
							<span class="q-cite"> (35, 1; Fox 156, 8)</span>
						</li>
						<li>
							<span class="q-oe">Nyte ðīn wynstre hwæt dō ðīn swȳðre</span>
							<span class="q-cite"> (Mt. Kmbl. 6, 3)</span>
						</li>
						<li>
							<span class="q-oe">Nytende</span>
							<span class="q-cite"> (Lchdm. i. 164, 5)</span>
						</li>
						<li>
							<span class="q-oe">Him nytendum</span>
							<span class="q-cite"> (228, 1)</span>
						</li>
						<li>
							<span class="q-la">clam custodibus</span>
							<span class="q-oe">Nytendum weardmannum</span>
							<span class="q-cite"> (Ælfc. Gr. 47; Som. 47, 58)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:nāt-" class="xref-target">nāt-</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fisc-noþ" d:title="fisc-noþ">
		
		<body>
			<h1>fisc-noþ<span class="pron"> | fiʃ.noθ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fishing</span>
						<span class="meaning-la"> (Lat. piscātus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the people knew not the art of fishing</span>
							<span class="q-oe">Seō þeōd ðone cræft ne cūðe ðæs fiscnoþes</span>
							<span class="q-cite"> (Bd. 4, 13; S. 582, 43)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
