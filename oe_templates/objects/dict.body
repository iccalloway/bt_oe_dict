<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-andwīs" d:title="un-andwīs">
		<body>
			<h1>un-andwīs<span class="pron"> | un.ɑn.dwiːs |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Inexperienced</span>
						<span class="meaning-la"> (Lat. inexpertus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Unandwīs inexpertus</span>
							<span class="q-cite"> (Wrt. Voc. ii. 84; 13: 46, 76)</span>
						</li>
						<li>
							<span class="q-la">inexperto (the passage, however, is in experto terrore, Ald. 34)</span>
							<span class="q-oe">Ðȳ unandwīsan</span>
							<span class="q-cite"> (79, 39)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gelm" d:title="gelm">
