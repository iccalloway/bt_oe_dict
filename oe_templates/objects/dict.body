<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brasian" d:title="brasian">
		
		<body>
			<h1>brasian<span class="pron"> | brɑ.si.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -ic brasige</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">I cover with brass</span>
						<span class="meaning-la"> (Lat. æro)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:bræsian" class="xref-target">bræsian</a>
			</p>
