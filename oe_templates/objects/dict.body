<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ālynnan" d:title="ālynnan">
		
		<body>
			<h1>ālynnan<span class="pron"> | ɑː.lyn.nɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -lann, pl: -lunnon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -lunnen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To deliver, free from, release</span>
						<span class="meaning-la"> (Lat. liberare, evellere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he would release him from calamity</span>
							<span class="q-oe">He wolde hine alynnan of lāþscipe</span>
							<span class="q-cite"> (Cd. 95; Th. 123, 19; Gen. 2048)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="greōsn" d:title="greōsn">
