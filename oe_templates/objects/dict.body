<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-meltan" d:title="for-meltan">
		
		<body>
			<h1>for-meltan<span class="pron"> | for.mel.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -mealt, pl: -multon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -molten</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To melt away, become liquid, liquefy</span>
						<span class="meaning-la"> (Lat. liquescere, liquefieri)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he commanded the weapons all to melt away</span>
							<span class="q-oe">Hēt wǣpen eall formeltan</span>
							<span class="q-cite"> (Andr. Kmbl. 2294; An. 1148)</span>
						</li>
						<li>
							<span class="q-la">liquefacta est terra</span>
							<span class="q-oe">Formealt oððe hnesce geworden is eorþe</span>
							<span class="q-cite"> (Ps. Lamb. 74, 4: Ex. 16, 21)</span>
						</li>
						<li>
							<span class="q-en">all the ships were consumed</span>
							<span class="q-oe">Ealle ða scipu formultan</span>
							<span class="q-cite"> (Ors. 5, 4; Bos. 105, 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cnyttan" d:title="ge-cnyttan">
