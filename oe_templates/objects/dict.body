						<span class="q-oe">Mid feōwerfealdum</span>
						<span class="q-cite"> (An. Ox. 1542)</span>
					</li>
					<li>
						<span class="q-la">quadruplum</span>
						<span class="q-oe">Feārfald</span>
						<span class="q-cite"> (Lk. L. 19, 8)</span>
					</li>
				</ul>
			</div>
