<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="driās" d:title="driās">
		<body>
			<h1>driās<span class="pron"> | dri.ɑːs |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
