				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">2.</span>
								<span class="sub-heading">gelíce ... swá as ... so</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gelīce þā biscopas syndan ... swā syndan þā mæssepreōstas</span>
									<span class="q-cite"> (Ll. Th. ii. 402, 19)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
