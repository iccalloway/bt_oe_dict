<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āscreopan" d:title="āscreopan">
		<body>
			<h1>āscreopan<span class="pron"> | ɑː.ʃre͜o.pɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -scræp, pl: -scrǣpon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -screpen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To scrape off, scrape</span>
						<span class="meaning-la"> (Lat. radere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">testa saniem radebat</span>
							<span class="q-oe">Ascræp ðone wyrms of his līce</span>
							<span class="q-cite"> (Job 2, 8; Thw. 166, 33)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:screopan" class="xref-target">screopan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="in-burh" d:title="in-burh">
