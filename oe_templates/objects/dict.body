	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="slæc" d:title="slæc">
		
		<body>
			<h1>slæc<span class="pron"> | slæK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">Slack</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">inactive, slothful, lazy, not willing to make an effort</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Slæc reses</span>
									<span class="q-cite"> (Wrt. Voc. ii. 118, 77)</span>
								</li>
								<li>
									<span class="q-oe">Sleac piger</span>
									<span class="q-cite"> (i. 74, 33: lentus vel piger, 49, 35)</span>
								</li>
								<li>
									<span class="q-oe">Sleac vel slaw pigras vel lentus</span>
									<span class="q-cite"> (16, 48)</span>
								</li>
								<li>
									<span class="q-en">thou wicked and slothful servant.</span>
									<span class="q-oe">Ðū yfela þeōwa and sleac thou wicked and slothful servant.</span>
									<span class="q-cite"> (Homl. Th. ii. 554, 7)</span>
								</li>
								<li>
									<span class="q-oe">Sægdon ðæt hē sleac wǣre, æðeling unfrom.</span>
									<span class="q-cite"> (Beo. Th. 4381; B. 2187)</span>
								</li>
								<li>
									<span class="q-oe">Ðæt ðæm sleacan preōste ne þince tō mycel geswinc, ðæt hē undō his eāgan</span>
									<span class="q-cite"> (Anglia viii. 317, 4)</span>
								</li>
								<li>
									<span class="q-oe">Tō swilcum sleacum cweð se hīrēdes ealdor: ' Tō hwī stande gē hēr ealne dæg ȳdele?'</span>
									<span class="q-cite"> (Homl. Th. ii. 78, 10)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">careless, negligent, remiss, not strict in the performance of duty</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">ne aut districtio rigida, oue pietas remissa.</span>
									<span class="q-oe">Ne tō stræc on ðære lāre ne tō slæc on ðære mildheortnesse</span>
									<span class="q-cite"> (Past. 17, 10; Swt. 125, 1)</span>
								</li>
								<li>
									<span class="q-oe">Se ðe sleac wǣre tō gōdnesse</span>
									<span class="q-cite"> (Homl. Th. ii. 100, 22)</span>
								</li>
								<li>
									<span class="q-oe">Se biþ wacigende .. . se biþ sleac and slǣpende</span>
									<span class="q-cite"> (Btwk. 220, 32)</span>
								</li>
								<li>
									<span class="q-oe">Sleaces socordis</span>
									<span class="q-cite"> (Germ. 388, 34)</span>
								</li>
								<li>
									<span class="q-oe">Ne beōn gē tō slāpole ne tō sleace, ac scyldaþ eōw georne wið deōfles dare.</span>
									<span class="q-cite"> (Wulfst. 40, 21)</span>
								</li>
								<li>
									<span class="q-oe">Sleace to ǣnig wyrcenne gōd pigre ad aliquod operandum bonum</span>
									<span class="q-cite"> (Anglia xi. 117, 36)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">languid, ill</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Slæce egra</span>
									<span class="q-cite"> (Wrt. Voc. ii. 107, 8 : 29, 18)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of things</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">of physical movement, slow, gentle</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sum munuc mid sleaccre stalcunge his fōtswaðum filigde</span>
									<span class="q-cite"> (Homl. Th. ii. 138, 6)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">that makes inactive, sluggish</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Wē sceolon āsceacan ðone sleacan slǣp ūs fram</span>
									<span class="q-cite"> (i. 602, 15)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">not attended with effort</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">gif hiē læsse singaþ</span>
									<span class="q-la">nimis iners seruilium</span>
									<span class="q-oe">Hit is ealles tō sleac munuca . þeōwdōm</span>
									<span class="q-cite"> (R. Ben. 44, 18)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:slæcness" class="xref-target">slæcness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-settan" d:title="un-settan">
		<body>
			<h1>un-settan<span class="pron"> | un.set.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to displace, put down</span>
						<span class="meaning-la"> (Lat. ad deponendum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ad deponendum</span>
							<span class="q-oe">Tō unsettanne (-setanne, Rush.) ad deponendum</span>
							<span class="q-cite"> (Mk. Skt. Lind. 15, 36)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="andian" d:title="andian">
		
		<body>
			<h1>andian<span class="pron"> | ɑn.di.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -andie, 1sg: -andige, 2sg: -andast, 3sg: -andaþ, 3sg: -andgaþ, pl: -andiaþ</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: present participle: -andigende, past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To envy</span>
						<span class="meaning-la"> (Lat. invidere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">invideo tibi</span>
							<span class="q-oe">Ic andige on ðē</span>
							<span class="q-cite"> (Ælfc. Gr. 41; Som. 43, 58: 26; Som. 29, 3)</span>
						</li>
						<li>
							<span class="q-la">invidet</span>
							<span class="q-oe">Andgaþ</span>
							<span class="q-cite"> (Prov. 28)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-bǣdan" d:title="-bǣdan">
		<body>
			<h1>-bǣdan<span class="pron"> | bæː.dɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:tō-bǣdan" class="xref-target">tō-bǣdan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āsyndran" d:title="āsyndran">
		
		<body>
			<h1>āsyndran<span class="pron"> | ɑː.syn.drɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">present: 1sg: -asyndrige</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede, sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed, past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To put ASUNDER, to separate, disjoin, sever</span>
						<span class="meaning-la"> (Lat. separare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">veni separare hominem adversus patrem suum</span>
							<span class="q-oe">Ic com mann asyndrian ongēn his fæder</span>
							<span class="q-cite"> (Mt. Bos. 10, 35: Ps. Spl. 67, 10)</span>
						</li>
						<li>
							<span class="q-en">death sunders body and soul</span>
							<span class="q-oe">Se deāþ asyndreþ līc and sāwle</span>
							<span class="q-cite"> (Soul Kmbl. 7 ; Seel. 4)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āsundrian" class="xref-target">āsundrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hel-lic" d:title="hel-lic">
		<body>
			<h1>hel-lic<span class="pron"> | xel.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">referring to classical mythology</span>
					</p>
					<ol class="sub-senses">
						<li>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þǣm hellicum gorgoneo (maculata cruore. Aid. 208, 21)</span>
									<span class="q-cite"> (Wrt. Voc. ii. 961 83)</span>
								</li>
								<li>
									<span class="q-oe">gorgoneis (molitur damna venenis, Aid. 166, n)</span>
									<span class="q-cite"> (92, 66 : 41, 44)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of hell</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On þām blindan cwearterne þǣre hellican sūsle</span>
							<span class="q-cite"> (Hml. A. 8, 205)</span>
						</li>
						<li>
							<span class="q-oe">On ðām hellican līge</span>
							<span class="q-cite"> (Hml. S. 17, 34)</span>
						</li>
						<li>
							<span class="q-oe">Ætwindan þāam hellicum wītum</span>
							<span class="q-cite"> (Hml A. 34, 2)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">worthy of hell, infernal, diabolic, exceedingly wicked</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ǣlcne crīstenne man warnian wið þās egeslican and þās deōfollican coðe, ꝥ ys wyð þās hellican unþeāwas</span>
							<span class="q-cite"> (Angl. viii. 337, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tægl-hǣr" d:title="tægl-hǣr">
		<body>
			<h1>tægl-hǣr<span class="pron"> | tæɣl.xæːr |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A hair of an animal's tail</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif ðū hafast mid ðē wulfes hrycghǣr and tæglhǣr ða ȳtemæstan on sīðfæte, būtan fyrhtu ðū ðone sīð gefremest, ac se wulf sorgaþ ymbe his sīð</span>
							<span class="q-cite"> (Lchdm. i. 360, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ele-beām" d:title="ele-beām">
		<body>
			<h1>ele-beām<span class="pron"> | e.le.bæ͜ɑːm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An olive-tree</span>
						<span class="meaning-la"> (Lat. olea, oliva)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Elebeām olea vel oliva</span>
							<span class="q-cite"> (Ælfc. Gl. 32; Som. 61, 111; Wrt. Voc. 27, 40: 47; Som. 65, 18; Wrt. Voc. 33, 17: 80, 25: 285, 70: Ps. Lamb. 51, 10)</span>
						</li>
						<li>
							<span class="q-en">she brought a twig of olive-tree</span>
							<span class="q-oe">Heō brohte elebeāmes twīg</span>
							<span class="q-cite"> (Cd. 72; Th. 88, 30; Gen. 1473)</span>
						</li>
						<li>
							<span class="q-la">illa portāvit rāmum olīvæ</span>
							<span class="q-oe">Heō brohte ān twīg of ānum elebeāme</span>
							<span class="q-cite"> (Gen. 8, 11)</span>
						</li>
						<li>
							<span class="q-en">all your olive-trees shall perish</span>
							<span class="q-oe">Ealle eōwre elebeāmas forwurþaþ</span>
							<span class="q-cite"> (Deut. 28, 40: Ps. Th. 127, 4)</span>
						</li>
						<li>
							<span class="q-la">sunt fīlii tui sīcut novellæ olīvārum</span>
							<span class="q-oe">Syndon bearn ðīne swā swā nywlīcra elebergena oððe guōgaþ elebeāma</span>
							<span class="q-cite"> (Ps. Lamb. 127, 3)</span>
						</li>
						<li>
							<span class="q-la">ita facies in vīnea et in olīvēto tuo</span>
							<span class="q-oe">Dō swā on ðīnum wīnearde and on ðīnum elebeāmon</span>
							<span class="q-cite"> (Ex. 23, 11)</span>
						</li>
						<li>
							<span class="q-la">dedit tibi olīvēta quæ non plantasti</span>
							<span class="q-oe">He eōw sylþ elebeāmas ðe gē ne plantudon</span>
							<span class="q-cite"> (Deut. 6, 11)</span>
						</li>
						<li>
							<span class="q-en">an unfruitful or wild olive-tree</span>
							<span class="q-la">oleaster</span>
							<span class="q-oe">Unwæstmbǣre elebeām</span>
							<span class="q-cite"> (Ælfc. Gl. 47; Som. 65, 19; Wrt. Voc. 33, 19: Ælfc. Gr. 8; Som. 7, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="erythræa centaureum" d:title="erythræa centaureum">
		<body>
			<h1>erythræa centaureum<span class="pron"> | e.ryt.xræ.ɑ, Ken.tɑ.u.re.um |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-la"> (Lat. Lin)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nim centaurian take centaury</span>
							<span class="q-cite"> (L. M. 2, 8; Lchdm. ii. 186, 26; 2, 39; Lchdm. ii. 248, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-feald" d:title="ge-feald">
		<body>
			<h1>ge-feald<span class="pron"> | je.fæ͜ɑld |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fold, inclosure, field</span>
						<span class="meaning-la"> (Lat. septum, āger)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he hastened forth through the field of the monsters</span>
							<span class="q-oe">Þurh fīfela gefeald forþonette</span>
							<span class="q-cite"> (Wald. 76; Vald. 2, 10)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hell-ware" d:title="hell-ware">
		
		<body>
			<h1>hell-ware<span class="pron"> | xell.wɑ.re |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The inhabitants of hell</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">all creatures, those in heaven, those on earth, those in hell, bow to Christ</span>
							<span class="q-oe">Ealle gesceafta heofonwara eorþwara helwara onbūgaþ Criste</span>
							<span class="q-cite"> (Homl. Th. ii. 362, 1: i. 36 26)</span>
						</li>
						<li>
							<span class="q-en">all the inmates of hell</span>
							<span class="q-oe">Ealle hellwara</span>
							<span class="q-cite"> (Exon. I21 b; Th. 466, 18; Hö. 123)</span>
						</li>
						<li>
							<span class="q-en">of the glorious host and of the dwellers in hell</span>
							<span class="q-oe">Wuldorweorudes and helwara</span>
							<span class="q-cite"> (Exon. 12 a; Th. 18, 20; Cri. 286: 114 a; Th. 437, 12; Rä. 56, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hell-waru" class="xref-target">hell-waru</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leōht-sceāwigend" d:title="leōht-sceāwigend">
		<body>
			<h1>leōht-sceāwigend<span class="pron"> | le͜oːxt.ʃæ͜ɑː.wi.Gend |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">light-seeing</span>
						<span class="meaning-la"> (Lat. lucivida)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="on-sting" d:title="on-sting">
		<body>
			<h1>on-sting<span class="pron"> | on.sting |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the right to intervene, or thrust oneself into, the affairs of another</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">Ia</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Icc nelle nâteswhôn geþafian ꝥ þaer æ-circ;nig man æ-circ;nigne onstyng habbe on æ-circ;nigum þingum</span>
									<span class="q-cite"> (Cht. E. 303, 10)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:stingan" class="xref-target">stingan</a>, <a href="x-dictionary:r:in-sting" class="xref-target">in-sting</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="and-swaru" d:title="and-swaru">
		<body>
			<h1>and-swaru<span class="pron"> | ɑnd.swɑ.ru |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Him andswaru (an-, v. l.) ne com</span>
						<span class="q-cite"> (Hml. S. 18, 117)</span>
					</li>
					<li>
						<span class="q-oe">Seō gōde andswaru (ant-, v. l.)</span>
						<span class="q-cite"> (R. Ben. 55, 8)</span>
					</li>
					<li>
						<span class="q-la">responsio mollis</span>
						<span class="q-oe">Hnesce andswore</span>
						<span class="q-cite"> (Kent. Gl. 502)</span>
					</li>
					<li>
						<span class="q-oe">Underfōn andswore (responsum)</span>
						<span class="q-cite"> (R. Ben. I. 112, 6)</span>
					</li>
					<li>
						<span class="q-oe">Ondsuære</span>
						<span class="q-cite"> (Jn. L. 1, 22)</span>
					</li>
					<li>
						<span class="q-oe">Ondsuere (-swore, R.)</span>
						<span class="q-cite"> (Lk. L. 2, 26)</span>
					</li>
					<li>
						<span class="q-la">consulta, i. interrogata</span>
						<span class="q-oe">Andswara, rǣdas</span>
						<span class="q-cite"> (An. Ox. 2524)</span>
					</li>
					<li>
						<span class="q-oe">Antswara</span>
						<span class="q-cite"> (8, 130)</span>
					</li>
					<li>
						<span class="q-oe">Ðā bysmrode ic hine mid mīnum ondswarum . . . þā wæs hē ge—feōnde mīnra ondswaro</span>
						<span class="q-cite"> (Nar. 18, 13-18)</span>
					</li>
					<li>
						<span class="q-la">responsis</span>
						<span class="q-oe">Ondsuearum (-sworum, R.)</span>
						<span class="q-cite"> (Lk. L. 2, 47)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feorm" d:title="feorm">
		<body>
			<h1>feorm<span class="pron"> | fe͜orm |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">provisions, stores</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðrītig ombra alāð, and ðreō hund hlāfa . . . feōwer weðras . . . sex gōsfuglas . . . ðrītig leapera . . . sester fulne saltes . . . and hiō forgifeð fīftēne pund for ðȳ ðe mon ðās feorme ðȳ soel gelǣste</span>
							<span class="q-cite"> (C. D. i. 312, 5-18)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="sub-heading">dead stock in contrast with live stock</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">morte morieris tu et omnia quae tua sunt (Gen. 20, 7)</span>
									<span class="q-oe">Þū sweltan scealt mid feō and mid feorme</span>
									<span class="q-cite"> (Gen. 2659)</span>
								</li>
								<li>
									<span class="q-oe">Hit (land) becwæð sē þe hit āhte swā swā hit his yldran mid feō and mid feore (feorme?) rihte begeāton</span>
									<span class="q-cite"> (Ll. Th. i. 184, 2)</span>
								</li>
								<li>
									<span class="q-en">that he be injured in respect to anything that is his</span>
									<span class="q-oe">Ꝥ hē āðer oþþe feō oþþe feorme (freme, v. l.) þā wyrse sȳ</span>
									<span class="q-cite"> (384, 24)</span>
								</li>
								<li>
									<span class="q-oe">Ǣhta lǣdan, feoh and feorme</span>
									<span class="q-cite"> (Gen. 1650)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">I b.</span>
								<span class="sub-heading">stores furnished to a person as his due</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">he took the provision that was due to him in Wuldaham, and intended to do the same in the other places</span>
									<span class="q-oe">Ðā nam hē his feorme on Wuldahām, and on ðām ōðran wolde</span>
									<span class="q-cite"> (C. D. vi. 127, 21)</span>
								</li>
								<li>
									<span class="q-oe">Þāra mynsterhāma hwelcne þe cyninges feorm tō belimpe</span>
									<span class="q-cite"> (Ll. Th. i. 60, 24)</span>
								</li>
								<li>
									<span class="q-la">de duabus meis nihtfirmis</span>
									<span class="q-oe">Fram twām mīnra (Athelstan's) feorma āgyfe mon āne ambra meles . . .</span>
									<span class="q-cite"> (198, 6)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a feast, an entertainment</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Eallum ǣhtemannum gebyreð Midwintres feorm and Eāstorfeorm</span>
							<span class="q-cite"> (Ll. Th. i. 436, 33)</span>
						</li>
						<li>
							<span class="q-la">cena facta</span>
							<span class="q-oe">Feorma (farma, L.) giworden wæs</span>
							<span class="q-cite"> (Jn. R. 13, 2)</span>
						</li>
						<li>
							<span class="q-la">hora caenae</span>
							<span class="q-oe">Tīd farmes</span>
							<span class="q-cite"> (Lk. L. 14, 17)</span>
						</li>
						<li>
							<span class="q-la">ad agapem</span>
							<span class="q-oe">Tō feorme</span>
							<span class="q-cite"> (An. Ox. 4834)</span>
						</li>
						<li>
							<span class="q-la">convivio</span>
							<span class="q-oe">Æt ānre feorme</span>
							<span class="q-cite"> (Ors. 237, 4)</span>
						</li>
						<li>
							<span class="q-oe">Aman unþances cōm tō þǣre cwēne feorme</span>
							<span class="q-cite"> (Hml. A. 99, 247)</span>
						</li>
						<li>
							<span class="q-la">surgit a cena</span>
							<span class="q-oe">Ārās from ðǣr farma (feorme, R.)</span>
							<span class="q-cite"> (Jn. L. 13, 4)</span>
						</li>
						<li>
							<span class="q-oe">Færma</span>
							<span class="q-cite"> (21, 20)</span>
						</li>
						<li>
							<span class="q-la">cum facis convivium</span>
							<span class="q-oe">Ðonne ðū feorme (forme, v. l.) gierwe on ælmessan</span>
							<span class="q-cite"> (Past. 323, 22)</span>
						</li>
						<li>
							<span class="q-la">magnificis ludis hic natalis annus a Christiano imperatore celebratus est</span>
							<span class="q-oe">Hiē þā miclan feorme þigedon Crīstes þonces þe hiē ǣr þigedon æt hiora diōfolgildum deōfla þonces</span>
							<span class="q-cite"> (Ors. 6, 21; S. 272, 22)</span>
						</li>
						<li>
							<span class="q-oe">Man þǣre sunnan feorme worhte</span>
							<span class="q-cite"> (Hml. Th. ii. 494, 6)</span>
						</li>
						<li>
							<span class="q-la">prandium</span>
							<span class="q-oe">Feorme</span>
							<span class="q-cite"> (Mt. 22, 4)</span>
						</li>
						<li>
							<span class="q-la">cenam</span>
							<span class="q-oe">Fearme</span>
							<span class="q-cite"> (Mk. R. 6, 21)</span>
						</li>
						<li>
							<span class="q-la">convivium</span>
							<span class="q-oe">Farma</span>
							<span class="q-cite"> (Lk. L. 5, 29)</span>
						</li>
						<li>
							<span class="q-la">nubtiae</span>
							<span class="q-oe">Ðā færmo</span>
							<span class="q-cite"> (Mt. L. 22, 10)</span>
						</li>
						<li>
							<span class="q-oe">Hǣmdo ł feorme (færmo, L.)</span>
							<span class="q-cite"> (Jn. R. 2, 1)</span>
						</li>
						<li>
							<span class="q-la">nubtiarum</span>
							<span class="q-oe">Ðāra farmana</span>
							<span class="q-cite"> (Jn. p. 1, 9)</span>
						</li>
						<li>
							<span class="q-oe">Farma</span>
							<span class="q-cite"> (p. 3, 12)</span>
						</li>
						<li>
							<span class="q-la">in cenis</span>
							<span class="q-oe">Æt feormum (farmum, L.)</span>
							<span class="q-cite"> (Mk. R. 12, 39)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">furnishing with food, entertainment</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:flȳman feorm" class="xref-target">flȳman feorm</a>, <a href="x-dictionary:r:cum-feorm" class="xref-target">cum-feorm</a>, <a href="x-dictionary:r:dæg-feorm" class="xref-target">dæg-feorm</a>, <a href="x-dictionary:r:gift-feorm" class="xref-target">gift-feorm</a>, <a href="x-dictionary:r:niht-feorm" class="xref-target">niht-feorm</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="frēfran" d:title="frēfran">
		<body>
			<h1>frēfran<span class="pron"> | freː.frɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To comfort, console</span>
						<span class="meaning-la"> (Lat. consōlāri)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I might find one who would comfort me friendless</span>
							<span class="q-oe">Ic findan meahte ðone ðe mec freōndleāsne frēfran wolde</span>
							<span class="q-cite"> (Exon. 76 b; Th. 288, 9; Wand. 28: Andr. Kmbl. 733; An. 367)</span>
						</li>
						<li>
							<span class="q-en">sometimes I comfort those whom ere I war against</span>
							<span class="q-oe">Hwīlum ic frēfre ða ic ǣr winne on</span>
							<span class="q-cite"> (Exon. 102 b; Th. 389, 13; Rä. 7, 7: 27 b; Th. 82, 19; Cri. 1341)</span>
						</li>
						<li>
							<span class="q-en">they comfort the poor</span>
							<span class="q-oe">Hī earme frēfraþ</span>
							<span class="q-cite"> (33 b; Th. 106, 29; Gū. 48)</span>
						</li>
						<li>
							<span class="q-la">tu me consōlātus es</span>
							<span class="q-oe">Ðu me frēfredest</span>
							<span class="q-cite"> (Ps. Th. 85, 17: Blickl. Homl. 135, 23)</span>
						</li>
						<li>
							<span class="q-la">dixit solito consolantium sermone</span>
							<span class="q-oe">Cwæþ he ðæt gewunalīce word ðara frēfrendra</span>
							<span class="q-cite"> (Bd. 5, 5; S. 681, 9)</span>
						</li>
						<li>
							<span class="q-la">consōlāti</span>
							<span class="q-oe">Frēfrede</span>
							<span class="q-cite"> (Ps. Spl. 125, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-frēfran" class="xref-target">ge-frēfran</a>, <a href="x-dictionary:r:frēfrian" class="xref-target">frēfrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-liden" d:title="for-liden">
		<body>
			<h1>for-liden<span class="pron"> | for.li.den |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">shipwrecked</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:for-līþan" class="xref-target">for-līþan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hwǣm-līce" d:title="ge-hwǣm-līce">
		
		<body>
			<h1>ge-hwǣm-līce<span class="pron"> | je.xwæːm.liː.tʃe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:dæg-gehwǣmlīce" class="xref-target">dæg-gehwǣmlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fricolo" d:title="fricolo">
		<body>
			<h1>fricolo<span class="pron"> | fri.ko.lo |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:friclo" class="xref-target">friclo</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="LǢCE" d:title="LǢCE">
		<body>
			<h1>LǢCE<span class="pron"> | læː.Ke |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:LǢCE-HŪS" class="xref-target">LǢCE-HŪS</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-weorodlǣcan" d:title="ge-weorodlǣcan">
		<body>
			<h1>ge-weorodlǣcan<span class="pron"> | je.we͜o.rod.læː.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to sweeten</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">in labiis suis indulcatur inimicus</span>
							<span class="q-oe">On welerum his byð gewerecilǣhþ feōnd</span>
							<span class="q-cite"> (Scint. 196, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlǣne" d:title="hlǣne">
		<body>
			<h1>hlǣne<span class="pron"> | xlæː.ne |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Hlǣne macer vel macilentus</span>
						<span class="q-cite"> (Wrt. Voc. i. 83, 48)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:þyn-hlǣne" class="xref-target">þyn-hlǣne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stig-fearh" d:title="stig-fearh">
		<body>
			<h1>stig-fearh<span class="pron"> | stiG.fæ͜ɑrx |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a young pig to keep in a sty</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Æhteswāne gebyreþ stīfearh</span>
							<span class="q-cite"> (L. R. S. 7 ; Th. i. 436, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-bryttian" d:title="ge-bryttian">
		<body>
			<h1>ge-bryttian<span class="pron"> | je.bryt.ti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To dispense, expend</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">exibuit</span>
							<span class="q-oe">Gebryttade</span>
							<span class="q-cite"> (Wrt. Voc. ii. 83, 64: 31, 22)</span>
						</li>
						<li>
							<span class="q-la">debemus ei aliquid caritatis impendere</span>
							<span class="q-oe">Wē sculon him gefremman and gebryttian hwylcnehuga dǣl þǣre brōðorlican lufan</span>
							<span class="q-cite"> (Gr. D. 345, 24)</span>
						</li>
						<li>
							<span class="q-la">inpensa</span>
							<span class="q-oe">Gebryttodre</span>
							<span class="q-cite"> (Wrt. Voc. ii. 45, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="west-ende" d:title="west-ende">
		<body>
			<h1>west-ende<span class="pron"> | west.en.de |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Tō ðæs clifes westende</span>
						<span class="q-cite"> (C. D. iii. 419, 6: 449, 14)</span>
					</li>
					<li>
						<span class="q-oe">On ðæs hlincæs wæstændæ</span>
						<span class="q-cite"> (v. 242, 32)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heorþ" d:title="heorþ">
		<body>
			<h1>heorþ<span class="pron"> | xe͜orθ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a hearth, fire place</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Fyrpannae vel herth arula</span>
							<span class="q-cite"> (Txts. 36, 5)</span>
						</li>
						<li>
							<span class="q-oe">Hearth</span>
							<span class="q-cite"> (123, 17)</span>
						</li>
						<li>
							<span class="q-oe">Heort foculare</span>
							<span class="q-cite"> (Wrt. Voc. ii. 39, 38)</span>
						</li>
						<li>
							<span class="q-oe">Īren hiorð arula</span>
							<span class="q-cite"> (10, 21)</span>
						</li>
						<li>
							<span class="q-oe">Heorðe fornacula</span>
							<span class="q-cite"> (log, 7: 35, 77)</span>
						</li>
						<li>
							<span class="q-oe">Wermōd gesodenne on wætere on nīwum cytele, dō of heorðe</span>
							<span class="q-cite"> (Lch. ii. 44, 2)</span>
						</li>
						<li>
							<span class="q-la">assaturam (alimentorum) in focularibus (praeparatam) ad edulium</span>
							<span class="q-oe">Brǣdingce on heorþum tō mōse</span>
							<span class="q-cite"> (An. Ox. 376 : Wrt. Voc. ii. 82, 30)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">as typical of the household or home</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ān mylen . . . and .vii. heorðas būtan ðon, and þreō cyrcan</span>
							<span class="q-cite"> (C. D. v 316, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wīgbed-heorþ" class="xref-target">wīgbed-heorþ</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="beān-cynn" d:title="beān-cynn">
