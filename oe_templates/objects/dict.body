<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="berigeblæ farcille" d:title="berigeblæ farcille">
		<body>
			<h1>berigeblæ farcille<span class="pron"> | be.ri.Ge.blæ, fɑr.Kil.le |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
