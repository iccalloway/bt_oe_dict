<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stānig" d:title="stānig">
		
		<body>
			<h1>stānig<span class="pron"> | stɑː.niG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Stony, rocky</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Of ðan hǣðenan byrgelse on ðone stānigan beorh; of ðan stānigan beorge ōð ða heāfda</span>
							<span class="q-cite"> (Cod. Dip. Kmbl. iii. 454, 2-4)</span>
						</li>
						<li>
							<span class="q-oe">On ðone stānigan weg</span>
							<span class="q-cite"> (vi. 186, 19)</span>
						</li>
						<li>
							<span class="q-oe">On stǣnig lond in petrosa ... on ða stānige lond supra petrosa</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 13, 5, 20)</span>
						</li>
						<li>
							<span class="q-oe">Ðǣr synd swȳðe scearpe wegas and stānige (stānihte, Laud. MS.)</span>
							<span class="q-cite"> (Ors. 1, 1; Bos. 16, 32)</span>
						</li>
						<li>
							<span class="q-oe">Ðeōs wyrt biþ cenned on stānigum stōwum</span>
							<span class="q-cite"> (Lchdm. i. 102, 3)</span>
						</li>
						<li>
							<span class="q-oe">Stǣnigum</span>
							<span class="q-cite"> (212, 9 note: 216, 20 note: 256, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swangettung" d:title="swangettung">
		<body>
			<h1>swangettung<span class="pron"> | swɑn.Get.tung |</span>
			</h1>
			<div>
