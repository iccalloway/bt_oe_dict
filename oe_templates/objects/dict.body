<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þeōd-wita" d:title="þeōd-wita">
		<body>
			<h1>þeōd-wita<span class="pron"> | θe͜oːd.wi.tɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">iurisperitorum</span>
									<span class="q-oe">Rǣdborena ł þeōdwitena</span>
									<span class="q-cite"> (An. Ox. 8, 349)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">II b.</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">philosophi</span>
									<span class="q-oe">Þeodwitan</span>
									<span class="q-cite"> (Scint. 106, 6)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feld-wōp" d:title="feld-wōp">
		<body>
			<h1>feld-wōp<span class="pron"> | feld.woːp |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A peewit (?)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Felduuōp, felduōp bradigabo</span>
							<span class="q-cite"> (Txts. 44, 131)</span>
						</li>
						<li>
							<span class="q-oe">Feldwuōp</span>
							<span class="q-cite"> (Wrt. Voc. ii. 11, 45)</span>
						</li>
						<li>
							<span class="q-oe">Feldwōp bradigatio, ploratio campi</span>
							<span class="q-cite"> (127, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mōd" d:title="mōd">
		<body>
			<h1>mōd<span class="pron"> | moːd |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">servi . . . quodcumque facitis ex animo (heartily, A.V.) operamini, sicut Domino (Col. 2, 23)</span>
						<span class="q-oe">Eālā gē ðeōwan . . . swā hwæt swā gē wyrcað, wyrcað mid mōde, swā swā Gode sylfum</span>
						<span class="q-cite"> (Hml. Th. ii. 336, 23)</span>
					</li>
					<li>
						<span class="q-oe">Ic eōw sumes fyrstes geann ꝥ gē eōw sylfe beþencean and on beteran mōde gebringan</span>
						<span class="q-cite"> (Hml. S. 23, 188)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:ge-mōd" class="xref-target">ge-mōd</a>, <a href="x-dictionary:r:meaht-mōd" class="xref-target">meaht-mōd</a>, <a href="x-dictionary:r:þole-mōd" class="xref-target">þole-mōd</a>, <a href="x-dictionary:r:un-mōd" class="xref-target">un-mōd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hlemman" d:title="hlemman">
		<body>
			<h1>hlemman<span class="pron"> | xlem.mɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To cause to sound, to clash</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">about the prey he clashes his fierce jaws together</span>
							<span class="q-oe">Hē ymbe ða herehūþe hlemmeþ tōgædre grimme gōman</span>
							<span class="q-cite"> (Exon. 97 b; Th. 363, 30; Wal. 61)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hlimman" class="xref-target">hlimman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="feastlice" d:title="feastlice">
		<body>
			<h1>feastlice<span class="pron"> | fæ͜ɑst.li.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Firmly, constantly, stoutly</span>
						<span class="meaning-la"> (Lat. firmiter, constanter)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they stoutly engaged</span>
							<span class="q-oe">Hī feastlīce fēngon</span>
							<span class="q-cite"> (Chr. 1004; Erl. 139, 32: 1008; Erl. 141, 17)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fæstlīce" class="xref-target">fæstlīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cystig-līce" d:title="cystig-līce">
		
