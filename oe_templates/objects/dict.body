<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ciric-þēn" d:title="ciric-þēn">
		<body>
			<h1>ciric-þēn<span class="pron"> | Ki.riK.θeːn |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A church-minister, clergyman</span>
						<span class="meaning-la"> (Lat. ecclesiæ minister, clericus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">let no man turn out a church-minister without the bishop's counsel</span>
							<span class="q-oe">Æ´nig man ciricþēn ne ūtige būton biscopes geþehte</span>
							<span class="q-cite"> (L. Eth. v. 10; Th. i. 306, 29: vi. 15 ; Th. i. 318, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-rȳþre" d:title="ge-rȳþre">
