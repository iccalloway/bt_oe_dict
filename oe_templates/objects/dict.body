<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-endebrednian" d:title="ge-endebrednian">
		<body>
			<h1>ge-endebrednian<span class="pron"> | je.en.de.bred.ni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To set in order</span>
						<span class="meaning-la"> (Lat. ordinare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ordinare</span>
							<span class="q-oe">Ðætte hia geendebrednadon</span>
							<span class="q-cite"> (Lk. Skt. Lind. 1, 1)</span>
						</li>
						<li>
							<span class="q-la">ordinare</span>
							<span class="q-oe">Geendebrednege</span>
							<span class="q-cite"> (Mt. Kmbl. p. 7, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-andwlatod" d:title="-andwlatod">
		<body>
			<h1>-andwlatod<span class="pron"> | ɑnd.wlɑ.tod |</span>
