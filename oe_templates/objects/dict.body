<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīþ-hycgende" d:title="nīþ-hycgende">
		<body>
			<h1>nīþ-hycgende<span class="pron"> | niːθ.xydʒ.dʒen.de |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">having hatred or malice in the heart</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">with hate in their hearts Assyria's warriors they (the Hebrews) hewed, not one did they spare</span>
							<span class="q-oe">Slōgon eornoste Assiria oretmæcgas nīþhycgende nānne ne sparedon</span>
							<span class="q-cite"> (Judth. Thw. 24, 40; Jud. 233)</span>
						</li>
						<li>
							<span class="q-oe">Him (Christ) mid næglum þurhdrifan nīþhycgende ða hwītan honda</span>
							<span class="q-cite"> (Exon. Th. 68, 28; Cri. 1110)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-strengd" d:title="ā-strengd">
		
