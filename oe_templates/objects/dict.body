<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stæl-wyrt" d:title="stæl-wyrt">
		<body>
			<h1>stæl-wyrt<span class="pron"> | stæl.wyrt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Water starwort</span>
						<span class="meaning-la"> (Lat. callitriche)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Stælwyrt callitriche (cf. wæterwyrt callitriche, 67, 18)</span>
							<span class="q-cite"> (Wrt. Voc. i. 68, 15)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Sceāp-īg" d:title="Sceāp-īg">
		<body>
			<h1>Sceāp-īg<span class="pron"> | ʃæ͜ɑːp.iːG |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sheppy ( =Sheep-island, cf. Far-oe, Icel. īær a sheep)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hēr hǣþne men ǣrest on Sceāpīge (-ēge, MS. E. ) ofer winter sǣtun</span>
							<span class="q-cite"> (Chr. 855 ; Erl. 68, 23)</span>
						</li>
						<li>
							<span class="q-oe">Hēr hǣþne men oferhergeadon Sceāpīge</span>
							<span class="q-cite"> (832 ; Ērl. 64, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Rōm-wealh" d:title="Rōm-wealh">
		
