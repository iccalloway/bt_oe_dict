<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="færeld" d:title="færeld">
		<body>
			<h1>færeld<span class="pron"> | fæ.reld |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">membra deliberare non potest</span>
							<span class="q-oe">Ne mæg hē begȳman his lyma færeldes</span>
							<span class="q-cite"> (Chrd. 75, 4)</span>
						</li>
						<li>
							<span class="q-la">simplici habitu incessuque</span>
							<span class="q-oe">Mid heora bilwitton gyrlan and færelde</span>
							<span class="q-cite"> (77, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
