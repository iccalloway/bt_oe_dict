							<span class="q-oe">Gyiltincg prævaricatio</span>
							<span class="q-cite"> (Rtl. 109, 41)</span>
						</li>
						<li>
							<span class="q-oe">Gultingum delictis</span>
							<span class="q-cite"> (66, 29)</span>
