<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sacc" d:title="sacc">
		<body>
			<h1>sacc<span class="pron"> | sɑkk |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">sacros codices in pelliceis sacculis portabat</span>
						<span class="q-oe">Hē lǣdde his hālgan bēc mid him on fellenum saccum (sæccum, v. l.)</span>
						<span class="q-cite"> (Gr. D. 34, 15)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="film" d:title="film">
		<body>
			<h1>film<span class="pron"> | film |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A FILM, skin, husk</span>
						<span class="meaning-la"> (Lat. cuticula)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fylmen" class="xref-target">fylmen</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ǣrest" d:title="ǣrest">
		<body>
			<h1>ǣrest<span class="pron"> | æː.rest |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">first, ERST</span>
						<span class="meaning-la"> (Lat. primus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">primus lapidem mittat</span>
							<span class="q-oe">Weorpe ǣrest stān</span>
							<span class="q-cite"> (Jn. Bos. 8, 7: Cd. 52; Th. 66, 5; Gen. 1079)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ǣr" class="xref-target">ǣr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-wealdan" d:title="ge-wealdan">
		<body>
			<h1>ge-wealdan<span class="pron"> | je.wæ͜ɑl.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -weōld</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -wealden</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To wield, rule, have power over, command, control, cause</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="sub-heading">with gen</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">I rule all the world</span>
									<span class="q-oe">Ic gewealde ealles middaneardes</span>
									<span class="q-cite"> (Homl. Th. ii. 308, 21)</span>
								</li>
								<li>
									<span class="q-en">Gregory ruled the papal see</span>
									<span class="q-oe">Gregorius ðæs pāpan setles geweōld</span>
									<span class="q-cite"> (132, 18)</span>
								</li>
								<li>
									<span class="q-en">except thou make thyself altogether a prince over us</span>
									<span class="q-oe">Būton ðū eāc ūre gewelde</span>
									<span class="q-cite"> (Num. 16, 13)</span>
								</li>
								<li>
									<span class="q-en">if he anywhere have wrongly been the cause of offence to any man, let him diligently make amends; and if any man have much offended him, let him forgive it</span>
									<span class="q-oe">Gif he abilhþe āhwām on unriht āhwār geweōlde gebēte hit georne and gif him abulge ǣnig man swīðe forgife ðæt</span>
									<span class="q-cite"> (L. Pen. 16; Th. ii. 284, 7)</span>
								</li>
								<li>
									<span class="q-en">to wield weapons</span>
									<span class="q-oe">Wǣpna gewealdan</span>
									<span class="q-cite"> (Beo. Th. 3022; B. 1509)</span>
								</li>
								<li>
									<span class="q-en">so she most easily might have complete power over the wretch</span>
									<span class="q-oe">Swā heō ðæs unlǣdan eāðost mihte wel gewealdan</span>
									<span class="q-cite"> (Judth. 10; Thw. 23, 3; Jud. 103)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="sub-heading">with acc</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">he who rules those whom he created</span>
									<span class="q-oe">Se ðe gewylt ða ðe he gesceōp</span>
									<span class="q-cite"> (Homl. Th. ii. 72, 27: Th. Chart. 239, 37)</span>
								</li>
								<li>
									<span class="q-en">who ruled all the world</span>
									<span class="q-oe">Ðe ealne middangeard geweōld</span>
									<span class="q-cite"> (Homl. Th. i. 80, 7)</span>
								</li>
								<li>
									<span class="q-en">holy God controlled victory in battle</span>
									<span class="q-oe">Hālig God geweōld wīgsigor</span>
									<span class="q-cite"> (Beo. Th. 3112; B. 1554)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="sub-heading">with instr</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">now canst thou no longer control the work</span>
									<span class="q-oe">Nū leng ne miht gewealdan ðȳ weorce</span>
									<span class="q-cite"> (Andr. Kmbl. 2729; An. 1367: Exon. 50 b; Th. 175, 24; Gū. 1199)</span>
								</li>
								<li>
									<span class="q-en">the king got command of his senses</span>
									<span class="q-oe">Cyning geweōld his gewitte</span>
									<span class="q-cite"> (Beo. Th. 5399; B. 2703)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="trahtnian" d:title="trahtnian">
		<body>
			<h1>trahtnian<span class="pron"> | trɑxt.ni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="meaning-en">wealth</span>
					</p>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">with prep, to treat of (be. ymbe)</span>
					</p>
					<ol class="sub-senses">
						<li>
							<ul class="quotes">
								<li>
									<span class="q-la">de hoc principio mulli tractaverunt</span>
									<span class="q-oe">Manega trahtuedon ymbe ðis angin</span>
									<span class="q-cite"> (Anglia viii. 307, 7)</span>
								</li>
								<li>
									<span class="q-oe">Mid were ǣwfæstum trahtna (tracta) be hālignysse</span>
									<span class="q-cite"> (Scint. 200, 14)</span>
								</li>
								<li>
									<span class="q-oe">Nū wille wē be ðyssere freōlstīde trahtnian</span>
									<span class="q-cite"> (Homl. Th. i. 104, 9)</span>
								</li>
								<li>
									<span class="q-oe">Wē woldon gefyrn trahtnian be ðam lambe</span>
									<span class="q-cite"> (ii. 278, 11)</span>
								</li>
								<li>
									<span class="q-oe">Nimeþþ gom off þiss þatt her iss trahhtnedd</span>
									<span class="q-cite"> (Orrm. 11680)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-trahtnian" class="xref-target">ā-trahtnian</a>, <a href="x-dictionary:r:ge-trahtnian" class="xref-target">ge-trahtnian</a>, <a href="x-dictionary:r:ofer-trahtnian" class="xref-target">ofer-trahtnian</a>, <a href="x-dictionary:r:trahtian" class="xref-target">trahtian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ellen-þrīst" d:title="ellen-þrīst">
		<body>
			<h1>ellen-þrīst<span class="pron"> | el.len.θriːst |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Bold in courage, bold</span>
						<span class="meaning-la"> (Lat. audax)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the bold women</span>
							<span class="q-oe">Ða idesa ellenþrīste</span>
							<span class="q-cite"> (Judth. 11; Thw. 23, 22; Jud. 133)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-edcenned" d:title="ge-edcenned">
		<body>
			<h1>ge-edcenned<span class="pron"> | je.ed.Ken.ned |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To regenerate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">per illud baptismum, quo uos sacerdos regenerauit</span>
							<span class="q-oe">Þurh þæne fulluht þe se mæssepreōst eōw of geedcende</span>
							<span class="q-cite"> (Ll. Lbmn. 413, 41)</span>
						</li>
						<li>
							<span class="q-la">renatus ex aqua et spiritu</span>
							<span class="q-oe">Geedcenned of wætere and of hāligum gāste</span>
							<span class="q-cite"> (Jn. 3, 5)</span>
						</li>
						<li>
							<span class="q-oe">His gecoren-an beōð geedcennede on fulluhte</span>
							<span class="q-cite"> (Hml. Th. ii. 524, 31)</span>
						</li>
						<li>
							<span class="q-la">renati Sancto Spiritu</span>
							<span class="q-oe">Geedcynnede of þām Hālgan Gāste</span>
							<span class="q-cite"> (Hy. S. 43, 15 : Hml. Th. i. 394, 26: 566, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fram-fær" d:title="fram-fær">
		<body>
			<h1>fram-fær<span class="pron"> | frɑm.fær |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A going away, departure</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se hālga wer wende āweg fram ðǣre stōwe ... se preōst stōd fægnigende ðæs ōðres framfæres</span>
							<span class="q-cite"> (Hml. Th. ii. 164, 3)</span>
						</li>
						<li>
							<span class="q-oe">Ic ðē bebeōde þæt ðū (a dragon) gewīte of ðyssere stōwe, and far tō wēstene ... and þū nānum men on ðīnum framfære ne drece</span>
							<span class="q-cite"> (296, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
