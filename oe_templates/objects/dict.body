<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="drinc-fæt" d:title="drinc-fæt">
		
		
		<body>
			<h1>drinc-fæt<span class="pron"> | drink.fæt |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -fætes, nominative pl: -fatu, accusative pl: -fatu</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A drinking-vessel, cup</span>
						<span class="meaning-la"> (Lat. pōculum, calix)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">their drinking-vessels shall be filled</span>
							<span class="q-oe">Beōþ heora drincfatu gefyldu</span>
							<span class="q-cite"> (Ps. Th. 10, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="rēwet[t]" d:title="rēwet[t]">
		<body>
			<h1>rēwet[t]<span class="pron"> | reː.wet, t |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">rowing</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">quia magnum navigium mihi est ad mare</span>
							<span class="q-oe">Forhwī ne fixast ðu on sǣ? Hwīlon ic dō, ac seldon, forðan micel rēwyt mē ys tō sǣ</span>
							<span class="q-cite"> (Coll. Monast. Th. 24, 3)</span>
						</li>
						<li>
							<span class="q-la">laborantes in remigando</span>
							<span class="q-oe">On rēwette swincende</span>
							<span class="q-cite"> (Mk. Skt. 6, 48)</span>
						</li>
						<li>
							<span class="q-oe">Hī wǣron on rēwute</span>
							<span class="q-cite"> (Homl. Th. i. 162, 10)</span>
						</li>
						<li>
							<span class="q-oe">On ðǣre sǣ swuncon on nihtlīcum rēwette</span>
							<span class="q-cite"> (ii. 384, 25)</span>
						</li>
						<li>
							<span class="q-oe">Gif hwā hreōhnysse on rēwytte þolige</span>
							<span class="q-cite"> (Lchdm. i. 302, 5)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a ship</span>
						<span class="meaning-la"> (Lat. navigium)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nauigii</span>
							<span class="q-oe">Lǣtaþ ðæt nett on ða swīðran healfe ðæs rēwettes</span>
							<span class="q-cite"> (Jn. Skt. 21, 6 : Homl. Th. ii. 290, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣ-wār" d:title="sǣ-wār">
