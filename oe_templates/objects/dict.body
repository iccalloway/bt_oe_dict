<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hyrsudon" d:title="hyrsudon">
		
		<body>
			<h1>hyrsudon<span class="pron"> | xyr.su.don |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To go on horseback (?)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ut undique ad eius mini-sterium de cunctis prope prouinciis uiri nobilissimi concurrerent</span>
							<span class="q-oe">Æghwanon hyrsudon of eallum þissum bīfylcum tō his folgōðe and tō his þēnunge ðā æþelestan menn</span>
							<span class="q-cite"> (Bd. 3, 14 ; Sch. 256, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hors" class="xref-target">hors</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fȳrenfull" d:title="fȳrenfull">
