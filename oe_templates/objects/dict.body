<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-befohten" d:title="un-befohten">
		<body>
			<h1>un-befohten<span class="pron"> | un.be.fox.ten |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unfought, unopposed</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā wēnde se here ... ðæt hiē mehten faran unbefohtene ðǣr ðǣr hiē wolden</span>
							<span class="q-cite"> (Chr. 911; Erl. 100, 23: Byrht. Th. 133, 28; By. 57)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æ-blēc" d:title="æ-blēc">
		<body>
			<h1>æ-blēc<span class="pron"> | æ.bleːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Pale, wan, whitish, bleak</span>
						<span class="meaning-la"> (Lat. pallidus)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:blǣc" class="xref-target">blǣc</a>, <a href="x-dictionary:r:blāc" class="xref-target">blāc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hū-ilpa" d:title="hū-ilpa">
		<body>
			<h1>hū-ilpa<span class="pron"> | xuː.il.pɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The name of a bird so called from its note</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Dyde ic mē tō gomene ganetes hleōþor and huilpan swēg</span>
							<span class="q-cite"> (Exon. 81 b; Th. 307, 9; Seef. 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="burna" d:title="burna">
		<body>
			<h1>burna<span class="pron"> | bur.nɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A stream, bourn</span>
						<span class="meaning-la"> (Lat. torrens, latex)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Burna oððe brōc latex</span>
							<span class="q-cite"> (Wrt. Voc. 80, 69)</span>
						</li>
						<li>
							<span class="q-en">the clear stream is disturbed: the brook is turned aside</span>
							<span class="q-oe">Scīr burna biþ gedrēfed: brōc biþ onwended.</span>
							<span class="q-cite"> (Bt. Met. Fox 5, 37; Met. 5, 19)</span>
						</li>
						<li>
							<span class="q-en">he bathes himself in the stream</span>
							<span class="q-oe">He hine bibaðaþ in ðam burnan</span>
							<span class="q-cite"> (Exon. 57b; Th. 205, 3; Ph. 107)</span>
						</li>
						<li>
							<span class="q-oe">Burna latex</span>
							<span class="q-cite"> (Wrt. Voc. 54, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:burn" class="xref-target">burn</a>, <a href="x-dictionary:r:burne" class="xref-target">burne</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brēmel-rind" d:title="brēmel-rind">
		<body>
			<h1>brēmel-rind<span class="pron"> | breː.mel.rind |</span>
