	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Wiht" d:title="Wiht">
		
		<body>
			<h1>Wiht<span class="pron"> | wixt |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">the Isle of Wight</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Seō mǣiđ đe nū eardaþ on Wiht</span>
							<span class="q-cite"> (Chr. 449; Th. i. 20, col. I: Cod. Dip. Kmbl. iii. 431, 16, 24: v. 82, 19: vi. 196, 8)</span>
						</li>
						<li>
							<span class="q-oe">Cāmon sex scipu tō Wiht</span>
							<span class="q-cite"> (Chr. 897 ; Th. i. 176, 7)</span>
						</li>
						<li>
							<span class="q-oe">Into Wiht (Wihtlande, v.ll.)</span>
							<span class="q-cite"> (1006; Th. i. 257, col. 2)</span>
						</li>
						<li>
							<span class="q-oe">Tō Wiht (Wihtlande, v. l.)</span>
							<span class="q-cite"> (1022; Th. i. 286, col. I)</span>
						</li>
						<li>
							<span class="q-oe">On Wihtlande</span>
							<span class="q-cite"> (998 ; Th. i. 246, 24)</span>
						</li>
						<li>
							<span class="q-oe">Intō Wihtlande</span>
							<span class="q-cite"> (1001 ; Th. i. 250, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hē on Wiht gehergade</span>
							<span class="q-cite"> (661 ; Th. i. 54, 24)</span>
						</li>
						<li>
							<span class="q-oe">Hiē Wieht (Wiht, v. l. ) forhergedon</span>
							<span class="q-cite"> (681; Th. i. 62, col. I)</span>
						</li>
						<li>
							<span class="q-oe">Hēr Cerdic and Cynrīc genāmon Wihte eālond (Wihtland, Wiht đæt eāland, v. ll.)</span>
							<span class="q-cite"> (530; Th. i. 26, 33)</span>
						</li>
						<li>
							<span class="q-oe">Hiē sealdon hiera nefum Wiht eāland (Wihte eāland, Wiht đæt ēgland, Wihtland, v. ll.)</span>
							<span class="q-cite"> (534 ; Th. i. 28, col. I)</span>
						</li>
						<li>
							<span class="q-la">Vectae insulae</span>
							<span class="q-oe">Ymbe Wiht đæt īgland (Wiht-land, v. l.)</span>
							<span class="q-cite"> (Bd. pref. ; S. 472, 14)</span>
						</li>
						<li>
							<span class="q-la">gens quae Vectam tenet insulam</span>
							<span class="q-oe">Seō đeōd đe Wiht đæt eālond (Wihtland, v. l.) oneardaþ</span>
							<span class="q-cite"> (I. 15; S. 483, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ymbsealde" d:title="ymbsealde">
		<body>
			<h1>ymbsealde<span class="pron"> | ymb.sæ͜ɑl.de |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">urbs absque murorum ambitu</span>
							<span class="q-oe">Byrig ðære ðe mid nāne wealle ne bið ymbworht</span>
							<span class="q-cite"> (Past. 38; Swt. 277, 21)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to weave</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">plectentes coronam</span>
							<span class="q-oe">Ymbworhton bēge</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 27, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ymb-sellan" class="xref-target">ymb-sellan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ān-lǣcung" d:title="ān-lǣcung">
		
		<body>
			<h1>ān-lǣcung<span class="pron"> | ɑːn.læː.kung |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ō-lǣcung" class="xref-target">ō-lǣcung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="flȳming" d:title="flȳming">
		<body>
			<h1>flȳming<span class="pron"> | flyː.ming |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fugitive, runaway, exile</span>
						<span class="meaning-la"> (Lat. profugus, fugitivus, exul)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fleānning" class="xref-target">fleānning</a>, <a href="x-dictionary:r:flȳma" class="xref-target">flȳma</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sam" d:title="sam">
		<body>
			<h1>sam<span class="pron"> | sɑm |</span>
			</h1>
			<div>
				<p>
					<b>conjunction</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">sam . . . sam</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sam (tam) gebrōþrum, sam (quam) eallum geleāffullum</span>
									<span class="q-cite"> (Angl. xiii. 414, 706)</span>
								</li>
								<li>
									<span class="q-la">siue manducatis, siue bibitis, siue aliud quid facietis</span>
									<span class="q-oe">Sam gē etan, sam gē drincan, sam gē āht elles gedōn</span>
									<span class="q-cite"> (Scint. 169, 12)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">sam þe . . . sam þe</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">siue servus, siue liber</span>
									<span class="q-oe">Sam þe þeōw, sam þe frig</span>
									<span class="q-cite"> (Scint. 189, 14: 226, 13)</span>
								</li>
								<li>
									<span class="q-la">tam a predicto patre, quam a sequacibus suis</span>
									<span class="q-oe">Sam þe fram þām foresǣdon fæder, sam þe fram æfterfyligendum hys</span>
									<span class="q-cite"> (Angl. xiii. 375, 140: 377, 176)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2 a)</span>
								<span class="sub-heading">sam þe . . . sam</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">tam sibi, quam successoribus suis</span>
									<span class="q-oe">Sam þe him sylfum, sam æftergencgum hyra</span>
									<span class="q-cite"> (Angl. xiii. 447, 1176)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="GE-TIMBRU" d:title="GE-TIMBRU">
