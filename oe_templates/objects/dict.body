			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a field</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:feld" class="xref-target">feld</a>
			</p>
		</body>
