<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wōdnes-dæg" d:title="wōdnes-dæg">
		<body>
			<h1>wōdnes-dæg<span class="pron"> | woːd.nes.dæj |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Wednesday</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wōdnesdæges nama wæs of Mercurio</span>
							<span class="q-cite"> (Anglia viii. 321, 16)</span>
						</li>
						<li>
							<span class="q-oe">On Wōdnesdæg</span>
							<span class="q-cite"> (Mt. Kmbl. Rubric 3, I. 13 ared often; Homl. Skt. i. 12, I : R. Ben. 155, 16: Wulfst. 180, 25)</span>
						</li>
						<li>
							<span class="q-oe">On ðone ōðerne Wōdnesdæg ofer Pentecosten</span>
							<span class="q-cite"> (Mt. Kmbl. Rubric 5, 17)</span>
						</li>
						<li>
							<span class="q-oe">.iiii. Wodnesdagas on .iiii. Ymbrenwican</span>
							<span class="q-cite"> (L. Alf. pol. 43; Th. i. 92, 8)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="trūwian" d:title="trūwian">
		<body>
			<h1>trūwian<span class="pron"> | truː.wi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To trust, confide</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic trūwige fido . . . , ic trūwige confido, ic trūwode confisus sum</span>
							<span class="q-cite"> (Ælfc. Gr. 33 Zup. 204, 14-16)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="sub-heading">with dat., to trust to</span>
								<span class="meaning-en">with dat., to trust to</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">dum protervi valde de se praesumunt</span>
									<span class="q-oe">Ðonne ða fortrūwodan him selfum tō suīðe trūwiaþ</span>
									<span class="q-cite"> (Past. 32; Swt. 209, 6)</span>
								</li>
								<li>
									<span class="q-oe">Ða ðe hyra weorcum trūwiaþ</span>
									<span class="q-cite"> (Exon. Th. 52, 24; Cri. 838)</span>
								</li>
								<li>
									<span class="q-oe">Ðā ðā ic him betst trūwode</span>
									<span class="q-cite"> (Bt. 2 ; Fox 4, 12 : Beo. Th. 3991; B. 1993)</span>
								</li>
								<li>
									<span class="q-la">sperare in incerto divitiarum suarum</span>
									<span class="q-oe">Secgaþ ðǣm welegum, ðæt hī tō wel ne trūwigen ðissum ungewissum welum</span>
									<span class="q-cite"> (Past. 26; Swt. 181, 15)</span>
								</li>
								<li>
									<span class="q-oe">Heō ongan his wordum trūwian</span>
									<span class="q-cite"> (Cd. Th. 40, 35; Gen. 649)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(I a.)</span>
										<span class="meaning-en">to trust something to a person</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Se Hǣlend ne trūgude hine sealfne him</span>
											<span class="q-cite"> (Jn. Skt. Lind. 2, 24)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(I b.)</span>
										<span class="meaning-en">to trust to a person for something (clause with ðæt)</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hygd bearne ne trūwode, ðæt hē wið ælfylcum ēþelstōlas healdan cūde</span>
											<span class="q-cite"> (Beo. Th. 4370; B. 2370)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="sub-heading">with gen. to trust in</span>
								<span class="meaning-en">with gen. to trust in</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Geāta leōd trūwode mōdgan mægnes</span>
									<span class="q-cite"> (Beo. Th. 1343; B. 669)</span>
								</li>
								<li>
									<span class="q-oe">Hē his wīsna trūwade, drohtes on ðære ādle</span>
									<span class="q-cite"> (Exon. Th. 171, 30; Gū. 1134)</span>
								</li>
								<li>
									<span class="q-la">qua mente utilitati ceterorum secretum praeponit suum</span>
									<span class="q-oe">Hwȳ hiē ðara geearnunga hiora dīgelnesse (and diēgelnesse, Hatt. MS. ) and incite bet truwien donne ðære hū hiē ōðerra monna mǣst gehelpen</span>
									<span class="q-cite"> (Past. 5 ; Swt. 46, 2)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(II a.)</span>
										<span class="meaning-en">with gen. and clause</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">he did not trust in resistance, that he should be able to repel the seamen</span>
											<span class="q-oe">Hē wiðres ne trūwode ðæt hē sǣmannum onsacan mihte</span>
											<span class="q-cite"> (Beo. Th. 5899; B. 2953)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="sub-heading">with prepositions (be, on, tó)</span>
								<span class="meaning-en">with prepositions (be, on, tō), to be confident about, trust in, on, or to</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">qui confidunt in eis</span>
									<span class="q-oe">Ða ðe trūwiaþ on him</span>
									<span class="q-cite"> (Ps. Spl. 134, 18)</span>
								</li>
								<li>
									<span class="q-la">universa arma in quibus confidebat</span>
									<span class="q-oe">Ealle his wǣpnu ðe hē on trūwude</span>
									<span class="q-cite"> (Lk. Skt. 11. 22)</span>
								</li>
								<li>
									<span class="q-oe">Ða burhware trūwodon tō ðam wealle</span>
									<span class="q-cite"> (Homl. Skt. ii. 25, 446)</span>
								</li>
								<li>
									<span class="q-oe">Trūa on Crist</span>
									<span class="q-cite"> (Homl. Th. ii. 392, 34)</span>
								</li>
								<li>
									<span class="q-en">that none of us be overconfident about himself</span>
									<span class="q-oe">Ðæt ūre nān be him sylfum tō dyrstelīce ne trūwige</span>
									<span class="q-cite"> (82, 26)</span>
								</li>
								<li>
									<span class="q-oe">Ne trūwige nān man be ælmesdǣdum oððe on gebedum, būtan ðære foresǣdan lufe</span>
									<span class="q-cite"> (i. 54, 11)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">IV.</span>
								<span class="sub-heading">with a clause</span>
								<span class="meaning-en">with a clause, to trust that</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ic trūwige, ðeāh, ðæt sum wurðe ābrird þurh God</span>
									<span class="q-cite"> (L. Ælfc. P. 3; Th. ii. 364, 17)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:for-trūwian" class="xref-target">for-trūwian</a>, <a href="x-dictionary:r:ge-trūwian" class="xref-target">ge-trūwian</a>, <a href="x-dictionary:r:or-trūwian" class="xref-target">or-trūwian</a>, <a href="x-dictionary:r:ofer-trūwod" class="xref-target">ofer-trūwod</a>, <a href="x-dictionary:r:treōwian" class="xref-target">treōwian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ēhtan" d:title="ēhtan">
		<body>
			<h1>ēhtan<span class="pron"> | eːx.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">tribŭlantium me</span>
						<span class="q-oe">Ðara ðe mīn ēhtaþ</span>
						<span class="q-cite"> (Ps. Th. 26, 14: 118, 157)</span>
					</li>
					<li>
						<span class="q-la">libĕrasti nos ex affligentĭbus nos</span>
						<span class="q-oe">Ðū us ahreddest æt ðām ðe ūre ēhton</span>
						<span class="q-cite"> (Ps. Th. 43, 9)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:eāhtan" class="xref-target">eāhtan</a>, <a href="x-dictionary:r:ōht" class="xref-target">ōht</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-cneōrednis" d:title="ge-cneōrednis">
		<body>
			<h1>ge-cneōrednis<span class="pron"> | je.kne͜oː.red.nis |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Genealogy</span>
						<span class="meaning-la"> (Lat. genealogia)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣlan" d:title="sǣlan">
		<body>
			<h1>sǣlan<span class="pron"> | sæː.lɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -de</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To happen, betide, fortune (e. g. in Spenser)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif hiē ærfeweard ne gestriōnen, oðða him sylfum ælles hwæt sǣle . . . Gif him elles hwæt sǣleþ</span>
							<span class="q-cite"> (Chart. Th. 471, 30-472, 1)</span>
						</li>
						<li>
							<span class="q-en">happen what might to us in those troubles</span>
							<span class="q-oe">Sǣlde unc on þām brocum swā unc gesǣlde (sǣlde, Kmbl.)</span>
							<span class="q-cite"> (485, 23)</span>
						</li>
						<li>
							<span class="q-en">how it may happen to thee, what your success may be</span>
							<span class="q-oe">Hū ðē sǣle</span>
							<span class="q-cite"> (Andr. Kmbl. 2710; An. 1357)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-sǣlan" class="xref-target">ge-sǣlan</a>, <a href="x-dictionary:r:tō-sǣlan" class="xref-target">tō-sǣlan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þorfend" d:title="þorfend">
		<body>
			<h1>þorfend<span class="pron"> | θor.fend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A needy person, a poor person</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wæs sum ðærfe ł ðo[r]fond (mendicus) ... wæs deād se ðorfendo (mendicus)</span>
							<span class="q-cite"> (Lk. Skt. Lind. 16, 20, 22)</span>
						</li>
						<li>
							<span class="q-la">super egenum et pauperem</span>
							<span class="q-oe">Ofer armne and ðorfend</span>
							<span class="q-cite"> (Rtl. 175, 33)</span>
						</li>
						<li>
							<span class="q-oe">Ðorfendo pauperes</span>
							<span class="q-cite"> (Mk. Skt. Lind. 14, 7)</span>
						</li>
						<li>
							<span class="q-oe">Eādgo ða ðorfendo beati pauperes</span>
							<span class="q-cite"> (Lk. Skt. Lind. 6, 20)</span>
						</li>
						<li>
							<span class="q-oe">Ic sello ðorfendum do pauperibus</span>
							<span class="q-cite"> (19, 8: Mk. Skt. Lind. Rush. 14, 5)</span>
						</li>
						<li>
							<span class="q-oe">Ðorfendum ł næfigum (ðarfendum, Rush.) egenis</span>
							<span class="q-cite"> (Jn. Skt. Lind. 12, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A needy person, a poor person</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:þearfende" class="xref-target">þearfende</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gegendan" d:title="gegendan">
		<body>
			<h1>gegendan<span class="pron"> | Ge.Gen.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">arsantes</span>
						<span class="q-oe">Ðā gegendan (gengendan ?) arsantes</span>
						<span class="q-cite"> (Wrt. Voc. ii. 9, 51)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="niþer-dǣl" d:title="niþer-dǣl">
		<body>
			<h1>niþer-dǣl<span class="pron"> | ni.θer.dæːl |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A lower part</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">in inferioribus terrae</span>
							<span class="q-oe">On niþerdǣlum eorþan</span>
							<span class="q-cite"> (Ps. Th. 138, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wīf-Þegen" d:title="wīf-Þegen">
		<body>
			<h1>wīf-Þegen<span class="pron"> | wiːf.θe.Gen |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A pander</span>
						<span class="meaning-la"> (Lat. leno)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="styrian" d:title="styrian">
		<body>
			<h1>styrian<span class="pron"> | sty.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="sub-heading">of non-material objects</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Swā styrigende is seō sāwul ꝥ heō furðon on slǣpe ne gestylþ</span>
									<span class="q-cite"> (Hml. S. 1, 131)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(2)</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">the object a person</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ne lēten hiē nō hiē on ǣlce healfe gebīgean, ne furðum nō āwecggan, ðeāh ðe hiē mon manigfealdlīce and mislīce styrede</span>
											<span class="q-cite"> (Past. 306, 5)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">the object a thing, feeling, passion, &amp;c.</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hiē styrigad geflitu and geciid</span>
											<span class="q-cite"> (Past. 293, 20)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:in-styrian" class="xref-target">in-styrian</a>, <a href="x-dictionary:r:un-styri(g)ende" class="xref-target">un-styri(g)ende</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gafol-gylda" d:title="gafol-gylda">
		
		
		
		<body>
			<h1>gafol-gylda<span class="pron"> | gɑ.fol.Gyl.dɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a tribute-payer, tributary, debtor</span>
						<span class="meaning-la"> (Lat. tributi redditor, debitor)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the Romans made them tributaries</span>
							<span class="q-oe">Rōmāne hȳ to gafol-gyldum gedydon</span>
							<span class="q-cite"> (Ors. 3, 8; Bos. 63, 38 : Bd. 2, 5; S. 506, 20)</span>
						</li>
						<li>
							<span class="q-la">cunctus populus salvabitur et serviet tibi sub tributo</span>
							<span class="q-oe">Beōn hig ealle gesunde and þeōwion ðē and beōn ðīne gafolgildan</span>
							<span class="q-cite"> (Deut. 20, 11)</span>
						</li>
						<li>
							<span class="q-la">duo debitores erant cuidam faeneratori</span>
							<span class="q-oe">Twegen gafolgyldan wǣron sumum lǣnende</span>
							<span class="q-cite"> (Lk. Bos. 7, 41 : 16, 5)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a rent-payer, a renter of land as opposed to the owner</span>
						<span class="meaning-la"> (Lat. qui censum annum pendit, conductor)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wealh gafolgelda [gafolgylda MSS. B. H.] a foreign [i.e. of British race] tenant</span>
							<span class="q-cite"> (L. In. 23; Th. i. 118, 3)</span>
						</li>
						<li>
							<span class="q-en">if he fight in a tenant's house, let him pay cxx shillings as fine</span>
							<span class="q-oe">Gif he on gafolgeldan [gafolgildan MS. H.] hūse gefeohte, cxx scillinga to wīte geselle</span>
							<span class="q-cite"> (6; Th. i. 106, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-gehāwian" d:title="ge-gehāwian">
		<body>
			<h1>ge-gehāwian<span class="pron"> | je.Ge.xɑː.wi.ɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hāwian" class="xref-target">ge-hāwian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sceand-līc" d:title="sceand-līc">
		<body>
			<h1>sceand-līc<span class="pron"> | ʃæ͜ɑnd.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">of persons, that acts in a disgraceful way, infamous, base, vile</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">On ānre tīde twā mǣdencild cumaþ, and biþ ðæt ān sydefull and ðæt ōðer sceandlīc</span>
							<span class="q-cite"> (Homl. Skt. i. 5, 280)</span>
						</li>
						<li>
							<span class="q-oe">Hierusalem winþ for rihtwīsnysse, and Babilonia winþ ongeān for unrihtwīsnysse ... Ðære heofonlīcan Hierusalem cyning is Crist, ðære scandlīcan Babilonian cyning is deōfol</span>
							<span class="q-cite"> (Homl. Th. ii. 66, 32)</span>
						</li>
						<li>
							<span class="q-oe">Ðā com ðæs gerēfan suna mid his sceandlīcum gegadum</span>
							<span class="q-cite"> (Homl. Skt. i. 7, 164)</span>
						</li>
						<li>
							<span class="q-oe">God sende tō ðām sceandlīcum mannum (the people of Sodom) twegen englas</span>
							<span class="q-cite"> (13, 207)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of things</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(a)</span>
								<span class="sub-heading">that is vile in its nature or circumstances, disgraceful, foul, shameful, obscene</span>
								<span class="meaning-en">that is vile in its nature or circumstances, disgraceful, foul, shameful, obscene</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">rldiculosum opprobrium</span>
									<span class="q-oe">Scandlīc hosp</span>
									<span class="q-cite"> (Hpt. Gl. 524, 73)</span>
								</li>
								<li>
									<span class="q-oe">Gif hit ǣr sceondlīc wæs, ne biþ hit nō ðȳ fægerre</span>
									<span class="q-cite"> (Bt. 14, 3 ; Fox 46, 16)</span>
								</li>
								<li>
									<span class="q-oe">Seō gesceādwīsnes; nis ðæt scandlīc cræft, forðæm hit nǣnig hafaþ neāt būton monnum</span>
									<span class="q-cite"> (Met. 20, 188)</span>
								</li>
								<li>
									<span class="q-la">spurcae obscoenitatis</span>
									<span class="q-oe">Scandlīcre fūlnesse</span>
									<span class="q-cite"> (Hpt. Gl. 447, 19)</span>
								</li>
								<li>
									<span class="q-la">ex turpi cogitatione</span>
									<span class="q-oe">Of scondlīcum geþohte</span>
									<span class="q-cite"> (Bd. 1, 27 ; S. 497, 5)</span>
								</li>
								<li>
									<span class="q-en">with foul lust</span>
									<span class="q-oe">Mid sceandlīcum willan</span>
									<span class="q-cite"> (Homl. Skt. i. 7, 170)</span>
								</li>
								<li>
									<span class="q-la">miserando turpissimoque exitu</span>
									<span class="q-oe">Ðīn mōdor gewīteþ of weorulde þurh scondlīcne deāð and unārlīcne</span>
									<span class="q-cite"> (Nar. 31, 29)</span>
								</li>
								<li>
									<span class="q-oe">Ǣlc ōðerne æftan heāweþ mid scandlīcan onscytan</span>
									<span class="q-cite"> (Wulfst. 160, 5)</span>
								</li>
								<li>
									<span class="q-oe">Hē sang scandlīcu leōþ, and plegode scandlīce plegan</span>
									<span class="q-cite"> (Shrn. 121, 10)</span>
								</li>
								<li>
									<span class="q-la">corruptibilibus</span>
									<span class="q-oe">Sceondlīcum</span>
									<span class="q-cite"> (Rtl. 24, 36)</span>
								</li>
								<li>
									<span class="q-la">nec mihi nunc enumerare opus est Tantali et Pelopisfacta turpia, fabulas iurpiores</span>
									<span class="q-oe">Ic wille geswigian Tontolis and Pilopes ðara scondlīcestena spella</span>
									<span class="q-cite"> (Ors. 1, 8 ; Swt. 42, 8)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(b)</span>
								<span class="sub-heading">that causes shame, disgraceful</span>
								<span class="meaning-en">that causes shame, disgraceful</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">pudet erroris humani</span>
									<span class="q-oe">Hit is scondlīc ymb swelc tō sprecanne hwelc hit ðā wæs</span>
									<span class="q-cite"> (l, 10; Swt. 48, 4)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wuldor-helm" d:title="wuldor-helm">
		<body>
			<h1>wuldor-helm<span class="pron"> | wul.dor.xelm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A crown</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Mōyses onfēng scīnendum wuldor-helme</span>
							<span class="q-cite"> (Blickl. Homl. 49, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dǣl-nimung" d:title="dǣl-nimung">
		<body>
			<h1>dǣl-nimung<span class="pron"> | dæːl.ni.mung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">participation</span>
						<span class="meaning-la"> (Lat. participatio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">a caritatis participatione</span>
							<span class="q-oe">Fram sōþre lufe dǣlnimincge</span>
							<span class="q-cite"> (Scint. 6, 7)</span>
						</li>
						<li>
							<span class="q-oe">Daelneomencge</span>
							<span class="q-cite"> (C. D. i. 114, 24)</span>
						</li>
						<li>
							<span class="q-la">a mense participatione</span>
							<span class="q-oe">Fram beōde dǣlnimunge</span>
							<span class="q-cite"> (R. Ben. I. 56, 8; 77, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gliew-mēden" d:title="gliew-mēden">
		<body>
			<h1>gliew-mēden<span class="pron"> | gli͜yw.meː.den |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A glee-maiden, female musician</span>
						<span class="meaning-la"> (Lat. tympanistria)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-sæpig" d:title="un-sæpig">
		<body>
			<h1>un-sæpig<span class="pron"> | un.sæ.piG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Not sappy, sapless</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Treōwa gif hī beōð on fullum mōnan geheāwene, hī beōð heardran tō getimbrunge, and swīðost gif hī beōð unsæpige geworhte</span>
							<span class="q-cite"> (Homl. Th. i. 102, 24)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōran" d:title="fōran">
		
		<body>
			<h1>fōran<span class="pron"> | foː.rɑn |</span>
			</h1>
			<div>
				<p>
					<b>preposition</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">Before</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Eādsige foran eallum folce hine lǣrde</span>
							<span class="q-cite"> (Chr. 1043 ; P. 163, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">alone</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">marking position, in front</span>
										<span class="meaning-en">marking position, in front</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hiē fortendun þæt swīðre breōst foran</span>
											<span class="q-cite"> (Ors. i. 10; S. 46, 12: Rü. 45, 2)</span>
										</li>
										<li>
											<span class="q-en">he that in front guides the bridle</span>
											<span class="q-oe">Sē þe foran lǣdeð brīdels</span>
											<span class="q-cite"> (El. 1184)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">in front of that which is defended</span>
										<span class="meaning-en">in front of that which is defended</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">he stood in front and defended him</span>
											<span class="q-oe">Hē hiene foran forstōd</span>
											<span class="q-cite"> (Ors. 4, 8; S. 186, 25)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(c)</span>
										<span class="sub-heading">in front of that which is obstructed or interfered with</span>
										<span class="meaning-en">in front of that which is obstructed or interfered with</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">they slew the men whose retreat they could cut</span>
											<span class="q-oe">Hī þā men ofslōgon þe hiē foran forrīdan mehton būtan geweorce</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wundon" d:title="wundon">
		<body>
			<h1>wundon<span class="pron"> | wun.don |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">wound or bound round</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:be-windan" class="xref-target">be-windan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="FǢR" d:title="FǢR">
		<body>
			<h1>FǢR<span class="pron"> | fæːr |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:FǢRINGA" class="xref-target">FǢRINGA</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dæg-cūþ" d:title="dæg-cūþ">
		<body>
			<h1>dæg-cūþ<span class="pron"> | dæj.kuːθ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Clear as daylight, perfectly known</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">nec lateat quidquam culparum cordis in antro, omnia quin luci verbis reddantur apertis</span>
							<span class="q-oe">Ne þǣr ōwiht inne ne belīfe on heortscræfe heānra gylta, ꝥ hit ne sȳ dægcūð, ꝥ ꝥ dīhle wæs, openum wordum eall ābæred</span>
							<span class="q-cite"> (Dōm. L. 40)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="under-þeōdendlīc" d:title="under-þeōdendlīc">
		<body>
			<h1>under-þeōdendlīc<span class="pron"> | un.der.θe͜oː.dend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Subjecting, subordinating</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sideware" d:title="sideware">
		<body>
			<h1>sideware<span class="pron"> | si.de.wɑ.re |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Zedoary</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nim sidewaran</span>
							<span class="q-cite"> (Lchdm. iii. 10, 30)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weg-līsu" d:title="weg-līsu">
		<body>
			<h1>weg-līsu<span class="pron"> | wej.liː.su |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Want of road</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Welise ( = wīlēsu?) devium</span>
							<span class="q-cite"> (Kent. Gl. 432)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gūþ-spell" d:title="gūþ-spell">
		<body>
			<h1>gūþ-spell<span class="pron"> | guːθ.spell |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">War-tidings</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-welgian" d:title="ge-welgian">
		<body>
			<h1>ge-welgian<span class="pron"> | je.wel.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">donat</span>
							<span class="q-oe">Gewelegade</span>
							<span class="q-cite"> (Wrt. Voc. ii. 141, 72)</span>
						</li>
						<li>
							<span class="q-la">a predito</span>
							<span class="q-oe">Gewelegodum</span>
							<span class="q-cite"> (2, 3)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">to become rich</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">becomes enriched with glory, becomes glorious</span>
									<span class="q-oe">Ellenrōf ūp āstondeð, þrymme gewelgað</span>
									<span class="q-cite"> (Pa. 41)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">to make rich</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">of material wealth</span>
									</p>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(a)</span>
												<span class="meaning-en">the object a person</span>
											</p>
											<ol class="sub-senses labeled">
												<li>
													<p>
														<span class="sense-label">(α)</span>
														<span class="meaning-en">to bestow wealth on another</span>
													</p>
													<ul class="quotes">
														<li>
															<span class="q-la">ut ditem (diligentes me)</span>
															<span class="q-oe">Ðet ic geweolegie</span>
															<span class="q-cite"> (Kent. Gl. 252)</span>
														</li>
														<li>
															<span class="q-oe">God ne hēt ūs gewelgian þā hæbbendan</span>
															<span class="q-cite"> (Wlfst. 287, 24)</span>
														</li>
													</ul>
												</li>
												<li>
													<p>
														<span class="sense-label">(β)</span>
														<span class="meaning-en">to make oneself rich</span>
													</p>
													<ul class="quotes">
														<li>
															<span class="q-oe">Gif hē beō gewelegod tō þām ꝥ (gif hē geþeō ꝥ, v. l.) hē āge .v. hȳda landes</span>
															<span class="q-cite"> (Ll. Th. i. 188, 19: 186, 18)</span>
														</li>
														<li>
															<span class="q-la">non ditabitur</span>
															<span class="q-oe">Ne bið geweolegad</span>
															<span class="q-cite"> (Kent. Gl. 789)</span>
														</li>
														<li>
															<span class="q-la">ut diteris</span>
															<span class="q-oe">ꝥ ðū siō geweolugad</span>
															<span class="q-cite"> (861)</span>
														</li>
													</ul>
												</li>
												<li>
													<p>
														<span class="sense-label">(γ)</span>
														<span class="meaning-en">the subject the material wealth</span>
													</p>
													<ul class="quotes">
														<li>
															<span class="q-oe">Þā welan þisses middangeardes nānne mon geweligian ne magon</span>
															<span class="q-cite"> (Bt. 13; F. 38, 37)</span>
														</li>
													</ul>
												</li>
											</ol>
										</li>
										<li>
											<p>
												<span class="sense-label">(b)</span>
												<span class="meaning-en">the object a thing</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-la">terram locupletare</span>
													<span class="q-oe">Eorðan geweolgian</span>
													<span class="q-cite"> (Ps. Srt. 64, 10)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">of non-material wealth</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Þū us gewelegodest mid þīnum tōcyme</span>
											<span class="q-cite"> (Bl. H. 89, 32)</span>
										</li>
										<li>
											<span class="q-la">infinitis remuneratore prodigiis donatur</span>
											<span class="q-oe">Ungeendedum edleāni[ende] forebeācnum wæs gewelgod</span>
											<span class="q-cite"> (An. Ox. 2551)</span>
										</li>
										<li>
											<span class="q-la">prosperabantur</span>
											<span class="q-oe">Gewelgode</span>
											<span class="q-cite"> (3630)</span>
										</li>
										<li>
											<span class="q-oe">Þā sāwla þe beōð gewelgode mid gōōdum geearnuncgum</span>
											<span class="q-cite"> (Ps. Th. 44, 13)</span>
										</li>
										<li>
											<span class="q-la">a sacerdotibus mira veritate et simplicitate praeditis</span>
											<span class="q-oe">Æt þām sācerdum ..., þā wǣron geweolgade (-welgode, v. l.) mid wundorlicre sōðfæstnesse and bilwitnesse</span>
											<span class="q-cite"> (Gr. D. 250, 6)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="earwunga" d:title="earwunga">
		
		<body>
			<h1>earwunga<span class="pron"> | æ͜ɑr.wun.gɑ |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Without cause</span>
						<span class="meaning-la"> (Lat. grātis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Afuhtan me</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weā" d:title="weā">
		<body>
			<h1>weā<span class="pron"> | wæ͜ɑː |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">woe, misery, evil, affliction, trouble</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">stifficit diei malitia sua</span>
							<span class="q-oe">Genōh dæge weā his</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 6, 34)</span>
						</li>
						<li>
							<span class="q-oe">Weā wæs ārǣred, tregena tuddor</span>
							<span class="q-cite"> (Cd. Th. 68, 26; Gen. 987)</span>
						</li>
						<li>
							<span class="q-oe">Mec ðīn weā æt heortan gehreāw</span>
							<span class="q-cite"> (Exon. Th. 91, 18; Cri. 1493)</span>
						</li>
						<li>
							<span class="q-oe">Weā biþ wundrum clibbor</span>
							<span class="q-cite"> (Menol. Fox 485 ; Gn. C. 13)</span>
						</li>
						<li>
							<span class="q-en">in expectation of evil</span>
							<span class="q-oe">Weān on wēnum</span>
							<span class="q-cite"> (Cd. Th. 63, 4; Gen. 1027: 191, 11; Exod. 213 : Exon. Th. 378, 32; Deōr. 25: Cd. Th. 146, 6; Gen. 2418)</span>
						</li>
						<li>
							<span class="q-en">nor did I wish you ill</span>
							<span class="q-oe">Ne ic ðē weān ūðe</span>
							<span class="q-cite"> (163, 3; Gen. 2692)</span>
						</li>
						<li>
							<span class="q-en">you knew nothing of misery</span>
							<span class="q-oe">Nysses ðū weān ǣnigne dǣl</span>
							<span class="q-cite"> (Exon. Th. 85, 3; Cri. 1385)</span>
						</li>
						<li>
							<span class="q-oe">Ne lǣd ðū ūs tō wīte in weān sorge</span>
							<span class="q-cite"> (Hy. 6, 27)</span>
						</li>
						<li>
							<span class="q-la">adjuvabit pauperem de inopia</span>
							<span class="q-oe">Hē þearfende of wǣdle weān ālȳsde</span>
							<span class="q-cite"> (Ps. Th. 106, 40)</span>
						</li>
						<li>
							<span class="q-en">if any man afflict thee</span>
							<span class="q-oe">Gif ðē ǣnig mid weān grēteþ</span>
							<span class="q-cite"> (Cd. Th. 105, 18 ; Gen. 1755)</span>
						</li>
						<li>
							<span class="q-oe">Hē heōld his ǣhta him tō weān</span>
							<span class="q-cite"> (Blickl. Homl. 53, 9)</span>
						</li>
						<li>
							<span class="q-oe">Biþ hē on ēcne weān be—drifen</span>
							<span class="q-cite"> (95, 5)</span>
						</li>
						<li>
							<span class="q-la">feliciores esse improbos supplicia luentes, quam si eos nulla justitiae poena coerceat</span>
							<span class="q-oe">Ðæt ða yfelan biōþ micle gesǣligran ðe on ðisse worulde habbaþ micelne weān and manigfeald wīte for hyra yfelum, ðonne ða siēn ðe nāne wræce nabbaþ</span>
							<span class="q-cite"> (Bt. 38, 3 ; Fox 200, 3)</span>
						</li>
						<li>
							<span class="q-la">super dolorem vulnerum meorum addiderunt</span>
							<span class="q-oe">Hī mē weān [īhton, cf. 77, 31] mīnra wunda sār</span>
							<span class="q-cite"> (Ps. Th. 68, 27)</span>
						</li>
						<li>
							<span class="q-oe">Weān, sār and sorge</span>
							<span class="q-cite"> (Cd. Th. 5, 20; Gen. 74; 267, 22; Sat. 42)</span>
						</li>
						<li>
							<span class="q-oe">Ic fleāh weān wana wilna gehwilces</span>
							<span class="q-cite"> (137, 11; Gen. 2272 : 109, 7; Gen. 1819)</span>
						</li>
						<li>
							<span class="q-oe">For hwon wāst ðū weān, gesyhst sorge</span>
							<span class="q-cite"> (54, 12; Gen. 876)</span>
						</li>
						<li>
							<span class="q-oe">Gedīgan weān and wræcsīð</span>
							<span class="q-cite"> (Beo. Th. 4573; B. 2292)</span>
						</li>
						<li>
							<span class="q-oe">Gesamna ūs of wīdwegum, ðǣr wē weān dreōgaþ</span>
							<span class="q-cite"> (Ps. Th. 105, 36: Cd. Th. 276, 7; Sat. 185)</span>
						</li>
						<li>
							<span class="q-oe">Hē for wlenco weān āhsode</span>
							<span class="q-cite"> (Beo. Th. 2417; B. 1206: 851; B. 423)</span>
						</li>
						<li>
							<span class="q-oe">Wyrd wōp wecceþ, heō weān hladeþ</span>
							<span class="q-cite"> (Salm. Kmbl. 874; Sal. 436)</span>
						</li>
						<li>
							<span class="q-oe">Eal sār and sace, hungor and þurst, wōp and hreām, and weāna mā ðonne ǣniges mannes gemet sȳ ðæt hiē ārīman mæge</span>
							<span class="q-cite"> (Blickl. Homl. 61, 36)</span>
						</li>
						<li>
							<span class="q-oe">Fela ic weāna gebād, heardra hilda</span>
							<span class="q-cite"> (Fins. Th. 51; Fin. 25)</span>
						</li>
						<li>
							<span class="q-oe">Wēn ne brūceþ, ðe can weāna lyt, sāres and sorge</span>
							<span class="q-cite"> (Runic pm. Kmbl. 340, 30 ; Rūn.8)</span>
						</li>
						<li>
							<span class="q-en">a deal of trouble</span>
							<span class="q-oe">Weāna dǣl</span>
							<span class="q-cite"> (Exon. Th. 379, 17; Deōr. 34: Beo. Th. 2304; B. 1150)</span>
						</li>
						<li>
							<span class="q-oe">Ic ðē wið weāna gehwam wreō</span>
							<span class="q-cite"> (Cd. Th. 131, 2 ; Gen. 2170: Beo. Th. 2796; B. 1396)</span>
						</li>
						<li>
							<span class="q-oe">Ic ǣnigra mē weāna ne wēnde bōte gebīdan</span>
							<span class="q-cite"> (1870; B. 933)</span>
						</li>
						<li>
							<span class="q-oe">Hiē ealle worlde weān oforhogodan</span>
							<span class="q-cite"> (Blickl. Homl. 119, 15)</span>
						</li>
						<li>
							<span class="q-oe">Weallende weān</span>
							<span class="q-cite"> (Exon. Th. 139, 2 ; Gū. 587)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">evil, wickedness, malice</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">non defecit de plateis ejus usura et dolus</span>
							<span class="q-oe">Nǣfre on his weorþige weā āspronge, mearce mā scyle mān inwides</span>
							<span class="q-cite"> (Ps. Th. 54, 10)</span>
						</li>
						<li>
							<span class="q-oe">Weā bið in mōde, siofa synnum fāh, gefylled mid fācne</span>
							<span class="q-cite"> (Fragm. Kmbl. 27; Leās. 15)</span>
						</li>
						<li>
							<span class="q-la">a malitia inhabitantium</span>
							<span class="q-oe">Ðæt gelamp for weān and for yfelnesse ðara eardiendra</span>
							<span class="q-cite"> (Bd. 4, 25 ; S. 599, 22)</span>
						</li>
						<li>
							<span class="q-oe">Hȳ magon weāna tō fela geseōn on</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:weā-dǣd" class="xref-target">weā-dǣd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hreōða" d:title="hreōða">
		<body>
			<h1>hreōða<span class="pron"> | xre͜oː.θɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:bord-hreōða" class="xref-target">bord-hreōða</a>, <a href="x-dictionary:r:scild-hreōða" class="xref-target">scild-hreōða</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="grund-wang" d:title="grund-wang">
		
		<body>
			<h1>grund-wang<span class="pron"> | grund.wɑng |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The bottom, ground, floor, the earth</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he could perceive the bottom [of the lake]</span>
							<span class="q-oe">He ðone grundwong ongytan mihte</span>
							<span class="q-cite"> (Beo. Th. 2996; B. 1496: 5533; B. 2770)</span>
						</li>
						<li>
							<span class="q-en">to give up the earth, to die</span>
							<span class="q-oe">Grundwong ofgyfan</span>
							<span class="q-cite"> (5169; B. 2588)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
