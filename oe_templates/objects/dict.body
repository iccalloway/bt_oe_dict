<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-tyhtend" d:title="for-tyhtend">
		
		<body>
			<h1>for-tyhtend<span class="pron"> | for.tyx.tend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A seducer, an unchaste person</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wrǣne fortyhtigend (-tiht- corruptor, Hpt. Gl. 484, 56) petulcus incestator i. maculator</span>
							<span class="q-cite"> (An. Ox. 3337)</span>
						</li>
						<li>
							<span class="q-oe">Fortihtend clinice, i. lectus tetrus</span>
							<span class="q-cite"> (Wrt. Voc. ii. 131, 71)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:preceding word" class="xref-target">preceding word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fals" d:title="fals">
		<body>
			<h1>fals<span class="pron"> | fɑls |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ꝥ deōfol his falses tō fela ongemang þǣre heorde ne gesāwe. Ne wyrð nǣfre folces wīse wel gerǣde on þām earde þe man mǣst falses lufað</span>
						<span class="q-cite"> (Ll. Th. ii. 312, 26-29)</span>
					</li>
					<li>
						<span class="q-oe">Buton ǣlcon false</span>
						<span class="q-cite"> (Wlfst. 272, 3)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swicdōm" d:title="swicdōm">
		
		<body>
			<h1>swicdōm<span class="pron"> | swik.doːm |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">an offence</span>
						<span class="meaning-la"> (Lat. scandalum)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">a scandalis; scandala; scandalum</span>
							<span class="q-oe">Wā ðysum middangearde þurh swicdōmas (a scandalis): neōd ys ðæt swycdōmas (scandala) cumon ; þeāhhwæðere wā ðam menn ðe swycdōm (scandalum, þurh hyne cymþ</span>
							<span class="q-cite"> (Mt. Kmbl. 18, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōre-teohung" d:title="fōre-teohung">
		
		<body>
			<h1>fōre-teohung<span class="pron"> | foː.re.te͜o.xung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Predestination</span>
						<span class="meaning-la"> (Lat. prædestinātio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the divine predestination is simple and unchangeable</span>
							<span class="q-oe">Siō godcunde fōreteohhung is ānfeald and unawendendlīc</span>
							<span class="q-cite"> (Bt. 39, 6; Fox 220, 16)</span>
						</li>
						<li>
							<span class="q-en">concerning the predestination of God</span>
							<span class="q-oe">Be ðære fōreteohunga Godes</span>
							<span class="q-cite"> (Bt. titl. xxxix; Fox xviii. 16)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fōre-tiohung" class="xref-target">fōre-tiohung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="birce" d:title="birce">
		<body>
			<h1>birce<span class="pron"> | bir.Ke |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Birciae, birce populus</span>
						<span class="q-cite"> (Txts. 88, 792)</span>
					</li>
					<li>
						<span class="q-oe">Birce</span>
						<span class="q-cite"> (Wrt. Voc. i. 285, 22)</span>
					</li>
					<li>
						<span class="q-oe">Byrce</span>
						<span class="q-cite"> (ii. 68, 25)</span>
					</li>
					<li>
						<span class="q-oe">Birce beta</span>
						<span class="q-cite"> (i. 285, 38: ii. 11, 57)</span>
					</li>
					<li>
						<span class="q-oe">Byrce betulus</span>
						<span class="q-cite"> (12, 65)</span>
					</li>
					<li>
						<span class="q-oe">Beeāstan ðā bircan</span>
						<span class="q-cite"> (C. D. iii. 213, 3)</span>
					</li>
					<li>
						<span class="q-oe">In ðā twislihtran biricean</span>
						<span class="q-cite"> (391, 21)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:beorc" class="xref-target">beorc</a>
			</p>
		</body>
	</d:entry>
