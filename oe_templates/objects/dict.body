<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hrōf-stān" d:title="hrōf-stān">
		<body>
			<h1>hrōf-stān<span class="pron"> | xroːf.stɑːn |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">yrnð dropmǣlum swīðe hluttor wæter (cf. wæs of þǣm ilcan stāne þǣre ciricean hrōfes swīðe hluttor wǣta ūt flōwende (cf. ꝥ ilce hūs (the church) on scræfes onlīcnesse wæs æteōwed, 207, 19)</span>
						<span class="q-cite"> (Bl. H. 209, 1.)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāþ-mōd" d:title="eāþ-mōd">
		<body>
			<h1>eāþ-mōd<span class="pron"> | æ͜ɑːθ.moːd |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Humble, lowly, obedient</span>
						<span class="meaning-la"> (Lat. hŭmĭlis, obēdiens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if thou meet a lowly person</span>
							<span class="q-oe">Gif ðū eāþmōdne eorl gemēte</span>
							<span class="q-cite"> (Exon. 84 b; Th. 318, 5; Mōd. 78)</span>
						</li>
						<li>
							<span class="q-en">he found men obedient to him</span>
							<span class="q-oe">He eāþmōde him eorlas funde</span>
							<span class="q-cite"> (Menol. Fox 195; Men. 99)</span>
						</li>
						<li>
							<span class="q-en">he becomes obedient to his feeder</span>
							<span class="q-oe">His ætgiefan eāþmōd weorþeþ</span>
							<span class="q-cite"> (Exon. 88 b; Th. 332, 27; Vy. 91)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eād-mōd" class="xref-target">eād-mōd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sylfren" d:title="sylfren">
