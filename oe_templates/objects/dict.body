<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-berendlic" d:title="ā-berendlic">
		<body>
			<h1>ā-berendlic<span class="pron"> | ɑː.be.rend.liK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Swilc forgifnes swilce hit for Gode gebeorhlic sȳ, and for weorulde āberendlic</span>
						<span class="q-cite"> (L. Edg. ii. 1; Th. i. 266, 6)</span>
					</li>
					<li>
						<span class="q-oe">Dōm . . . for worolde āberendlic</span>
						<span class="q-cite"> (L. Eth. vi. 10; Th. i. 318, 7)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:un-āberendlīc" class="xref-target">un-āberendlīc</a>, <a href="x-dictionary:r:un-āberendlīc-e" class="xref-target">un-āberendlīc-e</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāwed-ness" d:title="eāwed-ness">
		<body>
			<h1>eāwed-ness<span class="pron"> | æ͜ɑː.wed.ness |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:īwed-ness" class="xref-target">īwed-ness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gedafenlīc" d:title="un-gedafenlīc">
		<body>
			<h1>un-gedafenlīc<span class="pron"> | un.Ge.dɑ.fen.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unbecoming, unseemly, unmannerly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ungedafenlīc indecens</span>
							<span class="q-cite"> (Ælfc. Gr. 14; Zup. 87, 12)</span>
						</li>
						<li>
							<span class="q-la">quod indecorum sit</span>
							<span class="q-oe">Ðæt hit ungedafenlīc sig</span>
							<span class="q-cite"> (L. Ecg. P. i. 7; Th. ii. 174, 22)</span>
						</li>
						<li>
							<span class="q-oe">Ðæt man intō circan ǣnig þingc ne lōgige, ðæs ðe ðārtō ungedafenlīc sī</span>
							<span class="q-cite"> (L. Edg: C. 27; Th. ii. 250, 11)</span>
						</li>
						<li>
							<span class="q-la">loquacitatis incauta importunitate</span>
							<span class="q-oe">Mid ungedafenlīcre and unwærlīcre ofersprǣce</span>
							<span class="q-cite"> (Past. 15; Swt. 95, 19)</span>
						</li>
						<li>
							<span class="q-en">quarrels with unmannerly fellows</span>
							<span class="q-oe">Saca mid ungedafenlīcum</span>
							<span class="q-cite"> (Lchdm. iii. 204, 20)</span>
						</li>
						<li>
							<span class="q-oe">Wē oft ymb ungedafenlīce wīsan smeāgeaþ</span>
							<span class="q-cite"> (Past. 18; Swt. 139, 22)</span>
						</li>
						<li>
							<span class="q-oe">Gif preōst on circan ungedafenlīce þingc gelōgige, gebēte ðæt</span>
							<span class="q-cite"> (L. N. P. L. 26; Th. ii. 294, 12)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-gecoplīc" class="xref-target">un-gecoplīc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hredding" d:title="hredding">
		<body>
			<h1>hredding<span class="pron"> | xred.ding |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Ælc rihtwīs man hæfde fultum and hreddinge, sē ðe mid fullum geleāfum on his earfoðnyssum tō ðām Ælmihtigan clypode</span>
						<span class="q-cite"> (Hml. S. 13, 48)</span>
					</li>
					<li>
						<span class="q-oe">Hræddinge</span>
						<span class="q-cite"> (2, 219)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:ā-hredding" class="xref-target">ā-hredding</a>, <a href="x-dictionary:r:land-hredding" class="xref-target">land-hredding</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cirio-belle" d:title="cirio-belle">
		<body>
			<h1>cirio-belle<span class="pron"> | Ki.ri͜o.bel.le |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A church-bell</span>
						<span class="meaning-la"> (Lat. ecclesiæ campana)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">from a church-bell</span>
							<span class="q-oe">Of ciricbellan</span>
							<span class="q-cite"> (L. M. 1, 63; Lchdm. ii. 136, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āþiēstrian" d:title="āþiēstrian">
		<body>
			<h1>āþiēstrian<span class="pron"> | ɑː.θi͜yː.stri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To overcloud, to be eclipsed</span>
						<span class="meaning-la"> (Lat. obscurari)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the sun was eclipsed</span>
							<span class="q-oe">Seō sunne aþiēstrode</span>
							<span class="q-cite"> (Chr. 538; Th. 28, 6, 11, col. 1)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āþȳstrian" class="xref-target">āþȳstrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="munuc-hād" d:title="munuc-hād">
		<body>
			<h1>munuc-hād<span class="pron"> | mu.nuk.xɑːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">general or of a man</span>
					</p>
					<ol class="sub-senses">
						<li>
							<ul class="quotes">
								<li>
									<span class="q-la">in monachico habitu</span>
									<span class="q-oe">In munuchāde</span>
									<span class="q-cite"> (Gr. D. 27, 18)</span>
								</li>
								<li>
									<span class="q-oe">Ne mōt man iungum men wīf forgyfan, gif hē hine ǣr tō munuchāde (monachismo) gemynte</span>
									<span class="q-cite"> (Ll. Th. ii. 142, 9)</span>
								</li>
								<li>
									<span class="q-la">quidam in deteriori ordine sortem extremi habitus bene vivendo transcendunt</span>
									<span class="q-oe">Oft on lǣwedum hāde and on lǣwedum girelan mid gōdum weorcum and mid ryhte līfe man oferðīhð ðone munuchād and ðā ōðre ðe ðone hiērran hād habbað</span>
									<span class="q-cite"> (Past. 411. 36)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">of a woman</span>
					</p>
					<ol class="sub-senses">
						<li>
							<ul class="quotes">
								<li>
									<span class="q-la">ad eum quem desiderabat habitum perducta est</span>
									<span class="q-oe">Heō wæs gelǣded tō ðām munuchāde þe heō wilnode and gyrnde</span>
									<span class="q-cite"> (Gr. D. 199, 19)</span>
								</li>
								<li>
									<span class="q-la">anus quaedam in sanctimoniali habitu constituta in hac urbe manebat</span>
									<span class="q-oe">Sum eald wīf in hālgum munuchāde in þissere byrig wunode</span>
									<span class="q-cite"> (283, 5)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-spon" d:title="ge-spon">
		<body>
			<h1>ge-spon<span class="pron"> | je.spon |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An enticing, persuasion, artifice</span>
						<span class="meaning-la"> (Lat. illectatio, persuasio, seductio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the devil's artifice</span>
							<span class="q-oe">Deōfles gespon the devil's artifice</span>
							<span class="q-cite"> (Cd. 33; Th. 45, 2; Gen. 720)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-span" class="xref-target">ge-span</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="for-blāwan" d:title="for-blāwan">
		<body>
			<h1>for-blāwan<span class="pron"> | for.blɑː.wɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -bleōw, pl: -bleōwon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -blāwen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To blow away, inflate</span>
						<span class="meaning-la"> (Lat. inflāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">there came a wind, and blew them out on to the sea</span>
							<span class="q-oe">Com ān wind, ond forbleōw hie ūt on sǣ</span>
							<span class="q-cite"> (Ors. 5, 4; Bos. 105, 19)</span>
						</li>
						<li>
							<span class="q-en">if a man be inflated</span>
							<span class="q-oe">Gif mon sīe forblāwen</span>
							<span class="q-cite"> (L. M. 2, 34; Lchdm. ii. 240, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="horh" d:title="horh">
		<body>
			<h1>horh<span class="pron"> | xorx |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">flegma, i. saliva</span>
						<span class="q-oe">Horh flegma, i. saliva</span>
						<span class="q-cite"> (Wrt. Voc. ii. 149, 38: flegma, 35, 65)</span>
					</li>
					<li>
						<span class="q-oe">Nytta þāra læ-cedōma þe þone horh of þām heāfde teō</span>
						<span class="q-cite"> (Lch. ii. 282, 25)</span>
					</li>
					<li>
						<span class="q-oe">Þū forlēte on þīnne ondwlitan þā earman heora horh (spātl) spīwan</span>
						<span class="q-cite"> (Angl. xii. 505, 13)</span>
					</li>
					<li>
						<span class="q-la">flegmata</span>
						<span class="q-oe">Horh flegmata</span>
						<span class="q-cite"> (Wrt. Voc. ii. 108, 71: 35, 64)</span>
					</li>
					<li>
						<span class="q-oe">Swiling wiðd hōrum (hrum, MS.) and gillistrum tō heāfdes hǣlo</span>
						<span class="q-cite"> (Lch. ii. 2, 3)</span>
					</li>
					<li>
						<span class="q-oe">[H]ōras</span>
						<span class="q-cite"> (i. 358, 13)</span>
					</li>
					<li>
						<span class="q-oe">Dracontjan wiþ fūle hōras on men</span>
						<span class="q-cite"> (ii. 174, 5)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="delf" d:title="delf">
		<body>
			<h1>delf<span class="pron"> | delf |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A delving, the act of digging</span>
						<span class="meaning-la"> (Lat. fossio)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:dælf" class="xref-target">dælf</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-hīwede" d:title="-hīwede">
		<body>
			<h1>-hīwede<span class="pron"> | xiː.we.de |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:twi-hīwede" class="xref-target">twi-hīwede</a>, <a href="x-dictionary:r:þri-hīwede" class="xref-target">þri-hīwede</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ymb-sǣtnung" d:title="ymb-sǣtnung">
		<body>
			<h1>ymb-sǣtnung<span class="pron"> | ymb.sæːt.nung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a siege</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">obsidione</span>
							<span class="q-oe">Emsǣtnungum</span>
							<span class="q-cite"> (Hpt. Gl. 525, 40)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a sedition</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">cum audieritis proelia et seditiones</span>
							<span class="q-oe">Mið ðȳ giē gehēreþ gefehto and ymbsētnungo (-e, Rush.) ymb burgum</span>
							<span class="q-cite"> (Lk. Skt. Lind. 21, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ymb" class="xref-target">ymb</a>, <a href="x-dictionary:r:sǣtnung" class="xref-target">sǣtnung</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sǣmend" d:title="sǣmend">
		<body>
			<h1>sǣmend<span class="pron"> | sæː.mend |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:sēmend" class="xref-target">sēmend</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swara" d:title="swara">
		<body>
			<h1>swara<span class="pron"> | swɑ.rɑ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">swara in āþ-swara</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">hoc jus jurandum</span>
							<span class="q-oe">Ðes āðswara hoc jus jurandum</span>
							<span class="q-cite"> (Ælfc. Gr. 14; Zup. 88, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āþ-swara" class="xref-target">āþ-swara</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-anbyrdan" d:title="ge-anbyrdan">
		
		<body>
			<h1>ge-anbyrdan<span class="pron"> | je.ɑn.byr.dɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Geondbyrde</span>
						<span class="q-cite"> (Ll. Th. i. 404, 13 note)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="bliōtan" d:title="bliōtan">
		<body>
			<h1>bliōtan<span class="pron"> | bli͜oː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">sacrificed; 3rd pl. p. of blōtan to sacrifice</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">how the towns-people in Carthage sacrificed men to their gods</span>
							<span class="q-oe">Hū ða burhleōde on Cartaina bliōtan [ = bleōton] men hira godum</span>
							<span class="q-cite"> (Ors. cont. 4, 4; Bos. 11, 32)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:blōtan" class="xref-target">blōtan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gehwǣr" d:title="gehwǣr">
		
		<body>
			<h1>gehwǣr<span class="pron"> | Ge.xwæːr |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">everywhere</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">where there is motion</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="meaning-en">all over an area, throughout a space</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">ipsi veniebant et instar locustarum universa complebant</span>
											<span class="q-oe">Heora fȳnd fērdon freōlīce gehwǣr swā þicce swā gærstapan</span>
											<span class="q-cite"> (Jud. 6, 5)</span>
										</li>
										<li>
											<span class="q-la">circumquaque debachantes</span>
											<span class="q-oe">Gehwār ābūtan woffiende</span>
											<span class="q-cite"> (An. Ox. 3775)</span>
										</li>
										<li>
											<span class="q-oe">Þearfe bringeđ Maius micle geond menigeo gehwār</span>
											<span class="q-cite"> (Men. 79)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="meaning-en">to every place</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">cf. dixit eis: ' euntes in mundum universum praedicate euan-gelium, ' Mk. 16, 15</span>
											<span class="q-oe">Hē fērde fram Antiochiam, for þan þe hē wæs apostol, and sceolde gehwǣr gecuman and Crīstendōm ārǣran</span>
											<span class="q-cite"> (Hml. S. 10, 13)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">where there is doing or being</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="meaning-en">all over a limited area</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Wæs micel hearm gedōn gehwǣr be þǣm sǣriman</span>
											<span class="q-cite"> (Chr. 981; P. 124, 12)</span>
										</li>
										<li>
											<span class="q-la">parumper</span>
											<span class="q-oe">Gewaer</span>
											<span class="q-cite"> (Txts. 182, 84)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="meaning-en">at every place where a certain condition is possible</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">passim sacerdotes inter altaria trucidabantur</span>
											<span class="q-oe">Gehwǣr sācerdas and mæssepreōstas betwih wībedum wǣron slægene</span>
											<span class="q-cite"> (Bd. I. 15; Sch. 43, 15)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(c)</span>
										<span class="meaning-en">denoting frequent occurrence, in very many places</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">passim</span>
											<span class="q-oe">Gehwār (-hwǣr, v. l.)</span>
											<span class="q-cite"> (Ælfc. Gr. Z. 236, 14)</span>
										</li>
										<li>
											<span class="q-oe">ꝥ man swā geongne man cwealde . . . swā hē geāxod hæfde þe man gehwǣr (ubique) dyde</span>
											<span class="q-cite"> (Ll. Th. i. 240, 26)</span>
										</li>
										<li>
											<span class="q-oe">Ōđre bēc man hæfđ wīde gehwǣr on crīstendōme Crīste tō lofe</span>
											<span class="q-cite"> (Ælfc. T. Grn. 19, 39)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(cc)</span>
												<span class="meaning-en">of statements in books</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Hit is āwriten on Crīstes bēc, and gehwǣr on ōþrum bōcum</span>
													<span class="q-cite"> (Hml. Th. i. 136, 24)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(d)</span>
										<span class="meaning-en">in every instance</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Hē ꝥ in scopgereorde mid þā mǣstan swētnesse geglencde, and in Englisc gereorde wel gehwǣr forđbrōhte</span>
											<span class="q-cite"> (Bd. 4, 24; Sch. 481, 12)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">indefinite</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(I)</span>
								<span class="meaning-en">anywhere without restriction, anywhere one pleases</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="meaning-en">of motion</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">quolibet</span>
											<span class="q-oe">Gif hrȳđera hwelc siē þe hegas brece and gā in gehwǣr</span>
											<span class="q-cite"> (Ll. Th. i. 128, 12)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="meaning-en">of position</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Þā welmas þā þe beōþ gehwǣr geond þone līchoman</span>
											<span class="q-cite"> (Lch. ii. 204, 14)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">somewhere</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Wæs eāc eorđstynung on manegum stōwum on Wygracestre and on Wīc and on Deōrbȳ and elles gehwǣr (in some other places) and eāc ꝥ wilde fȳr on Deōrbȳscīre micel yfel dyde and gehwǣr elles</span>
									<span class="q-cite"> (Chr. 1049 ; P. 167, 24-27)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-weorþan" d:title="ge-weorþan">
		<body>
			<h1>ge-weorþan<span class="pron"> | je.we͜or.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to honour a person</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sit se heofonlica dēma on his heāhsettle helme gewurþod.</span>
									<span class="q-cite"> (Wlfst. 137, 17)</span>
								</li>
								<li>
									<span class="q-oe">Secg . . . wǣpnum geweorðad,</span>
									<span class="q-cite"> (B. 250)</span>
								</li>
								<li>
									<span class="q-oe">Adam stōp, gāste geweorðad,</span>
									<span class="q-cite"> (Gen. 1137)</span>
								</li>
								<li>
									<span class="q-oe">Sweōt . . . sigore geweorðod,</span>
									<span class="q-cite"> (Jud. 299)</span>
								</li>
								<li>
									<span class="q-oe">Æitele eorlgebyrdum, welum geweorðad,</span>
									<span class="q-cite"> (Met. 10, 28)</span>
								</li>
								<li>
									<span class="q-oe">Geweorþad fretns (cf. (?) meterlicere getincnesse gegōdod (fretus), An. Ox. 126),</span>
									<span class="q-cite"> (Wrt. Voc. ii. 23, 32)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to adorn, decorate</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(α)</span>
										<span class="sub-heading">an animal</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Mearh . . . midlum geweorðod,</span>
											<span class="q-cite"> (El. 1193)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(β)</span>
										<span class="sub-heading">a thing</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Oft ꝥā þeōdwitan þus heora meteruers gewurðiað,</span>
											<span class="q-cite"> (Angl. viii. 332, 16 : 313, 29)</span>
										</li>
										<li>
											<span class="q-oe">Sadol . . . since gewurðad,</span>
											<span class="q-cite"> (B. 1038)</span>
										</li>
										<li>
											<span class="q-oe">Geweorðad,</span>
											<span class="q-cite"> (1450)</span>
										</li>
										<li>
											<span class="q-oe">Ælfheres lāf . . . golde geweorðod,</span>
											<span class="q-cite"> (Vald. 2, 18)</span>
										</li>
										<li>
											<span class="q-oe">Wuldres treōw wǣdum geweorīīod, ... gegyred mid golde,</span>
											<span class="q-cite"> (Kr. 15)</span>
										</li>
										<li>
											<span class="q-oe">Salem stōd weallum geweorðod,</span>
											<span class="q-cite"> (Dan. 41)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">to honour a place or season</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Seō stōw is mid manegum godcundum wuldrum swīþe heālīce geweorþod,</span>
									<span class="q-cite"> (Bl. H. 125, 18 : 197, 12)</span>
								</li>
								<li>
									<span class="q-oe">Þes dæg is geweorþod mid manegum godcundum geofum,</span>
									<span class="q-cite"> (133, 2)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sylf" d:title="sylf">
