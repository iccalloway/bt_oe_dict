<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="firen-cræft" d:title="firen-cræft">
		<body>
			<h1>firen-cræft<span class="pron"> | fi.ren.kræft |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A sinful craft, wickedness</span>
						<span class="meaning-la"> (Lat. scělesta ars, něquităia)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they hated the Lord's law in their wickedness</span>
							<span class="q-oe">Hī Dryhtnes ǣ feōdon þurh firencræft</span>
							<span class="q-cite"> (Exon. 66a; Th. 243, 21; Jul. 14)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-sih" d:title="be-sih">
