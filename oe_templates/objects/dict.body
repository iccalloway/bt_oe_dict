<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tō-līsing" d:title="tō-līsing">
		<body>
			<h1>tō-līsing<span class="pron"> | toː.liː.sing |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">dissolution, destruction</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Geleāfan tōlȳsinge</span>
							<span class="q-cite"> (Lchdm. iii. 206, 20)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">release, redemption</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ut daret animam suam redemptionem pro multis</span>
							<span class="q-oe">Ðætte hē salde sāwel his lēsnise ł tōlēsinc fore monigum</span>
							<span class="q-cite"> (Mk. Skt. Lind. 10, 45)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:tō-līsan" class="xref-target">tō-līsan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="leac-blæd" d:title="leac-blæd">
		<body>
			<h1>leac-blæd<span class="pron"> | læ͜ɑK.blæd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A leek leaf</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þis man sceal wið ꝥ gedrif wrītan on þreōm leācbladan</span>
							<span class="q-cite"> (Nap. 41)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-pos" d:title="ge-pos">
		<body>
			<h1>ge-pos<span class="pron"> | je.pos |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Swā byð se ealda man ceald and snoflig; flegmata ꝥ byð hrāca oððe geposu, deriað þām ealdan</span>
						<span class="q-cite"> (Angl. viii. 299, 36)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-sparrian" d:title="be-sparrian">
		<body>
			<h1>be-sparrian<span class="pron"> | be.spɑr.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To bolt, shut up</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">oppilatae</span>
							<span class="q-oe">Bisparrad</span>
							<span class="q-cite"> (Wrt. Voc. ii. 115, 68)</span>
						</li>
						<li>
							<span class="q-oe">Bespar—rade</span>
							<span class="q-cite"> (63, 47)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mann-sliht" d:title="mann-sliht">
		
		
		<body>
			<h1>mann-sliht<span class="pron"> | mɑnn.slixt |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Manslaughter, homicide, murder</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ða heāfodleahtras sind, mansliht ...</span>
							<span class="q-cite"> (Homl. Th. ii. 592, 4)</span>
						</li>
						<li>
							<span class="q-la">reus perpetrati homicidii non tenetur</span>
							<span class="q-oe">Ðonne mæg hē beōn orsorg ðæs monnslihtes (monnsliehtes. Hatt. MS.)</span>
							<span class="q-cite"> (Past. 21, 7; Swt. 166, 20)</span>
						</li>
						<li>
							<span class="q-oe">Manslehtes beteōn</span>
							<span class="q-cite"> (L. A. G. 3; Th. i. 154, 5)</span>
						</li>
						<li>
							<span class="q-oe">Be monslihte (monnslyhte, MS. H.)</span>
							<span class="q-cite"> (L. In. 34; Th. i. 122, 15: L. Edm. E. 3; Th. i. 246, 1: L. Edm. S. 1; Th. i. 248, 1)</span>
						</li>
						<li>
							<span class="q-oe">Be ðām monnum ðe heora wǣpna tō monslyhte lǣnaþ. Gif hwā his wǣpnes ōðrum onlǣne ðæt hē mon mid ofsleā</span>
							<span class="q-cite"> (L. Alf. pol. 19; Th. i. 74, 1-4)</span>
						</li>
						<li>
							<span class="q-en">to commit murder</span>
							<span class="q-oe">Manslyht gewyrcan</span>
							<span class="q-cite"> (Mk. Skt. 15, 7)</span>
						</li>
						<li>
							<span class="q-oe">Hēðenra manna hergung ādiligode Godes cyrican þurh reāflāc and mansleht.</span>
							<span class="q-cite"> (Chr. 793; Erl. 59, 12)</span>
						</li>
						<li>
							<span class="q-oe">Manslæht</span>
							<span class="q-cite"> (Confess. Peccat.)</span>
						</li>
						<li>
							<span class="q-oe">Ðis synt ða īdelnyssa ðisse worlde ... manslehtas (homicidia)</span>
							<span class="q-cite"> (L. Ecg. P. i. 8; Th. ii. 174, 34: Wulfst. 164, 4)</span>
						</li>
						<li>
							<span class="q-la">inhumatas strages reliquit</span>
							<span class="q-oe">Ðǣr wǣron swā micle monslihtas on ǣgðere healfe ðæt hiē mon bebyrgan ne mehte</span>
							<span class="q-cite"> (Ors. 4, 6; Swt. 176, 30)</span>
						</li>
						<li>
							<span class="q-oe">Ungetīma ǣgder ge on monslehtum ge on hungre</span>
							<span class="q-cite"> (1, 11; Swt. 50, 19: Chr. 994; Erl. 133, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stepe" d:title="stepe">
		<body>
			<h1>stepe<span class="pron"> | ste.pe |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:stæpe" class="xref-target">stæpe</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="heāh-þearf" d:title="heāh-þearf">
		<body>
			<h1>heāh-þearf<span class="pron"> | xæ͜ɑːx.θæ͜ɑrf |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Great need</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">at my greatest need</span>
							<span class="q-oe">Æt heāhþearfe</span>
							<span class="q-cite"> (Ps. Th. 117, 16, 20, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="glengista" d:title="glengista">
		<body>
			<h1>glengista<span class="pron"> | glen.Gi.stɑ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The translator seems to have misunderstood the passage to mean: 'In order that thy diligence and genius may add somewhat to the knowledge of these things of mine.' In some way ingenium is represented by glengista. Could this word be the superlative of an adjective, glenge well-ordered, and the passage be completed ?þīn] glengista [orþanc?]</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:glengan" class="xref-target">glengan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="omer" d:title="omer">
		<body>
			<h1>omer<span class="pron"> | o.mer |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">a bird's name, hammer (in yellow-hammer)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Omer (emer, Ep. Gl. 23 e, 31) scorelus</span>
							<span class="q-cite"> (Wrt. Voc. ii. 120, 6)</span>
						</li>
						<li>
							<span class="q-oe">Amore scorellus</span>
							<span class="q-cite"> (i. 281, 18)</span>
						</li>
						<li>
							<span class="q-oe">In Cd. Dip. Kmbl. iii. 118 omerlond occurs</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:clod-hamer" class="xref-target">clod-hamer</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sūþ-eāsterne" d:title="sūþ-eāsterne">
		<body>
			<h1>sūþ-eāsterne<span class="pron"> | suːθ.æ͜ɑː.ster.ne |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">South-eastern</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sūðeāsterne wind eurus</span>
							<span class="q-cite"> (Ælfc. Gr. 4; Zup. 8, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cōp" d:title="cōp">
		<body>
			<h1>cōp<span class="pron"> | koːp |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A cope, an outer garment worn by priests</span>
						<span class="meaning-la"> (Lat. ependytes)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Cōp vel hoppada vel nfrescrūd ependeton [= ependytes]</span>
							<span class="q-cite"> (Ælfc. Gl. 112; Som. 79, 83; Wrt. Voc. 59, 52)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="clam" d:title="clam">
		
		<body>
			<h1>clam<span class="pron"> | klɑm |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a bond, fetter</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">ut eripiatur</span>
							<span class="q-oe">Ꝥ hē sȳ genered of þām clammum</span>
							<span class="q-cite"> (Gr. D. 345, 27)</span>
						</li>
						<li>
							<span class="q-oe">Æfter þǣm bendum his deāþes and æfter þǣm clammum helle þeōstra</span>
							<span class="q-cite"> (Bl. H. 83, 22)</span>
						</li>
						<li>
							<span class="q-oe">Dryhten gescylde ūs wiþ þā ēcan clammas</span>
							<span class="q-cite"> (Wlfst. 226, 9)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a bond, pledge</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Clam oððe wed clasma (v. māl in Dict.)</span>
							<span class="q-cite"> (Wrt. Voc. ii. 21, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:nīd-clamm" class="xref-target">nīd-clamm</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ār-cræftig" d:title="ār-cræftig">
		<body>
			<h1>ār-cræftig<span class="pron"> | ɑːr.kræf.tiG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Skilful or quick in shewing respect, respectful, polite</span>
						<span class="meaning-la"> (Lat. morigerus, obsequens)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">a respectful messenger, a prophet</span>
							<span class="q-oe">Ārcræftig ār</span>
							<span class="q-cite"> (Cd. 202; Th. 250, 23; Dan. 551)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geond-innan" d:title="geond-innan">
		
		<body>
			<h1>geond-innan<span class="pron"> | Ge͜ond.in.nɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:geond" class="xref-target">geond</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fēþre" d:title="fēþre">
		<body>
			<h1>fēþre<span class="pron"> | feː.θre |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Laden, loaded</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">better is often loaded than overloaded</span>
							<span class="q-la">meliora plura quam gravia honera fiunt</span>
							<span class="q-oe">Sēlre byð oft fēðre þænne oferfēðre</span>
							<span class="q-cite"> (Angl. ii. 373)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fōþor" class="xref-target">fōþor</a>, <a href="x-dictionary:r:fēþrian" class="xref-target">fēþrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="sib-æðeling" d:title="sib-æðeling">
		<body>
			<h1>sib-æðeling<span class="pron"> | sib.æ.θe.ling |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A prince and kinsman</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sibæðelingas (Beowulf and Wiglaf; a few lines before the former is spoken of as the mǣg of the latter).</span>
							<span class="q-cite"> (Beo. Th. 5409; B. 2708.)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Godmundingahām" d:title="Godmundingahām">
		<body>
			<h1>Godmundingahām<span class="pron"> | god.mun.din.gɑ.xɑːm |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Goodmanham, between Pocklington and Beverley, a place a little to the east of York, beyond the river Derwent, where a famous Witena-gemōt was convened by Edwin, king of Northumbria, in A. D. 625, to consider the propriety of receiving the Christian faith. The speeches were so much in favour of Christianity that the creed was at once received; these speeches are particularly worthy of notice</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hōn" d:title="hōn">
		<body>
			<h1>hōn<span class="pron"> | xoːn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -hēng</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -hangen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To hang, suspend, crucify</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">crucifigetis</span>
							<span class="q-oe">Gē hig hōþ</span>
							<span class="q-cite"> (Mt. Kmbl. 23, 34)</span>
						</li>
						<li>
							<span class="q-la">ille suspensus est in cruce</span>
							<span class="q-oe">Hine man hēng</span>
							<span class="q-cite"> (Gen. 41, 13)</span>
						</li>
						<li>
							<span class="q-la">crucifixerunt eum</span>
							<span class="q-oe">Hig hine hēngon</span>
							<span class="q-cite"> (Lk. Skt. 23, 33)</span>
						</li>
						<li>
							<span class="q-oe">Ðōne hēngon on heāne beām fæderas ūsse</span>
							<span class="q-cite"> (Elen. Kmbl. 847; El. 424)</span>
						</li>
						<li>
							<span class="q-la">crucifige eum</span>
							<span class="q-oe">Hōh hine</span>
							<span class="q-cite"> (Mk. Skt. 15, 13)</span>
						</li>
						<li>
							<span class="q-oe">Hōh hyne hōh hyne: Ðā cwæþ pilatus tō him Nime gē hine and hōþ</span>
							<span class="q-cite"> (Jn. Skt. 19, 6)</span>
						</li>
						<li>
							<span class="q-en">hang it on to the arm</span>
							<span class="q-oe">Hōh on earm</span>
							<span class="q-cite"> (Med. ex Quadr. 9, 12; Lchdm, i. 362, 27)</span>
						</li>
						<li>
							<span class="q-la">alterum suspendit in crucem</span>
							<span class="q-oe">Ðone ōðerne hē hēt hōn on gealgan</span>
							<span class="q-cite"> (Gen. 40, 22)</span>
						</li>
						<li>
							<span class="q-oe">Hēt se wælhreōwa hine hōn on heardre hengene</span>
							<span class="q-cite"> (Homl. Th. ii. 308, 29)</span>
						</li>
						<li>
							<span class="q-en">there were brought two thieves to be crucified for their sins</span>
							<span class="q-oe">Ðǣr wǣron gelǣdde twegen sceaþan for heora synnum tō hōnne</span>
							<span class="q-cite"> (254, 22)</span>
						</li>
						<li>
							<span class="q-la">ad crucifigendum</span>
							<span class="q-oe">Tō hōanne</span>
							<span class="q-cite"> (Mt. Kmbl. Lind. 20, 19)</span>
						</li>
						<li>
							<span class="q-oe">Ic hæbbe mihte ðē tō hōnne</span>
							<span class="q-cite"> (Jn. Skt. 19, 10)</span>
						</li>
						<li>
							<span class="q-la">crucifigentibus</span>
							<span class="q-oe">Ðǣm hōendum</span>
							<span class="q-cite"> (Lk. Skt. 11, 7)</span>
						</li>
						<li>
							<span class="q-oe">Frignan ongan on hwylcum ðara beāma bearn wealdendes hangen wǣre</span>
							<span class="q-cite"> (Elen. Kmbl. 1701; El. 851)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āhōn" class="xref-target">āhōn</a>, <a href="x-dictionary:r:be-hōn" class="xref-target">be-hōn</a>, <a href="x-dictionary:r:bi-hōn" class="xref-target">bi-hōn</a>, <a href="x-dictionary:r:ge-hōn" class="xref-target">ge-hōn</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="plantian" d:title="plantian">
		<body>
			<h1>plantian<span class="pron"> | plɑn.ti.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">literal</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Swā swā treōw ꝥ planted (plantatum) is wið ryne wætera</span>
									<span class="q-cite"> (Ps. Rdr. 1, 3)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">figurative</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Þīn hand plantade (plantavit) ūre foregengan</span>
									<span class="q-cite"> (Ps. Th. 43, 3)</span>
								</li>
								<li>
									<span class="q-oe">Būton hē of his hiēremonna mōde ðā ðornas ðǣre īdlan lufan ǣr ūp ātuge, unnyt hē plantode on hī ðā word ðǣre hālgan lāre</span>
									<span class="q-cite"> (Past. 443, 1)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:under-plantian" class="xref-target">under-plantian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hluttrian" d:title="hluttrian">
		<body>
			<h1>hluttrian<span class="pron"> | xlut.tri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to become clear</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">it will become clear</span>
							<span class="q-oe">Hit wile hluttrian</span>
							<span class="q-cite"> (Lchdm. iii. 76, 7)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to make clear, purify</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the morning rain purifies</span>
							<span class="q-oe">Morgenrēn hluttraþ [o r is the verb in the plural?]</span>
							<span class="q-cite"> (Exon. 54 a; Th. 191, 8; Az. 85)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āhluttrian" class="xref-target">āhluttrian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīdþearf-līce" d:title="nīdþearf-līce">
		
		
		<body>
			<h1>nīdþearf-līce<span class="pron"> | niːd.θæ͜ɑrf.liː.tʃe |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Necessarily</span>
						<span class="meaning-la"> (Lat. necessario)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nēdþearflīce (nīd-, nȳd-, neād-) necessario</span>
							<span class="q-cite"> (Ælfc. Gr. 38; Som. 41, 37)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nīd-hǣmestre" d:title="nīd-hǣmestre">
		<body>
			<h1>nīd-hǣmestre<span class="pron"> | niːd.xæː.me.stre |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A woman who has been violated, a mistress</span>
						<span class="meaning-la"> (Lat. amatricis)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">amatricis</span>
							<span class="q-oe">Nēdhǣmestran</span>
							<span class="q-cite"> (Hpt. Gl. 509, 70)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āsniðan" d:title="āsniðan">
		<body>
			<h1>āsniðan<span class="pron"> | ɑː.sni.θɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -snāp, pl: -snidon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -sniden</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To cut off</span>
						<span class="meaning-la"> (Lat. amputare)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:snīðan" class="xref-target">snīðan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āslacigendlīc" d:title="āslacigendlīc">
		<body>
			<h1>āslacigendlīc<span class="pron"> | ɑː.slɑ.Ki.Gend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Remissive</span>
						<span class="meaning-la"> (Lat. remissivus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">some [adverbs] are remissiva, that is remissives, etc.</span>
							<span class="q-oe">Sume [adverbia] syndon remissiva, ðæt synd aslacigendlīce [lytlum paulatim, softe suaviter, etc.]</span>
							<span class="q-cite"> (Ælfc. Gr. 38; Som. 40, 29)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="forod" d:title="forod">
		<body>
			<h1>forod<span class="pron"> | fo.rod |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Gif hōhsino forod (-ad, 146, 4) siē</span>
						<span class="q-cite"> (Lch. ii. 14, 27)</span>
					</li>
					<li>
						<span class="q-oe">Ðe mā ðe ǣnig fugel his flyhtes gewylt, gif his ōðer fiðere forod bið</span>
						<span class="q-cite"> (Hml. Th. ii. 318, 29)</span>
					</li>
					<li>
						<span class="q-oe">Heora fæder feōll foredum swyran</span>
						<span class="q-cite"> (326, 7)</span>
					</li>
					<li>
						<span class="q-oe">Man hine foredum sceancum intō þǣre eā wurpe</span>
						<span class="q-cite"> (Hml. S. 27, 58)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:sceanc-forod" class="xref-target">sceanc-forod</a>, <a href="x-dictionary:r:un-forod" class="xref-target">un-forod</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-feālīce" d:title="ge-feālīce">
		<body>
			<h1>ge-feālīce<span class="pron"> | je.fæ͜ɑː.liː.Ke |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:un-ge-feālīce" class="xref-target">un-ge-feālīce</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-þrǣstan" d:title="ge-þrǣstan">
		<body>
			<h1>ge-þrǣstan<span class="pron"> | je.θræː.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-la">attrivit</span>
							<span class="q-oe">Geþrǣste attrivit</span>
							<span class="q-cite"> (Wrt. Voc. ii. 6, 11)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">to crush material, break to pieces, smash</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">parietem evertit, atque unum monachum opprimens ruina contrivit</span>
									<span class="q-oe">Mid þy fylle ðæs wāges forþryccende hē geþrǣste (tōcwȳsde, v. l.) ǣnne þāra muneca</span>
									<span class="q-cite"> (Gr. D. 125, 6)</span>
								</li>
								<li>
									<span class="q-oe">Geðrǣste geatu ðā ǣrenan</span>
									<span class="q-cite"> (Ps. Vos. 106, 16)</span>
								</li>
								<li>
									<span class="q-oe">Ðā heān muntas beōð genehhe mid heofenfȳre geþrǣste</span>
									<span class="q-cite"> (Wlfst. 262, 15)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">to destroy</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ealle trymenesse hlāfes geðræste</span>
									<span class="q-cite"> (Ps. Vos. 104, 16)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="meaning-en">to vex, distress, afflict</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">the body</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">causam vexationis suae narrabat</span>
											<span class="q-oe">Þā āsweōll him se līchama ... sārlīce hē wæs mid þām sāre geswenced ... þā sǣde hē him þone intingan þurh hwæt hē ǣrest swā geþrǣst wǣre</span>
											<span class="q-cite"> (Guth. Gr. 153, 18)</span>
										</li>
										<li>
											<span class="q-oe">Ic wæs swīðe geþrēst for þyses wēstenes wæter wǣdlnesse</span>
											<span class="q-cite"> (Hml. S. 23 b, 537)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">the mind</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">ab accensore suo demone (p)urguetur</span>
											<span class="q-oe">Gif þū gesihst ēhtere þīnne þearle wēdende, wite þū þæt fram ātendendum his deōfle byþ geþrǣst</span>
											<span class="q-cite"> (Scint. 208, 4)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">IV.</span>
								<span class="meaning-en">to constrain, bind, confine</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">artatur, i. constringitur</span>
									<span class="q-oe">Geþrǣst artatur, i. constringitur</span>
									<span class="q-cite"> (An. Ox. 2121)</span>
								</li>
								<li>
									<span class="q-la">mancipatur, i. retinetur</span>
									<span class="q-oe">Sī geþrǣst, gehæft mancipatur, i. retinetur</span>
									<span class="q-cite"> (1164)</span>
								</li>
								<li>
									<span class="q-la">addicti</span>
									<span class="q-oe">Gescriuene, geþrǣste addicti (geþrēsde adducti, Hpt. Gl. 440, 37)</span>
									<span class="q-cite"> (1452)</span>
								</li>
								<li>
									<span class="q-la">artabantur</span>
									<span class="q-oe">Geþrǣste artabantur</span>
									<span class="q-cite"> (4876)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-þrǣstedness" class="xref-target">ge-þrǣstedness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hyhtendlic" d:title="ge-hyhtendlic">
		<body>
			<h1>ge-hyhtendlic<span class="pron"> | je.xyx.tend.liK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To be hoped for</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">est fides sperandarum substantia rerum</span>
							<span class="q-oe">Paulus cwæð ꝥ se geleāfa wǣre gehyhtendlicra þinga spēd</span>
							<span class="q-cite"> (Gr. D. 269, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwer-hwette" d:title="hwer-hwette">
