<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æf-dæll" d:title="æf-dæll">
		
		<body>
			<h1>æf-dæll<span class="pron"> | æf.dæll |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">Tō æfdæll (-delle, R.)</span>
						<span class="q-cite"> (Lk. L. 19, 37)</span>
					</li>
				</ul>
			</div>
			<p class="xref">See also: <a href="x-dictionary:r:of-dæle" class="xref-target">of-dæle</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nǣder-fāh" d:title="nǣder-fāh">
		<body>
			<h1>nǣder-fāh<span class="pron"> | næː.der.fɑːx |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Spotted like a snake</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Inn eōde ān grislic deōfol. Hē wæs on dracan heōwe and eall hē wæs nǣdderfāh</span>
							<span class="q-cite"> (Hml. A. 175, 183)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="meōning" d:title="meōning">
		<body>
			<h1>meōning<span class="pron"> | me͜oː.ning |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A garter, binding for a sock</span>
						<span class="meaning-la"> (Lat. fascellas)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">fascellas</span>
							<span class="q-oe">Meōningas (printed weoningas)</span>
							<span class="q-cite"> (Wrt. Voc. ii. 146, 53)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:meō" class="xref-target">meō</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="uppe-land" d:title="uppe-land">
		<body>
			<h1>uppe-land<span class="pron"> | up.pe.lɑnd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Upland, inland country</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efn-gemæcca" d:title="efn-gemæcca">
		<body>
			<h1>efn-gemæcca<span class="pron"> | efn.Ge.mæk.kɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A fellow-companion, associate, fellow</span>
						<span class="meaning-la"> (Lat. consors)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">they are their equals and their fellows in their nature</span>
							<span class="q-oe">Ða beōþ hira gelīcan and hira efngemæccan on hira gecynde</span>
							<span class="q-cite"> (Past. 29; Hat. MS. 38 b, 16)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="getingnesse" d:title="getingnesse">
		
		
		
		<body>
			<h1>getingnesse<span class="pron"> | Ge.tin.gnes.se |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">eloquence</span>
						<span class="meaning-la"> (Lat. facundia)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Getingnesse facundia</span>
							<span class="q-cite"> (143, 23)</span>
						</li>
						<li>
							<span class="q-la">facundia</span>
							<span class="q-oe">Getincnesse</span>
							<span class="q-cite"> (34, 16)</span>
						</li>
						<li>
							<span class="q-la">metrica facundia (i. eloquentia) fretus</span>
							<span class="q-oe">Meterlicere getincnesse gegōdod</span>
							<span class="q-cite"> (An. Ox. 125)</span>
						</li>
						<li>
							<span class="q-la">urbanitate, i. disertitudine (verborum praeditus)</span>
							<span class="q-oe">Getincnesse</span>
							<span class="q-cite"> (2297)</span>
						</li>
						<li>
							<span class="q-la">nobis luce veritatis plena eloquia subministrat</span>
							<span class="q-oe">Hē ūs selð micle getyngnesse and wlitige sprǣce ymb sōðfæsðnesse tō cȳðanne</span>
							<span class="q-cite"> (Past. 369, 14)</span>
						</li>
						<li>
							<span class="q-en">they had skill to speak in all tongues</span>
							<span class="q-oe">Hī eallra gereorda getingnesse hæfdon</span>
							<span class="q-cite"> (Btwk. 214, 32)</span>
						</li>
						<li>
							<span class="q-la">per facundiam</span>
							<span class="q-oe">Þurh getingnesse</span>
							<span class="q-cite"> (Ll. Lbmn. 414, 12)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">elegance of speech</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">eleganti prosę sententia (i. peritia)</span>
									<span class="q-oe">Mid þæslicere race getinnysse (getignysse, Hpt. Gl. 528, 4)</span>
									<span class="q-cite"> (An. Ox. 5403)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="meaning-en">skill</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Getydde on bōclicum cræfte hig witon mid getingnysse heora mōdes ꝥ ꝥ rihtmeterfers sceal habban feōwer and twēntig tīman</span>
									<span class="q-cite"> (Angl. viii. 314, 10)</span>
								</li>
								<li>
									<span class="q-oe">For ðǣra bōcra getingnyssum</span>
									<span class="q-cite"> (300, 3)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">III a.</span>
										<span class="meaning-en">skilful words, wise sayings</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Rǣde hē þæs eādigan weres getingnyssa, Bēdan</span>
											<span class="q-cite"> (Angl. 308, 12)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">IV.</span>
								<span class="meaning-en">set speech</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">oratio</span>
									<span class="q-oe">Getincnes</span>
									<span class="q-cite"> (An. Ox. 319)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-tynge" class="xref-target">ge-tynge</a>
			</p>
		</body>
	</d:entry>
