<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="stuðan-sceaft" d:title="stuðan-sceaft">
		<body>
			<h1>stuðan-sceaft<span class="pron"> | stu.θɑn.ʃæ͜ɑft |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A prop, stay</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic gaderode stuþansceaftas</span>
							<span class="q-cite"> (Shrn. 163, 5)</span>
						</li>
						<li>
							<span class="q-oe">Tō ðam ilcan wuda ðār ic ðās stuðansceaftas cearf</span>
							<span class="q-cite"> (14)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:studu" class="xref-target">studu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="dropan" d:title="dropan">
		
		<body>
			<h1>dropan<span class="pron"> | dro.pɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: present participle sg: -ende, past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To drop</span>
						<span class="meaning-la"> (Lat. stillāre)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sīcut stilliċdia stillantia super terram</span>
							<span class="q-oe">Swā swa dropan dropende ofer eorþan</span>
							<span class="q-cite"> (Ps. Spl. 71, 6)</span>
						</li>
						<li>
							<span class="q-oe">Droppende</span>
							<span class="q-cite"> (Ps. Lamb. 71, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:dropa" class="xref-target">dropa</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="meaht-loc" d:title="meaht-loc">
		<body>
			<h1>meaht-loc<span class="pron"> | mæ͜ɑxt.lok |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A bolt of might</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ne wāciað þās geweorc, ac hī wel healdað, stondað stīdlīce bestryþed fæste miclum meahtlocum</span>
							<span class="q-cite"> (Sch. 88)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="maffa" d:title="maffa">
		<body>
			<h1>maffa<span class="pron"> | mɑf.fɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A caul</span>
						<span class="meaning-la"> (Lat. omentum)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-brōðorscipe" d:title="ge-brōðorscipe">
		<body>
			<h1>ge-brōðorscipe<span class="pron"> | je.broː.θor.ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Brothership, brotherhood, fraternity</span>
						<span class="meaning-la"> (Lat. fraternĭtas)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">such brotherhood they had among them</span>
							<span class="q-oe">Ðyllīcne gebrōðorscipe hȳ heōldon [MS. healdan] him betweonum</span>
							<span class="q-cite"> (Ors. 3, 11; Bos. 76, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-logian" d:title="ge-logian">
		<body>
			<h1>ge-logian<span class="pron"> | je.lo.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To place, lodge, dispose, regulate</span>
						<span class="meaning-la"> (Lat. ponere, disponere, reponere, collocare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Deus posuit hominem</span>
							<span class="q-oe">God gelogode ðone man</span>
							<span class="q-cite"> (Gen. 2, 8 : Homl. Th. i. 12, 33)</span>
						</li>
						<li>
							<span class="q-en">the faithful folk dispose themselves and their life for God</span>
							<span class="q-oe">Ða geleāfullan folc hīg sylfe gelogiaþ and heora līf for Gode</span>
							<span class="q-cite"> (Ælfc. T. Lisle 28, 13)</span>
						</li>
						<li>
							<span class="q-en">regulates his own life</span>
							<span class="q-oe">Gelogaþ his āgen līf</span>
							<span class="q-cite"> (Tract. de Spir. Septif : Homl. Th. i. 168, 11)</span>
						</li>
						<li>
							<span class="q-en">the servant of God who takes orders must be disposed in the manner that God has taught</span>
							<span class="q-oe">Godes ðeōw se ðe hād underfēhþ sceal beōn on ða wīson gelogod ðe God tǣhte</span>
							<span class="q-cite"> (ii. 48, 31 : i. 286, 13)</span>
						</li>
						<li>
							<span class="q-en">that monastery he filled with men of good life</span>
							<span class="q-oe">Ðæt mynster he gelogode mid wellybbendum mannum</span>
							<span class="q-cite"> (506, 15)</span>
						</li>
						<li>
							<span class="q-en">then the holy bones were washed and laid up</span>
							<span class="q-oe">Ðā ðwōh man ða hālgan bān and gelogodon hī up</span>
							<span class="q-cite"> (Swt. Rdr. 100, 158)</span>
						</li>
						<li>
							<span class="q-en">they placed S. Ælfeg's holy body on the north side of the altar</span>
							<span class="q-oe">Hī gelogodon sce Ælfeāges hālgan līchaman on norþhealfe weofodes</span>
							<span class="q-cite"> (Chr. 1023; Erl. 163, 33)</span>
						</li>
						<li>
							<span class="q-en">he got more castles and lodged his knights therein</span>
							<span class="q-oe">He begeat mā castelas and ðǣr inne his rīderas gelogode</span>
							<span class="q-cite"> (1090; Erl. 226, 30)</span>
						</li>
						<li>
							<span class="q-en">in the best of the land make them to dwell</span>
							<span class="q-oe">Geloga hīg on ðære sēlostan stōwe</span>
							<span class="q-cite"> (Gen. 47, 6)</span>
						</li>
						<li>
							<span class="q-en">these lambs which thou hast set by themselves</span>
							<span class="q-oe">Ðās lamb ðe ðū gelogast on sundron</span>
							<span class="q-cite"> (21, 9)</span>
						</li>
						<li>
							<span class="q-en">laid the wood in order</span>
							<span class="q-oe">Ðone wudu gelogode</span>
							<span class="q-cite"> (22, 9)</span>
						</li>
						<li>
							<span class="q-en">he was gathered to his people</span>
							<span class="q-oe">He wæs gelogod to his folcum</span>
							<span class="q-cite"> (Deut. 32, 50)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weder" d:title="weder">
		<body>
			<h1>weder<span class="pron"> | we.der |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">weather, condition of the atmosphere</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Uueder temperies</span>
							<span class="q-cite"> (Wrt. Voc. ii. 122, 27)</span>
						</li>
						<li>
							<span class="q-oe">Gif hit siē gōd weder</span>
							<span class="q-cite"> (Lchdm. ii. 182, 10)</span>
						</li>
						<li>
							<span class="q-la">serenum erit</span>
							<span class="q-oe">Hyt byð smylte weder serenum erit</span>
							<span class="q-cite"> (Mt. Kmbl. 16, 2: Bt. 23; Fox 78, 26)</span>
						</li>
						<li>
							<span class="q-oe">Ðonne wind ligeþ, weder bið fæger</span>
							<span class="q-cite"> (Exon. Th. 210, 8; Ph. 182)</span>
						</li>
						<li>
							<span class="q-la">tempestas</span>
							<span class="q-oe">Hreōh weder tempestas</span>
							<span class="q-cite"> (Mt. Kmbl. 16, 3)</span>
						</li>
						<li>
							<span class="q-oe">Rēn, swylce hagal and snāw, weder unhiōre</span>
							<span class="q-cite"> (Met. 29, 65)</span>
						</li>
						<li>
							<span class="q-oe">Hit wæs ceald weder</span>
							<span class="q-cite"> (Ors. 6, 32; Swt. 286, 31: Met. 26, 28)</span>
						</li>
						<li>
							<span class="q-oe">Forstas and snāwas, winterbiter weder</span>
							<span class="q-cite"> (Cd. Th. 239, 32; Dan. 379)</span>
						</li>
						<li>
							<span class="q-oe">Wearm weder</span>
							<span class="q-cite"> (Exon. Th. 198, 30; Ph. 18)</span>
						</li>
						<li>
							<span class="q-oe">Rēuig weder</span>
							<span class="q-cite"> (380, 18 ; Rä. 1, 10)</span>
						</li>
						<li>
							<span class="q-oe">Wederes blæst, hādor heofon—leōma</span>
							<span class="q-cite"> (Andr. Kmbl. 1674; An. 839)</span>
						</li>
						<li>
							<span class="q-oe">Līþes weðres</span>
							<span class="q-cite"> (Met. 12, 13)</span>
						</li>
						<li>
							<span class="q-oe">Wedere gelīcost . . . on sumeres tīd</span>
							<span class="q-cite"> (Cd. Th. 237, 34; Dan. 347)</span>
						</li>
						<li>
							<span class="q-oe">Ða sǣ ðe wæs smylte wedere glæshlūtru</span>
							<span class="q-cite"> (Bt. 6; Fox 14, 24)</span>
						</li>
						<li>
							<span class="q-oe">Þeah nine (a sick man) mon on sunnan lǣde, ne mæg hē be ðȳ wedre wesan (he can't stand the weather), þeāh hit sȳ wearm on sumera</span>
							<span class="q-cite"> (Exon. Th. 340, 18 ; Gn. Ex. 113)</span>
						</li>
						<li>
							<span class="q-oe">Hē ūs giefeþ weder līþe</span>
							<span class="q-cite"> (Exon. Th. 38, 12; Cri. 605)</span>
						</li>
						<li>
							<span class="q-oe">Winter bringeþ weder ungemetceald, swifte windas</span>
							<span class="q-cite"> (Met. 11. 59)</span>
						</li>
						<li>
							<span class="q-oe">On sumera ðonne ða hātostan weder synd</span>
							<span class="q-cite"> (Lchdm. ii. 252, 10)</span>
						</li>
						<li>
							<span class="q-oe">Weder cōle—don heardum hægelscūrum</span>
							<span class="q-cite"> (Andr. Kmbl. 2514 ; An. 1258)</span>
						</li>
						<li>
							<span class="q-oe">Wuldortorhtan weder</span>
							<span class="q-cite"> (Beo. Th. 2276; B. 1136)</span>
						</li>
						<li>
							<span class="q-oe">Wedera cealdost</span>
							<span class="q-cite"> (1097; B. 546)</span>
						</li>
						<li>
							<span class="q-oe">Wedera cyst</span>
							<span class="q-cite"> (Cd. Th. 238, 6 ; Dan. 350)</span>
						</li>
						<li>
							<span class="q-oe">Niht bið wedera þeōstrost</span>
							<span class="q-cite"> (Salm. Kmbl. 621; Sal. 310)</span>
						</li>
						<li>
							<span class="q-oe">Ðeōf sceal gangan in ðȳstrum wederum</span>
							<span class="q-cite"> (Menol. Fox 544; Gn. C. 42)</span>
						</li>
						<li>
							<span class="q-oe">Hwȳ hī ne scīnen scīrum wederum</span>
							<span class="q-cite"> (Met. 28, 45)</span>
						</li>
						<li>
							<span class="q-oe">Holmegum wederum</span>
							<span class="q-cite"> (Cd. Th. 185, 6 ; Exod. 118)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">Ia.</span>
								<span class="meaning-en">good weather</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hine ne went nāðor ne weder ne unweder of ðam ðe him gecynde ys</span>
									<span class="q-cite"> (Lchdm. iii. 268, 3)</span>
								</li>
								<li>
									<span class="q-oe">Winter sceal geweorpan, weder eft cuman, sumor swegle hāt</span>
									<span class="q-cite"> (338, 12 ; Gn. Ex. 77)</span>
								</li>
								<li>
									<span class="q-oe">Wedres on luste</span>
									<span class="q-cite"> (361, 28 ; Waℓ. 26)</span>
								</li>
								<li>
									<span class="q-oe">Rēn cymð, ðonne eōwre wæstmas wederes be—þorftan</span>
									<span class="q-cite"> (Wulfst. 297, 11)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">wind, storm, breeze, air</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">aura</span>
							<span class="q-oe">Weder aura</span>
							<span class="q-cite"> (Wrt. Voc. i. 76, 43: 52, 59)</span>
						</li>
						<li>
							<span class="q-la">aure tenuis</span>
							<span class="q-oe">Smylte wedere aure tenuis</span>
							<span class="q-cite"> (ii. 4, 56: 6, 20)</span>
						</li>
						<li>
							<span class="q-la">flos pulcherrimus cito ad leuem marcescit auram</span>
							<span class="q-oe">Blōstme fægerust raþe tō leohtnm forscrincþ wedere flos pulcherrimus cito ad leuem marcescit auram</span>
							<span class="q-cite"> (Scint. 70, 3)</span>
						</li>
						<li>
							<span class="q-oe">Wedre ge—somnad</span>
							<span class="q-cite"> (Exon. Th. 412, 19; Rä. 31, 2)</span>
						</li>
						<li>
							<span class="q-la">in auram</span>
							<span class="q-oe">In wedr in auram</span>
							<span class="q-cite"> (Blickl. Gl.)</span>
						</li>
						<li>
							<span class="q-oe">Weder</span>
							<span class="q-cite"> (Ps. Surt. 106, 29)</span>
						</li>
						<li>
							<span class="q-oe">Wurdon ormǣtlīca wædera mid þunre</span>
							<span class="q-cite"> (Chr. 1117; Erl. 246, 15)</span>
						</li>
						<li>
							<span class="q-la">cum saevis aquilonibus stridens campus inhorruit</span>
							<span class="q-oe">Wintregum wederum cum saevis aquilonibus stridens campus inhorruit</span>
							<span class="q-cite"> (Bt. 5, 2 ; Fox 10, 31)</span>
						</li>
						<li>
							<span class="q-oe">Styrmendum wederum</span>
							<span class="q-cite"> (7, 3; Fox 22, 5)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">IIa.</span>
								<span class="meaning-en">in reference to sailing, weather (as in weather-bow, -bound), wind</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">vela Neritii ducis eurus appulit insulae</span>
									<span class="q-oe">Ðā gestōd hine beāh weder and storm sǣ, wearþ ðā fordrifan on ān īglond vela Neritii ducis eurus appulit insulae</span>
									<span class="q-cite"> (Bt. 38, 1; Fox 194, 10)</span>
								</li>
								<li>
									<span class="q-oe">Ðā him weder com, and Godwine and ða ðe mid him wǣron wendan tō Brycge</span>
									<span class="q-cite"> (Chr. 1052 ; Erl. 181, 19)</span>
								</li>
								<li>
									<span class="q-oe">Wearð ðæt wæder swīðe strang, ðæt ða eorlas ne mihton ge—witan hwet Godwine eorl gefaren hæfde</span>
									<span class="q-cite"> (Erl. 183, 3)</span>
								</li>
								<li>
									<span class="q-oe">Hē ðǣs wederes ābād</span>
									<span class="q-cite"> (1094; Erl. 229, 36: 1097; Erl. 234, 20)</span>
								</li>
								<li>
									<span class="q-oe">Hē wearð þurh weder gelet</span>
									<span class="q-cite"> (Erl. 233, 34)</span>
								</li>
								<li>
									<span class="q-oe">Gōd scipstȳra ongit micelne wind on hreōre sǣ ǣr ǣr hit geweorþe . . . warenaþ hē hine wiþ ðæt weder</span>
									<span class="q-cite"> (Bt. 41, 3; Fox 250, 17)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-weder" class="xref-target">ge-weder</a>, <a href="x-dictionary:r:ofer-weder" class="xref-target">ofer-weder</a>, <a href="x-dictionary:r:un-weder" class="xref-target">un-weder</a>, <a href="x-dictionary:r:un-geweder" class="xref-target">un-geweder</a>, <a href="x-dictionary:r:weder-dæg" class="xref-target">weder-dæg</a>, <a href="x-dictionary:r:weder-fæst" class="xref-target">weder-fæst</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="BEŌD" d:title="BEŌD">
		<body>
			<h1>BEŌD<span class="pron"> | be͜oːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A table</span>
						<span class="meaning-la"> (Lat. mensa)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">sedentibus ad mensam fratribus</span>
							<span class="q-oe">Ðā ða gebrōðru æt beōde sǣton</span>
							<span class="q-cite"> (Bd. 3, 2; S. 525, 9)</span>
						</li>
						<li>
							<span class="q-la">parasti in conspectu meo mensam</span>
							<span class="q-oe">Ðū gearcodest befōran mīnre gesihþe beōd vel beōdwyste vel mȳsan</span>
							<span class="q-cite"> (Ps. Lamb. 22, 5)</span>
						</li>
						<li>
							<span class="q-oe">Beōdas lances</span>
							<span class="q-cite"> (Cot. 123)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="norþan-westan" d:title="norþan-westan">
		<body>
			<h1>norþan-westan<span class="pron"> | nor.θɑn.we.stɑn |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">From the north-west</span>
						<span class="meaning-la"> (Lat. a circio)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="friþ-scipe" d:title="friþ-scipe">
		<body>
			<h1>friþ-scipe<span class="pron"> | friθ.ʃi.pe |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A state of peace</span>
						<span class="meaning-la"> (Lat. pax)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">for peace</span>
							<span class="q-oe">To friþscipe</span>
							<span class="q-cite"> (L. R. S. 1; Th. i. 432, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="wil-hrēþig" d:title="wil-hrēþig">
		<body>
			<h1>wil-hrēþig<span class="pron"> | wil.xreː.θiG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Satisfied, exultant</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Weorud willhrēðig sægdon wuldor Gode</span>
							<span class="q-cite"> (Elen. Kmbl. 2231; El. 1117)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:wil-fægen" class="xref-target">wil-fægen</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eāþ-" d:title="eāþ-">
		
		
		<body>
			<h1>eāþ-<span class="pron"> | æ͜ɑːθ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:īþ-" class="xref-target">īþ-</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eādgian" d:title="eādgian">
		
		<body>
			<h1>eādgian<span class="pron"> | æ͜ɑːd.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to make happy</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">manus debilis mulier quae nan beatificat uirum suum</span>
							<span class="q-oe">Hand unhāl wīf seō þe nā eādigað wer hyre</span>
							<span class="q-cite"> (Scint. 224, 4)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to bless, enrich with something (gen.)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sē þe eādgað ūs siges, ōðrum forwyrneð wlitigan wilsīðes</span>
							<span class="q-cite"> (Cri. 20)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to call blessed</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hī (the Virgin Mary) englas eādigað and ealle þeōda</span>
							<span class="q-cite"> (Hml. A. 136, 690)</span>
						</li>
						<li>
							<span class="q-oe">Heō is ūs tō herianne and tō eādgienne, for þon þe heō engla þreātas eādige bodedon</span>
							<span class="q-cite"> (Bl. H. 11, 11)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-eādgian" class="xref-target">ge-eādgian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ūp-ānafu" d:title="ūp-ānafu">
		<body>
			<h1>ūp-ānafu<span class="pron"> | uːp.ɑː.nɑ.fu |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An uplifting, elevation</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Sȳ mīnra handa ūpāhafu (elevatio) þē gecwēme ǣfenofrung</span>
							<span class="q-cite"> (Chrd. 30, 21)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-ālīsend-līc" d:title="un-ālīsend-līc">
		
		<body>
			<h1>un-ālīsend-līc<span class="pron"> | un.ɑː.liː.send.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Not to be remitted or forgiven, without remission</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Bið his scyld unālȳsendlīc</span>
							<span class="q-cite"> (Homl. Th. i. 500, 18)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="be-twih" d:title="be-twih">
		<body>
			<h1>be-twih<span class="pron"> | be.twix |</span>
			</h1>
			<div>
				<p>
					<b>preposition</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">between</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:betwih-licgan" class="xref-target">betwih-licgan</a>, <a href="x-dictionary:r:be-tweoh" class="xref-target">be-tweoh</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="DYNT" d:title="DYNT">
		<body>
			<h1>DYNT<span class="pron"> | dynt |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">a stroke, stripe, blow</span>
						<span class="meaning-la"> (Lat. ictus, plaga, percussio)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he, with the blow, fell down</span>
							<span class="q-oe">He, mid ðam dynte, nyðer astāh</span>
							<span class="q-cite"> (Chr. 1012; Th. 268, 29, col. 2: Jn. Lind. Rush. War. 18, 22)</span>
						</li>
						<li>
							<span class="q-en">let them fear the stroke</span>
							<span class="q-oe">Ondrǣden him ðone dynt</span>
							<span class="q-cite"> (Past. 45, 2; Hat. MS. 64 b, 23)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">the mark or noise of a blow,-A bruise, DINT, noise, crash</span>
						<span class="meaning-la"> (Lat. contusio, impressio, sonus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">if there be a bruise, a shilling; if he receive a right hand bruise, let him [the striker] pay a shilling</span>
							<span class="q-oe">Gif dynt sie, scilling; gif he heāhre handa dyntes onfēhþ, scilling forgelde</span>
							<span class="q-cite"> (L. Ethb. 58; Th. i. 18, 1)</span>
						</li>
						<li>
							<span class="q-en">they are not sparing of severe dints</span>
							<span class="q-oe">Ne wyrnaþ deōrra dynta</span>
							<span class="q-cite"> (Salm. Kmbl. 245; Sal. 122)</span>
						</li>
						<li>
							<span class="q-en">makes a loud crash</span>
							<span class="q-oe">Wyrcþ hlūdne dynt</span>
							<span class="q-cite"> (Bt. 38, 2; Fox 198, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="giccan" d:title="giccan">
		<body>
			<h1>giccan<span class="pron"> | Gik.kɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:gicce" class="xref-target">gicce</a>, <a href="x-dictionary:r:gicenes" class="xref-target">gicenes</a>, <a href="x-dictionary:r:gicþa" class="xref-target">gicþa</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fǣringa" d:title="fǣringa">
		
		
		<body>
			<h1>fǣringa<span class="pron"> | fæː.rin.gɑ |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<ul class="quotes">
						<li>
							<span class="q-oe">(repente) stōd þǣr ætforan þǣre dura sum man</span>
							<span class="q-cite"> (Gr. D. 62, 9 : Bl. H. 173, 24; 175, 2: B. 1414)</span>
						</li>
						<li>
							<span class="q-oe">Fǣringa ymbe þā herehūðe hē hlemmeð tōgædre grimme gōman</span>
							<span class="q-cite"> (Wal. 60 : 44)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="meaning-en">suddenly, unexpectedly</span>
								<span class="meaning-la"> (Lat. repente)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">(repente) stōd þǣr ætforan þǣre dura sum man</span>
									<span class="q-cite"> (Gr. D. 62, 9 : Bl. H. 173, 24; 175, 2: B. 1414)</span>
								</li>
								<li>
									<span class="q-oe">Fǣringa ymbe þā herehūðe hē hlemmeð tōgædre grimme gōman</span>
									<span class="q-cite"> (Wal. 60 : 44)</span>
								</li>
								<li>
									<span class="q-oe">Hē fǣringa feōll tō þǣre eorðan. . . and hē forðfērde</span>
									<span class="q-cite"> (Chr. 1042; P. 162, 14: Bl. H. 223, 11)</span>
								</li>
								<li>
									<span class="q-oe">Swealt Ōsgod fǣringa swā swā hē on his reste læg</span>
									<span class="q-cite"> (Chr. 1054 ; P. 184, 21 : Jul. 477)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">without premeditation</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sume ic lārum geteāh tō geflite . . . þæt hȳ fǣringa ealde æfþoncan ednīwedan</span>
									<span class="q-cite"> (Jul. 484)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">III.</span>
								<span class="meaning-en">soon, at once, without delay, early</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē cwæþ : " Cuman nū mycele hundas forþ "; and þā fǣringa cōman hundas forþ</span>
									<span class="q-cite"> (Bl. H. 181, 20)</span>
								</li>
								<li>
									<span class="q-oe">Eft fǣringa (cf. eft sōna)</span>
									<span class="q-cite"> (129, 9)</span>
								</li>
								<li>
									<span class="q-la">diluculo veniebant ad eum</span>
									<span class="q-oe">Fǣrunga hig cōmon tō him</span>
									<span class="q-cite"> (Ps L. 77, 34)</span>
								</li>
								<li>
									<span class="q-oe">Biscope is forbod ꝥ hē onfōe nīwe cumenum preōst and tō gehǣlgenne fērunga</span>
									<span class="q-cite"> (Mt. L. 10, 14 note)</span>
								</li>
								<li>
									<span class="q-oe">Hit fǣringa fȳre byrneð</span>
									<span class="q-cite"> (Ph. 531)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">IV.</span>
								<span class="meaning-en">by chance</span>
								<span class="meaning-la"> (Lat. forte)</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Man slǣtte ǣnne fearr fǣringa (fēr-, v. l.) þǣrūte</span>
									<span class="q-cite"> (Hml. S. 12, 72)</span>
								</li>
								<li>
									<span class="q-oe">Gif heora hwylc fǣringa (forte) tōðint</span>
									<span class="q-cite"> (R. Ben. 46, 16)</span>
								</li>
								<li>
									<span class="q-oe">Fǣrunga</span>
									<span class="q-cite"> (R. Ben. I. UNCERTAIN 16, 13 : 54, 6 : 87, 3)</span>
								</li>
								<li>
									<span class="q-la">adtendite ne forte grauentur corda uestra</span>
									<span class="q-oe">Begȳmað þæt [ne] fǣrunga beōn gehefegude heortan eōwre</span>
									<span class="q-cite"> (Scint. 105, 1)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fǣran" class="xref-target">fǣran</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ȳþan" d:title="ȳþan">
		<body>
			<h1>ȳþan<span class="pron"> | yː.θɑn |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:ȳþian" class="xref-target">ȳþian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="neowol" d:title="neowol">
		
		
		
		<body>
			<h1>neowol<span class="pron"> | ne͜o.wol |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">prone, prostrate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nihol pronus</span>
							<span class="q-cite"> (Ep. Gl. 20 b, 2)</span>
						</li>
						<li>
							<span class="q-oe">Nihold</span>
							<span class="q-cite"> (Wrt. Voc. ii. 118, 20)</span>
						</li>
						<li>
							<span class="q-la">cur jaces pronus in terra?</span>
							<span class="q-oe">Hwī līst ðū neowel on eorþan</span>
							<span class="q-cite"> (Jos. 7, 10)</span>
						</li>
						<li>
							<span class="q-oe">Hē feōll niwel on ða eorþan</span>
							<span class="q-cite"> (Gen. 33, 3)</span>
						</li>
						<li>
							<span class="q-oe">Niwol</span>
							<span class="q-cite"> (Bt. 1 ; Fox 4, 3)</span>
						</li>
						<li>
							<span class="q-oe">Neowol</span>
							<span class="q-cite"> (Met. 1, 80)</span>
						</li>
						<li>
							<span class="q-la">ecce impetu abiit totus grex per praeceps in mare</span>
							<span class="q-oe">Ðǣrrihte fērde eall seō heord myclum onrǣse niwel on sǣ</span>
							<span class="q-cite"> (Mt. Kmbl. 8, 32)</span>
						</li>
						<li>
							<span class="q-oe">Neōl ic fēre</span>
							<span class="q-cite"> (Exon. Th. 403, 2; Rä. 22, 1)</span>
						</li>
						<li>
							<span class="q-oe">Hīt swā niowul (prostrate) up ārǣrde</span>
							<span class="q-cite"> (Bt. 3, 1 ; Fox 4, 26)</span>
						</li>
						<li>
							<span class="q-en">the shades of night that had settled down upon earth</span>
							<span class="q-oe">Neowle nihtscūwan</span>
							<span class="q-cite"> (Cd. Th. 184, 28; Exod. 114)</span>
						</li>
						<li>
							<span class="q-oe">Ða neowelan cernua</span>
							<span class="q-cite"> (Wrt. Voc. ii. 18, 14 : 78. 59)</span>
						</li>
						<li>
							<span class="q-oe">Neōle cernuas</span>
							<span class="q-cite"> (83, 3)</span>
						</li>
						<li>
							<span class="q-oe">Niōle</span>
							<span class="q-cite"> (18, 42)</span>
						</li>
						<li>
							<span class="q-oe">Nifle nædran cynn serpentes</span>
							<span class="q-cite"> (Ps. Th. 148, 10)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">deep down, low, profound</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Niōl infima</span>
							<span class="q-cite"> (110, 73)</span>
						</li>
						<li>
							<span class="q-en">deep underground</span>
							<span class="q-oe">Under neōlum niþer næsse</span>
							<span class="q-cite"> (Elen. Kmbl. 1660; El. 832)</span>
						</li>
						<li>
							<span class="q-en">in that deepest den (hell)</span>
							<span class="q-oe">In ðam neōlan scræfe</span>
							<span class="q-cite"> (Exon. Th. 283, 23; Jul. 684)</span>
						</li>
						<li>
							<span class="q-oe">In ðissum neowlan genipe (hell)</span>
							<span class="q-cite"> (Cd. Th. 271, 7 ; Sat. 102)</span>
						</li>
						<li>
							<span class="q-en">to that profound abyss</span>
							<span class="q-oe">In ðone neowlan grund</span>
							<span class="q-cite"> (267, 1 ; Sat. 31 : 270, 16; Sat. 91)</span>
						</li>
						<li>
							<span class="q-oe">In ðis neowle genip</span>
							<span class="q-cite"> (275, 31 ; Sat. 180 : 292, 25 ; Sat. 446)</span>
						</li>
						<li>
							<span class="q-en">for thee the Lord descended from the high heaven to this lower world</span>
							<span class="q-oe">Drihten for ðē of ðæm heān heofone on ðās neowlan gesceaft niðer āstāh</span>
							<span class="q-cite"> (L. E. I. prm. ; Th. ii. 396, 2)</span>
						</li>
						<li>
							<span class="q-en">ye shall be dismissed to the bottomless pit</span>
							<span class="q-oe">Gē beōþ forǣltene on ðone neowlan helle seāð</span>
							<span class="q-cite"> (396, 18)</span>
						</li>
						<li>
							<span class="q-oe">Gǣst ellor hwearf under neowelne næs</span>
							<span class="q-cite"> (Judth. Thw. 23, 9; Jud. 113)</span>
						</li>
						<li>
							<span class="q-oe">Sunne gewāt tō sete glīdan under niflan næs</span>
							<span class="q-cite"> (Andr. Kmbl. 2611 ; An. 1307)</span>
						</li>
						<li>
							<span class="q-la">descendunt usque ad abyssos</span>
							<span class="q-oe">Nyþer gefeallaþ under neowulne grund</span>
							<span class="q-cite"> (Ps. Th. 106, 25)</span>
						</li>
						<li>
							<span class="q-en">low-lying headlands</span>
							<span class="q-oe">Neowle næssas</span>
							<span class="q-cite"> (Beo. Th. 2826 ; B.1411)</span>
						</li>
						<li>
							<span class="q-oe">Niþer under næssas, neōle grundas (hell)</span>
							<span class="q-cite"> (Exon. Th. 136, 3; Gū. 535)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="healsfange" d:title="healsfange">
		<body>
			<h1>healsfange<span class="pron"> | xæ͜ɑls.fɑn.Ge |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">II.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to pay compensation for a person wronged or slain</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gif hwā fǣmnan beswīce unbeweddode, and hire mid slǣpe, forgielde hiē</span>
									<span class="q-cite"> (52, 6)</span>
								</li>
								<li>
									<span class="q-oe">Hē þone ǣnne hēht golde forgyldan, þone þe Grendel ācwealde</span>
									<span class="q-cite"> (B. 1054)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(b)</span>
								<span class="sub-heading">the object a thing lost or destroyed or damaged</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">gilde be twifealdon duplum restituet, Ex. 22, 4</span>
									<span class="q-oe">Gif . . . siē funden ꝥ hē ǣr stæl, be twyfealdum forgielde hē hit</span>
									<span class="q-cite"> (Ll. Th. i. 50, 23)</span>
								</li>
								<li>
									<span class="q-oe">Gif mon āfelle on wuda wel monega treōwa . . ., forgielde .III. treōwu ǣlc .XXX. sciłł.</span>
									<span class="q-cite"> (128, 20)</span>
								</li>
								<li>
									<span class="q-oe">Gif fyrdscip man āmyrre ꝥ hit ǣnote weorðe, forgilde hit fullīce</span>
									<span class="q-cite"> (324, 7)</span>
								</li>
								<li>
									<span class="q-oe">Ðeāh ūre heorda hwylc ān sceāp forgȳme, wē willað ꝥ hē hit forgylde</span>
									<span class="q-cite"> (ii. 326, 25)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(c)</span>
								<span class="sub-heading">the object an undischarged obligation</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ciricsceat gelǣste man be Martinus mæssan, and se þe ꝥ ne gelǣste, forgilde hine mid twelffealdan</span>
									<span class="q-cite"> (Ll. Th. i. 342, 28)</span>
								</li>
								<li>
									<span class="q-oe">Forgylde hine .XI. sīðan</span>
									<span class="q-cite"> (366, 20)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(d)</span>
								<span class="sub-heading">the object a misdeed</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Sceolan wē mid ūre ānre sāule forgyldan and gebētan ealle þā þing þe wē ǣr ofor his bebod gedydon</span>
									<span class="q-cite"> (Bl. H. 91, 16)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="sub-heading">with acc. of compensation paid</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gif man mannan ofslæhð . . . ealne leōd forgelde . . . þā māgas healfne leōd forgelden</span>
									<span class="q-cite"> (Ll. Th. i. 8, 6, 8)</span>
								</li>
								<li>
									<span class="q-oe">Ealle forgielden þone wer gemǣnum hondum</span>
									<span class="q-cite"> (80, 16)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">with idea of release, redemption</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to pay for a criminal to save him from punishment</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Gif hine (the criminal) mon eft gefō, forgielde hē hine selfa be his wergilde</span>
									<span class="q-cite"> (Ll. Th. i. 66, 11)</span>
								</li>
								<li>
									<span class="q-oe">Sȳ hē his tungan scyldig, būton hē hine mid his were forgilde</span>
									<span class="q-cite"> (384, 27)</span>
								</li>
								<li>
									<span class="q-oe">Siē se hlāford ofslegen oþþe forgolden</span>
									<span class="q-cite"> (i. 50, 1)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to pay to get immunity from, buy off</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Eōw betere is þæt gē þisne gārrǣs mid gafole forgyldon</span>
									<span class="q-cite"> (By. 32)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">IV.</span>
						<span class="meaning-en">with idea of recompense, retribution, to repay, pay out, requite a person (dat.)</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">absolute</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">reddet Deus unicuique secundum opera sua</span>
									<span class="q-oe">Hē forgylt ānra gehwylcum æfter his āgenum gewyrhtum</span>
									<span class="q-cite"> (Wlfst. 184, 9)</span>
								</li>
								<li>
									<span class="q-oe">Wæs him forgolden æfter his āgenum gewyrhtum</span>
									<span class="q-cite"> (Bl. H. 45, 2)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">with acc. of action that is recompensed</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">visitabo in verberibus peccata eorum</span>
									<span class="q-oe">Ic heora synne swinglum forgylde</span>
									<span class="q-cite"> (Ps. Th. 88, 29)</span>
								</li>
								<li>
									<span class="q-oe">Forþon þū ūs þus dydest, wē hit þē forgyldaþ</span>
									<span class="q-cite"> (Bl. H. 241, 18)</span>
								</li>
								<li>
									<span class="q-la">vincere, dum vincitur, edocuit</span>
									<span class="q-oe">Hȳ him grimme forguldon þone wīgcræft þe hȳ æt him geleornodon</span>
									<span class="q-cite"> (Ors. 1, 2; S. 30, 7)</span>
								</li>
								<li>
									<span class="q-la">retribuant</span>
									<span class="q-oe">Mid hwām hiē hit ðē forgielden</span>
									<span class="q-cite"> (Past. 323, 24)</span>
								</li>
								<li>
									<span class="q-oe">Hē wolde Grendle forgyldan gūðrǣsa fela</span>
									<span class="q-cite"> (B. 1577)</span>
								</li>
								<li>
									<span class="q-oe">Hē wile hit him mid yfele eall forgyldan</span>
									<span class="q-cite"> (Bl. H. 55, 25)</span>
								</li>
								<li>
									<span class="q-oe">Hit weorþeþ forgolden</span>
									<span class="q-cite"> (195, 23)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(2 a)</span>
										<span class="sub-heading">the object a clause</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">he will requite us for both the good and the evil that we do here</span>
											<span class="q-oe">Hē ūs forgyldeþ swā wē nū hēr dōþ ge gōdes ge yfeles</span>
											<span class="q-cite"> (Bl. H. 51, 26)</span>
										</li>
										<li>
											<span class="q-en">the fire-drake wanted to repay (the robbery of) the precious cup with flame</span>
											<span class="q-oe">Beorges hyrde wolde līge forgyldan dryncfæt dȳre</span>
											<span class="q-cite"> (B. 2305)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">V.</span>
						<span class="meaning-en">to pay what is due, perform a vow</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðū forgeldes Drihtne gihāta ðīne</span>
							<span class="q-cite"> (Mt. L. 5, 33)</span>
						</li>
						<li>
							<span class="q-oe">Þæt ic ðē forgulde ealle þā gehāt</span>
							<span class="q-cite"> (Ps. Th. 65, 13)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-forgolden" class="xref-target">un-forgolden</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gabban" d:title="gabban">
		<body>
			<h1>gabban<span class="pron"> | gɑb.bɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ede</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -ed</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To scoff, mock, delude, jest; hence, perhaps, GABBLE, GIBBERISH</span>
						<span class="meaning-la"> (Lat. deridere, ludere, illudere)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="geldan" d:title="geldan">
