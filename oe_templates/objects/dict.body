<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eād-mēd" d:title="eād-mēd">
		<body>
			<h1>eād-mēd<span class="pron"> | æ͜ɑːd.meːd |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Humility</span>
						<span class="meaning-la"> (Lat. humĭlĭtas)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">humiliātus sum</span>
							<span class="q-oe">Ic eādmēdu efnan þence</span>
							<span class="q-cite"> (Ps. Th. 118, 107)</span>
						</li>
						<li>
							<span class="q-la">in humilĭtāte mea</span>
							<span class="q-oe">On mīnum eādmēdum</span>
							<span class="q-cite"> (118, 92)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:eāþ-mēd" class="xref-target">eāþ-mēd</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lām" d:title="lām">
		<body>
			<h1>lām<span class="pron"> | lɑːm |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Clay, mud, mire, earth</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Laam argilla</span>
							<span class="q-cite"> (Ælfc. Gl. 56; Som. 67, 35; Wrt. Voc. 37, 25: Wrt. Voc. ii. 100, 66)</span>
						</li>
						<li>
							<span class="q-oe">Lām a[r]gella</span>
							<span class="q-cite"> (Wrt. Voc. 285, 7)</span>
						</li>
						<li>
							<span class="q-oe">limus</span>
							<span class="q-cite"> (Ælfc. Gr. 13; Som. 16, 4: Wrt. Voc. ii. 112, 81)</span>
						</li>
						<li>
							<span class="q-oe">Lāmes gelīcnes the body [after death]</span>
							<span class="q-cite"> (Exon. 98 a; Th. 368, 9; Seel. 19)</span>
						</li>
						<li>
							<span class="q-la">formavit dominus deus hominem de limo terræ</span>
							<span class="q-oe">God gesceōp man of ðære eorþan lāme</span>
							<span class="q-cite"> (Gen. 2, 7: Homl. Th. i. 12, 29: 236, 15)</span>
						</li>
						<li>
							<span class="q-en">I sink in deep mire</span>
							<span class="q-la">infixus sum in Iimo profundi</span>
							<span class="q-oe">Āfæstnod ic eom on lāme grundes</span>
							<span class="q-cite"> (Ps. Spl. 68, 2)</span>
						</li>
						<li>
							<span class="q-en">deliver me out of the mire</span>
							<span class="q-la">eripe me de luto</span>
							<span class="q-oe">Genera mē of lāme</span>
							<span class="q-cite"> (C. 68, 18)</span>
						</li>
						<li>
							<span class="q-oe">Lāme bitolden covered with earth [buried]</span>
							<span class="q-cite"> (Exon. 64 a; Th. 235, 11; Ph. 555: 50 a; Th. 173, 27; Gū. 1167: 117 b; Th. 451, 5; Dōm. 99)</span>
						</li>
						<li>
							<span class="q-en">I cast away from me the power that is promised me by thee, as the dirt that I tread upon with my feet</span>
							<span class="q-oe">Ic āworpe ða myht fram mē ðe mē fram ðē gehāten ys swā ðæt lām ðe ic myd mȳnum fōtum ontrede</span>
							<span class="q-cite"> (Shrn. 151, 22)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="FOR-ÞYLDIGIAN" d:title="FOR-ÞYLDIGIAN">
