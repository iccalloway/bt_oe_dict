<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hūslung" d:title="hūslung">
		<body>
			<h1>hūslung<span class="pron"> | xuː.slung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">hanseling, communion</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hāligra hūslung is and on crīstendōme hāligra gemana</span>
							<span class="q-cite"> (Wlfst. 24, 13 note)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="eorþ-styrennis" d:title="eorþ-styrennis">
		
