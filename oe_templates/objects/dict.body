			<h1>ge-welhwilc<span class="pron"> | je.wel.xwilk |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-oe">On corne and on flexe and on gewelhwylcon wæstme</span>
						<span class="q-cite"> (Wlfst. 310, 23)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="blǣd-wēla" d:title="blǣd-wēla">
		<body>
			<h1>blǣd-wēla<span class="pron"> | blæːd.weː.lɑ |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -an</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fruitful riches</span>
						<span class="meaning-la"> (Lat. opes uberes)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I set thee on the fair earth to enjoy the fruitful riches of Paradise</span>
							<span class="q-oe">Ic ðē on ða fægran foldan gesette to neōtenne neorxna wonges blǣdwēlan</span>
							<span class="q-cite"> (Exon. 28 a; Th. 85, 16; Cri. 1392)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="-ful" d:title="-ful">
