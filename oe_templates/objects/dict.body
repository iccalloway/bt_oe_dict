<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="an-funden" d:title="an-funden">
		<body>
			<h1>an-funden<span class="pron"> | ɑn.fun.den |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">found, taken; p. of an-findan</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:an-findan" class="xref-target">an-findan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weorold-rīcetere" d:title="weorold-rīcetere">
		<body>
			<h1>weorold-rīcetere<span class="pron"> | we͜o.rold.riː.Ke.te.re |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Worldly power</span>
						<span class="meaning-la"> (Lat. dignitatem aliquam mundanam)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Wē gesetton ꝥ þā þe ǣne beōð tō preōsthāde gedōn . . . ꝥ hig nā siððan tō nānon worold-rīcetere (dignitatem aliquam mundanam) ne geþrīstlācen tō becumenne</span>
							<span class="q-cite"> (Chrd. 68. 34)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þri-rēðre" d:title="þri-rēðre">
		
		
		<body>
			<h1>þri-rēðre<span class="pron"> | θri.reː.θre |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Having three banks of oars; used substantively trireme</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðā næfde hē mā scipa ðonne ān; ðæt wæs ðeāh þrerēþre</span>
							<span class="q-cite"> (Bt, 38, 1; Fox 194, 10)</span>
						</li>
						<li>
							<span class="q-oe">Þrierēþre ceōl</span>
							<span class="q-cite"> (Met. 26, 27)</span>
						</li>
						<li>
							<span class="q-la">centum triremes</span>
							<span class="q-oe">Ān C. ðara miclena þrierēðrena</span>
							<span class="q-cite"> (Ors. 3, 1; Swt. 96, 27: 5, 13; Swt. 246, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="self-myrþe" d:title="self-myrþe">
		<body>
			<h1>self-myrþe<span class="pron"> | self.myr.θe |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Self-destructive</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">inter biothonatas</span>
							<span class="q-oe">Betweōnan sylfmyrþe inter biothonatas</span>
							<span class="q-cite"> (Wrt. Voc. ii. 80, 2)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:next word" class="xref-target">next word</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fugel-hǣlsere" d:title="fugel-hǣlsere">
		<body>
			<h1>fugel-hǣlsere<span class="pron"> | fu.Gel.xæːl.se.re |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A diviner by birds, soothsayer</span>
						<span class="meaning-la"> (Lat. augur)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fugel-weohlere" class="xref-target">fugel-weohlere</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tin-tregian" d:title="tin-tregian">
		
		<body>
			<h1>tin-tregian<span class="pron"> | tin.tre.Gi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To torment, torture, afflict</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ða ðe hē ne mæg fram rihtan geleāfan tō him gebīgan, ðonne tintregaþ hē ða on mænigfælde wīsan</span>
							<span class="q-cite"> (Wulfst. 197, 7: Blickl. Homl. 59, 31)</span>
						</li>
						<li>
							<span class="q-oe">Philippus hī miclum tintrade (tintergade, MS. C.) and bismrade</span>
							<span class="q-cite"> (Ors. 3, 7; Swt. 118, 25)</span>
						</li>
						<li>
							<span class="q-oe">Se kāsere hine tintregode mid unāsecgendlīcum wītum</span>
							<span class="q-cite"> (Shrn. 116, 1)</span>
						</li>
						<li>
							<span class="q-oe">Ða ðe tintergedon ðone hālgan wer</span>
							<span class="q-cite"> (73, 1)</span>
						</li>
						<li>
							<span class="q-la">plagis impositis abierunt semivivo reticto</span>
							<span class="q-oe">Hī tintregodon hine and forlēton hine sāmcucene</span>
							<span class="q-cite"> (Lk. Skt. 10, 30)</span>
						</li>
						<li>
							<span class="q-oe">Ða wīfmen hiē swā tintredon</span>
							<span class="q-cite"> (Ors. 1, 10; Swt. 48, 13)</span>
						</li>
						<li>
							<span class="q-oe">Ðeāh ðe ðæt fȳr tintregige ða unrihtwīsan</span>
							<span class="q-cite"> (Homl. Th. ii. 590, 3)</span>
						</li>
						<li>
							<span class="q-la">caedi Dei confessorem a tortoribus praecepit</span>
							<span class="q-oe">Hēt swingan and tintregian ðone Godes andettere</span>
							<span class="q-cite"> (Bd. 1, 7; S. 477, 42)</span>
						</li>
						<li>
							<span class="q-oe">Tintergian</span>
							<span class="q-cite"> (Shrn. 76, 33)</span>
						</li>
						<li>
							<span class="q-la">torquere</span>
							<span class="q-oe">Tinterga</span>
							<span class="q-cite"> (Mt. Kmbl. Rush. 8, 29)</span>
						</li>
						<li>
							<span class="q-oe">Decius gewende tō tintregienne ða cristenan</span>
							<span class="q-cite"> (Homl. Th. ii. 424, 19)</span>
						</li>
						<li>
							<span class="q-la">torquendus, cruciandus</span>
							<span class="q-oe">Tō tintreinne</span>
							<span class="q-cite"> (Hpt. Gl. 482, 35)</span>
						</li>
						<li>
							<span class="q-oe">Ðǣr hē tintregad wearð; ǣrest hiene mon swong, ða sticode him mon ða eāgan ūt, and siþþan him mon slōg ða handa of, ðā ðæt heāfod</span>
							<span class="q-cite"> (Ors. 4, 5; Swt. 168, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-tintregian" class="xref-target">ge-tintregian</a>, <a href="x-dictionary:r:tregian" class="xref-target">tregian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cneōwade" d:title="cneōwade">
		<body>
			<h1>cneōwade<span class="pron"> | kne͜oː.wɑ.de |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:cneōwede" class="xref-target">cneōwede</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-sōþian" d:title="ge-sōþian">
		<body>
			<h1>ge-sōþian<span class="pron"> | je.soː.θi.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to prove the truth of a statement, charge, &amp;c.</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gif hē gewyrce ꝥ man hine āfylle þurh ꝥ þe hē ongeān riht geanbyrde, gif man ꝥ gesōðige (gesōðian mæge, v.l.), licge ǣgilde</span>
							<span class="q-cite"> (Ll. Th. i. 404, 13)</span>
						</li>
					</ul>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I a.</span>
								<span class="sub-heading">gesóþian on ánum to convict a person of something</span>
								<span class="meaning-en">gesōþian on ānum to convict a person of something</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">super eum inveritare</span>
									<span class="q-oe">Gif se Englisca beclypað Frenciscne mid ūtlagan þingan, and wille hit on him gesōþian (super eum inveritare)</span>
									<span class="q-cite"> (Ll. Th. i. 489, 23)</span>
								</li>
								<li>
									<span class="q-oe">Gif hit him on gesōðod weorðe</span>
									<span class="q-cite"> (324, 18)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to attest, bear witness to</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þæt hē geseah hē gesōðode eāc þurh his gesēð-nysse</span>
							<span class="q-cite"> (Nap. 32, 3)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-sēþan" class="xref-target">ge-sēþan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hose-bend" d:title="hose-bend">
		<body>
			<h1>hose-bend<span class="pron"> | xo.se.bend |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
				<ul class="quotes">
					<li>
						<span class="q-la">periscelides (crurum)</span>
						<span class="q-oe">Hosebendas periscelides (crurum)</span>
						<span class="q-cite"> (An. Ox. 4822)</span>
					</li>
				</ul>
			</div>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hwisprian" d:title="hwisprian">
		<body>
			<h1>hwisprian<span class="pron"> | xwi.spri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ede</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To mutter, murmur, WHISPER</span>
						<span class="meaning-la"> (Lat. mussito)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">omnes murmurabant</span>
							<span class="q-oe">Alle hwispredon</span>
							<span class="q-cite"> (Lk. Skt. Rush. 19, 7)</span>
						</li>
						<li>
							<span class="q-oe">Hwispradun</span>
							<span class="q-cite"> (Jn. Skt. Rush. 6, 41)</span>
						</li>
						<li>
							<span class="q-la">nolite murmurari</span>
							<span class="q-oe">Nallaþ gē hwispriga</span>
							<span class="q-cite"> (43)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æppel-leāf" d:title="æppel-leāf">
		<body>
			<h1>æppel-leāf<span class="pron"> | æp.pel.læ͜ɑːf |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An apple-leaf</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:appel-leāf" class="xref-target">appel-leāf</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="aloþ" d:title="aloþ">
		<body>
			<h1>aloþ<span class="pron"> | ɑ.loθ |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">ale</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">Wulfred should give two tuns full of clear ale, and ten mittan or measures of Welsh ale</span>
							<span class="q-oe">Wulfrēd scolde gifan twā tunnan fulle hlutres aloþ, and ten mittan Wælsces aloþ</span>
							<span class="q-cite"> (Chr. 852; Ing. 93, 16: Th. Diplm. A. D. 791-796; 40, 4, 5, 6: A. D. 804-829; p. 460, 25)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ealaþ" class="xref-target">ealaþ</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ĀR" d:title="ĀR">
		<body>
			<h1>ĀR<span class="pron"> | ɑːr |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">An OAR</span>
						<span class="meaning-la"> (Lat. remus)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">his oar becomes</span>
							<span class="q-oe">Drugaþ his ār on borde</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="swerian" d:title="swerian">
		<body>
			<h1>swerian<span class="pron"> | swe.ri.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -swōr, sg: -swerede, pl: -swōron</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -sworen</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To swear, make oath</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">I.</span>
								<span class="meaning-en">absolute</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-la">qui jurat proximo suo</span>
									<span class="q-oe">Se ðe sweraþ (swereþ, Ps. Th. Surt.) nēhstan his</span>
									<span class="q-cite"> (Ps. Spl. 14, 6)</span>
								</li>
								<li>
									<span class="q-la">terram pro qua juravi patribus eorum</span>
									<span class="q-oe">Ðæt land ðe ic fore swōr heora fæderum</span>
									<span class="q-cite"> (Num. 14, 23)</span>
								</li>
								<li>
									<span class="q-oe">Ðæt land ðe ðū hira fæderum fore swōre</span>
									<span class="q-cite"> (11, 12)</span>
								</li>
								<li>
									<span class="q-la">adversum me jurabant</span>
									<span class="q-oe">Hī wið mē sweōrun</span>
									<span class="q-cite"> (Ps. Surt. 101, 9)</span>
								</li>
								<li>
									<span class="q-oe">Ic secge eōw, ðæt gē eallunga ne swerion</span>
									<span class="q-cite"> (Mt. Kmbl. 5, 34)</span>
								</li>
								<li>
									<span class="q-oe">Hī mē hraþe æfter swerigean ongunnon</span>
									<span class="q-cite"> (Ps. Th. 101, 6)</span>
								</li>
								<li>
									<span class="q-oe">Hē mōt swerian for syxtig hīda</span>
									<span class="q-cite"> (L. In. 19; Th. i. 114, 11)</span>
								</li>
							</ul>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">I a.</span>
										<span class="meaning-en">to swear by or on</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Swā hwylc swā swereþ on temple . . . swā hwā swā swereþ on ðæs temples golde</span>
											<span class="q-cite"> (Mt. Kmbl. 23, 16, 18, 20, 21)</span>
										</li>
										<li>
											<span class="q-oe">Swā swā ðū swōre on sōðfæstnysse ðīne</span>
											<span class="q-cite"> (Ps. Spl. 88, 48)</span>
										</li>
										<li>
											<span class="q-la">juro per Deum</span>
											<span class="q-oe">Ic swerige ðurh God</span>
											<span class="q-cite"> (Ælfc. Gr. 38; Zup. 227, 4)</span>
										</li>
										<li>
											<span class="q-oe">Ne swerie gē þurh ūtencymena goda naman</span>
											<span class="q-cite"> (Ex. 23, 13: Mt. Kmbl. 5, 34, 35)</span>
										</li>
										<li>
											<span class="q-oe">Ne swerigen gē nǣfre under hǣðene godas</span>
											<span class="q-cite"> (L. Alf. 48; Th. i. 54, 23)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">I b.</span>
										<span class="meaning-en">to swear to anything</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ðæt hī hit gegaderian and eft āgifan swā hī durran tō swerian</span>
											<span class="q-cite"> (L. N. P. L. 57; Th. ii. 300, 2)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">II.</span>
								<span class="meaning-en">with an object</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(1)</span>
										<span class="meaning-en">a noun (pronoun)</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Ðā swōron hī swīðe, ðæt hit swā wǣre. Ðā cwæð hē tō him: 'Ac tō hwon sweriaþ git mān?'</span>
											<span class="q-cite"> (Guthl. 14; Gdwin. 64, 6)</span>
										</li>
										<li>
											<span class="q-oe">Ic ne swōr fela āþa on unriht</span>
											<span class="q-cite"> (Beo. Th. 5470; B. 2738)</span>
										</li>
										<li>
											<span class="q-oe">Hē mē āðas swōr</span>
											<span class="q-cite"> (949; B. 472)</span>
										</li>
										<li>
											<span class="q-oe">Hē him ðone āð swōr</span>
											<span class="q-cite"> (Gen. 24, 9)</span>
										</li>
										<li>
											<span class="q-la">jusjurandum quod juravit</span>
											<span class="q-oe">Ðone swergendan āð ðone hē swōr</span>
											<span class="q-cite"> (Ps. Surt. ii. p. 199, 20)</span>
										</li>
										<li>
											<span class="q-la">devotabant</span>
											<span class="q-oe">Wyrgdan, āð sweredan (āðsweredan?)</span>
											<span class="q-cite"> (Wrt. Voc. ii. 26, 48)</span>
										</li>
										<li>
											<span class="q-oe">Se ðe mānāð swerige</span>
											<span class="q-cite"> (L. Ath. i. 25; Th. i. 212, 18)</span>
										</li>
										<li>
											<span class="q-oe">Ðæs deādan mǣgas swerian unceāses āð</span>
											<span class="q-cite"> (L. In. 35; Th. i. 124, 7)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(1 a)</span>
												<span class="meaning-en">to swear an oath by something</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Ða ðe āðas sweriaþ on hine</span>
													<span class="q-cite"> (Ps. Th. 62, 9)</span>
												</li>
												<li>
													<span class="q-oe">Ic ǣne swōr āð on hālgum</span>
													<span class="q-cite"> (88, 31)</span>
												</li>
												<li>
													<span class="q-oe">Gange ǣlc man ðæs tō gewitnesse ðe hē durre on ðam hāligdōme swerian</span>
													<span class="q-cite"> (L. Eth. iii. 2; Th. i. 292, 14)</span>
												</li>
												<li>
													<span class="q-oe">Ic swōr mǣne āðas mīnra hlāforda līfe</span>
													<span class="q-cite"> (L. de Cf. 9; Th. ii. 264, 11)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(2)</span>
										<span class="meaning-en">where the object is a clause that contains a statement of that which is confirmed by oath</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">tunc coepit detestari et jurare quia non novisset hominem</span>
											<span class="q-oe">Ðā ætsōc hē and swerede ðæt hē nǣfre ðone man ne cūðe</span>
											<span class="q-cite"> (Mt. Kmbl. 26, 74)</span>
										</li>
										<li>
											<span class="q-oe">Hig swōron him betweōnan, ðæt hig sibbe heōldon</span>
											<span class="q-cite"> (Gen. 21, 31)</span>
										</li>
										<li>
											<span class="q-oe">Ðā swōran hiē swīðe, ðæt hiē sōð sægdon</span>
											<span class="q-cite"> (Nar. 25, 27)</span>
										</li>
										<li>
											<span class="q-oe">Swerige hē, ðæt hē him nān fācn on wiste</span>
											<span class="q-cite"> (L. In. 56; Th. i. 138, 12: L. Ath. v. 12, 2; Th. i. 242, 4)</span>
										</li>
										<li>
											<span class="q-oe">Begite hē ðara .v. .i. ðæt him mid swerige, ðæt . . .</span>
											<span class="q-cite"> (i. 9; Th. i. 204, 11)</span>
										</li>
										<li>
											<span class="q-oe">Swerian (cf. gif hī ðone āð syllan ne durren, 394. 3) hī, ðæt him nǣfre āð ne burste</span>
											<span class="q-cite"> (L. C. S. 30; Th. i. 392, 27)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(2 a)</span>
												<span class="meaning-en">to swear by, on . . . that . . .</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Swerian hī on ðam hāligdōme, ðæt hig nellan nǣnne sacleāsan man forsecgean</span>
													<span class="q-cite"> (L. Eth. iii. 3; Th. i. 294, 4)</span>
												</li>
												<li>
													<span class="q-oe">Ic swerige þurh mē sylfne . . . ic ðē bletsige</span>
													<span class="q-cite"> (Gen. 22, 16)</span>
												</li>
												<li>
													<span class="q-oe">Sweriaþ þurh Drihten, ðæt gē dōn wið mē mildheortnisse</span>
													<span class="q-cite"> (Jos. 2, 12)</span>
												</li>
												<li>
													<span class="q-oe">Ðā āsweartode eall se king and swōr under God ælmihtine and under ealle hālgan ðārtō, ðæt hit næs nā his rǣd</span>
													<span class="q-cite"> (Chart. Th. 340, 1)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
								<li>
									<p>
										<span class="sense-label">(3)</span>
										<span class="meaning-en">where noun and clause both occur</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">Swerige hē ðone āð, ðæt hē sȳ unscyldig</span>
											<span class="q-cite"> (L. Ath. i. 73; Th. i. 210, 31)</span>
										</li>
										<li>
											<span class="q-oe">Ðæt Drihten swōre āð swīðe, ðæt God wolde sendan hungor</span>
											<span class="q-cite"> (Wulfst. 209, 26)</span>
										</li>
									</ul>
									<ol class="sub-senses labeled">
										<li>
											<p>
												<span class="sense-label">(3 a)</span>
												<span class="meaning-en">with adjuration</span>
											</p>
											<ul class="quotes">
												<li>
													<span class="q-oe">Āð swereþ engla þeōden þurh his sylfes līf, ðæt ðīnes cynnes rīm ne cunnon yldo</span>
													<span class="q-cite"> (Cd. Th. 205, 5; Exod. 431)</span>
												</li>
											</ul>
										</li>
									</ol>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ā-swerian" class="xref-target">ā-swerian</a>, <a href="x-dictionary:r:æt-swerian" class="xref-target">æt-swerian</a>, <a href="x-dictionary:r:for-swerian" class="xref-target">for-swerian</a>, <a href="x-dictionary:r:ge-swerian" class="xref-target">ge-swerian</a>, <a href="x-dictionary:r:ōþ-swerian" class="xref-target">ōþ-swerian</a>, <a href="x-dictionary:r:swerigend-līc" class="xref-target">swerigend-līc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="earnung" d:title="earnung">
		<body>
			<h1>earnung<span class="pron"> | æ͜ɑr.nung |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">labour to obtain something</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">omnis mortalium cura, quam multiplicium studiorum labor exercet, diverso quidem calle procedit, sed ad unum tamen beatitudinis finem nititur pervenire</span>
							<span class="q-oe">Ǣlc deāþlic man swencþ hine selfne mid mistlicum and manigfealdum ymbhogum, and þeāh willniað ealle þurh mistlice paþas cuman tō ānum ende ꝥ is ꝥ hī wilniaþ þurh ungelīce earnunga cuman tō ānre eādignesse</span>
							<span class="q-cite"> (Bt. 24, 1; F. 80, 9)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">merit, desert</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">merito</span>
							<span class="q-oe">Earnunga</span>
							<span class="q-cite"> (Rtl. 42, 27)</span>
						</li>
						<li>
							<span class="q-oe">Hearnunge</span>
							<span class="q-cite"> (Jn. p. 7, 10)</span>
						</li>
						<li>
							<span class="q-oe">For his hālgena earnunge</span>
							<span class="q-cite"> (Hml. S. 23, 314: Solil. H. 1, 21)</span>
						</li>
						<li>
							<span class="q-la">meritorum</span>
							<span class="q-oe">Earnunga</span>
							<span class="q-cite"> (Rtl. 39, 32)</span>
						</li>
						<li>
							<span class="q-oe">Edleān heora geearnunga (earnunga, v. i.)</span>
							<span class="q-cite"> (Bt. 31, 1; F. 112, 1)</span>
						</li>
						<li>
							<span class="q-oe">Mid miclan earnungan wē geearnodon þā yrmða . . ., and mid swȳðe miclan earnungan wē þā bōte mōtan æt Gode gerǣcan</span>
							<span class="q-cite"> (Wlfst. 157, 3-6)</span>
						</li>
						<li>
							<span class="q-oe">Ðerh Sancti Cūðberhtes earnunga</span>
							<span class="q-cite"> (Jn. p. 188, 12)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">recompense</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hē rīt for þȳ þe hē mid þǣre rāde earnaþ sume earnunga</span>
							<span class="q-cite"> (Bt. 34, 7; F. 144, 7)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-molsnian" d:title="ge-molsnian">
		<body>
			<h1>ge-molsnian<span class="pron"> | je.mol.sni.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode, sg: -ade</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -od, past participle sg: -ad</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To corrupt, decay, wither</span>
						<span class="meaning-la"> (Lat. putrefacere, tabefacere, macerare, marcescere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">he shall there rot in the earth</span>
							<span class="q-oe">He ðǣr on moldan gemolsnaþ</span>
							<span class="q-cite"> (Blickl. Homl. 109, 32)</span>
						</li>
						<li>
							<span class="q-en">my dwellings are decayed and perished</span>
							<span class="q-oe">Mīne herewīc syndon gebrosnode and gemolsnode</span>
							<span class="q-cite"> (113, 26)</span>
						</li>
						<li>
							<span class="q-la">tabes</span>
							<span class="q-oe">Gemolsnad flǣsc</span>
							<span class="q-cite"> (Ælfc. Gl. 12; Wrt. Voc. 20, 16: Solil. 2)</span>
						</li>
						<li>
							<span class="q-en">as a withered herb</span>
							<span class="q-oe">Swā gemolsnad wyrt</span>
							<span class="q-cite"> (Ps. Th. 89, 6)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:molsnian" class="xref-target">molsnian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ā-læccan" d:title="ā-læccan">
		<body>
			<h1>ā-læccan<span class="pron"> | ɑː.læk.kɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -læhte</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">To get hold of, catch</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Se kyng ālehte him betwux his earmes</span>
							<span class="q-cite"> (Chr. 1123; P. 251, 9)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="þæslīcness" d:title="þæslīcness">
		
		<body>
			<h1>þæslīcness<span class="pron"> | θæ.sliː.kness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fitness, meetness, agreement with what is right</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">Domini, quod justum est et aequum, servis praestate</span>
							<span class="q-oe">Ða hlāfordas hē manode ðæt hī milde wǣron heora ðeōwum mannum mid þæslīcnysse</span>
							<span class="q-cite"> (Homl. Th. ii. 326, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:un-þæslīcness" class="xref-target">un-þæslīcness</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hreāw" d:title="hreāw">
		<body>
			<h1>hreāw<span class="pron"> | xræ͜ɑːw |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:hrǣw" class="xref-target">hrǣw</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="neoðane" d:title="neoðane">
		<body>
			<h1>neoðane<span class="pron"> | ne͜o.θɑ.ne |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Beneath, below</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Hēr is fȳr micel ufan and neoþone</span>
							<span class="q-cite"> (Cd. Th. 24, 8 ; Gen. 375)</span>
						</li>
						<li>
							<span class="q-oe">Ufane and neoþan</span>
							<span class="q-cite"> (Met. 20, 141)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="fōre-cymeþ" d:title="fōre-cymeþ">
		
		<body>
			<h1>fōre-cymeþ<span class="pron"> | foː.re.Ky.meθ |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">præveniet</span>
						<span class="meaning-la"> (Lat. præveniet)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:fōre-cuman" class="xref-target">fōre-cuman</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="luf-wende" d:title="luf-wende">
		<body>
			<h1>luf-wende<span class="pron"> | luf.wen.de |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">loving, affectionate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Amans homo byð lufwende man</span>
							<span class="q-cite"> (Angl. viii. 331, 41)</span>
						</li>
						<li>
							<span class="q-la">amico fatu</span>
							<span class="q-oe">Lufwyndre sage</span>
							<span class="q-cite"> (An. Ox. 18, 26)</span>
						</li>
						<li>
							<span class="q-oe">lch luuie þe tō leofmon, luuewende lauerd</span>
							<span class="q-cite"> (Jul. 65, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="æfst" d:title="æfst">
		<body>
			<h1>æfst<span class="pron"> | æfst |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:æfest" class="xref-target">æfest</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="edisc" d:title="edisc">
		<body>
			<h1>edisc<span class="pron"> | e.diʃ |</span>
			</h1>
			<div>
				<p>
					<b>neuter noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">EDISH or aftermath, pasture</span>
						<span class="meaning-la"> (Lat. pascua)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">we were his sheep, which he fed in his pasture</span>
							<span class="q-oe">Wǣrun we his sceāp, ða he on his edisce afēdde</span>
							<span class="q-cite"> (Ps. Th. 94, 7: 99, 3)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a park</span>
						<span class="meaning-la"> (Lat. vīvārium)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="nēp-flōd" d:title="nēp-flōd">
		<body>
			<h1>nēp-flōd<span class="pron"> | neːp.floːd |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A neap-tide, a very low tide</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Nēpflōd vel ebba ledona</span>
							<span class="q-cite"> (Wrt. Voc. i. 57, 11 : ledo, 63, 74: ii. 98, 22)</span>
						</li>
						<li>
							<span class="q-oe">On ǣlcum ānum geāre weaxeþ ðæt flōd ðæs sǣs feōwer and twentigum sīða, and swā oft wanaþ; fylleþflōd biþ nēmned on lǣden malina, and se nēpflōd ledo</span>
							<span class="q-cite"> (Shrn. 63, 31)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-georne" d:title="un-georne">
		<body>
			<h1>un-georne<span class="pron"> | un.Ge͜or.ne |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">unwillingly, reluctantly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">qui fastidiose ducem in disponendo bello audientes</span>
							<span class="q-oe">Ðā on ðæm tweōn ðe hiē swā ungeorne his willan fulleodon</span>
							<span class="q-cite"> (Ors 3, 11; Swt. 146, 24)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">without diligence, negligently</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ðæt hē tō ungeorne bewiste hwæt hē on þeōstrum dyde</span>
							<span class="q-cite"> (Blickl. Homl. 183, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="iū-dǣd" d:title="iū-dǣd">
		<body>
			<h1>iū-dǣd<span class="pron"> | i.uː.dæːd |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A deed done of old or formerly</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gū-dǣda</span>
							<span class="q-cite"> (Exon. 64 a ; Th. 235, 12; Ph. 556)</span>
						</li>
						<li>
							<span class="q-oe">Iūdǣdum</span>
							<span class="q-cite"> (76 a; Th. 284, 26; Jul. 703 : Cd. 217; Th. 276, 10; Sat. 186)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hēr-līc" d:title="hēr-līc">
		
		<body>
			<h1>hēr-līc<span class="pron"> | xeːr.liːtʃ |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Noble, excellent</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">that was no noble deed</span>
							<span class="q-oe">Næs ðæt hērlic dǣd</span>
							<span class="q-cite"> (Bt. Met. Fox 9, 36; Met. 9, 18)</span>
						</li>
						<li>
							<span class="q-oe">Hǣrlīc</span>
							<span class="q-cite"> (1, 86; Met. 1, 43)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:hēr" class="xref-target">hēr</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āhefen" d:title="āhefen">
		
		<body>
			<h1>āhefen<span class="pron"> | ɑː.xe.fen |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">raised up, exalted</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:āhebban" class="xref-target">āhebban</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="self-bana" d:title="self-bana">
		<body>
			<h1>self-bana<span class="pron"> | self.bɑ.nɑ |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:sellan" class="xref-target">sellan</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ōþ-flītan" d:title="ōþ-flītan">
		<body>
			<h1>ōþ-flītan<span class="pron"> | oːθ.fliː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">to get from another by litigation</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">then Higa at once began the case against him, and wanted to get the land from him by the litigation</span>
							<span class="q-oe">Ðā ongon Higa him specan sōna on, and wolde him ōþflītan ðæt lond</span>
							<span class="q-cite"> (Chart. Th. 169, 23)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="lǣfend" d:title="lǣfend">
		<body>
			<h1>lǣfend<span class="pron"> | læː.fend |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">One who misleads [a traitor, = lǣwend?]</span>
						<span class="meaning-la"> (Lat. seductor)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="Īstas" d:title="Īstas">
		<body>
			<h1>Īstas<span class="pron"> | iː.stɑs |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">The Esthonians</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Ic wæs mid Īstum</span>
							<span class="q-cite"> (Exon. 86 a ; Th. 323, 31; Vīd. 87)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:Ēste" class="xref-target">Ēste</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="tilian" d:title="tilian">
		
		
		
		<body>
			<h1>tilian<span class="pron"> | ti.li.ɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -ode</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">To strive after or for some object</span>
					</p>
					<ol class="sub-senses">
						<li>
							<p>
								<span class="sub-heading">where the construction is not determined</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Hē higode oððe tilode nititur</span>
									<span class="q-cite"> (Wrt. Voc. ii. 59, 69)</span>
								</li>
								<li>
									<span class="q-oe">Tioludun perstant</span>
									<span class="q-cite"> (117, 15)</span>
								</li>
								<li>
									<span class="q-oe">Tilege nitatur</span>
									<span class="q-cite"> (61, 56)</span>
								</li>
								<li>
									<span class="q-oe">Teolige decrevit</span>
									<span class="q-cite"> (Hpt. Gl. 469, 50)</span>
								</li>
								<li>
									<span class="q-oe">Tilgende nisus</span>
									<span class="q-cite"> (Wrt. Voc. ii. 60, 28)</span>
								</li>
								<li>
									<span class="q-oe">Tilgendum adnitentibiis</span>
									<span class="q-cite"> (99, 32)</span>
								</li>
								<li>
									<span class="q-oe">Tillgendum</span>
									<span class="q-cite"> (6, 23)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">where the object of effort is not expressed, to strive to obtain, to labour, toil, procure with effort, provide, acquire</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">where the person for whom the action takes place is not expressed</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-en">I command all my reeves, that they obtain revenue rightfully from my own property and maintain me therewith</span>
									<span class="q-oe">Ic bebeōde eallum mīnan gerēfan ðæt hī on mīnan āgenan rihtlīce tilian and mē mid ðam feormian</span>
									<span class="q-cite"> (L. C. S. 70; Th. i. 412, 21)</span>
								</li>
								<li>
									<span class="q-oe">Se ðe wǣre scaðiende, weorðe se tiligende on rihtlīcre tilðe</span>
									<span class="q-cite"> (Wulfst. 72, 13)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="sub-heading">with dat. of person for whom the effort is made</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Oxa teolaþ his hlāforde</span>
									<span class="q-cite"> (Homl. Th. i. 412, 3)</span>
								</li>
								<li>
									<span class="q-oe">Se ðe him sylfum teolaþ</span>
									<span class="q-cite"> (14)</span>
								</li>
								<li>
									<span class="q-oe">Se ðe him sylfum teolaþ, nā Gode, ne com se nā gyt binnon Godes wīngearde. Ða tyliaþ Gode, ða ðe ne sēcaþ heora āgen gestreōn ðurh UNCERTAIN gȳtsunge</span>
									<span class="q-cite"> (ii. 76, 32-34)</span>
								</li>
								<li>
									<span class="q-en">he should provide for himself from ii</span>
									<span class="q-oe">Ðæt hē ða eorðan worhte and him ðēron tilode</span>
									<span class="q-cite"> (Gen. 3, 23)</span>
								</li>
								<li>
									<span class="q-en">procured for themselves what they wanted with that money</span>
									<span class="q-oe">Hit māre is ðonne ccc geāra and lxxii wintra syððan ðyllīc feoh wæs farende on eorðan and ealle men heom mid tiledon</span>
									<span class="q-cite"> (Homl. Skt. i. 23, 703)</span>
								</li>
								<li>
									<span class="q-en">he deserves that you exert yourself for him</span>
									<span class="q-la">dignus est ut hoc illi praestes</span>
									<span class="q-oe">Hē is wyrðe ðæt ðū him tilige</span>
									<span class="q-cite"> (Lk. Skt. 7, 4)</span>
								</li>
								<li>
									<span class="q-en">let every priest provide for himself honestly, and let none be a trader dishonestly</span>
									<span class="q-oe">Preōsta gehwilc tilige him rihtlīce and ne beō ǣnig mangere mid unrihte</span>
									<span class="q-cite"> (L. Edg. C. 14; Th. ii. 246, 23)</span>
								</li>
								<li>
									<span class="q-en">gets gain for himself by working at his craft</span>
									<span class="q-oe">Swā hwā swā ǣnige cȳpinge on ðam dæge begāþ . . . oððe ǣnig cræftig man him on his cræfte tylige</span>
									<span class="q-cite"> (Wulfst. 296, 8)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">with gen.</span>
					</p>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="sub-heading">of an object to be obtained by effort</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">without reference to person for whom, to seek after, get after seeking, procure, make provision of</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">you weave and make provision of garments</span>
											<span class="q-oe">Ðū wyfst and wǣda tylast</span>
											<span class="q-cite"> (Homl. Th. i. 488, 26)</span>
										</li>
										<li>
											<span class="q-oe">Tilaþ ānra gehwilc āgnes willan</span>
											<span class="q-cite"> (Met. 11, 83)</span>
										</li>
										<li>
											<span class="q-oe">Ǣlc man ðæs tiolaþ, hū hē on ēcnesse swincan mǣge</span>
											<span class="q-cite"> (Ps. Th. 48, 7)</span>
										</li>
										<li>
											<span class="q-la">qui faciendae pacis studiis occupantur</span>
											<span class="q-oe">Ða ðe on ðam beōþ ābisgode ðæt hiē sibbe tiligaþ (tiliaþ, Cott. MSS)</span>
											<span class="q-cite"> (Past. 47; Swt. 363, 9)</span>
										</li>
										<li>
											<span class="q-oe">Ðæt hī unrihtes tiligeaþ</span>
											<span class="q-cite"> (Ps. Th. 143, 9)</span>
										</li>
										<li>
											<span class="q-oe">Tilgaþ</span>
											<span class="q-cite"> (Exon. Th. 230, 14; Ph. 472)</span>
										</li>
										<li>
											<span class="q-la">uxor ac liberi, qui jucunditatis gratia petantur</span>
											<span class="q-oe">Sume tiliaþ wīfa for ðam ðæt hī þurh ðæt mǣge mǣst bearna begitan and eāc wynsumlīce libban</span>
											<span class="q-cite"> (Bt. 24, 3; Fox 82, 25)</span>
										</li>
										<li>
											<span class="q-en">what was necessary for his heriots should be provided</span>
											<span class="q-oe">Man tilode tō his hergeatwæn ðæs ðe man habban sceolde</span>
											<span class="q-cite"> (Cod. Dip. Kmbl. iii. 352, 16)</span>
										</li>
										<li>
											<span class="q-oe">Mid his handcræfte hē teolode his and his gefērena forðdǣda</span>
											<span class="q-cite"> (Homl. Th. i. 392, 16)</span>
										</li>
										<li>
											<span class="q-oe">Hi wunnon æfter wyrþscipe and tiledon (tiolodon, Cott. MS.) gōdes hlisan mid gōdum weorcum</span>
											<span class="q-cite"> (Bt. 40, 4; Fox 240, 5)</span>
										</li>
										<li>
											<span class="q-la">ut sic securitatem de simplicitate possideant, ut circumspectionem prudentiae non amittant</span>
											<span class="q-oe">Ðæt hē suā tilige ðære orsorgnesse mid ðære ānfealdnesse ðætte hē ðone ymboðonc UNCERTAIN ðæs wærscipes ne forlǣte</span>
											<span class="q-cite"> (Past. 35; Swt. 237, 16)</span>
										</li>
										<li>
											<span class="q-en">I grant the land to Æffe, and let her provide what is necessary for both our souls therefrom</span>
											<span class="q-oe">Ic an ðæs landes Æffan, and heō tilige uncer begea sāwla þearfe ðǣron</span>
											<span class="q-cite"> (Chart. Th. 495, 34: 497, 18)</span>
										</li>
										<li>
											<span class="q-en">laboratores are workmen, that have to obtain by their efforts that by which all the nation has to live</span>
											<span class="q-oe">Laboratores syndon weorcmen ðe tilian sculon ðæs ðe eall þeōdscype big sceall libban</span>
											<span class="q-cite"> (L. I. P. 4; Th. ii. 306, 35: Beo. Th. 3651; B. 1823)</span>
										</li>
										<li>
											<span class="q-en">he must procure many tools</span>
											<span class="q-oe">Hē sceal fela tola tilian</span>
											<span class="q-cite"> (Anglia ix. 262, 27: 261, 10)</span>
										</li>
										<li>
											<span class="q-la">amor ortandi sobolis</span>
											<span class="q-oe">Seō lufu tuddres tō tilianne</span>
											<span class="q-cite"> (Bd. 1, 27; S. 495, 38)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">with dat. of person</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-en">Paul took no praise to himself</span>
											<span class="q-la">nec Paulus sibi aliquid imputavit</span>
											<span class="q-oe">Paulus him sylfan nānes lofes ne tilade</span>
											<span class="q-cite"> (R. Ben. 4, 5)</span>
										</li>
										<li>
											<span class="q-en">the Danes provided themselves with what they needed</span>
											<span class="q-oe">Se here tilode him ðæs ðe hī behōfdan</span>
											<span class="q-cite"> (Chr. 1006; Erl. 140, 16)</span>
										</li>
										<li>
											<span class="q-oe">Hī heom metes tilodon</span>
											<span class="q-cite"> (1016; Erl. 157, 3: Hexam. 17; Norm. 26, 9)</span>
										</li>
										<li>
											<span class="q-en">I advise you [not] to rejoice so much in other men's goodness and nobility, that you do not provide yourself with your own</span>
											<span class="q-oe">Ic lǣre ðæt ðū [ne?] fægenige ōþerra manna gōdes and heora æþelo tō ðon swīþe ðæt ðū ne tilige ðē selfum āgnes</span>
											<span class="q-cite"> (Bt. 30, 1; Fox)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
					</ol>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="prīm" d:title="prīm">
		<body>
			<h1>prīm<span class="pron"> | priːm |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">prime, the first hour, six o'clock; also the service held at that hour</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Prīm prima, undern tertia, middæg sexta</span>
							<span class="q-cite"> (Wrt. Voc. i. 53, 10-12)</span>
						</li>
						<li>
							<span class="q-la">ad primam</span>
							<span class="q-oe">Onginnaþ heāfudcwido tō prīm</span>
							<span class="q-cite"> (Rtl. 166, 17)</span>
						</li>
						<li>
							<span class="q-oe">Gibedd tō prīm</span>
							<span class="q-cite"> (171, 27)</span>
						</li>
						<li>
							<span class="q-oe">On ðysum tīdum wē herien ūrne scyppend ... on dægrēd, on prīm, on undem, on middæg, on nōn, on ǣfen, on nihtsange</span>
							<span class="q-cite"> (R. Ben. 40, 13)</span>
						</li>
						<li>
							<span class="q-oe">Ic sang prīm and seofon seolmas</span>
							<span class="q-cite"> (Coll. Monast. Th. 33, 27)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:prīm-sang" class="xref-target">prīm-sang</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="hearm-scearu" d:title="hearm-scearu">
		<body>
			<h1>hearm-scearu<span class="pron"> | xæ͜ɑrm.ʃæ͜ɑ.ru |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">What is imposed as a punishment or penalty</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">for them punishment will be prepared, some severe penalty</span>
							<span class="q-oe">Wyrþ him wīte gegearwod sum heard harmscearu</span>
							<span class="q-cite"> (Cd. 22; Th. 28, 7; Gen. 432: 37; Th. 48, 25; Gen. 781: 38; Th. 51, 19; Gen. 829)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gewif-sǣlig" d:title="gewif-sǣlig">
		<body>
			<h1>gewif-sǣlig<span class="pron"> | Ge.wif.sæː.liG |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Fortunate</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Gewifsǣli furtunatus, þone gewifsǣligan (but gewilsǣligan according to Wülcker's reading, see Wülck. Gl. 406, 2) fortunatiim</span>
							<span class="q-cite"> (Wrt. Voc. ii. 37, 6, 5)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-wilsǣlig" class="xref-target">ge-wilsǣlig</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="cneōwung" d:title="cneōwung">
		
		<body>
			<h1>cneōwung<span class="pron"> | kne͜oː.wung |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A kneeling</span>
						<span class="meaning-la"> (Lat. genuflectio)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="āwrītan" d:title="āwrītan">
		<body>
			<h1>āwrītan<span class="pron"> | ɑː.wriː.tɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
				<p>
					<b class="ending">past: sg: -wrāt, pl: -writon</b>
				</p>
				<p>
					<b class="ending">participle: past participle sg: -writen</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">to write out or down, to transcribe, describe, compose</span>
						<span class="meaning-la"> (Lat. transcribere, describere, conscribere, contexere)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">I wrote out the life of the holy father and bishop, St. Cuthbert, first in heroic metre, and after a space in prose</span>
							<span class="q-oe">Ðæs hālgan fæder and biscopes Sancti Cuþberhtes līf ǣrest eroico metro and æfter fæce gerǣde worde ic awrāt</span>
							<span class="q-cite"> (Bd. 5, 23 ; S. 648, 27)</span>
						</li>
						<li>
							<span class="q-la">cuncta per ordinem transcribere curavi</span>
							<span class="q-oe">Eall þurh endebyrdnesse ic awrāt</span>
							<span class="q-cite"> (5, 23; S. 648, 11)</span>
						</li>
						<li>
							<span class="q-en">now have we described the south</span>
							<span class="q-oe">Nū hæbbe we awriten ðære sūþ</span>
							<span class="q-cite"> (Ors.1,1; Bos. 17, 42)</span>
						</li>
						<li>
							<span class="q-en">Leviticus is called in Latin Ministerialis, that is servicebook, because the services of the priests are described therein</span>
							<span class="q-oe">Leviticus ys genemned Ministerialis on Lȳden, dæt ys þēnungbōc, for ðam ðara sacerda þēnunga sind ðār awritene</span>
							<span class="q-cite"> (Lev. pref.)</span>
						</li>
						<li>
							<span class="q-la">quibus scriptura sancta contexta est</span>
							<span class="q-oe">Ðām ðæt hālige gewrit awriten is</span>
							<span class="q-cite"> (Bd. 5, 23; S. 648, 43)</span>
						</li>
						<li>
							<span class="q-en">thoughtest thou that it was not written</span>
							<span class="q-oe">Wēndest ðū ðæt awriten nǣre</span>
							<span class="q-cite"> (Cd. 228; Th. 307, 8; Sat. 676: Ps. Th. 138, 14)</span>
						</li>
						<li>
							<span class="q-en">one is cunning to write down word-mysteries</span>
							<span class="q-oe">Sum biþ list-hendig to awrītanne word-gerȳnu</span>
							<span class="q-cite"> (Exon. 79 b; Th. 299, 2 ; Crä. 96)</span>
						</li>
						<li>
							<span class="q-en">I wrote a history and narrative of the abbots of this monastery in two books</span>
							<span class="q-oe">Ðara abbuda stǣr and spell ðysses mynstres on twām bōcum ic awrāt</span>
							<span class="q-cite"> (Bd. 5, 23 ; S. 648, 30: 5, 23 ; S. 649, 11)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">to inscribe</span>
						<span class="meaning-la"> (Lat. inscribere, inscriptione ornare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">the beam was inscribed with letters</span>
							<span class="q-oe">Wæs se beām bōcstafum awriten</span>
							<span class="q-cite"> (Elen. Kmbl. 182; El. 91)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">III.</span>
						<span class="meaning-en">to carve, delineate, draw</span>
						<span class="meaning-la"> (Lat. sculpere, delineare)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-en">upon the wall are carved the thanes of glory</span>
							<span class="q-oe">Sindon awritene [MS. awriten] on wealle wuldres þegnas</span>
							<span class="q-cite"> (Andr. Kmbl. 1451; An. 726)</span>
						</li>
						<li>
							<span class="q-en">they bore the Saviour's likeness figured and drawn on a board</span>
							<span class="q-la">ferebant imaginem Domini Salvatoris in tabula depictam</span>
							<span class="q-oe">Hī bǣron anlīcnysse Hǣlendes on brede afægde and awritene</span>
							<span class="q-cite"> (Bd. 1, 25; S. 487, 4)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="weorold-gerǣdness" d:title="weorold-gerǣdness">
		<body>
			<h1>weorold-gerǣdness<span class="pron"> | we͜o.rold.Ge.ræːd.ness |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">A secular ordinance</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Weoruldgerǣdnes (Eādgāres cyninges gerǣdnes, MS. D.)</span>
							<span class="q-cite"> (L. Edg. ii. 1; Th. i. 266, 1)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="un-gewendendlīc" d:title="un-gewendendlīc">
		<body>
			<h1>un-gewendendlīc<span class="pron"> | un.Ge.wen.dend.liːK |</span>
			</h1>
			<div>
				<p>
					<b>adjective</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Unchangeable, invariable, chronic (of disease)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Þeāh man sȳ on hwylcre ungewendendlīcre (-dedlīcre, MS. H.) ādle</span>
							<span class="q-cite"> (Lchdm. i. 328, 20)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="mǣrþ" d:title="mǣrþ">
		<body>
			<h1>mǣrþ<span class="pron"> | mæːrθ |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol class="labeled">
				<li>
					<p>
						<span class="sense-label">I.</span>
						<span class="meaning-en">greatness, honour, glory, fame</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">processit rumor ejus in omnem regionem Galilaeae</span>
							<span class="q-oe">Gesprang mērþu his in all lond Galileæ</span>
							<span class="q-cite"> (Mk. Skt. Lind. 1, 28)</span>
						</li>
						<li>
							<span class="q-oe">Lof wīde sprang, miht and mǣrþo, ofer middangeard, þeodnes þegna.</span>
							<span class="q-cite"> (Apstls. Kmbl. 13; Ap. 7)</span>
						</li>
						<li>
							<span class="q-en">there was celebrated Beowulf's glory</span>
							<span class="q-oe">Ðǣr wæs Beōwulfes mǣrþo mǣned</span>
							<span class="q-cite"> (Beo. Th. 1718; B. 857: 1322; B. 659)</span>
						</li>
						<li>
							<span class="q-en">to achieve glory</span>
							<span class="q-oe">Mǣrþo fremman</span>
							<span class="q-cite"> (4274; B. 2134)</span>
						</li>
						<li>
							<span class="q-en">that they should build a city in their own honour</span>
							<span class="q-oe">Ðæt hiē him to mǣrþe burh geworhte</span>
							<span class="q-cite"> (Cd. 80; Th. 100, 12; Gen. 1663)</span>
						</li>
						<li>
							<span class="q-oe">Ðū ongunne ætȳwan ðīne mǣrþe (magnitudinem).</span>
							<span class="q-cite"> (Deut. 3, 24: Ps. Lamb. 150, 2)</span>
						</li>
						<li>
							<span class="q-oe">Sillaþ mǣrþe (magnificentiam) ūrum Gode,</span>
							<span class="q-cite"> (Deut. 32, 3)</span>
						</li>
						<li>
							<span class="q-en">to the Lord that gave her honour and glory</span>
							<span class="q-oe">Dryhtne ðe hyre weorþmynde geaf mǣrþe</span>
							<span class="q-cite"> (Judth. 12; Thw. 26, 25; Jud. 344)</span>
						</li>
						<li>
							<span class="q-oe">Geceōsan swā helle hiēnþu swā heofones mǣrþu,</span>
							<span class="q-cite"> (Exon. 16b; Th. 37, 11; Cri. 591)</span>
						</li>
						<li>
							<span class="q-oe">Me þincþ ðæt hit hæbbe geboht sume swīðe leāslīce mǣrþe,</span>
							<span class="q-cite"> (Bt. 24, 3; Fox 82, 24)</span>
						</li>
						<li>
							<span class="q-la">video . . nec celebritatem gloria posse contingere</span>
							<span class="q-oe">Ic ongite ðæt . . ða mǣstan mǣrþa ne sint on ðysse woruldgylpe</span>
							<span class="q-cite"> (33, 1; Fox 120, 4)</span>
						</li>
						<li>
							<span class="q-en">most blessed of glories</span>
							<span class="q-oe">Mǣrþa gesǣligost</span>
							<span class="q-cite"> (Salm. Kmbl. 136; Sal. 67)</span>
						</li>
						<li>
							<span class="q-la">magnitudinem tuam narrabunt</span>
							<span class="q-oe">Mǣrþa ðīne hig tellaþ</span>
							<span class="q-cite"> (Ps. Lamb. 144, 6)</span>
						</li>
						<li>
							<span class="q-oe">Eālā mīn drihten . . mǣrþum gefrǣge,</span>
							<span class="q-cite"> (Bt. Met. Fox 20, 4; Met. 20, 2)</span>
						</li>
						<li>
							<span class="q-en">him God confirmed with glory and with might</span>
							<span class="q-oe">Hine God trymede mǣrþum and mihtum</span>
							<span class="q-cite"> (Elen. Kmbl. 29; El. 15)</span>
						</li>
					</ul>
				</li>
				<li>
					<p>
						<span class="sense-label">II.</span>
						<span class="meaning-en">a great, honourable, glorious action, a wonderful thing, mighty work</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-la">corium (serpentis) Romam devectum (quod fuisse centum viginti pedum spatio ferunt) cunctis miraculo fuit</span>
							<span class="q-oe">Hē hēt ða hȳde tō Rōme bringan and hiē ðǣr tō mǣrþe āþenian for ðon heō wæs hundtwelftiges fōta lang</span>
							<span class="q-cite"> (Ors. 4, 6; Swt. 174, 16)</span>
						</li>
						<li>
							<span class="q-oe">Sceoldon hiera senatus ða menn beforan him drīfan gebundene ðe ðǣr gefongene wǣron, ðæt heora mǣrþa sceoldon ðȳ þrymlīcran beōn,</span>
							<span class="q-cite"> (2, 4; Swt. 70, 30)</span>
						</li>
						<li>
							<span class="q-la">ibi sunt illa magna insignia que Alexander operari jusserat</span>
							<span class="q-oe">Ðǣr syndon ða micclan mǣrþa ðæt syndon ða geweorc ðe Alexander hēt gewyrcean</span>
							<span class="q-cite"> (Nar. 33, 20)</span>
						</li>
						<li>
							<span class="q-en">eager to do great things</span>
							<span class="q-oe">Mǣrþa georne</span>
							<span class="q-cite"> (Cd. 80; Th. 101, 5; Gen. 1677)</span>
						</li>
						<li>
							<span class="q-oe">Hæbbe ic mǣrþa fela ongunnen,</span>
							<span class="q-cite"> (Beo. Th. 821; B. 408: 5284; B. 2645: Exon. 82 b; Th. 310, 34; Seef. 84)</span>
						</li>
						<li>
							<span class="q-en">thou didst make it all . . though thou didst not need all those mighty works</span>
							<span class="q-oe">Ðū hit worhtes eall . . ðeāh ðē nǣnegu nēdþearf wǣre ealra ðara mǣrþa</span>
							<span class="q-cite"> (Bt. Met. Fox 20, 51; Met. 20, 26)</span>
						</li>
						<li>
							<span class="q-oe">Mǣrþa fruma God,</span>
							<span class="q-cite"> (Chr. 975; Erl. 126, 15; Edg. 41)</span>
						</li>
						<li>
							<span class="q-oe">Standaþ and geseōþ Drihtnes mǣrþa (magnalia).</span>
							<span class="q-cite"> (Ex. 14, 13: Hy. Surt. 96, 36)</span>
						</li>
						<li>
							<span class="q-oe">Mārþa,</span>
							<span class="q-cite"> (Ps. Spl. 105, 21)</span>
						</li>
						<li>
							<span class="q-oe">Ic wylle fǣhþe sēcan, mǣrþum (gloriously, nobly) fremman,</span>
							<span class="q-cite"> (Beo. Th. 5021; B. 2514)</span>
						</li>
						<li>
							<span class="q-oe">Hǣfdon neowne gefeān mǣrþum (wondrously, miraculously) gemēted,</span>
							<span class="q-cite"> (Elen. Kmbl. 1738; El. 871)</span>
						</li>
					</ul>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ellen-mǣrþu" class="xref-target">ellen-mǣrþu</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ēl" d:title="ēl">
		<body>
			<h1>ēl<span class="pron"> | eːl |</span>
			</h1>
			<div>
				<p>
					<b>noun</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">an eel</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ǣl" class="xref-target">ǣl</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-sāweled" d:title="ge-sāweled">
		<body>
			<h1>ge-sāweled<span class="pron"> | je.sɑː.we.led |</span>
			</h1>
			<div>
				<p>
					<b>participle</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Provided with a soul</span>
						<span class="meaning-la"> (Lat. animatus)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brōc-lice" d:title="brōc-lice">
		<body>
			<h1>brōc-lice<span class="pron"> | broːk.li.Ke |</span>
			</h1>
			<div>
				<p>
					<b>adverb</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sickly, grievously</span>
						<span class="meaning-la"> (Lat. ægre)</span>
					</p>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:brōc" class="xref-target">brōc</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="WÆR" d:title="WÆR">
		<body>
			<h1>WÆR<span class="pron"> | wær |</span>
			</h1>
			<p class="xref">See also: <a href="x-dictionary:r:WÆRNESS" class="xref-target">WÆRNESS</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="efen-niht" d:title="efen-niht">
		<body>
			<h1>efen-niht<span class="pron"> | e.fen.nixt |</span>
			</h1>
			<div>
				<p>
					<b>feminine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -e</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Even-night, equinox</span>
						<span class="meaning-la"> (Lat. æquinoctium)</span>
					</p>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="ge-hycgan" d:title="ge-hycgan">
		<body>
			<h1>ge-hycgan<span class="pron"> | je.xydʒ.dʒɑn |</span>
			</h1>
			<div>
				<p>
					<b>verb</b>
				</p>
			</div>
			<ol>
				<li>
					<ol class="sub-senses labeled">
						<li>
							<p>
								<span class="sense-label">(1)</span>
								<span class="meaning-en">to think of, consider</span>
							</p>
							<ol class="sub-senses labeled">
								<li>
									<p>
										<span class="sense-label">(a)</span>
										<span class="sub-heading">with acc.</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-oe">ꝥ ic on mīnum mōde betwih þās eorđlican gedrēfednesse hwīlum gehicge þā heofonlican þing</span>
											<span class="q-cite"> (Gr. D. I. 20)</span>
										</li>
									</ul>
								</li>
								<li>
									<p>
										<span class="sense-label">(b)</span>
										<span class="sub-heading">with clause</span>
									</p>
									<ul class="quotes">
										<li>
											<span class="q-la">pensa eorum animae qualiter vivunt</span>
											<span class="q-oe">Sceāwa nū and gehige hū heora sāwla lifgiađ</span>
											<span class="q-cite"> (Gr. D. 271, 13)</span>
										</li>
									</ul>
								</li>
							</ol>
						</li>
						<li>
							<p>
								<span class="sense-label">(2)</span>
								<span class="meaning-en">to think, conceive, have an idea of</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">Ne mæg ic þæt gehicgan, hū ic in þǣm becwōm</span>
									<span class="q-cite"> (Sat. 179)</span>
								</li>
							</ul>
						</li>
						<li>
							<p>
								<span class="sense-label">(3)</span>
								<span class="meaning-en">to resolve, determine</span>
							</p>
							<ul class="quotes">
								<li>
									<span class="q-oe">For þon scyle mon gehycgan þæt hē Meotude hȳre</span>
									<span class="q-cite"> (Sch. 98)</span>
								</li>
							</ul>
						</li>
					</ol>
				</li>
			</ol>
			<p class="xref">See also: <a href="x-dictionary:r:ge-hogian" class="xref-target">ge-hogian</a>
			</p>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="brym[m]" d:title="brym[m]">
		
		<body>
			<h1>brym[m]<span class="pron"> | brym, m |</span>
			</h1>
			<div>
				<p>
					<b>masculine noun</b>
				</p>
				<p>
					<b class="ending">genitive sg: -es</b>
				</p>
			</div>
			<ol>
				<li>
					<p>
						<span class="meaning-en">Sea, waves</span>
						<span class="meaning-la"> (Lat. Sea, waves)</span>
					</p>
					<ul class="quotes">
						<li>
							<span class="q-oe">Brym, sǣ æquor</span>
							<span class="q-cite"> (Wrt. Voc. i. 53, 50)</span>
						</li>
						<li>
							<span class="q-oe">Brym vel holm cataclismus, diluvium</span>
							<span class="q-cite"> (ii. 129, 42)</span>
						</li>
						<li>
							<span class="q-oe">Eorþe, brym (pontus), roderas</span>
							<span class="q-cite"> (Hy. S. 74, 34)</span>
						</li>
						<li>
							<span class="q-oe">Se brym hwoðerode under his fōtswaðum</span>
							<span class="q-cite"> (Hml. Th. ii. 388, 19)</span>
						</li>
						<li>
							<span class="q-oe">Of grunde brymmes (pelagi)</span>
							<span class="q-cite"> (Rtl. 61, 33)</span>
						</li>
						<li>
							<span class="q-oe">Of brymme aequore</span>
							<span class="q-cite"> (Hy. S. 70, 31)</span>
						</li>
						<li>
							<span class="q-oe">Īgland beworpen mid sealtum brymme</span>
							<span class="q-cite"> (Hml. Th. ii. 142, 29: 138, 4)</span>
						</li>
						<li>
							<span class="q-oe">On þām heāgan brymme</span>
							<span class="q-cite"> (Hml. S. 2, 394)</span>
						</li>
						<li>
							<span class="q-oe">Hāwian tō ðǣre sǣ, gif ǣnig mist ārise of ðām mycclum brymme</span>
							<span class="q-cite"> (18, 146)</span>
						</li>
						<li>
							<span class="q-oe">Ofer ðone sealtan brym</span>
							<span class="q-cite"> (Hml. Th. ii. 144, 20)</span>
						</li>
						<li>
							<span class="q-en">the sea of Galilee</span>
							<span class="q-oe">Ðone brym the sea of Galilee</span>
							<span class="q-cite"> (378, 23: 384, 19)</span>
						</li>
						<li>
							<span class="q-oe">Brymmas aequora</span>
							<span class="q-cite"> (Hy. S. 38, 23)</span>
						</li>
						<li>
							<span class="q-oe">Sǣs brymmas ponti freta</span>
							<span class="q-cite"> (6, 28)</span>
						</li>
						<li>
							<span class="q-oe">Flōdes bremmas (brymmas, 2, 90) cataclismi cerula</span>
							<span class="q-cite"> (An. Ox. 2478)</span>
						</li>
						<li>
							<span class="q-oe">Swā ymbclyppaþ cealda brymmas</span>
							<span class="q-cite"> (Chr. 1065; P. 193, 35)</span>
						</li>
					</ul>
				</li>
			</ol>
		</body>
	</d:entry>
<d:entry xmlns:d="http://www.apple.com/DTDs/DictionaryService-1.0.rng" id="gib" d:title="gib">
